module(
    name = "seekdb",
    version = "0.0.0",
    bazel_compatibility = [
        ">=9.3.0",
        "<=9.3.0",
    ],
)

bazel_dep(name = "rules_cc", version = "0.2.25")
# Use public-mirror releases for the rules_cc toolchain dependencies too.
bazel_dep(name = "apple_support", version = "2.8.4")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
# SDK installation belongs to build.py init.
rust.toolchain(versions = [])

installed_rust_repository = use_repo_rule("//bazel:rust_toolchain.bzl", "installed_rust_repository")
installed_rust_repository(name = "rust_native")
register_toolchains("@rust_native//:all")
installed_rust_repository(name = "rust_wasm", kind = "wasm")
register_toolchains("@rust_wasm//:all")
wasm_std_repository = use_repo_rule("//bazel:rust_toolchain.bzl", "wasm_std_repository")
wasm_std_repository(name = "rust_wasm_std")
cxxbridge_repository = use_repo_rule("//bazel:rust_repositories.bzl", "cxxbridge_repository")
cxxbridge_repository(name = "cxxbridge_source")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "*",
    repositories = ["rust_crates", "external_crates"],
    build_script_env = {"DEBUG": "true", "PROFILE": "release"},
)
crate.annotation(
    crate = "cxx",
    repositories = ["rust_crates"],
    additive_build_file = "//bazel:cxx_runtime.BUILD.bazel",
)
crate.annotation(
    crate = "spdlog-rs",
    version = "0.5.3",
    repositories = ["rust_crates"],
    patches = ["//bazel:spdlog-rs-emscripten.diff"],
    patch_args = ["-p1"],
)
_RUST_PLATFORMS = [
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "aarch64-apple-darwin",
    "x86_64-pc-windows-msvc",
    "aarch64-pc-windows-msvc",
    "aarch64-linux-android",
    "aarch64-apple-ios",
    "aarch64-apple-ios-sim",
    "wasm32-unknown-emscripten",
]
crate.from_cargo(
    name = "rust_crates",
    manifests = ["//:Cargo.toml"],
    cargo_lockfile = "//:Cargo.lock",
    cargo_config = "//bazel:rust_cargo_config.toml",
    host_tools = "@rust_native//:BUILD.bazel",
    isolated = False,
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = _RUST_PLATFORMS,
)
crate.from_cargo(
    name = "cxxbridge_deps",
    manifests = ["@cxxbridge_source//:Cargo.toml"],
    cargo_lockfile = "@cxxbridge_source//:Cargo.lock",
    cargo_config = "//bazel:rust_cargo_config.toml",
    host_tools = "@rust_native//:BUILD.bazel",
    skip_cargo_lockfile_overwrite = True,
    isolated = False,
    supported_platform_triples = _RUST_PLATFORMS,
)
crate.annotation(
    crate = "seekdb-jemalloc-sys",
    repositories = ["external_crates"],
    build_script_env = {
        "JEMALLOC_SYS_CONFIGURE_ENV": "CPPFLAGS=\nLDFLAGS=",
        "CFLAGS": "-O2 -fPIC",
        "MAKEFLAGS": "",
        "NUM_JOBS": "4",
    },
    extra_aliased_targets = {"jemalloc_build": "build_script_build"},
)
crate.annotation_select(
    crate = "seekdb-jemalloc-sys",
    repositories = ["external_crates"],
    triples = [target for target in _RUST_PLATFORMS if target not in ["aarch64-apple-ios", "aarch64-apple-ios-sim"]],
    build_script_env = {"JEMALLOC_SYS_CONFIGURE_ARGS": "--with-jemalloc-prefix=je_"},
)
crate.annotation_select(
    crate = "seekdb-jemalloc-sys",
    repositories = ["external_crates"],
    triples = ["aarch64-apple-ios", "aarch64-apple-ios-sim"],
    build_script_env = {
        "JEMALLOC_SYS_CONFIGURE_ARGS": "--with-jemalloc-prefix=je_\n--host=aarch64-apple-ios\n--with-lg-page=14\n--disable-zone-allocator",
    },
)
crate.from_cargo(
    name = "external_crates",
    manifests = ["//deps/external:Cargo.toml"],
    cargo_lockfile = "//deps/external:Cargo.lock",
    cargo_config = "//bazel:rust_cargo_config.toml",
    host_tools = "@rust_native//:BUILD.bazel",
    skip_cargo_lockfile_overwrite = True,
    isolated = False,
    supported_platform_triples = _RUST_PLATFORMS,
)
use_repo(crate, "rust_crates", "cxxbridge_deps", "external_crates")

host_tools_repository = use_repo_rule("//bazel:parser.bzl", "host_tools_repository")
host_tools_repository(name = "host_tools")

third_party_headers_repository = use_repo_rule(
    "//bazel/third_party:repositories.bzl",
    "third_party_headers_repository",
)

third_party_headers_repository(name = "third_party_native")
third_party_headers_repository(name = "third_party_android", platform = "android")
third_party_headers_repository(name = "third_party_ios", platform = "iphoneos")
third_party_headers_repository(name = "third_party_ios_simulator", platform = "iphonesimulator")
third_party_headers_repository(name = "third_party_wasm", platform = "wasm")

linux_cc_toolchain_repository = use_repo_rule(
    "//bazel/toolchains/cc:linux_cc_toolchain_repo.bzl",
    "linux_cc_toolchain_repository",
)

linux_cc_toolchain_repository(name = "linux_cc_toolchain")

register_toolchains("@linux_cc_toolchain//:all")

android_cc_toolchain_repository = use_repo_rule(
    "//bazel/toolchains/cc:android_cc_toolchain_repo.bzl",
    "android_cc_toolchain_repository",
)
android_cc_toolchain_repository(name = "android_ndk")
register_toolchains("@android_ndk//:all")

emscripten_cc_toolchain_repository = use_repo_rule(
    "//bazel/toolchains/cc:emscripten_cc_toolchain_repo.bzl",
    "emscripten_cc_toolchain_repository",
)
emscripten_cc_toolchain_repository(name = "emscripten")
register_toolchains("@emscripten//:all")

# Keep the repository-owned Clang toolchain as the reproducible Linux build
# toolchain. rules_cc configures other native hosts; apple_support registers
# the macOS compiler and SDK toolchain. The Linux/glibc toolchain is not portable
# to those hosts.
cc_configure = use_extension(
    "@rules_cc//cc:extensions.bzl",
    "cc_configure_extension",
)

use_repo(
    cc_configure,
    "local_config_cc",
    "local_config_cc_toolchains",
)

register_toolchains("@local_config_cc_toolchains//:all")

sdk_sources = use_extension("//bazel/sdk_sources:repositories.bzl", "sdk_sources")

use_repo(
    sdk_sources,
    "sdk_abseil",
    "sdk_s2_ios",
    "sdk_s2_wasm",
    "sdk_roaring",
    "sdk_vsag_ios",
    "sdk_vsag_wasm",
    "sdk_cpuinfo",
    "sdk_fmt",
    "sdk_spdlog",
    "sdk_nlohmann_json",
    "sdk_robin_map",
    "sdk_thread_pool",
    "sdk_clapack",
    "sdk_openblas",
    "sdk_antlr4",
    "sdk_lapack",
    "sdk_openmp",
    "sdk_boost",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "pyyaml",
    urls = ["https://github.com/yaml/pyyaml/archive/refs/tags/6.0.2.tar.gz"],
    sha256 = "9377c381ac3fccad8df73d96b5139ef8b1a2c57a0d913e95ab0a2275d66b5caa",
    strip_prefix = "pyyaml-6.0.2",
    build_file_content = '''package(default_visibility = ["//visibility:public"])
exports_files(["lib/yaml/__init__.py"])
filegroup(name = "files", srcs = glob(["lib/yaml/*.py"]))
''',
)
