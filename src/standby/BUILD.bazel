load("//bazel:defs.bzl", "cc_library")
load("//bazel:build_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:private"])

bool_flag(
    name = "enable_standby",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "standby_disabled",
    flag_values = {":enable_standby": "false"},
)

_STANDBY_DEPS = [
    "//src/logservice:append_callback_interface",
    "//src/logservice:logservice",
    "//src/oblib/grpc:grpc_runtime",
    "//src/oblib/grpc:standby_proto",
    "//src/oblib:oblib_foundation",
    "//src/oblib:oblib_base",
    "//src/oblib:oblib_common",
    "//src/share:cluster_metadata_persistence",
    "//src/share:config",
    "//src/share:core_types",
    "//src/share:debug_sync_interface",
    "//src/share:diagnostics",
    "//src/share:execution_contracts",
    "//src/share:freeze_coordination",
    "//src/share:io",
    "//src/share:io_device_interface",
    "//src/share:lob_diff_interface",
    "//src/share:lob_read_service",
    "//src/share:log_protocol",
    "//src/share:max_id_allocation",
    "//src/share:runtime_context",
    "//src/share:runtime_foundation",
    "//src/share:scn_interface",
    "//src/share:schema_access",
    "//src/share:tenant_role_transition_interface",
    "//src/share:tenant_runtime",
    "//src/share:task_control",
    "//src/storage:storage_runtime_internal_headers",
    "//src/storage:storage_runtime_interface",
]

cc_library(
    name = "standby_interface",
    hdrs = [
        "standby_host.h",
        "standby_module.h",
    ],
    deps = [
        "//src/oblib:oblib_base",
        "//src/share:runtime_foundation",
    ],
    features = ["layering_check"],
)

cc_library(
    name = "standby_state",
    srcs = ["control/standby_state_store.cpp"],
    hdrs = ["control/standby_state_store.h"],
    deps = [
        "//rust:config_headers",
        "//src/oblib:oblib_foundation",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_common",
        "//src/share:config",
        "//src/share:runtime_foundation",
        "//src/share:tenant_runtime",
    ],
    features = ["layering_check"],
)

cc_library(
    name = "standby_runtime",
    srcs = glob(["**/*.cpp"], exclude = [
        "control/standby_state_store.cpp",
        "standby_module.cpp",
        "standby_module_disabled.cpp",
    ]),
    hdrs = glob(["**/*.h"], exclude = [
        "control/standby_state_store.h",
        "standby_host.h",
        "standby_module.h",
    ]),
    deps = _STANDBY_DEPS + [
        ":standby_interface",
        ":standby_state",
    ],
    features = ["layering_check"],
)

cc_library(
    name = "standby_enabled",
    srcs = ["standby_module.cpp"],
    deps = _STANDBY_DEPS + [
        ":standby_interface",
        ":standby_runtime",
        ":standby_state",
    ],
    features = ["layering_check"],
)

cc_library(
    name = "standby_disabled_impl",
    srcs = ["standby_module_disabled.cpp"],
    deps = [
        ":standby_interface",
        ":standby_state",
        "//src/oblib:oblib_base",
        "//src/share:tenant_runtime",
    ],
    features = ["layering_check"],
)

cc_library(
    name = "standby",
    deps = select({
        ":standby_disabled": [":standby_disabled_impl"],
        "//conditions:default": [":standby_enabled"],
    }),
    visibility = ["//src/observer:__pkg__"],
)
