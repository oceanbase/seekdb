def sql_runtime_group_oblib_deps(groups, base = {}):
    actual = {group.name: True for group in groups}
    unknown = sorted([
        name
        for name in _SQL_RUNTIME_GROUP_OBLIB_DEPS
        if name not in actual
    ])
    missing = sorted([
        name
        for name in actual
        if name not in _SQL_RUNTIME_GROUP_OBLIB_DEPS
    ])
    if unknown or missing:
        fail("OBLib Unity dependency map differs from inventory: unknown=%s missing=%s" % (unknown, missing))
    return {
        name: base.get(name, []) + _SQL_RUNTIME_GROUP_OBLIB_DEPS[name]
        for name in actual
    }

def sql_runtime_test_oblib_deps():
    """Returns the OBLib closure reached by SQL's regular runtime groups."""
    deps = {}
    for group_deps in _SQL_RUNTIME_GROUP_OBLIB_DEPS.values():
        for dep in group_deps:
            deps[dep] = True
    return sorted(deps.keys())
