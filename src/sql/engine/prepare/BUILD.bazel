load(
    "//bazel:defs.bzl",
    "unity_cc_library",
    "cc_library",
)

package(default_visibility = ["//visibility:private"])

_ENGINE_PREPARE_PUBLIC_HEADERS = [
    "ob_deallocate_executor.h",
    "ob_execute_executor.h",
    "ob_prepare_executor.h",
]

cc_library(
    name = "engine_prepare_public_headers",
    hdrs = _ENGINE_PREPARE_PUBLIC_HEADERS,
    deps = ["//src/sql:sql_runtime_interface"],
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "engine_prepare_internal_headers",
    hdrs = glob(["*.h"], exclude = _ENGINE_PREPARE_PUBLIC_HEADERS, allow_empty = True),
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

unity_cc_library(
    name = "engine_prepare",
    unity_members = [
        "ob_deallocate_executor.cpp",
        "ob_execute_executor.cpp",
        "ob_prepare_executor.cpp",
