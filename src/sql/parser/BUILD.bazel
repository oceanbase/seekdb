load("//bazel:parser.bzl", "parser", "parser_type_names")
load(
    "//bazel:defs.bzl",
    "C_COPTS",
    "CXX_COPTS",
    "unity_source",
    "cc_library",
)
load(
    "//src/sql:sql_header_inventory.bzl",
    "SQL_COMPOSITION_HEADERS",
    "SQL_INTERFACE_CLOSURE_HEADERS",
    "SQL_PUBLIC_HEADER_ROOTS",
)
load(
    "//src/sql:sql_source_inventory.bzl",
    "SQL_PARSER_SOURCES",
)
load(
    "//src/sql:sql_module_sources.bzl",
    "paths_under",
)

package(default_visibility = ["//visibility:private"])

_PARSER_SOURCES = paths_under(
    SQL_PARSER_SOURCES,
    "src/sql/parser/",
)
_PARSER_C_SOURCES = [
    source
    for source in _PARSER_SOURCES
    if source.endswith(".c")
]
_PARSER_DRIVER_UNITY_MEMBERS = [
    "ob_sql_parser.cpp",
    "parser_utility.cpp",
]
_PARSER_CXX_STANDALONE_SOURCES = [
    source
    for source in _PARSER_SOURCES
    if (
        source.endswith(".cc")
        or source.endswith(".cpp")
        or source.endswith(".cxx")
    ) and source not in _PARSER_DRIVER_UNITY_MEMBERS
]

parser(
    name = "generate_fts_parser",
    grammar = "ftsparser.y",
    lexer_source = "ftsblex.l",
    parser = "bazel_generated/ftsparser_tab.c",
    parser_header = "bazel_generated/ftsparser_tab.h",
    lexer = "bazel_generated/ftsblex_lex.c",
    lexer_header = "bazel_generated/ftsblex_lex.h",
    flex_options = ["-Cfa", "-B", "-8"],
    lexer_patch = "fts",
)

parser(
    name = "generate_sql_parser",
    grammar = "sql_parser_mysql_mode.y",
    lexer_source = "sql_parser_mysql_mode.l",
    parser = "bazel_generated/sql_parser_mysql_mode_tab.c",
    parser_header = "bazel_generated/sql_parser_mysql_mode_tab.h",
    lexer = "bazel_generated/sql_parser_mysql_mode_lex.c",
    lexer_header = "bazel_generated/sql_parser_mysql_mode_lex.h",
    flex_options = ["-Cfa", "-B", "-8"],
    lexer_patch = "sql",
)

parser_type_names(
    name = "generate_type_names",
    src = "//src/query:_sql_item_type_definition",
    out = "bazel_generated/type_name.c",
)

cc_library(
    name = "_generated_headers",
    hdrs = [
        "bazel_generated/ftsblex_lex.h",
        "bazel_generated/ftsparser_tab.h",
        "bazel_generated/sql_parser_mysql_mode_lex.h",
        "bazel_generated/sql_parser_mysql_mode_tab.h",
    ],
    include_prefix = "sql/parser",
    includes = ["bazel_generated"],
    strip_include_prefix = "bazel_generated",
    visibility = ["//src/sql:__subpackages__"],
)

_PARSER_PUBLIC_ROOTS = paths_under(
    SQL_PUBLIC_HEADER_ROOTS,
    "parser/",
)
_PARSER_INTERFACE_CLOSURE = paths_under(
    SQL_INTERFACE_CLOSURE_HEADERS,
    "parser/",
)
_PARSER_COMPOSITION_HEADERS = paths_under(
    SQL_COMPOSITION_HEADERS,
    "parser/",
)

_PARSER_PRIVATE_HEADERS = glob(
    ["**/*.h", "**/*.ipp", "**/*.def"],
    allow_empty = True,
    exclude = _PARSER_PUBLIC_ROOTS + _PARSER_INTERFACE_CLOSURE + _PARSER_COMPOSITION_HEADERS,
)

cc_library(
    name = "parser_public_headers",
    hdrs = _PARSER_PUBLIC_ROOTS,
    textual_hdrs = _PARSER_INTERFACE_CLOSURE,
    deps = [
        "//src/oblib:common_sql_mode",
        "//src/query:_sql_parser_types",
    ],
    includes = ["."],
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

# The Observer retrieval composition target needs the concrete boolean-query
# evaluator through SQL's narrow composition seam. Own the two C parser
# declarations as normal headers so remote compile actions receive them as
# declared inputs; the broad parser interface keeps them textual for its
# generated-C consumers.
cc_library(
    name = "retrieval_composition_parser_headers",
    hdrs = _PARSER_COMPOSITION_HEADERS,
    deps = [
        "//src/oblib:common_sql_mode",
        "//src/query:_sql_parser_types",
    ],
    tags = ["manual"],
    visibility = ["//src/sql:__pkg__"],
)

cc_library(
    name = "parser_internal_headers",
    hdrs = _PARSER_PRIVATE_HEADERS,
    deps = [
        ":retrieval_composition_parser_headers",
        ":parser_public_headers",
        "//src/oblib:common_sql_mode",
        "//src/query:_sql_parser_types",
    ],
    includes = ["."],
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "_server_parser_c",
    srcs = [
        "bazel_generated/ftsblex_lex.c",
        "bazel_generated/ftsparser_tab.c",
        "bazel_generated/sql_parser_mysql_mode_lex.c",
        "bazel_generated/sql_parser_mysql_mode_tab.c",
        "bazel_generated/type_name.c",
    ] + _PARSER_C_SOURCES,
    implementation_deps = [
        ":_generated_headers",
        ":parser_internal_headers",
        ":parser_public_headers",
        "//src/sql:sql_runtime_interface",
        "//src/sql:sql_runtime_internal_headers",
        "//src/oblib:common_sql_mode",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_foundation",
    ],
    copts = C_COPTS,
    tags = ["manual"],
)

cc_library(
    name = "_sql_parser_driver_unity_members",
    textual_hdrs = _PARSER_DRIVER_UNITY_MEMBERS,
)

sql_parser_driver_unity = unity_source(
    name = "sql_parser_driver_impl",
    unity_members = _PARSER_DRIVER_UNITY_MEMBERS,
    tags = ["manual"],
)

cc_library(
    name = "_server_parser_cxx",
    srcs = [
        sql_parser_driver_unity,
    ] + _PARSER_CXX_STANDALONE_SOURCES,
    implementation_deps = [
        ":_sql_parser_driver_unity_members",
        ":parser_internal_headers",
        ":parser_public_headers",
        "//src/sql:sql_runtime_interface",
        "//src/sql:sql_runtime_internal_headers",
        "//src/oblib:common_sql_mode",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_collections_primitives",
        "//src/oblib:oblib_common",
        "//src/oblib:oblib_compression",
        "//src/oblib:oblib_concurrency_primitives",
        "//src/oblib:oblib_foundation",
        "//src/oblib:oblib_memory_primitives",
    ],
    copts = CXX_COPTS,
    tags = ["manual"],
)

cc_library(
    name = "sql_parser_driver",
    deps = [
        ":parser_internal_headers",
        ":parser_public_headers",
    ],
    implementation_deps = [
        ":_server_parser_c",
        ":_server_parser_cxx",
    ],
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "sql_server_parser",
    implementation_deps = [
        ":_server_parser_c",
        ":_server_parser_cxx",
    ],
    tags = ["manual"],
    visibility = [
        "//src/observer:__pkg__",
        "//src/sql:__pkg__",
    ],
)
