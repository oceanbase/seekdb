load(
    "//bazel:defs.bzl",
    "seekdb_semantic_unity_cc_library",
    cc_library = "seekdb_cc_library",
)
load(
    "//src/sql:sql_build_defs.bzl",
    "SQL_INTERFACE_CLOSURE_HEADERS",
    "SQL_OPTIMIZER_GROUP_NAMES",
    "SQL_PRIVATE_HEADERS",
    "SQL_PUBLIC_HEADER_ROOTS",
    "SQL_UNITY_GROUPS",
    "sql_groups_named",
    "sql_headers_under",
)

package(default_visibility = ["//visibility:private"])

_OPTIMIZER_PUBLIC_ROOTS = sql_headers_under(
    SQL_PUBLIC_HEADER_ROOTS,
    "optimizer/",
)
_OPTIMIZER_INTERFACE_CLOSURE = sql_headers_under(
    SQL_INTERFACE_CLOSURE_HEADERS,
    "optimizer/",
)
_OPTIMIZER_PRIVATE_HEADERS = sql_headers_under(
    SQL_PRIVATE_HEADERS,
    "optimizer/",
)

_OPTIMIZER_COMMON_SHARE_DEPS = [
    "//src/share:ai_endpoint_interface",
    "//src/share:autoincrement_runtime",
    "//src/share:cache",
    "//src/share:catalog_access",
