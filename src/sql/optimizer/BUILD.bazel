    ],
    "ob_sql_optimizer_stat_1": _OPTIMIZER_COMMON_SHARE_DEPS + [
        "//src/share:sql_persistence_support",
    ],
}

# Physical header owners are separate from the implementation library. This
# keeps SQL's aggregate interface acyclic even though existing SQL headers have
# mutual textual includes across the root/Optimizer package seam.
cc_library(
    name = "optimizer_public_headers",
    hdrs = _OPTIMIZER_PUBLIC_ROOTS,
    textual_hdrs = _OPTIMIZER_INTERFACE_CLOSURE,
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "optimizer_internal_headers",
    hdrs = _OPTIMIZER_PRIVATE_HEADERS,
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "_textual_optimizer_map_inputs",
    textual_hdrs = ["ob_join_property.map"],
)

seekdb_semantic_unity_cc_library(
    name = "optimizer",
    owner_package = "src/sql/optimizer",
    unity_groups = sql_groups_named(
        SQL_UNITY_GROUPS,
        SQL_OPTIMIZER_GROUP_NAMES,
    ),
    expected_group_names = SQL_OPTIMIZER_GROUP_NAMES,
    group_implementation_deps = _OPTIMIZER_GROUP_IMPLEMENTATION_DEPS,
    deps = [
        ":optimizer_public_headers",
        "//src/sql:sql_runtime_interface",
    ],
    implementation_deps = [
        ":_textual_optimizer_map_inputs",
        ":optimizer_internal_headers",
        "//src/data_plane:optimizer_storage_service",
        "//src/data_plane:parallel_range_task_planner",
        "//src/sql:sql_runtime_internal_headers",
    ],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = [
        "//src/observer:__subpackages__",
        "//src/pl:__subpackages__",
        "//src/rootserver:__subpackages__",
        "//src/sql:__subpackages__",
    ],
)
