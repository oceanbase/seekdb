_OPTIMIZER_GROUP_IMPLEMENTATION_DEPS = {
    "ob_sql_optimizer_0": _OPTIMIZER_COMMON_SHARE_DEPS + [
        "//src/share:datum",
        "//src/share:srs_provider_interface",
        "//src/share:vector",
    ],
    "ob_sql_optimizer_1": _OPTIMIZER_COMMON_SHARE_DEPS + [
        "//src/share:datum",
        "//src/share:object_cast",
        "//src/share:srs_provider_interface",
        "//src/share:vector",
    ],
    "ob_sql_optimizer_2": _OPTIMIZER_COMMON_SHARE_DEPS + [
        "//src/share:sql_persistence_support",
    ],
    "ob_sql_optimizer_stat_0": _OPTIMIZER_COMMON_SHARE_DEPS + [
        "//src/query:query_api_interface",
        "//src/share:datum",
        "//src/share:geo_serialization",
        "//src/share:object_cast",
        "//src/share:sql_persistence_support",
        "//src/share:srs_provider_interface",
