load(
    "//bazel:defs.bzl",
    "grouped_unity_cc_library",
    "cc_library",
)
load(
    "//src/sql:sql_header_inventory.bzl",
    "SQL_INTERFACE_CLOSURE_HEADERS",
    "SQL_PUBLIC_HEADER_ROOTS",
)
load(
    "//src/sql:sql_module_sources.bzl",
    "OPTIMIZER_GROUP_NAMES",
    "paths_under",
)
load("//bazel:module_sources.bzl", "select_unity_groups")
load(
    "//src/sql:sql_source_inventory.bzl",
    "SQL_UNITY_GROUPS",
)

package(default_visibility = ["//visibility:private"])

_OPTIMIZER_PUBLIC_ROOTS = paths_under(
    SQL_PUBLIC_HEADER_ROOTS,
    "optimizer/",
)
_OPTIMIZER_INTERFACE_CLOSURE = paths_under(
    SQL_INTERFACE_CLOSURE_HEADERS,
    "optimizer/",
)
_OPTIMIZER_PRIVATE_HEADERS = glob(
    ["**/*.h", "**/*.ipp", "**/*.def"],
    allow_empty = True,
    exclude = _OPTIMIZER_PUBLIC_ROOTS + _OPTIMIZER_INTERFACE_CLOSURE,
)


# Physical header owners are separate from the implementation library. This
# keeps SQL's aggregate interface acyclic even though existing SQL headers have
# mutual textual includes across the root/Optimizer package seam.
cc_library(
    name = "optimizer_public_headers",
    hdrs = _OPTIMIZER_PUBLIC_ROOTS,
    textual_hdrs = _OPTIMIZER_INTERFACE_CLOSURE,
    deps = ["//rust:config_headers"],
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "optimizer_internal_headers",
    hdrs = _OPTIMIZER_PRIVATE_HEADERS,
    deps = ["//rust:config_headers"],
    tags = ["manual"],
    visibility = ["//src/sql:__subpackages__"],
)

cc_library(
    name = "_textual_optimizer_map_inputs",
    textual_hdrs = ["ob_join_property.map"],
)

grouped_unity_cc_library(
    name = "optimizer",
    unity_groups = select_unity_groups(
        SQL_UNITY_GROUPS,
        OPTIMIZER_GROUP_NAMES,
        language = None,
    ),
    split_unity_groups = True,
    deps = [
        ":optimizer_public_headers",
        "//src/sql:sql_runtime_interface",
    ],
    implementation_deps = [
        ":_textual_optimizer_map_inputs",
        ":optimizer_internal_headers",
