# OBLib's own tests exercise private Implementation headers in addition to the
# public Module Interface.  Keep that compile seam narrow: no peer Module can
# depend on it, and //unittest/oblib discards all link inputs through
# seekdb_test_interface.
cc_library(
    name = "oblib_unit_test_internal_headers",
    testonly = True,
    deps = [
        ":_oblib_implementation_headers",
        ":common_sql_mode",
        ":oblib_foundation",
    ],
    visibility = ["//unittest/oblib:__pkg__"],
)

# Unit tests compile against public OBLib interfaces, but may link this
# test-only runtime to resolve OBLib's implementation-internal cycles without
# acquiring any SQL, Storage, or Observer dependency.
cc_library(
    name = "oblib_test_runtime",
    testonly = True,
    deps = [
        ":_malloc_hook_impl",
        ":_ob_malloc_impl",
        ":_oblib_bitmap_impl",
        ":_oblib_codec_scalar_impl",
        ":_oblib_codec_simd_impl",
        ":_oblib_common_impl",
        ":_oblib_common_standalone_impl",
        ":_oblib_compression_impl",
        ":_oblib_foundation_c_impl",
        ":_oblib_foundation_impl",
        ":_oblib_restore_impl",
        ":_oblib_rpc_impl",
        ":_oblib_ssl_impl",
        ":_oblib_vector_impl",
        ":_zstd_1_3_8_objects",
        "@seekdb_3rd_headers//:libaio",
        "@seekdb_3rd_headers//:libcrypto",
        "@seekdb_3rd_headers//:libssl",
        "@seekdb_3rd_headers//:libunwind",
        "@seekdb_3rd_headers//:zlib",
    ],
    visibility = ["//unittest/oblib:__pkg__"],
)

# Match CMake OBJECT libraries: materialize compilation outputs without asking
# each cc_library for its DefaultInfo, which also contains unused .a/.so files.
filegroup(
    name = "_oblib_compilation_outputs",
    srcs = [
        ":_malloc_hook_impl",
        ":_mock_di_impl",
        ":_ob_malloc_impl",
        ":_oblib_bitmap_impl",
        ":_oblib_codec_scalar_impl",
        ":_oblib_codec_simd_impl",
        ":_oblib_common_impl",
        ":_oblib_common_standalone_impl",
        ":_oblib_compression_impl",
        ":_oblib_foundation_c_impl",
        ":_oblib_foundation_impl",
        ":_oblib_restore_impl",
        ":_oblib_rpc_impl",
        ":_oblib_ssl_impl",
        ":_oblib_vector_impl",
    ],
    output_group = "compilation_outputs",
    tags = ["manual"],
)

filegroup(
    name = "oblib_objects_build",
    srcs = [
        ":_oblib_compilation_outputs",
        # The legacy CMake graph also folds the vendored Zstd objects with
        # `ld -r` before localizing their hidden symbols.
        ":_zstd_1_3_8_partial_link_object",
    ],
    tags = ["manual"],
)
