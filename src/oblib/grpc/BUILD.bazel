load("//bazel:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

genrule(
    name = "windows_standby_proto",
    srcs = ["standbyservice.proto"],
    outs = ["windows/standbyservice" + suffix for suffix in [".pb.cc", ".pb.h", ".grpc.pb.cc", ".grpc.pb.h"]],
    tools = [
        "@third_party_native//:protoc/protoc.exe",
        "@third_party_native//:grpc_tools/grpc_cpp_plugin.exe",
        "@third_party_native//:protoc_runtime",
    ],
    cmd_bat = 'call "$(location @third_party_native//:protoc/protoc.exe)"' +
              ' --proto_path=src/oblib/grpc --cpp_out=$(RULEDIR)/windows --grpc_out=$(RULEDIR)/windows' +
              ' --plugin=protoc-gen-grpc="$(location @third_party_native//:grpc_tools/grpc_cpp_plugin.exe)"' +
              ' $(location standbyservice.proto)',
    target_compatible_with = ["@platforms//os:windows"],
)

cc_library(
    name = "standby_proto",
    srcs = select({
        "@platforms//os:windows": ["windows/standbyservice.pb.cc", "windows/standbyservice.grpc.pb.cc"],
        "//conditions:default": ["standbyservice.pb.cc", "standbyservice.grpc.pb.cc"],
    }),
    hdrs = select({
        "@platforms//os:windows": ["windows/standbyservice.pb.h", "windows/standbyservice.grpc.pb.h"],
        "//conditions:default": ["standbyservice.pb.h", "standbyservice.grpc.pb.h"],
    }),
    include_prefix = "grpc/proto",
    strip_include_prefix = select({"@platforms//os:windows": "windows", "//conditions:default": "."}),
    visibility = ["//src/standby:__pkg__"],
    deps = [
        "//bazel/third_party:absl_headers",
        "//bazel/third_party:grpc_headers",
        "//bazel/third_party:protobuf_cpp_headers",
    ],
)

cc_library(
    name = "grpc_runtime",
    srcs = [
        "ob_grpc_context.cpp",
        "ob_grpc_server.cpp",
    ],
    hdrs = [
        "ob_grpc_context.h",
        "ob_grpc_server.h",
    ],
    deps = [
        ":standby_proto",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_foundation",
        "//bazel/third_party:absl_headers",
        "//bazel/third_party:grpc_headers",
        "//bazel/third_party:openssl_headers",
        "//bazel/third_party:protobuf_cpp_headers",
    ],
    features = ["layering_check"],
    includes = [".."],
    visibility = [
        "//src/observer:__pkg__",
        "//src/standby:__pkg__",
    ],
)
