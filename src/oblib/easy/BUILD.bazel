load("//bazel:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

# Easy is a small, header-only portability runtime. Its headers form one
# cohesive interface and are consumed together; splitting them by directory
# would add target ceremony without creating an independent seam.
cc_library(
    name = "easy",
    hdrs = glob([
        "include/*.h",
        "io/*.h",
        "thread/*.h",
        "util/*.h",
    ]),
    deps = ["//bazel/third_party:openssl_headers"],
    includes = [
        ".",
        "include",
    ],
    sanity_instrumentation = False,
    features = ["layering_check"],
    visibility = [
        "//src/oblib:__subpackages__",
        "//src:__subpackages__",
    ],
)
