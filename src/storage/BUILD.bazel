# Logservice consumes Storage's public headers. Keep that implementation edge
# out of Storage's native header interface so the native header graph remains
# acyclic.
_STORAGE_INTERFACE_NATIVE_DEPS = [
    dep
    for dep in _STORAGE_RUNTIME_NATIVE_DEPS
    if dep not in (
        ["//src/logservice:logservice"] +
        _STORAGE_RUNTIME_ONLY_SHARE_DEPS +
        _STORAGE_PRIVATE_HEADER_SHARE_DEPS
    )
]

_STORAGE_HEADER_NATIVE_DEPS = [
    dep
    for dep in _STORAGE_RUNTIME_NATIVE_DEPS
    if dep not in (
        ["//src/logservice:logservice"] +
        _STORAGE_RUNTIME_ONLY_SHARE_DEPS
    )
]

_STORAGE_INTERFACE_SHARE_DEPS = [
