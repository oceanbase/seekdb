        "//src/share:schema_model_interface",
        "//src/share:sql_persistence_support",
        "//src/share:tenant_runtime",
        "//src/share:transaction_id",
        "@seekdb_3rd_headers//:openssl_headers",
    ],
    includes = ["api"],
    tags = ["manual"],
    visibility = ["//src:__subpackages__"],
)

