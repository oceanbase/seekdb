    name = "data_plane_api_interface",
    hdrs = DATA_PLANE_API_INTERFACE_HEADERS,
    deps = [
        ":tablet_scan_interface",
        "//src/oblib:oblib_foundation",
        "//src/share:core_types",
        "//src/share:datum",
