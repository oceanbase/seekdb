    if not dep.startswith("//src/share:")
]

_ROOTSERVER_CROSS_MODULE_DEPS = [
    dep
    for dep in _ROOTSERVER_NATIVE_DEPS
    if (
        dep.startswith("//src/data_plane:") or
        dep.startswith("//src/logservice:") or
        dep.startswith("//src/pl:") or
        dep.startswith("//src/query:") or
        dep.startswith("//src/sql:") or
        dep.startswith("//src/storage:")
    )
]

_ROOTSERVER_INTERFACE_CROSS_MODULE_DEPS = [
    dep
    for dep in _ROOTSERVER_INTERFACE_NON_SHARE_DEPS
    if dep in _ROOTSERVER_CROSS_MODULE_DEPS
]

_ROOTSERVER_INTERFACE_OBLIB_DEPS = [
    dep
    for dep in _ROOTSERVER_INTERFACE_NON_SHARE_DEPS
    if dep.startswith("//src/oblib:")
]

_ROOTSERVER_INTERFACE_COMMON_DEPS = [
    dep
    for dep in _ROOTSERVER_INTERFACE_NON_SHARE_DEPS
    if (
        dep not in _ROOTSERVER_CROSS_MODULE_DEPS and
        not dep.startswith("//src/oblib:")
    )
]

_ROOTSERVER_HEADER_CROSS_MODULE_DEPS = [
    dep
    for dep in _ROOTSERVER_HEADER_NON_SHARE_DEPS
    if dep in _ROOTSERVER_CROSS_MODULE_DEPS
]

_ROOTSERVER_HEADER_OBLIB_DEPS = [
    dep
    for dep in _ROOTSERVER_HEADER_NON_SHARE_DEPS
    if dep.startswith("//src/oblib:")
]

_ROOTSERVER_HEADER_COMMON_DEPS = [
    dep
    for dep in _ROOTSERVER_HEADER_NON_SHARE_DEPS
    if (
        dep not in _ROOTSERVER_CROSS_MODULE_DEPS and
        not dep.startswith("//src/oblib:")
    )
]

_ROOTSERVER_RUNTIME_COMMON_DEPS = [
    dep
    for dep in _ROOTSERVER_NATIVE_DEPS
    if (
        not dep.startswith("//src/share:") and
        not dep.startswith("//src/oblib:") and
        dep not in _ROOTSERVER_CROSS_MODULE_DEPS
    )
]

cc_library(
    name = "rootserver_interface",
    hdrs = [
        header
        for header in ROOTSERVER_PUBLIC_HEADERS
        if header not in _ROOTSERVER_COMPOSITION_HEADERS
    ],
    deps = [
        ":debug_sync_local_runtime_interface",
    ] + _ROOTSERVER_INTERFACE_COMMON_DEPS,
    implementation_deps = (
        _ROOTSERVER_INTERFACE_SHARE_DEPS +
        _ROOTSERVER_INTERFACE_OBLIB_DEPS +
        _ROOTSERVER_INTERFACE_CROSS_MODULE_DEPS
    ),
    features = ["layering_check"],
    tags = ["manual"],
    visibility = [
        "//src:__subpackages__",
        "//unittest:__subpackages__",
    ],
)

cc_library(
    name = "debug_sync_local_runtime_interface",
    hdrs = _DEBUG_SYNC_LOCAL_RUNTIME_HEADERS,
    features = ["layering_check"],
    tags = ["manual"],
    visibility = ["//src/observer:__pkg__"],
)

cc_library(
    name = "major_freeze_coordinator_adapter",
    hdrs = _MAJOR_FREEZE_ADAPTER_HEADERS,
    deps = ["//src/data_plane:major_freeze_coordinator_interface"],
    features = ["layering_check"],
    tags = ["manual"],
