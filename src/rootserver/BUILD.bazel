rootserver_validate_source_inventory(
    ROOTSERVER_UNITY_GROUPS,
    ROOTSERVER_STANDALONE_SOURCES,
    glob([
        "**/*.c",
        "**/*.cc",
        "**/*.cpp",
        "**/*.cxx",
    ], allow_empty = True),
    ROOTSERVER_IGNORED_SOURCES,
)

rootserver_validate_header_inventory(glob(["**/*.h"]))

# Public only for central-policy negative probes. It carries no production
# providers, so ordinary visibility cannot authorize a forbidden module edge.
filegroup(
    name = "module_policy_public_probe",
    tags = ["manual"],
    testonly = True,
    visibility = ["//visibility:public"],
)

# Rootserver must never recover a dependency on its Observer composition root.
filegroup(
    name = "module_policy_illegal_observer_dependency",
    srcs = ["//src/observer:module_policy_public_probe"],
    tags = ["manual"],
    testonly = True,
)

