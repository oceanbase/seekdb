_ROOTSERVER_INTERFACE_NATIVE_DEPS = [
    dep
    for dep in _ROOTSERVER_NATIVE_DEPS
    if dep not in _ROOTSERVER_RUNTIME_ONLY_SHARE_DEPS + _ROOTSERVER_PRIVATE_HEADER_SHARE_DEPS
]

_ROOTSERVER_HEADER_NATIVE_DEPS = [
    dep
    for dep in _ROOTSERVER_NATIVE_DEPS
    if dep not in _ROOTSERVER_RUNTIME_ONLY_SHARE_DEPS
]

_ROOTSERVER_INTERFACE_SHARE_DEPS = [
    dep
    for dep in _ROOTSERVER_INTERFACE_NATIVE_DEPS
    if dep.startswith("//src/share:")
]

_ROOTSERVER_INTERFACE_NON_SHARE_DEPS = [
    dep
    for dep in _ROOTSERVER_INTERFACE_NATIVE_DEPS
    if not dep.startswith("//src/share:")
]

_ROOTSERVER_HEADER_SHARE_DEPS = [
    dep
    for dep in _ROOTSERVER_HEADER_NATIVE_DEPS
