    tags = ["manual"],
    visibility = ["//src/observer:__pkg__"],
)

cc_library(
    name = "rootserver_internal_headers",
    hdrs = glob(["**/*.h"], exclude = ROOTSERVER_PUBLIC_HEADERS),
    deps = [":rootserver_interface"] + _ROOTSERVER_HEADER_COMMON_DEPS,
    implementation_deps = (
        _ROOTSERVER_HEADER_SHARE_DEPS +
        _ROOTSERVER_HEADER_OBLIB_DEPS +
        _ROOTSERVER_HEADER_CROSS_MODULE_DEPS
