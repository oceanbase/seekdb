load(
    "//bazel:defs.bzl",
    cc_library = "seekdb_cc_library",
)

# The rootserver fork translator also uses namespace identity; storage and
# share remain namespace-blind.
package(default_visibility = ["//visibility:private"])

cc_library(
    name = "namespace",
    hdrs = ["namespace.h"],
    srcs = ["namespace.cpp"],
    features = ["layering_check"],
    visibility = [
        "//src/observer:__pkg__",
        "//src/rootserver:__pkg__",
        "//src/sql:__pkg__",
    ],
)
