load(
    "//bazel:defs.bzl",
    "seekdb_semantic_unity_cc_library",
    "seekdb_test_interface",
    cc_library = "seekdb_cc_library",
)
load(":logservice_build_defs.bzl", "LOGSERVICE_UNITY_GROUPS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "append_callback_interface",
    hdrs = ["ob_append_callback.h"],
    deps = [
        "//src/oblib:oblib_foundation",
        "//src/share:log_protocol",
        "//src/share:scn_interface",
    ],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = ["//src:__subpackages__"],
)

_LOGSERVICE_GROUP_NAMES = [
    "ob_logservice_common_0",
    "ob_logservice_common_mixed_0",
    "ob_logservice_common_util_0",
    "ob_logservice_palf_0",
    "ob_logservice_palf_1",
]

# Current public surface: headers included outside src/logservice plus their
# complete in-module textual closure. It is intentionally honest and broad;
# shrinking it is the next, source-refactoring phase.
_PUBLIC_HDRS = [
    "applyservice/ob_log_apply_service.h",
    "ob_i_log_storage.h",
    "ob_log_handler.h",
    "ob_log_monitor.h",
    "ob_log_service.h",
    "ob_server_log_block_mgr.h",
    "palf/block_gc_timer_task.h",
    "palf/fixed_sliding_window.h",
    "palf/log_block_handler.h",
    "palf/log_block_header.h",
    "palf/log_block_mgr.h",
    "palf/log_block_pool_interface.h",
    "palf/log_cache.h",
    "palf/log_checksum.h",
    "palf/log_engine.h",
    "palf/log_entry.h",
    "palf/log_entry_header.h",
    "palf/log_group_entry.h",
    "palf/log_group_entry_header.h",
    "palf/log_io_adapter.h",
    "palf/log_io_context.h",
    "palf/log_io_task.h",
    "palf/log_io_task_cb_thread_pool.h",
    "palf/log_io_task_cb_utils.h",
    "palf/log_io_utils.h",
    "palf/log_io_worker.h",
    "palf/log_io_worker_wrapper.h",
    "palf/log_iterator_impl.h",
    "palf/log_iterator_info.h",
    "palf/log_iterator_storage.h",
    "palf/log_loop_thread.h",
    "palf/log_meta.h",
    "palf/log_meta_entry.h",
    "palf/log_meta_entry_header.h",
    "palf/log_meta_info.h",
    "palf/log_mode_mgr.h",
    "palf/log_reader.h",
    "palf/log_reader_utils.h",
    "palf/log_shared_queue_thread.h",
    "palf/log_sliding_window.h",
    "palf/log_state_mgr.h",
    "palf/log_storage.h",
    "palf/log_storage_interface.h",
    "palf/log_task.h",
    "palf/log_throttle.h",
    "palf/log_write_buf.h",
    "palf/lsn_allocator.h",
    "palf/palf_log_buffer.h",
    "palf/palf_callback.h",
