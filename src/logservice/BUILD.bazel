load(
    "//bazel:defs.bzl",
    "grouped_unity_cc_library",
    "cc_library",
)
load(":logservice_build_defs.bzl", "LOGSERVICE_UNITY_GROUPS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "append_callback_interface",
    hdrs = ["ob_append_callback.h"],
    deps = [
        "//src/oblib:oblib_foundation",
        "//src/share:log_protocol",
        "//src/share:scn_interface",
    ],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = ["//src:__subpackages__"],
)

_PUBLIC_HDRS = [
    "applyservice/ob_log_apply_service.h",
    "ob_i_log_storage.h",
    "ob_log_handler.h",
    "ob_log_monitor.h",
    "ob_log_service.h",
    "ob_server_log_block_mgr.h",
    "palf/block_gc_timer_task.h",
    "palf/fixed_sliding_window.h",
    "palf/log_block_handler.h",
    "palf/log_block_header.h",
    "palf/log_block_mgr.h",
    "palf/log_block_pool_interface.h",
    "palf/log_cache.h",
    "palf/log_checksum.h",
    "palf/log_engine.h",
    "palf/log_entry.h",
    "palf/log_entry_header.h",
    "palf/log_group_buffer.h",
    "palf/log_group_entry.h",
    "palf/log_group_entry_header.h",
    "palf/log_io_adapter.h",
    "palf/log_io_context.h",
    "palf/log_io_task.h",
    "palf/log_io_task_cb_thread_pool.h",
    "palf/log_io_task_cb_utils.h",
    "palf/log_io_utils.h",
    "palf/log_io_worker.h",
    "palf/log_io_worker_wrapper.h",
    "palf/log_iterator_impl.h",
    "palf/log_iterator_info.h",
    "palf/log_iterator_storage.h",
    "palf/log_loop_thread.h",
    "palf/log_meta.h",
    "palf/log_meta_info.h",
    "palf/log_mode_mgr.h",
    "palf/log_reader.h",
    "palf/log_reader_utils.h",
    "palf/log_shared_queue_thread.h",
    "palf/log_sliding_window.h",
    "palf/log_state_mgr.h",
    "palf/log_storage.h",
    "palf/log_storage_interface.h",
    "palf/log_task.h",
    "palf/log_throttle.h",
    "palf/log_writer_utils.h",
    "palf/lsn_allocator.h",
    "palf/palf_callback.h",
    "palf/palf_callback_wrapper.h",
    "palf/palf_env.h",
    "palf/palf_env_impl.h",
    "palf/palf_handle.h",
    "palf/palf_handle_impl.h",
    "palf/palf_handle_impl_guard.h",
    "palf/palf_iterator.h",
    "palf_handle_guard.h",
    "replayservice/ob_log_replay_service.h",
    "replayservice/ob_replay_handler.h",
    "replayservice/ob_replay_status.h",
]

# New headers are private by default. Promoting one to the module interface is
# therefore a deliberate BUILD-file review rather than an accidental include.
_PRIVATE_HDRS = glob(
    ["**/*.h"],
    exclude = _PUBLIC_HDRS,
)

# One semantic module and one archive, retaining five independent Unity compile
# actions for parallelism and incremental rebuild granularity.
grouped_unity_cc_library(
    name = "logservice",
    unity_groups = LOGSERVICE_UNITY_GROUPS,
    public_hdrs = _PUBLIC_HDRS,
    private_hdrs = _PRIVATE_HDRS,
    deps = [
        ":append_callback_interface",
        "//src/share:log_protocol",
        "//src/data_plane:data_plane_api_interface",
        "//src/data_plane:tx_read_snapshot_interface",
        "//src/oblib/easy:easy",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_compression",
        "//src/oblib:oblib_concurrency_primitives",
        "//src/oblib:oblib_common",
        "//src/oblib:oblib_foundation",
        "//src/oblib:oblib_io_primitives",
        "//src/oblib:oblib_restore",
        "//src/query:query_api_interface",
        "//src/share:_generated_inner_table_headers",
        "//src/share:cluster_topology",
        "//src/share:cluster_version_interface",
        "//src/share:core_types",
        "//src/share:delegate_interface",
        "//src/share:device_manager_interface",
        "//src/share:diagnostics",
        "//src/share:error_codes",
        "//src/share:io",
        "//src/share:redo_log_storage",
        "//src/share:runtime_context",
        "//src/share:scn_interface",
        "//src/share:server_resource_types",
        "//src/share:tenant_runtime",
        "//src/share:thread_pool_interface",
        "//src/share:unit_topology",
        "//src/share:worker_runtime",
        "//bazel/third_party:absl_headers",
        "//bazel/third_party:curl_headers",
        "//bazel/third_party:libaio_headers",
        "//bazel/third_party:mariadb_headers",
        "//bazel/third_party:openssl_headers",
        "//bazel/third_party:rapidjson_headers",
        "//bazel/third_party:s2_headers",
        "//bazel/third_party:vsag_headers",
        "//bazel/third_party:zlib_headers",
    ],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = [
        "//src/observer:__subpackages__",
        "//src/pl:__subpackages__",
        "//src/rootserver:__subpackages__",
        "//src/sql:__subpackages__",
        "//src/storage:__subpackages__",
        "//src/standby:__subpackages__",
    ],
    implementation_deps = [
        "//src/oblib:oblib_collections_primitives",
    ],
)
