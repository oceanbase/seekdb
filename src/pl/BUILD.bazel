load(
    "//bazel:defs.bzl",
    "SEEKDB_C_MIGRATION_COPTS",
    "seekdb_semantic_unity_cc_library",
    "seekdb_test_interface",
    cc_library = "seekdb_cc_library",
)
load(
    ":pl_build_defs.bzl",
    "PL_IGNORED_GENERATED_HEADERS",
    "PL_IGNORED_GENERATED_SOURCES",
    "PL_PRIVATE_HEADERS",
    "PL_PUBLIC_HEADER_ROOTS",
    "PL_STANDALONE_SOURCES",
    "PL_UNITY_GROUPS",
    "pl_singleton_unity_groups",
    "pl_validate_header_inventory",
    "pl_validate_source_inventory",
)
load(
    ":pl_parser_c_group_oblib_deps.bzl",
    "pl_parser_c_group_oblib_deps",
)
load(":pl_runtime_group_oblib_deps.bzl", "pl_runtime_group_oblib_deps")

package(default_visibility = ["//visibility:private"])

pl_validate_source_inventory(
    PL_UNITY_GROUPS,
    PL_STANDALONE_SOURCES,
    glob([
        "**/*.c",
        "**/*.cc",
        "**/*.cpp",
        "**/*.cxx",
    ], exclude = PL_IGNORED_GENERATED_SOURCES, allow_empty = True),
)

pl_validate_header_inventory(glob(
    ["**/*.h"],
    exclude = PL_IGNORED_GENERATED_HEADERS,
))

# Public only for the negative central-policy probe in //src/sql/bazel_pilot.
# It carries no production files or providers; its purpose is to prove that a
# broad target visibility cannot authorize a forbidden module direction.
filegroup(
    name = "module_policy_public_probe",
    tags = ["manual"],
    testonly = True,
    visibility = ["//visibility:public"],
)

# These producers deliberately expose public probes, so ordinary visibility
# permits the edges. The central module policy must independently reject both
# forbidden PL -> server directions.
filegroup(
    name = "bazel_pilot_illegal_observer_dependency",
    srcs = ["//src/observer:module_policy_public_probe"],
    tags = ["manual"],
    testonly = True,
)

filegroup(
    name = "bazel_pilot_illegal_rootserver_dependency",
    srcs = ["//src/rootserver:module_policy_public_probe"],
    tags = ["manual"],
    testonly = True,
)

genrule(
    name = "generate_pl_parser",
    srcs = [
        "parser/pl_parser_mysql_mode.l",
        "parser/pl_parser_mysql_mode.y",
    ],
    outs = [
        "parser/bazel_generated/pl_parser_mysql_mode_lex.c",
        "parser/bazel_generated/pl_parser_mysql_mode_lex.h",
        "parser/bazel_generated/pl_parser_mysql_mode_tab.c",
        "parser/bazel_generated/pl_parser_mysql_mode_tab.h",
    ],
    cmd = """
      bash $(location //tools/bazel_migration:generate_pl_parser.sh) \
        $(location @seekdb_3rd_headers//:devtools/bin/bison) \
        $(location @seekdb_3rd_headers//:devtools/bin/flex) \
        $$(dirname $(location @seekdb_3rd_headers//:devtools/share/bison/README)) \
        $(RULEDIR)/parser/bazel_generated \
        $$(dirname $(location parser/pl_parser_mysql_mode.y))
    """,
    tools = [
        "//tools/bazel_migration:generate_pl_parser.sh",
        "@seekdb_3rd_headers//:bison_runtime",
        "@seekdb_3rd_headers//:devtools/bin/bison",
        "@seekdb_3rd_headers//:devtools/bin/flex",
        "@seekdb_3rd_headers//:devtools/share/bison/README",
    ],
    tags = ["manual"],
)

cc_library(
    name = "_generated_pl_parser_headers",
    hdrs = [
        "parser/bazel_generated/pl_parser_mysql_mode_lex.h",
        "parser/bazel_generated/pl_parser_mysql_mode_tab.h",
    ],
    include_prefix = "pl/parser",
    includes = ["parser/bazel_generated"],
    strip_include_prefix = "parser/bazel_generated",
    visibility = [
        "//src/observer:__pkg__",
        "//src/pl:__subpackages__",
    ],
)

# PL has one external interface. The files here are facade headers; the
# canonical stored-program vocabulary remains SQL-owned so SQL never acquires
# a reverse dependency on PL.
cc_library(
    name = "pl_interface",
    hdrs = PL_PUBLIC_HEADER_ROOTS,
    deps = ["//src/sql:sql_runtime_interface"],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = [
        "//src:__subpackages__",
        "//unittest:__subpackages__",
    ],
)

cc_library(
    name = "pl_internal_headers",
    hdrs = PL_PRIVATE_HEADERS,
    deps = [
        ":pl_interface",
        "//src/oblib:oblib_foundation",
        "//src/sql:sql_runtime_interface",
    ],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = ["//src/observer:__pkg__"],
)

seekdb_test_interface(
    name = "pl_unit_test_interface",
    deps = [
        ":_generated_pl_parser_headers",
        ":pl_internal_headers",
    ],
    visibility = ["//unittest/pl:__pkg__"],
)

