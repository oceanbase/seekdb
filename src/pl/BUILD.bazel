_PL_RUNTIME_NON_OBLIB_DEPS = [
    dep
    for dep in _PL_RUNTIME_DEPS
    if not dep.startswith("//src/oblib:")
]

_PL_RUNTIME_UNITY_GROUPS = PL_UNITY_GROUPS + pl_singleton_unity_groups(
    PL_STANDALONE_SOURCES,
    "pl_parser_cxx",
    "c++",
)

# Five C++ Unity actions, one archive: the four release groups plus the parser.
seekdb_semantic_unity_cc_library(
    name = "pl_runtime",
    owner_package = "src/pl",
    unity_groups = _PL_RUNTIME_UNITY_GROUPS,
    expected_group_names = [
        "pl_cache",
        "pl_common",
        "pl_parser_cxx_0",
        "pl_recompile",
        "pl_sys_package",
    ],
    implementation_deps = _PL_RUNTIME_NON_OBLIB_DEPS,
    group_implementation_deps = pl_runtime_group_oblib_deps(
        _PL_RUNTIME_UNITY_GROUPS,
    ),
    features = ["layering_check"],
    tags = ["manual"],
)

# Flex/Bison C sources remain separate Unity actions to avoid generated-symbol
# collisions, but belong to one semantic parser archive.
seekdb_semantic_unity_cc_library(
    name = "pl_parser_c",
    owner_package = "src/pl",
    unity_groups = pl_singleton_unity_groups(
        PL_STANDALONE_SOURCES,
        "pl_parser_c",
        "c",
    ),
    language = "c",
    expected_group_names = [
        "pl_parser_c_0",
        "pl_parser_c_1",
        "pl_parser_c_2",
        "pl_parser_c_3",
    ],
    source_replacements = {
        "src/pl/parser/pl_parser_mysql_mode_lex.c": "parser/bazel_generated/pl_parser_mysql_mode_lex.c",
        "src/pl/parser/pl_parser_mysql_mode_tab.c": "parser/bazel_generated/pl_parser_mysql_mode_tab.c",
    },
    implementation_deps = [
        ":_generated_pl_parser_headers",
        ":pl_internal_headers",
        "//src/query:query_api_interface",
        "//src/sql:sql_runtime_interface",
    ],
    group_implementation_deps = pl_parser_c_group_oblib_deps(
        pl_singleton_unity_groups(
            PL_STANDALONE_SOURCES,
            "pl_parser_c",
            "c",
        ),
    ),
    copts = SEEKDB_C_MIGRATION_COPTS,
    tags = ["manual"],
)

