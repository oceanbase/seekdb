_PL_RUNTIME_DEPS = [
    ":_generated_pl_parser_headers",
    ":pl_interface",
    ":pl_internal_headers",
    "//src/oblib/easy:easy",
    "//src/oblib:common_sql_mode",
    "//src/oblib:oblib_foundation",
    "//src/data_plane:data_plane_api_interface",
    "//src/data_plane:tx_desc_access_interface",
    "//src/query:ai_endpoint_admin",
    "//src/query:change_stream_service",
    "//src/query:mysql_protocol_util",
    "//src/query:query_api_interface",
    "//src/query:root_command_service",
    "//src/query:root_service_serialization",
    "//src/query:scheduler_interface",
    "//src/sql:sql_runtime_interface",
] + _PL_RUNTIME_SHARE_HEADER_DEPS

_PL_RUNTIME_NON_OBLIB_DEPS = [
    dep
    for dep in _PL_RUNTIME_DEPS
    if not dep.startswith("//src/oblib:")
]

_PL_RUNTIME_UNITY_GROUPS = PL_UNITY_GROUPS + singleton_unity_groups(
    PL_STANDALONE_CXX_SOURCES,
    "pl_parser_cxx",
    "c++",
)

grouped_unity_cc_library(
    name = "pl_runtime",
    unity_groups = _PL_RUNTIME_UNITY_GROUPS,
    implementation_deps = _PL_RUNTIME_NON_OBLIB_DEPS + ["//rust:config_headers"] + [
        "//src/oblib:common_sql_mode",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_collections_primitives",
        "//src/oblib:oblib_common",
        "//src/oblib:oblib_compression",
        "//src/oblib:oblib_concurrency_primitives",
        "//src/oblib:oblib_db_meta",
        "//src/oblib:oblib_foundation",
        "//src/oblib:oblib_memory_primitives",
        "//src/oblib:oblib_mysql_protocol",
        "//src/oblib:oblib_restore",
        "//src/oblib:oblib_rpc",
    ],
    split_unity_groups = True,
    features = ["layering_check"],
    tags = ["manual"],
)

grouped_unity_cc_library(
    name = "pl_parser_c",
    unity_groups = singleton_unity_groups(
        PL_STANDALONE_C_SOURCES,
        "pl_parser_c",
        "c",
    ),
    language = "c",
    source_replacements = {
        "src/pl/parser/pl_parser_mysql_mode_lex.c": "parser/bazel_generated/pl_parser_mysql_mode_lex.c",
        "src/pl/parser/pl_parser_mysql_mode_tab.c": "parser/bazel_generated/pl_parser_mysql_mode_tab.c",
    },
    implementation_deps = [
        ":_generated_pl_parser_headers",
        ":pl_internal_headers",
        "//src/query:query_api_interface",
        "//src/sql:sql_runtime_interface",
        "//src/oblib:common_sql_mode",
        "//src/oblib:oblib_base",
        "//src/oblib:oblib_foundation",
    ],
    split_unity_groups = True,
    copts = C_COPTS,
    tags = ["manual"],
)

cc_library(
    name = "syspack_source",
    srcs = ["//src/share/inner_table/sys_package:bazel_generated/syspack/syspack_source.cpp"],
    tags = ["manual"],
    visibility = ["//src/observer:__pkg__"],
)

cc_library(
    name = "pl_static",
    implementation_deps = [
        ":pl_parser_c",
        ":pl_runtime",
    ],
    tags = ["manual"],
    visibility = ["//src/observer:__pkg__"],
)
