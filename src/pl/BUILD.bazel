load("//bazel:parser.bzl", "parser")
load(
    "//bazel:defs.bzl",
    "C_COPTS",
    "grouped_unity_cc_library",
    "cc_library",
)
load(
    ":pl_header_inventory.bzl",
    "PL_PUBLIC_HEADER_ROOTS",
)
load(
    ":pl_source_inventory.bzl",
    "PL_STANDALONE_CXX_SOURCES",
    "PL_STANDALONE_C_SOURCES",
    "PL_UNITY_GROUPS",
)
load(
    "//bazel:module_sources.bzl",
    "singleton_unity_groups",
)

package(default_visibility = ["//visibility:private"])


parser(
    name = "generate_pl_parser",
    grammar = "parser/pl_parser_mysql_mode.y",
    lexer_source = "parser/pl_parser_mysql_mode.l",
    parser = "parser/bazel_generated/pl_parser_mysql_mode_tab.c",
    parser_header = "parser/bazel_generated/pl_parser_mysql_mode_tab.h",
    lexer = "parser/bazel_generated/pl_parser_mysql_mode_lex.c",
    lexer_header = "parser/bazel_generated/pl_parser_mysql_mode_lex.h",
    tags = ["manual"],
)

cc_library(
    name = "_generated_pl_parser_headers",
    hdrs = [
        "parser/bazel_generated/pl_parser_mysql_mode_lex.h",
        "parser/bazel_generated/pl_parser_mysql_mode_tab.h",
    ],
    include_prefix = "pl/parser",
    includes = ["parser/bazel_generated"],
    strip_include_prefix = "parser/bazel_generated",
    visibility = [
        "//src/observer:__pkg__",
        "//src/pl:__subpackages__",
    ],
)

# PL has one external interface. The files here are facade headers; the
# canonical stored-program vocabulary remains SQL-owned so SQL never acquires
# a reverse dependency on PL.
cc_library(
    name = "pl_interface",
    hdrs = PL_PUBLIC_HEADER_ROOTS,
    deps = ["//src/sql:sql_runtime_interface"],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = [
        "//src:__subpackages__",
        "//unittest:__subpackages__",
    ],
)

cc_library(
    name = "pl_internal_headers",
    hdrs = glob(["**/*.h"], exclude = PL_PUBLIC_HEADER_ROOTS),
    deps = [
        ":pl_interface",
        "//rust:config_headers",
        "//src/oblib:oblib_foundation",
        "//src/sql:sql_runtime_interface",
    ],
    features = ["layering_check"],
    tags = ["manual"],
    visibility = ["//src/observer:__pkg__", "//unittest/pl:__pkg__"],
)


