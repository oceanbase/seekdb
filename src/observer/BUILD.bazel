_SYSTEM_LINKOPTS = select({
    "@platforms//os:windows": ["ws2_32.lib", "crypt32.lib", "bcrypt.lib", "userenv.lib", "wldap32.lib", "advapi32.lib", "synchronization.lib", "ntdll.lib"],
    "@platforms//os:android": ["-ldl", "-lm", "-llog", "-landroid", "-latomic"],
    "@platforms//os:macos": [
