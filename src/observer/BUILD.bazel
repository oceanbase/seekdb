_EXECUTABLE_LINKOPTS = select({
    "@platforms//os:windows": ["/INCREMENTAL:NO", "/OPT:REF", "/OPT:ICF"],
    "@platforms//os:android": ["-pie", "-fopenmp", "-static-openmp", "-Wl,--gc-sections", "-Wl,--build-id=sha1"],
    "@platforms//os:macos": [
        # Retain jemalloc's standalone malloc-zone registration constructor.
        "-Wl,-u,_je_zone_register",
        "-Wl,-dead_strip",
        "-Wl,-framework,Security",
        "-Wl,-framework,CoreFoundation",
        "-Wl,-framework,SystemConfiguration",
        "-liconv",
    ],
    "//conditions:default": [
        "-no-pie",
        "-Wl,-z,noexecstack",
        "-Wl,--no-rosegment",
        "-Wl,--build-id=sha1",
        "-Wl,--gc-sections",
        "-Wl,--icf=all",
        "-Wl,--export-dynamic-symbol=obp_*",
        "-Wl,-z,relro",
        "-Wl,-z,now",
    ],
})


_SHARED_LINKOPTS = select({
    "@platforms//os:macos": [
        "-Wl,-framework,Security",
        "-Wl,-framework,CoreFoundation",
        "-Wl,-framework,SystemConfiguration",
