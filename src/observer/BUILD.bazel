    "src/observer/virtual_table/ob_all_virtual_sqlite_tables.cpp": "//src/share:generated_sqlite_virtual_table_source",
}

observer_validate_source_inventory(
    OBSERVER_UNITY_GROUPS,
    [
        OBSERVER_MAIN_SOURCES,
        OBSERVER_RETRIEVAL_COMPOSITION_SOURCES,
        OBSERVER_STANDALONE_SOURCES,
    ],
    glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cxx",
        ],
        exclude = ["virtual_table/ob_all_virtual_sqlite_tables.cpp"],
        allow_empty = True,
    ),
    OBSERVER_IGNORED_SOURCES,
    _OBSERVER_GENERATED_SOURCE_REPLACEMENTS.keys(),
)

observer_validate_header_inventory(
    OBSERVER_PRIVATE_HEADERS,
    glob(
        [
            "**/*.def",
            "**/*.h",
            "**/*.hh",
            "**/*.hpp",
            "**/*.hxx",
            "**/*.inc",
            "**/*.inl",
            "**/*.ipp",
            "**/*.tcc",
        ],
        exclude = ["virtual_table/ob_all_virtual_sqlite_tables.h"],
        allow_empty = True,
    ),
)

