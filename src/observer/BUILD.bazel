    name = "_roaring_vsag_link",
    srcs = ["//bazel/third_party:lib/libroaring.a"],
    tags = ["manual"],
)

filegroup(
    name = "_roaring_core_link",
    srcs = ["//bazel/third_party:lib/libroaring.a"],
    tags = ["manual"],
)

