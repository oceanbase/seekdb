_OBSERVER_RUNTIME_UNITY_GROUPS = OBSERVER_UNITY_GROUPS + observer_singleton_unity_groups(
    OBSERVER_STANDALONE_SOURCES,
    "ob_server_standalone",
)

seekdb_semantic_unity_cc_library(
    name = "observer_runtime",
    owner_package = "src/observer",
    unity_groups = _OBSERVER_RUNTIME_UNITY_GROUPS,
    source_replacements = _OBSERVER_GENERATED_SOURCE_REPLACEMENTS,
    implementation_deps = [
        ":observer_internal_interface",
    ] + _OBSERVER_NON_OBLIB_NATIVE_DEPS,
    group_implementation_deps = observer_runtime_group_oblib_deps(
        _OBSERVER_RUNTIME_UNITY_GROUPS,
    ),
    features = ["layering_check"],
    tags = ["manual"],
)

# SQL owns the retrieval lifecycle facade; this composition object owns the
# physical SQL/Storage binding and registers it during final-link startup.
seekdb_semantic_unity_cc_library(
    name = "observer_retrieval_composition",
    owner_package = "src/observer",
    unity_groups = observer_singleton_unity_groups(
        OBSERVER_RETRIEVAL_COMPOSITION_SOURCES,
        "ob_retrieval_composition",
    ),
    implementation_deps = [
        ":observer_internal_interface",
        "//src/sql:sql_retrieval_composition_headers",
    ] + _OBSERVER_NON_OBLIB_NATIVE_DEPS,
    group_implementation_deps = observer_retrieval_composition_group_oblib_deps(
        observer_singleton_unity_groups(
            OBSERVER_RETRIEVAL_COMPOSITION_SOURCES,
            "ob_retrieval_composition",
        ),
    ),
    features = ["layering_check"],
    tags = ["manual"],
)

seekdb_semantic_unity_cc_library(
    name = "observer_main",
    owner_package = "src/observer",
    unity_groups = observer_singleton_unity_groups(
        OBSERVER_MAIN_SOURCES,
        "ob_main",
    ),
    implementation_deps = [
        ":observer_internal_interface",
    ] + _OBSERVER_NON_OBLIB_NATIVE_DEPS,
    group_implementation_deps = observer_main_group_oblib_deps(
        observer_singleton_unity_groups(
            OBSERVER_MAIN_SOURCES,
            "ob_main",
        ),
    ),
    features = ["layering_check"],
    tags = ["manual"],
)

# Partitioned Unity libraries intentionally expose a source-less semantic
# aggregate.  The ordered final link must name their source-owning private
# groups so it can place the generated Unity objects at the head of the link.
_OBSERVER_RETRIEVAL_COMPOSITION_OBJECT_TARGETS = [
    ":_observer_retrieval_composition_ob_retrieval_composition_0_objects",
]

_OBSERVER_MAIN_OBJECT_TARGETS = [
    ":_observer_main_ob_main_0_objects",
    ":_observer_main_ob_main_1_objects",
]

seekdb_version_source(
    name = "_generate_ob_version",
    template = "//src/share:ob_version.cpp.in",
    out = "ob_version.cpp",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "observer_version",
    srcs = [":_generate_ob_version"],
    deps = [
        "//src/oblib:oblib_core_utilities",
        "//src/oblib:oblib_foundation",
        "//src/share:utility_types",
    ],
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

# The release link names the same roaring archive twice in distinct ordered
# positions. Bazel label_list rejects one identical label repeated, so these
# two positional aliases intentionally preserve that link-line behavior.
filegroup(
    name = "_roaring_vsag_link",
    srcs = ["@seekdb_3rd_headers//:lib/libroaring.a"],
    tags = ["manual"],
)

filegroup(
    name = "_roaring_core_link",
    srcs = ["@seekdb_3rd_headers//:lib/libroaring.a"],
    tags = ["manual"],
)

