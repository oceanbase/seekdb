final_link(
    name = "_executable_link",
    direct_object_deps = (
        _OBSERVER_RETRIEVAL_COMPOSITION_OBJECT_TARGETS +
        _OBSERVER_MAIN_OBJECT_TARGETS
    ),
    # Repeat oblib in tail_deps to resolve references introduced by later archives.
    group_deps = _CORE_LINK_DEPS,
    tail_deps = _TAIL_LINK_DEPS,
    ordered_link_files = _ORDERED_LINK_FILES,
    extra_inputs = _EXTRA_LINK_INPUTS,
    linkopts = _SYSTEM_LINKOPTS + _EXECUTABLE_LINKOPTS + sanity_linkopts() + select({
        "//bazel:linux_package_runtime": ["-Wl,-rpath,$ORIGIN/../libexec/seekdb/lib"],
        "//conditions:default": [],
    }),
    out = select({"@platforms//os:windows": "seekdb/seekdb.exe", "//conditions:default": "seekdb"}),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "seekdb",
    actual = ":_executable_link",
    visibility = ["//visibility:public"],
)

