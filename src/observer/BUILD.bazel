    ],
    "//conditions:default": [
        "pthread",
        "dl",
        "m",
        "rt",
    ],
})

_SEEKDB_EXECUTABLE_LINKOPTS = select({
    "@platforms//os:macos": [
        "-Wl,-dead_strip",
        "-Wl,-framework,Security",
        "-Wl,-framework,CoreFoundation",
        "-Wl,-framework,SystemConfiguration",
        "-liconv",
    ],
    "//conditions:default": [
        "-no-pie",
        "-Wl,-z,noexecstack",
        "-Wl,--no-rosegment",
        "-Wl,--build-id=sha1",
        "-Wl,--gc-sections",
        "-Wl,--icf=all",
        "-Wl,--export-dynamic-symbol=obp_*",
        "-Wl,-z,relro",
        "-Wl,-z,now",
    ],
})

_SEEKDB_SHARED_LINKOPTS = select({
    "@platforms//os:macos": [
        "-Wl,-framework,Security",
        "-Wl,-framework,CoreFoundation",
        "-Wl,-framework,SystemConfiguration",
        "-liconv",
    ],
    "//conditions:default": [
        "-Wl,-z,notext",
        "-Wl,-z,noexecstack",
        "-Wl,--no-rosegment",
        "-Wl,--build-id=sha1",
        "-Wl,-z,relro",
        "-Wl,-z,now",
    ],
})

seekdb_final_link(
    name = "seekdb_link",
    direct_object_deps = (
        _OBSERVER_RETRIEVAL_COMPOSITION_OBJECT_TARGETS +
        _OBSERVER_MAIN_OBJECT_TARGETS
    ),
    # The first migration link flattens the former core archives into one
    # circular-resolution group. oblib also remains in its historical tail
    # position below; the repeat is deliberate while its component archives
    # have not yet been consolidated into a single ordered archive.
    group_deps = _SEEKDB_CORE_LINK_DEPS,
    whole_archive_deps = [],
    tail_deps = _SEEKDB_TAIL_LINK_DEPS,
    ordered_link_files = _SEEKDB_ORDERED_LINK_FILES,
    extra_inputs = _SEEKDB_EXTRA_LINK_INPUTS,
    system_libs = _SEEKDB_SYSTEM_LIBS,
    linkopts = _SEEKDB_EXECUTABLE_LINKOPTS,
    out = "seekdb",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Compatibility runtime for the first unit-test migration.  It deliberately
# exports the complete production implementation closure, as the former CMake
# `oceanbase` shared target did, but owns no headers.  Tests must still obtain
# compile-time access from source-module-owned test interfaces.
seekdb_final_link(
    name = "_liboceanbase_link",
    whole_group_deps = (
        _OBSERVER_RETRIEVAL_COMPOSITION_OBJECT_TARGETS +
        _SEEKDB_CORE_LINK_DEPS +
        select({
            "@platforms//os:macos": [
                "//src/sql/parser:sql_server_parser",
            ],
            "//conditions:default": [
                "//src/oblib:malloc_hook_objects",
                "//src/sql/parser:sql_server_parser",
            ],
        })
    ),
    ordered_link_files = _SEEKDB_ORDERED_LINK_FILES,
    extra_inputs = _SEEKDB_EXTRA_LINK_INPUTS,
    system_libs = _SEEKDB_SYSTEM_LIBS,
    linkopts = _SEEKDB_SHARED_LINKOPTS,
    out = "liboceanbase.so",
    shared = True,
    tags = ["manual"],
)

cc_import(
    name = "liboceanbase",
    shared_library = ":_liboceanbase_link",
    tags = ["manual"],
    testonly = True,
    visibility = ["//unittest:__subpackages__"],
)

# Analysis-only guard: one checked-in source may feed exactly one generated
# Unity translation unit in the final production graph.
seekdb_source_ownership_check(
    name = "seekdb_source_ownership",
    root = ":seekdb_link",
    tags = ["manual"],
)
