final_link(
    name = "_liboceanbase_link",
    testonly = True,
    whole_group_deps = (
        _OBSERVER_RETRIEVAL_COMPOSITION_OBJECT_TARGETS +
        _CORE_LINK_DEPS +
        select({
            "@platforms//os:macos": [
                "//src/sql/parser:sql_server_parser",
            ],
            "//conditions:default": [
                "//src/oblib:malloc_hook_objects",
                "//src/sql/parser:sql_server_parser",
            ],
        })
    ) + select({
        # The shared test runtime retains the Rust in-process bridge, including
        # its reference to run_server. Supply the real implementation on Linux.
        "@platforms//os:linux": [":_unittest_in_process_entry", ":in_process_api"],
        "//conditions:default": [],
    }),
    ordered_link_files = _ORDERED_LINK_FILES,
    extra_inputs = _EXTRA_LINK_INPUTS,
    linkopts = _SYSTEM_LINKOPTS + _SHARED_LINKOPTS + sanity_linkopts(),
    out = "liboceanbase.so",
    shared = True,
    tags = ["manual"],
)

cc_import(
    name = "liboceanbase",
    shared_library = ":_liboceanbase_link",
    tags = ["manual"],
    testonly = True,
    visibility = ["//unittest:__subpackages__"],
)


