+if test "x${abi}" = "xpecoff" ; then
+
+{ $as_echo "$as_me:${as_lineno-$LINENO}: checking whether Windows background threads is compilable" >&5
+$as_echo_n "checking whether Windows background threads is compilable... " >&6; }
+if ${je_cv_windows_background_thread+:} false; then :
+  $as_echo_n "(cached) " >&6
+else
+  cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+/* end confdefs.h.  */
+
+#include <stdint.h>
+#include <windows.h>
+#include <process.h>
+#if !defined(_WIN32_WINNT) || _WIN32_WINNT < 0x0600
+#error "Windows background threads require Vista or later"
+#endif
+static unsigned __stdcall background_thread_probe(void *arg) {
+  (void)arg;
+  return 0;
+}
+
+int
+main ()
+{
+  CONDITION_VARIABLE cond;
+  SRWLOCK lock;
+  InitializeConditionVariable(&cond);
+  InitializeSRWLock(&lock);
+  AcquireSRWLockExclusive(&lock);
+  SleepConditionVariableSRW(&cond, &lock, 0, 0);
+  ReleaseSRWLockExclusive(&lock);
+  WakeConditionVariable(&cond);
+  uintptr_t thread = _beginthreadex(NULL, 0, background_thread_probe, NULL,
+      0, NULL);
+  WaitForSingleObject((HANDLE)thread, INFINITE);
+  CloseHandle((HANDLE)thread);
+
+  ;
+  return 0;
+}
+_ACEOF
+if ac_fn_c_try_link "$LINENO"; then :
+  je_cv_windows_background_thread=yes
+else
+  je_cv_windows_background_thread=no
+fi
+rm -f core conftest.err conftest.$ac_objext \
+    conftest$ac_exeext conftest.$ac_ext
+fi
+{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $je_cv_windows_background_thread" >&5
+$as_echo "$je_cv_windows_background_thread" >&6; }
+
+fi
+
 if test "x${have_pthread}" = "x1" -a "x${je_cv_os_unfair_lock}" != "xyes" -a \
-       "x${abi}" != "xmacho" ; then
+       "x${abi}" != "xmacho" -o "x${je_cv_windows_background_thread}" = "xyes" ; then
 
 $as_echo "#define JEMALLOC_BACKGROUND_THREAD  " >>confdefs.h
 
