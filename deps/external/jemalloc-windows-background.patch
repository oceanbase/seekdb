diff --git a/vendor/jemalloc/configure.ac b/vendor/jemalloc/configure.ac
--- a/vendor/jemalloc/configure.ac
+++ b/vendor/jemalloc/configure.ac
@@ -2832,8 +2832,36 @@
 dnl ============================================================================
 dnl Enable background threads if possible.
 
+if test "x${abi}" = "xpecoff" ; then
+  JE_COMPILABLE([Windows background threads], [
+#include <stdint.h>
+#include <windows.h>
+#include <process.h>
+#if !defined(_WIN32_WINNT) || _WIN32_WINNT < 0x0600
+#error "Windows background threads require Vista or later"
+#endif
+static unsigned __stdcall background_thread_probe(void *arg) {
+  (void)arg;
+  return 0;
+}
+], [
+  CONDITION_VARIABLE cond;
+  SRWLOCK lock;
+  InitializeConditionVariable(&cond);
+  InitializeSRWLock(&lock);
+  AcquireSRWLockExclusive(&lock);
+  SleepConditionVariableSRW(&cond, &lock, 0, 0);
+  ReleaseSRWLockExclusive(&lock);
+  WakeConditionVariable(&cond);
+  uintptr_t thread = _beginthreadex(NULL, 0, background_thread_probe, NULL,
+      0, NULL);
+  WaitForSingleObject((HANDLE)thread, INFINITE);
+  CloseHandle((HANDLE)thread);
+], [je_cv_windows_background_thread])
+fi
+
 if test "x${have_pthread}" = "x1" -a "x${je_cv_os_unfair_lock}" != "xyes" -a \
-       "x${abi}" != "xmacho" ; then
+       "x${abi}" != "xmacho" -o "x${je_cv_windows_background_thread}" = "xyes" ; then
   AC_DEFINE([JEMALLOC_BACKGROUND_THREAD], [ ], [ ])
 fi
 
diff --git a/vendor/jemalloc/configure b/vendor/jemalloc/configure
