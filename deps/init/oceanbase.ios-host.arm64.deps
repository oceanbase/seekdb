# Host parser tools and fallback headers for iOS cross-compilation.
# Xcode supplies the compiler; iOS target libraries are built separately.
[target-default]
os=macos
arch=arm64
repo=https://mirrors.oceanbase.com/oceanbase/development-kit/darwin/13/arm64

[deps]
devdeps-abseil-cpp-20211102.0-20260126.tar.gz
devdeps-boost-1.74.0-20260126.tar.gz
devdeps-libcurl-8.12.1-20260126.tar.gz
devdeps-openssl-1.1.1u-20260126.tar.gz
devdeps-roaringbitmap-croaring-3.0.0-20260126.tar.gz
devdeps-vsag-1.1.0-20260126.tar.gz

[tools]
obdevtools-bison-2.4.1-20260122.tar.gz
obdevtools-flex-2.5.35-20260126.tar.gz
