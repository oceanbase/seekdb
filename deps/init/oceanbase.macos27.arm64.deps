# macOS 27 uses host-installed LLVM; third-party packages currently reuse the macOS 15 repository.
[target-default]
os=macos
arch=arm64
repo=https://mirrors.oceanbase.com/oceanbase/development-kit/darwin/15/arm64

[target-community]
os=macos
arch=arm64
repo=https://mirrors.oceanbase.com/oceanbase/development-kit/darwin/15/arm64

[deps]
devdeps-boost-1.74.0-20251205.tar.gz
devdeps-roaringbitmap-croaring-3.0.0-20251208.tar.gz
devdeps-xz-5.2.2-20251208.tar.gz
[tools]
obdevtools-bison-2.4.1-20251219.tar.gz
obdevtools-flex-2.5.35-20251219.tar.gz

[tools-deps]
obshell-4.4.1.1-20260325.tgz

[test-utils]
