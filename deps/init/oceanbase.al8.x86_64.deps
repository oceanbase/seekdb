[target-default]
os=8
arch=x86_64
repo=https://mirrors.oceanbase.com/oceanbase/development-kit/al/8/x86_64/

[target-community]
os=8
arch=x86_64
repo=http://mirrors.oceanbase.com/oceanbase/community/stable/al/8/x86_64/

[deps]
# SDKs are built from the pinned deps/dependencies source submodule.

[tools]
obdevtools-binutils-2.30-82024092619.al8.x86_64.rpm
obdevtools-bison-2.4.1-42024092621.al8.x86_64.rpm
obdevtools-ccache-3.7.12-52024092621.al8.x86_64.rpm
obdevtools-cmake-3.22.1-122024092710.al8.x86_64.rpm
obdevtools-flex-2.5.35-42024092621.al8.x86_64.rpm
obdevtools-gcc-12.3.0-32024122017.al8.x86_64.rpm
obdevtools-llvm-17.0.6-202026032415.al8.x86_64.rpm

[tools-deps]
obshell-4.4.1.1-32026031914.al8.x86_64.rpm target=community
#obshell-4.5.0.0-12026050816.al8.x86_64.rpm target=community

[test-utils]
ob-deploy-4.1.0-2.al8.x86_64.rpm target=community
obclient-2.2.3-202024102217.al8.x86_64.rpm target=community
libobclient-2.2.3-152024102213.al8.x86_64.rpm target=community
