load("//bazel:plugin.bzl", "native_plugin")
load("//bazel:rust_plugin.bzl", "host_contract")

host_contract(
    name = "host_contract",
    target_compatible_with = select({"@platforms//os:linux": [], "//conditions:default": ["@platforms//:incompatible"]}),
)

native_plugin(
    name = "seekdb_server_dev_reference",
    srcs = ["server_dev_reference.cpp"],
    output_name = "seekdb_server_dev_reference.so",
    server_headers_target = "//src/sql:server_dev_headers",
    server_headers = ["sql/optimizer/ob_optimizer.h"],
    exports = ["seekdb_server_dev_numbering_probe"],
    contract = ":host_contract",
)
