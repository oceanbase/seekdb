.gitattributes export-ignore
.gitignore export-ignore

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat

# Shell scripts are executed by Linux containers, WSL and CI. Git for Windows
# defaults to core.autocrlf=true, which checks them out with CRLF and makes the
# shell reject them ("bash: $'\r': command not found"). Pin LF so a checkout on
# Windows keeps the tracked scripts runnable.
*.sh text eol=lf
