.gitattributes export-ignore
.gitignore export-ignore

# Keep dependency lockfile inputs byte-identical across build hosts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat
