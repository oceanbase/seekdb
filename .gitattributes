.gitattributes export-ignore
.gitignore export-ignore

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat

# cbindgen regenerates this header with LF endings during the build; keep the
# checked-in copy byte-identical so a build never leaves the tree dirty.
rust/sql-nio/include/nio.h -text -filter
