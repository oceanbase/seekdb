+      ret = OB_ERR_UNEXPECTED;
+    } else {
+      ObResolver resolver(params);
+      ret = resolver.resolve(ObResolver::IS_NOT_PREPARED_STMT, *parsed.result_tree_->children_[0], result);
+    }
+  }
+  return ret;
+}
