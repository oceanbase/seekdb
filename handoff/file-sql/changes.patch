+      case Type::real: type = ObDoubleType; break;
+      case Type::boolean: type = ObTinyIntType; break;
+      case Type::date: type = ObDateType; break;
+      case Type::datetime: type = ObDateTimeType; break;
+      case Type::null: type = ObNullType; break;
