+    file_sql::FileSqlFormat format = file_sql::FileSqlFormat::csv;
+    if (OB_FILE_JSONL_TABLE_TYPE == MY_SPEC.table_type_) format = file_sql::FileSqlFormat::jsonl;
+    else if (OB_FILE_PARQUET_TABLE_TYPE == MY_SPEC.table_type_) format = file_sql::FileSqlFormat::parquet;
+    else if (OB_FILE_GLOB_TABLE_TYPE == MY_SPEC.table_type_) format = file_sql::FileSqlFormat::glob;
+    file_sql_scan_ = new (memory) file_sql::FileSqlScan(format);
+  }
+  int ret = file_sql_scan_->open(*get_exec_ctx().get_my_session(), MY_SPEC.namespace_def_.at(0), MY_SPEC.namespace_def_.at(1));
+  if (OB_SUCC(ret)) ret = file_sql_scan_->begin(MY_SPEC.namespace_def_.at(2) == ObString("1"));
+  return ret;
+}
