# ---------------------------------------------------------------------------
# 5) Non-file SQL regression (DDL / DML / EXPLAIN / DESCRIBE on a real table)
# ---------------------------------------------------------------------------
create table t_reg (id int primary key, name varchar(20));
insert into t_reg values (1,'a'),(2,'b');
select * from t_reg order by id;
id	name
1	a
2	b

describe t_reg;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL
name	varchar(20)	YES		NULL

explain select * from t_reg where id = 1;
Query Plan  ->  TABLE GET t_reg, range[1 ; 1]   (EXPLAIN unchanged)

select count(*) from t_reg;
count(*)
2

