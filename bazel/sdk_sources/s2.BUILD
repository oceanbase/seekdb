    hdrs = glob(
        ["src/**/*.h"],
        allow_empty = True,
    ),
    copts = select({
        "@platforms//os:emscripten": ["-std=c++20"],
        "//conditions:default": ["-std=c++17"],
    }) + select({
        "@platforms//os:emscripten": [
            "-pthread",
            "-fexceptions",
        ],
        "//conditions:default": [],
