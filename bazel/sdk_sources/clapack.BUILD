load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "library",
    srcs = [
        "BLAS/SRC/isamax.c",
        "BLAS/SRC/saxpy.c",
        "BLAS/SRC/scopy.c",
        "BLAS/SRC/sdot.c",
        "BLAS/SRC/sgemm.c",
        "BLAS/SRC/sgemv.c",
        "BLAS/SRC/sger.c",
        "BLAS/SRC/snrm2.c",
        "BLAS/SRC/sscal.c",
        "BLAS/SRC/sswap.c",
        "BLAS/SRC/ssymv.c",
        "BLAS/SRC/ssyr2.c",
        "BLAS/SRC/ssyr2k.c",
        "BLAS/SRC/strmm.c",
        "BLAS/SRC/strmv.c",
        "BLAS/SRC/strsm.c",
        "BLAS/SRC/xerbla.c",
        "F2CLIBS/libf2c/i_nint.c",
        "F2CLIBS/libf2c/pow_ii.c",
        "F2CLIBS/libf2c/pow_ri.c",
        "F2CLIBS/libf2c/r_sign.c",
        "F2CLIBS/libf2c/s_cmp.c",
        "F2CLIBS/libf2c/s_copy.c",
        "INSTALL/lsame.c",
        "INSTALL/slamch.c",
        "SRC/ieeeck.c",
        "SRC/ilaenv.c",
        "SRC/ilaslc.c",
        "SRC/ilaslr.c",
        "SRC/iparmq.c",
        "SRC/sgeqr2.c",
        "SRC/sgeqrf.c",
        "SRC/sgetf2.c",
        "SRC/sgetrf.c",
        "SRC/sisnan.c",
        "SRC/slae2.c",
        "SRC/slaev2.c",
        "SRC/slaisnan.c",
        "SRC/slanst.c",
        "SRC/slansy.c",
        "SRC/slapy2.c",
        "SRC/slarf.c",
        "SRC/slarfb.c",
        "SRC/slarfg.c",
        "SRC/slarfp.c",
        "SRC/slarft.c",
        "SRC/slartg.c",
        "SRC/slascl.c",
        "SRC/slaset.c",
        "SRC/slasr.c",
        "SRC/slasrt.c",
        "SRC/slassq.c",
        "SRC/slaswp.c",
        "SRC/slatrd.c",
        "SRC/sorg2l.c",
        "SRC/sorg2r.c",
        "SRC/sorgql.c",
        "SRC/sorgqr.c",
        "SRC/sorgtr.c",
        "SRC/ssteqr.c",
        "SRC/ssterf.c",
        "SRC/ssyev.c",
        "SRC/ssytd2.c",
        "SRC/ssytrd.c",
    ],
    hdrs = glob(
        [
            "INCLUDE/*.h",
            "F2CLIBS/libf2c/*.h",
        ],
        allow_empty = True,
    ),
    additional_compiler_inputs = ["@seekdb//bazel/sdk_sources:openblas/blas_abi.h"],
    copts = [
        "-pthread",
        "-include",
        "$(location @seekdb//bazel/sdk_sources:openblas/blas_abi.h)",
    ],
    includes = ["INCLUDE"],
    linkstatic = True,
    local_defines = ["NO_BLAS_WRAP"],
)
