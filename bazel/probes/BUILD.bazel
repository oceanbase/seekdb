# These aliases prove that generated mechanical ownership does not expose
# implementation-only headers outside each first-level module. They are built
# only by tools/bazel_pilot_verify.sh, which expects visibility analysis to
# reject every target.
alias(
    name = "oblib_private_header_probe",
    actual = "//src/oblib:_oblib_implementation_headers",
    tags = ["manual"],
)

alias(
    name = "observer_private_header_probe",
    actual = "//src/observer:observer_internal_interface",
    tags = ["manual"],
)

alias(
    name = "pl_private_header_probe",
    actual = "//src/pl:pl_internal_headers",
    tags = ["manual"],
)

alias(
    name = "rootserver_private_header_probe",
    actual = "//src/rootserver:rootserver_internal_headers",
    tags = ["manual"],
)

alias(
    name = "sql_private_header_probe",
    actual = "//src/sql:sql_runtime_internal_headers",
    tags = ["manual"],
)

alias(
    name = "storage_private_header_probe",
    actual = "//src/storage:storage_runtime_internal_headers",
    tags = ["manual"],
)

# Source-bearing native targets are private implementation. Only their package
# facade (or the Observer composition root) may consume them.
alias(
    name = "oblib_private_implementation_probe",
    actual = "//src/oblib:_oblib_common_impl",
    tags = ["manual"],
)

alias(
    name = "observer_private_implementation_probe",
    actual = "//src/observer:observer_runtime",
    tags = ["manual"],
)

alias(
    name = "pl_private_implementation_probe",
