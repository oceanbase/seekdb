    tags = ["manual"],
)

alias(
    name = "share_private_implementation_probe",
    actual = "//src/share:share_runtime",
    tags = ["manual"],
)

alias(
    name = "sql_private_implementation_probe",
    actual = "//src/sql:sql_runtime",
    tags = ["manual"],
)

alias(
    name = "storage_private_implementation_probe",
    actual = "//src/storage:storage_runtime",
    tags = ["manual"],
)
