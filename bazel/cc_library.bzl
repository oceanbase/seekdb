"""C++ helpers for seekdb's Bazel build."""

load(
    "@rules_cc//cc:cc_library.bzl",
    _rules_cc_library = "cc_library",
)
load(
    "//bazel:compile_config.bzl",
    "MODULE_C_COPTS",
    "RELEASE_LOCAL_DEFINES",
    "MODULE_CXX_COPTS",
    "sanity_settings",
    "logging_defines",
)
load(
    "//bazel:platforms.bzl",
    "arch_copts",
    "platform_compiler_inputs",
    "platform_copts",
    "platform_local_defines",
)


def _cc_library_impl(
        name, visibility, copts, local_defines, sanity_instrumentation,
        additional_compiler_inputs, cxxopts, implementation_deps,
        target_compatible_with, **kwargs):
    sanity = sanity_settings(sanity_instrumentation)
    _rules_cc_library(
        name = name,
        visibility = visibility,
        additional_compiler_inputs = additional_compiler_inputs + platform_compiler_inputs() + sanity.additional_compiler_inputs,
        copts = copts + arch_copts() + platform_copts() + sanity.copts,
        cxxopts = cxxopts + sanity.cxxopts + select({
            "@platforms//os:windows": ["/std:c++20"],
            "//conditions:default": [],
        }),
        implementation_deps = implementation_deps + sanity.implementation_deps + select({
            "@platforms//os:windows": ["//bazel/third_party:windows_headers"],
            "//conditions:default": [],
        }),
        linkstatic = True,
        local_defines = local_defines + logging_defines() + platform_local_defines() + sanity.local_defines,
        target_compatible_with = target_compatible_with + sanity.target_compatible_with,
        **kwargs
    )

# rules_cc's public cc_library entry point is a legacy forwarding function,
# so declare our supported C++ attributes and inherit Bazel's common attrs.
cc_library = macro(
    implementation = _cc_library_impl,
    inherit_attrs = "common",
    attrs = {
        "srcs": attr.label_list(allow_files = True),
        "hdrs": attr.label_list(allow_files = True),
        "textual_hdrs": attr.label_list(allow_files = True),
        "deps": attr.label_list(),
        "implementation_deps": attr.label_list(),
        "additional_compiler_inputs": attr.label_list(allow_files = True),
        "additional_linker_inputs": attr.label_list(allow_files = True),
        "copts": attr.string_list(default = MODULE_CXX_COPTS),
        "cxxopts": attr.string_list(),
        "conlyopts": attr.string_list(),
        "local_defines": attr.string_list(default = RELEASE_LOCAL_DEFINES),
        "defines": attr.string_list(),
        "includes": attr.string_list(),
        "include_prefix": attr.string(),
        "strip_include_prefix": attr.string(),
        "linkopts": attr.string_list(),
        "alwayslink": attr.bool(default = False),
        "target_compatible_with": attr.label_list(),
        "sanity_instrumentation": attr.bool(default = True, configurable = False),
    },
)

def _dedupe(values):
    return {value: None for value in values}.keys()

def _package_relative_source(owner_package, source):
    prefix = owner_package + "/"
    if not source.startswith(prefix):
        fail(
            "source %s is outside owner package %s; give it a native Bazel target first" %
            (source, owner_package),
        )
    return source[len(prefix):]


def _emit_unity_source_impl(ctx):
    lines = [
        "/* generated by Bazel; do not edit */",
        "",
    ]
    for target in ctx.attr.srcs:
        files = target[DefaultInfo].files.to_list()
        if len(files) != 1:
            fail(
                "Each Unity member label must provide exactly one file, got %s from %s" %
                (len(files), target.label),
            )
        src = files[0]
        if src.short_path.startswith("../"):
            fail("Unity members must belong to the main seekdb workspace: %s" % src)
        lines.append('#include "%s"' % src.short_path)
        lines.append("")
        lines.extend([
            "#ifdef USING_LOG_PREFIX",
            "#undef USING_LOG_PREFIX",
            "#endif",
            "",
        ])

    ctx.actions.write(
        output = ctx.outputs.out,
        content = "\n".join(lines),
    )
    return [
        DefaultInfo(files = depset([ctx.outputs.out])),
    ]

_emit_unity_source = rule(
    implementation = _emit_unity_source_impl,
    attrs = {
        "out": attr.output(mandatory = True),
        "srcs": attr.label_list(
            allow_files = [".c", ".cc", ".cpp", ".cxx"],
            mandatory = True,
        ),
    },
)


def unity_source(
        name,
        unity_members,
        language = "c++",
        tags = []):
    """Generates one ordered Unity source and returns its target label."""

    if language not in ("c", "c++"):
        fail("language must be 'c' or 'c++', got %s" % language)

    unity_source_target = "_" + name + "_generated_unity"
    _emit_unity_source(
        name = unity_source_target,
        srcs = unity_members,
        out = name + (".unity.c" if language == "c" else ".unity.cpp"),
        tags = tags,
        visibility = ["//visibility:private"],
    )

    return ":" + unity_source_target

def _unity_cc_library(
        name,
        unity_srcs,
        unity_members,
        public_hdrs = [],
        private_hdrs = [],
        implementation_deps = [],
        sanity_instrumentation = True,
        tags = [],
        **kwargs):
    """Keep Unity members in a private textual dependency, outside the interface."""
    unity_members_target = "_" + name + "_unity_members"
    cc_library(
        name = unity_members_target,
        textual_hdrs = unity_members,
        sanity_instrumentation = sanity_instrumentation,
        tags = tags,
        visibility = ["//visibility:private"],
    )
    cc_library(
        name = name,
        srcs = _dedupe(unity_srcs + private_hdrs),
        hdrs = public_hdrs,
        implementation_deps = _dedupe([":" + unity_members_target] + implementation_deps),
        sanity_instrumentation = sanity_instrumentation,
        tags = tags,
        **kwargs
    )

def unity_cc_library(
        name,
        unity_members,
        language = "c++",
        copts = None,
        tags = [],
        **kwargs):
    """Compile one ordered Unity source; other attributes go to cc_library."""
    unity_src = unity_source(
        name = name,
        unity_members = unity_members,
        language = language,
        tags = tags,
    )
    _unity_cc_library(
        name = name,
        unity_srcs = [unity_src],
        unity_members = unity_members,
        copts = MODULE_C_COPTS if language == "c" and copts == None else copts,
        tags = tags,
        **kwargs
    )

def grouped_unity_cc_library(
        name,
        unity_groups,
        language = "c++",
        split_unity_groups = False,
        source_replacements = {},
        public_hdrs = [],
        private_hdrs = [],
        deps = [],
        implementation_deps = [],
        copts = None,
        tags = [],
        **kwargs):
    """Compile named Unity groups; other attributes go to cc_library.

    Groups share one library unless split_unity_groups is set for final links
    that need individual group objects.
    """
    if language not in ("c", "c++"):
        fail("language must be 'c' or 'c++', got %s" % language)
    if not unity_groups:
        fail("%s has no Unity groups" % name)
    if split_unity_groups and (public_hdrs or private_hdrs):
        fail("%s partitioned Unity compilation requires headers to have separate semantic owner targets" % name)
    if language == "c" and copts == None:
        copts = MODULE_C_COPTS

    owner_package = native.package_name()
    unity_srcs = []
    unity_members = []
    group_targets = []
    seen_group_names = {}
    used_replacements = {}
    for group in unity_groups:
        if group.name in seen_group_names:
            fail("%s contains duplicate Unity group %s" % (name, group.name))
        seen_group_names[group.name] = True
        if group.language != language:
            fail("%s expects %s Unity groups, got %s" % (name, language, group.language))

        members = []
        for source in group.srcs:
            if source in source_replacements:
                members.append(source_replacements[source])
                used_replacements[source] = True
            else:
                members.append(_package_relative_source(owner_package, source))
        if not members:
            fail("%s contains an empty Unity group: %s" % (name, group.name))
        unity_src = unity_source(
            name = name + "_" + group.name,
            unity_members = members,
            language = language,
            tags = tags,
        )
        if split_unity_groups:
            group_target = "_" + name + "_" + group.name + "_objects"
            _unity_cc_library(
                name = group_target,
                unity_srcs = [unity_src],
                unity_members = members,
                deps = deps,
                implementation_deps = implementation_deps,
                copts = copts,
                tags = tags,
                **(kwargs | {"visibility": ["//visibility:private"]})
            )
            group_targets.append(":" + group_target)
        else:
            unity_srcs.append(unity_src)
            unity_members.extend(members)

    unused_replacements = sorted([
        source
        for source in source_replacements
        if source not in used_replacements
    ])
    if unused_replacements:
        fail("%s has unused source replacements: %s" % (name, unused_replacements))

    if split_unity_groups:
        cc_library(
            name = name,
            deps = deps,
            implementation_deps = group_targets,
            copts = copts,
            tags = tags,
            **kwargs
        )
    else:
        _unity_cc_library(
            name = name,
            unity_srcs = unity_srcs,
            unity_members = unity_members,
            public_hdrs = public_hdrs,
            private_hdrs = private_hdrs,
            deps = deps,
            implementation_deps = implementation_deps,
            copts = copts,
            tags = tags,
            **kwargs
        )
