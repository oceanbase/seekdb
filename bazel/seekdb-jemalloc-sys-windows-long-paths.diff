+fn report_tail(label: &str, bytes: &[u8], keep: usize, drop_include_notes: bool) {
+    let text = String::from_utf8_lossy(bytes);
+    let lines: Vec<&str> = text
+        .lines()
+        .filter(|line| {
+            !(drop_include_notes && line.trim_start().starts_with("Note: including file:"))
+        })
+        .collect();
+    let start = lines.len().saturating_sub(keep);
+    if start < lines.len() {
+        eprintln!(
+            "--- {label}: last {} of {} lines ---",
+            lines.len() - start,
+            lines.len()
+        );
+        for line in &lines[start..] {
+            eprintln!("{line}");
+        }
+    }
+}
