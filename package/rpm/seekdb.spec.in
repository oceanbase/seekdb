%global _missing_build_ids_terminate_build 0
%global _find_debuginfo_opts -g
%global __brp_check_rpaths %{nil}
%undefine __brp_mangle_shebangs
%global __requires_exclude ^(/bin/bash|/usr/bin/.*)$
%undefine _debugsource_packages
%undefine _debuginfo_subpackages
%define __strip @STRIP@
%define __debug_install_post \
  mv %{buildroot}/usr/bin/obshell %{_builddir}/obshell; \
  %{_rpmconfigdir}/find-debuginfo.sh %{?_find_debuginfo_opts} %{_builddir}; \
  mv %{_builddir}/obshell %{buildroot}/usr/bin/obshell; \
%{nil}
Name: seekdb
Version: @VERSION@
Release: @RELEASE@%{?dist}
Summary: seekdb single-node database
License: Apache-2.0
URL: https://www.oceanbase.ai
Group: Applications/Databases
Requires: seekdb-libs%{?_isa} = %{version}-%{release}, systemd
%description
seekdb single-node relational database.
%package libs
Summary: Runtime libraries for seekdb
%description libs
libaio runtime libraries for seekdb.
%global __debug_package 1
%package debuginfo
Summary: Debug information for seekdb
Group: Development/Debug
AutoReq: no
%description debuginfo
Debug information for the seekdb release binaries.
%prep
%build
%install
mkdir -p %{buildroot}
cp -a @PAYLOAD@/. %{buildroot}/
cp -a @LIBS@/. %{buildroot}/
%pre -p /bin/bash
@PRE@
%post -p /bin/bash
@POST@
%preun -p /bin/bash
@PREUN@
%postun -p /bin/bash
@POSTUN@
%files
%defattr(-,root,root,-)
%dir /etc/seekdb
%dir /usr/libexec/seekdb
%config(noreplace) /etc/seekdb/seekdb.cnf
/etc/seekdb/ob_system_variable_init.json
/etc/seekdb/oceanbase-pre.json
/etc/seekdb/telemetry-pre.json
/usr/bin/seekdb
/usr/bin/obshell
/usr/lib/systemd/system/seekdb.service
/usr/libexec/seekdb/import*.py
/usr/libexec/seekdb/scripts
/usr/share/seekdb
%files libs
%defattr(-,root,root,-)
/usr/libexec/seekdb/lib
%files debuginfo
%defattr(-,root,root,-)
/usr/lib/debug
