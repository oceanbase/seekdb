load(":rust_licenses.bzl", "rust_licenses")

exports_files(["package_framework.py"], visibility = ["//src/observer:__pkg__"])

rust_licenses(
    name = "rust_licenses",
    deps = ["//rust:archive", "@external_crates//:seekdb-jemalloc-sys"],
    manifest = "rust-licenses.json",
    visibility = ["//src/observer:__pkg__"],
)

filegroup(
    name = "rust_license_files",
    srcs = [":rust_licenses"],
    output_group = "license_files",
    visibility = ["//src/observer:__pkg__"],
)
