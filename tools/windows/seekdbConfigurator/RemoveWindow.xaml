<Window x:Class="seekdbConfigurator.RemoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="seekdb Configurator"
        Width="820" Height="560"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource ContentBg}">
    <Window.Resources>
        <Style x:Key="SidebarItem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SidebarFg}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,6" />
        </Style>
        <Style x:Key="SidebarItemActive" TargetType="TextBlock" BasedOn="{StaticResource SidebarItem}">
            <Setter Property="Foreground" Value="{StaticResource SidebarActiveFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="14,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left sidebar -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBg}">
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="seekdb Configurator" FontSize="15" FontWeight="Bold"
                           Foreground="White" Margin="18,0,0,4" />
                <TextBlock Text="seekdb Server" FontSize="12" Foreground="#999" Margin="18,0,0,16" />
                <StackPanel x:Name="SidebarPanel" />
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="28,20,28,10">

            <!-- Page 0: Remove Data -->
            <StackPanel x:Name="PageRemoveData" Visibility="Visible">
                <TextBlock Style="{StaticResource PageTitle}" Text="Remove Data" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Do you want to remove the data directory?" />
                <TextBlock FontSize="13" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,18"
                           Text="When the data directory is left untouched, all data stored in the databases will persist and can be reused on a different installation." />
                <CheckBox x:Name="ChkRemoveData" IsChecked="True"
                          Content="Remove the data directory" FontSize="13" Margin="0,0,0,12" />
                <TextBlock x:Name="LblDataDirPath" FontSize="12" Foreground="#888" Margin="20,0,0,0" />
            </StackPanel>

            <!-- Page 1: Remove Steps -->
            <Grid x:Name="PageRemoveSteps" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Remove Steps" />
                <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" x:Name="LblRemoveSubtitle"
                           Text="Click [Execute] to remove the server configurations" />

                <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Padding="12" CornerRadius="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StepListPanel" />
                    </ScrollViewer>
                </Border>

                <Button Grid.Row="3" x:Name="BtnExecute" Content="Execute" Style="{StaticResource NavButton}"
                        HorizontalAlignment="Center" Margin="0,12,0,0" Click="Execute_Click" />
            </Grid>

            <!-- Page 2: Removal Complete -->
            <StackPanel x:Name="PageRemoveComplete" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" x:Name="LblCompleteTitle"
                           Text="Removal Complete" Foreground="{StaticResource SuccessGreen}" />
                <TextBlock Style="{StaticResource PageSubtitle}" x:Name="LblCompleteSubtitle"
                           Text="The configuration removal operation was successful.&#x0a;Click Finish to continue." />
                <Button x:Name="BtnCopyLog" Content="Copy Log to Clipboard" Width="200" Height="28"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="CopyLog_Click" />
            </StackPanel>
        </Grid>

        <!-- Footer with navigation buttons -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource FooterBg}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblStatusBar" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#666" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Content="&lt; Back" Style="{StaticResource NavButton}" Click="Back_Click" />
                    <Button x:Name="BtnNext" Content="Next &gt;" Style="{StaticResource NavButton}" Click="Next_Click" IsDefault="True" />
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource NavButton}" Click="Cancel_Click" />
                    <Button x:Name="BtnFinish" Content="Finish" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="Finish_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
