##########################
#owner : fenggu.yh
#owner group: storage
#description: quick test
# 测试点：
# 1.reboot
# 2. 验证默认租户下表的DML/SELECT
# 4. 触发转储
# 5. 再次验证mysql租户下表的DML/SELECT
# 6. 集群重启
##########################

ob1=OBI(cluster=1:1:1, proxy_num=0, init_unit_cpu=0);

ob1.z1.obs0.set extra_config=_enable_defensive_check=0,enable_async_syslog=false,cpu_count='64',memory_budget='60G',rpc_timeout='20s';
ob1.z2.obs0.set extra_config=_enable_defensive_check=0,enable_async_syslog=false,cpu_count='64',memory_budget='60G',rpc_timeout='20s';
ob1.z3.obs0.set extra_config=_enable_defensive_check=0,enable_async_syslog=false,cpu_count='64',memory_budget='60G',rpc_timeout='20s';

# case 1. 验证bootstrap
ob1.force_stop;
sleep 6;
ob1.reboot;
sleep 6;


ob_connect(conn_sys, ob1.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
--enable_sorted_result

set @@session.ob_query_timeout = 1000000000;

# case 2. 验证默认租户下表的DML/SELECT
ob_connect(conn_mysql, ob1.z1.obs0, root@sys, , test, , USE_MYSQL_CONNECTOR);

connection conn_mysql;
create table t1_no_pk (c1 int);
source include/check_schema_sync.inc;
insert into t1_no_pk values (1), (2), (3);
select * from t1_no_pk;
update t1_no_pk set c1=c1+10;
select * from t1_no_pk;

create table t1_pk (c1 int primary key);
source include/check_schema_sync.inc;
insert into t1_pk values (1), (2), (3);
select * from t1_pk;
update t1_pk set c1=c1+10;
select * from t1_pk;

create table t1_part (c1 int primary key) partition by hash(c1) partitions 4;
source include/check_schema_sync.inc;
insert into t1_part values (1), (2), (3), (4);
select * from t1_part;
update t1_part set c1=c1+10;
select * from t1_part;

# case 4: test minor freeze
connection conn_sys;
alter system minor freeze;
# case 5. 再次验证mysql租户下表的DML/SELECT
connection conn_mysql;
insert into t1_no_pk values (1001), (1002), (1003);
select * from t1_no_pk;
update t1_no_pk set c1=c1+10;
select * from t1_no_pk;

insert into t1_pk values (1011), (1012), (1013);
select * from t1_pk;
update t1_pk set c1=c1+10;
select * from t1_pk;

create table t1_part_1 (c1 int primary key) partition by hash(c1) partitions 4;
source include/check_schema_sync.inc;
insert into t1_part_1 values (1), (2), (3), (4);
select * from t1_part_1;
update t1_part_1 set c1=c1+10;
select * from t1_part_1;

# case 6. 集群重启
ob1.force_stop;
sleep 10;
ob1.nstart;
sleep 40;

ob_connect(conn_mysql, ob1.z1.obs0, root@sys, , test, , USE_MYSQL_CONNECTOR);
connection conn_mysql;
select * from t1_no_pk;
select * from t1_pk;
select * from t1_part_1;
