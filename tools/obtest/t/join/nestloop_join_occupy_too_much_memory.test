# owner: bin.lb
# owner group: sql
#
# Nestloop join occupy too much memory.
#
# See:
# 
#

ob1=OBI(cluster=1,proxy_num=0,init_unit_cpu=0);
ob1.reboot;

let $ip = deploy_get_value(ob1.z1.obs0.ip);
let $port = deploy_get_value(ob1.z1.obs0.mysql_port);

connect(conn1,$ip,root@sys,,test,$port);
connect(conn2,$ip,root@sys,,test,$port);
connect(conn3,$ip,root@sys,,oceanbase,$port);
connection conn1;

create table t1 (k bigint primary key, v bigint);
create table t2 (k bigint primary key, v bigint);

let $i = 0;
while ($i < 100)
{
  eval insert into t1 (k, v) values ($i, $i);
  inc $i;
}

let $i = 1;
while ($i < 10)
{
  eval insert into t1 select k + 100 * $i, v from t1 where k < 100;
  inc $i;
}

let $i = 1;
while ($i < 10)
{
  eval insert into t1 select k + 1000 * $i, v from t1 where k < 1000;
  inc $i;
}

insert into t2 select k, v from t1;

let $i = 1;
while ($i < 50)
{
  eval insert into t1 select k + 10000 * $i, v from t1 where k < 10000;
  inc $i;
}

let $i = 1;
while ($i < 50)
{
  eval insert into t2 select k + 10000 * $i, v from t2 where k < 10000;
  inc $i;
}

set ob_query_timeout = 200000000;

connection conn3;
let $sql_workarea_mem_pre = query_get_value(select committed_bytes value from V\$OB_COMPONENT_MEMORY where component_name = 'SQL_WORKAREA', value, 1);

connection conn1;
send select /*+use_nl(t1 t2) */ count(*) from t1, t2 where t1.k = t2.k;

connection conn3;
--sleep 2
let $sql_workarea_mem_now = query_get_value(select committed_bytes value from V\$OB_COMPONENT_MEMORY where component_name = 'SQL_WORKAREA', value, 1);
eval select $sql_workarea_mem_now - $sql_workarea_mem_pre < 10000000 sql_workarea_less_than_10M;
--sleep 2
let $sql_workarea_mem_now = query_get_value(select committed_bytes value from V\$OB_COMPONENT_MEMORY where component_name = 'SQL_WORKAREA', value, 1);
eval select $sql_workarea_mem_now - $sql_workarea_mem_pre < 10000000 sql_workarea_less_than_10M;
--sleep 5
let $sql_workarea_mem_now = query_get_value(select committed_bytes value from V\$OB_COMPONENT_MEMORY where component_name = 'SQL_WORKAREA', value, 1);
eval select $sql_workarea_mem_now - $sql_workarea_mem_pre < 10000000 sql_workarea_less_than_10M;

connection conn1;
reap;

connection conn3;
let $sql_workarea_mem_after = query_get_value(select committed_bytes value from V\$OB_COMPONENT_MEMORY where component_name = 'SQL_WORKAREA', value, 1);
eval select $sql_workarea_mem_after <= $sql_workarea_mem_pre + 10000000 sql_workarea_released;
