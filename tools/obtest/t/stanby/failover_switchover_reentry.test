# CASE_OWNER:
#    @nijia.nj
# CASE_DESC:
#    Verify one-way online promotion and durable crash resumption.
#    Primary demotion remains external-orchestrated and restart based; the
#    failed old primary is not rejoined.
#
#    Coverage:
#      1. Planned promotion survives a forced stop after durable intent.
#      2. Restart resumes the same one-way promotion automatically.
#      3. A crash after durable role commit but before write-gate publication
#         restarts safely as PRIMARY.
#      4. Failover requires the old primary to be stopped before prepare.
#      5. A failover target becomes PRIMARY online.

--disable_query_log
db_p=OBI(cluster=1,proxy_num=0,role=primary);
db_p.reboot;

db_s=OBI(cluster=1,proxy_num=0,primary=db_p);
db_s.reboot;

sleep 5;
--enable_query_log

ob_connect(conn_a, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
ob_connect(conn_b, db_s.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);

--disable_query_log
--disable_result_log
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
--enable_result_log
--enable_query_log

connection conn_a;
create table if not exists test_reentry(id int primary key, name varchar(100));
insert into test_reentry values(1, 'init_data');

--disable_query_log
--disable_result_log
db_s.check_until_timeout select count(*) from test_reentry where name = 'init_data', 1, 120;
--enable_result_log
--enable_query_log

#################################################################################################
#################  Part 1: Planned Switchover with Forced Stop  ###############################
#################################################################################################
--echo ======== Part 1: Planned Switchover with Forced Stop ========

# The old primary must know the new source before it is fenced.
let $db_s_svr_ip = deploy_get_value(db_s.select select svr_ip from oceanbase.__all_virtual_server_stat limit 1, svr_ip, 1);
let $db_s_rpc_port = deploy_get_value(db_s.select select rpc_port from oceanbase.__all_virtual_server_stat limit 1, rpc_port, 1);
connection conn_a;
eval alter system set log_restore_source = '$db_s_svr_ip:$db_s_rpc_port';

# VERIFY is observational and cannot create a pending transition.
ALTER SYSTEM SWITCHOVER TO STANDBY VERIFY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;

# Prepare the source and verify that active role remains PRIMARY.
ALTER SYSTEM SWITCHOVER TO STANDBY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'STANDBY' and switchover_status = 'PREPARING', 1, 60;
--error 4688
insert into test_reentry values(2, 'must_be_fenced');

# Stop at the durable-intent boundary, then crash the target before any
# promotion side effect runs.
db_s.mysql alter system set debug_sync_timeout = '1000s';
db_s.mysql set ob_global_debug_sync = 'AFTER_STANDBY_PROMOTION_INTENT_PERSISTED wait_for promotion_resume execute 1';
connection conn_b;
send ALTER SYSTEM SWITCHOVER TO PRIMARY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'PRIMARY' and switchover_status = 'PREPARING', 1, 120;

# The fenced source remains available while restart resumes to its exact
# cutover boundary.
db_s.force_stop;
--disable_result_log
--error 255
reap;
--enable_result_log
db_s.nstart;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_b, db_s.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);

# Restart the old source as the new standby only after the new primary is ready.
db_p.force_stop;
db_p.nstart;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_a, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
db_p.check_until_timeout select count(*) from test_reentry where name = 'init_data', 1, 120;

--echo ---- Part 1 completed: durable promotion intent resumed after crash ----

#################################################################################################
#################  Part 2: Crash Between Role Commit and Write Publication  ###################
#################################################################################################
--echo ======== Part 2: Crash Between Role Commit and Write Publication ========

connection conn_b;
ALTER SYSTEM SWITCHOVER TO PRIMARY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
insert into test_reentry values(2, 'from_new_primary');

--disable_query_log
--disable_result_log
db_p.check_until_timeout select count(*) from test_reentry where name = 'from_new_primary', 1, 120;
--enable_result_log
--enable_query_log

# Prepare the current primary db_s to restart as standby after db_p is promoted.
let $db_p_svr_ip = deploy_get_value(db_p.select select svr_ip from oceanbase.__all_virtual_server_stat limit 1, svr_ip, 1);
let $db_p_rpc_port = deploy_get_value(db_p.select select rpc_port from oceanbase.__all_virtual_server_stat limit 1, rpc_port, 1);
connection conn_b;
eval alter system set log_restore_source = '$db_p_svr_ip:$db_p_rpc_port';
ALTER SYSTEM SWITCHOVER TO STANDBY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'STANDBY' and switchover_status = 'PREPARING', 1, 60;

# Hold db_p after its PRIMARY role is durable but before runtime publication.
db_p.mysql alter system set debug_sync_timeout = '1000s';
db_p.mysql set ob_global_debug_sync = 'AFTER_STANDBY_PRIMARY_ROLE_COMMITTED signal primary_role_committed wait_for publish_primary execute 1';
ob_connect(conn_probe, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
connection conn_a;
send ALTER SYSTEM SWITCHOVER TO PRIMARY;

--disable_query_log
--disable_result_log
db_p.mysql set ob_global_debug_sync = 'now wait_for primary_role_committed';

# Persisted role is PRIMARY, but the active runtime role and write gate have not
# been published yet.
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
--enable_result_log
--enable_query_log

connection conn_probe;
--error 4688
insert into test_reentry values(3, 'gate_must_stay_closed');

# Crash in the held window. Startup must use the durable PRIMARY role and only
# open the write gate after the PRIMARY boot profile is ready.
db_p.force_stop;
connection conn_a;
--disable_result_log
--error 255
reap;
--enable_result_log
db_p.nstart;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_a, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);

# Restart the fenced db_s as standby and verify it follows db_p again.
db_s.force_stop;
db_s.nstart;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_b, db_s.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
db_s.check_until_timeout select count(*) from test_reentry where name = 'from_new_primary', 1, 120;

--echo ---- Part 2 completed: committed role recovered before write publication ----

#################################################################################################
#################  Part 3: Failover with Stopped Old Primary  ###############################
#################################################################################################
--echo ======== Part 3: Failover with Stopped Old Primary ========

# The current primary is the old primary for this failover and must leave the topology.
db_p.force_stop;

connection conn_b;
ALTER SYSTEM ACTIVATE STANDBY VERIFY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;

ALTER SYSTEM ACTIVATE STANDBY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
insert into test_reentry values(3, 'after_failover');
select count(*) from test_reentry;
# 3

# The failed old primary is intentionally not restarted or rejoined.
--echo ---- Part 3 completed: failover activated online; old primary left out ----

#################################################################################################
#################  Summary  #####################################################################
#################################################################################################
--echo ======== Test Summary ========
--echo One-way online promotion and crash resumption passed.
