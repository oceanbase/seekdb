# CASE_OWNER:
#    @nijia.nj
# CASE_DESC:
#    Verify durable pending-role preparation and restart activation.
#    Role changes are external-orchestrated; there is no online role state
#    machine and the failed old primary is not rejoined.
#
#    Coverage:
#      1. Planned switchover survives a forced stop between prepare and restart.
#      2. The target becomes PRIMARY only after restart.
#      3. Failover requires the old primary to be stopped before prepare.
#      4. A failover target becomes PRIMARY only after restart.

--disable_query_log
db_p=OBI(cluster=1,proxy_num=0,role=primary);
db_p.reboot;

db_s=OBI(cluster=1,proxy_num=0,primary=db_p);
db_s.reboot;

sleep 5;
--enable_query_log

ob_connect(conn_a, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
ob_connect(conn_b, db_s.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);

--disable_query_log
--disable_result_log
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
--enable_result_log
--enable_query_log

connection conn_a;
create table if not exists test_reentry(id int primary key, name varchar(100));
insert into test_reentry values(1, 'init_data');

--disable_query_log
--disable_result_log
db_s.check_until_timeout select count(*) from test_reentry where name = 'init_data', 1, 120;
--enable_result_log
--enable_query_log

#################################################################################################
#################  Part 1: Planned Switchover with Forced Stop  ###############################
#################################################################################################
--echo ======== Part 1: Planned Switchover with Forced Stop ========

# The old primary must know the new source before it is fenced.
let $db_s_svr_ip = deploy_get_value(db_s.select select svr_ip from oceanbase.__all_virtual_server_stat limit 1, svr_ip, 1);
let $db_s_rpc_port = deploy_get_value(db_s.select select rpc_port from oceanbase.__all_virtual_server_stat limit 1, rpc_port, 1);
connection conn_a;
eval alter system set log_restore_source = '$db_s_svr_ip:$db_s_rpc_port';

# VERIFY is observational and cannot create a pending transition.
ALTER SYSTEM SWITCHOVER TO STANDBY VERIFY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;

# Prepare the source and verify that active role remains PRIMARY.
ALTER SYSTEM SWITCHOVER TO STANDBY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'STANDBY' and switchover_status = 'PREPARING', 1, 60;
--error 4688
insert into test_reentry values(2, 'must_be_fenced');

# Prepare the target while the fenced source is still serving its final log.
connection conn_b;
ALTER SYSTEM SWITCHOVER TO PRIMARY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'PRIMARY' and switchover_status = 'PREPARING', 1, 120;

# A forced stop before activation must preserve the pending role.
db_p.force_stop;
db_s.force_stop;
db_s.nstart;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_b, db_s.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);

# Restart the old source as the new standby only after the new primary is ready.
db_p.nstart;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_a, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
db_p.check_until_timeout select count(*) from test_reentry where name = 'init_data', 1, 120;

--echo ---- Part 1 completed: planned switchover activated after restart ----

#################################################################################################
#################  Part 2: New Primary Log Sync  ###############################################
#################################################################################################
--echo ======== Part 2: New Primary Log Sync ========

connection conn_b;
ALTER SYSTEM SWITCHOVER TO PRIMARY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
insert into test_reentry values(2, 'from_new_primary');

--disable_query_log
--disable_result_log
db_p.check_until_timeout select count(*) from test_reentry where name = 'from_new_primary', 1, 120;
--enable_result_log
--enable_query_log

--echo ---- Part 2 completed: restarted standby follows the new primary ----

#################################################################################################
#################  Part 3: Failover with Stopped Old Primary  ###############################
#################################################################################################
--echo ======== Part 3: Failover with Stopped Old Primary ========

# The current primary is the old primary for this failover and must leave the topology.
db_s.force_stop;

connection conn_a;
ALTER SYSTEM ACTIVATE STANDBY VERIFY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;

ALTER SYSTEM ACTIVATE STANDBY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'PRIMARY' and switchover_status = 'PREPARING', 1, 60;

# Pending PRIMARY is committed only by the next process start.
db_p.force_stop;
db_p.nstart;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
ob_connect(conn_a, db_p.z1.obs0, root@sys, , oceanbase, , USE_MYSQL_CONNECTOR);
insert into test_reentry values(3, 'after_failover');
select count(*) from test_reentry;
# 3

# The failed old primary is intentionally not restarted or rejoined.
--echo ---- Part 3 completed: failover activated after restart; old primary left out ----

#################################################################################################
#################  Summary  #####################################################################
#################################################################################################
--echo ======== Test Summary ========
--echo Durable pending-role restart semantics passed.
