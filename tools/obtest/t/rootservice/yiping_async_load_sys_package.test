ob1=OBI(cluster=1:1:1,proxy_num=0);
ob1.reboot;

ob_connect(sys_conn, ob1.z1.obs0, root@sys,,oceanbase,USE_MYSQL_CONNECTOR);
# mysql sys package load finished
select job_id, job_type, job_status from oceanbase.__all_admin_job;

# 集群重启
ob1.force_stop;
ob1.nstart;

ob1.check_until_timeout select count(*) from oceanbase.__all_server where start_service_time <= 0 or status='INACTIVE',0,180;
ob1.check_until_timeout select count(1) as unsync_cnt from GV\$OB_LOG_STAT where in_sync = 'NO',0,600;
source include/check_schema_sync_for_restart.inc;

let $leader_zone=deploy_get_value(ob1.select select zone from oceanbase.__all_ls_meta_table where role=1 and ls_id=1 and tenant_id=1, zone, 1);

# 强制load sys package报错4016，验证能自动重试

# 重启后自动执行load sys package，等所有load sys package的rs job完成
ob1.check_until_timeout select count(*) from __all_admin_job where job_status!='SUCCESS', 0, 600;

let $ip = deploy_get_value(ob1.z1.obs0.ip);
let $port = deploy_get_value(ob1.z1.obs0.port);

ob1.mysql alter tenant sys set primary_zone='z1';
ob1.check_until_timeout select role from __all_ls_meta_table where ls_id=1 and tenant_id=1 and zone='z1', 1, 600;
ob1.check_until_timeout select count(*)>0 from oceanbase.__all_virtual_server_event_history where event='full_rootservice' and value1=0 and value2 like '%$ip:$port%' order by 1 desc, 1, 10;

# 集群重启
ob1.force_stop;
ob1.nstart;

ob1.check_until_timeout select count(*) from oceanbase.__all_server where start_service_time <= 0 or status='INACTIVE',0,180;
ob1.check_until_timeout select count(1) as unsync_cnt from GV\$OB_LOG_STAT where in_sync = 'NO',0,600;
source include/check_schema_sync_for_restart.inc;

ob1.check_until_timeout select role from oceanbase.__all_ls_meta_table where ls_id=1 and tenant_id=1 and zone='z1', 1, 600;
ob1.check_until_timeout select count(*)>0 from oceanbase.__all_virtual_server_event_history where event='full_rootservice' and value1=0 and value2 like '%$ip:$port%' order by 1 desc, 1, 10;

# 重启后会自动执行一次load sys package，这个时候因为重启前成功了，所以预期不会走到执行DDL
ob1.z1.obs0.check_rs_log_until_success -c "admin job is not INPROGRESS, no need to load package";

let $sys_package_count = deploy_get_value(ob1.select select count(*) a from __all_package, a, 1);
