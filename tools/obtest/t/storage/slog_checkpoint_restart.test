# owner: gaishun.gs
# owner group: storage
# description: write slog checkpoint and restart

ob1=OBI(cluster=1:1:1,proxy_num=0,init_unit_cpu=0);
ob1.reboot;

let $ip=deploy_get_value(ob1.z1.obs0.ip);
let $port=deploy_get_value(ob1.z1.obs0.mysql_port);
connect (conn1,$ip,root@sys,,oceanbase,$port);
connection conn1;

ob1.mysql alter system minor freeze;
create table mytable(c1 int primary key) partition by range(c1) (
  partition p0 values less than (100),
  partition p1 values less than (200),
  partition p2 values less than (300),
  partition p3 values less than (400),
  partition p4 values less than (500),
  partition p5 values less than (600));

--disable_query_log
let $count = 1;
while ($count < 550)
{
  eval insert into mytable values($count);
  inc $count;
}
--enable_query_log

--disable_query_log
alter system checkpoint;
--enable_query_log
ob1.mysql alter system minor freeze;
sleep 10;
ob1.force_stop;
sleep 10;
ob1.nstart;
ob1.check_until_timeout select count(*) as cnt from oceanbase.V\$OB_SERVER_STAT where start_service_time > 0, 1, 180;
source include/check_schema_sync_for_restart.inc;
connect (conn1,$ip,root@sys,,oceanbase,$port);
connection conn1;
select count(*) as row_count from mytable;
