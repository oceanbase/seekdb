ob2.check_until_timeout select count(*) c from __all_virtual_meta_table where tenant_id = $tt2_id, $partition_cnt, 120;
ob2.check_until_timeout select min_log_service_ts > $now from oceanbase.__all_virtual_partition_info where table_id=$t1_id, 1, 120;
ob2.check_until_timeout select count(*) from oceanbase.__all_virtual_sys_stat where tenant_id = $tt2_id and name = 'current_timezone_version', 1, 120;
