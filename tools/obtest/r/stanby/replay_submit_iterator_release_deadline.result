db_p=OBI(cluster=1,proxy_num=0,role=primary);
db_p.reboot;
db_s=OBI(cluster=1,proxy_num=0,primary=db_p);
db_s.reboot;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
db_s.check_until_timeout select count(*) from replay_submit_iterator_release_deadline where id = 1 and marker = 'initial_non_empty_clog', 1, 120;
db_s.z1.obs0.check_log_until_success -c "succ to submit log task.*buf_:0x[1-9a-f][0-9a-f]*.*user:\"REPLAY\"";
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_sys_parameter where name = 'server_role_info' and value = 'PRIMARY:INVALID:NORMAL:0', 1, 30;
db_s.check_until_timeout select count(*) from replay_submit_iterator_release_deadline where id = 2026091701 and marker = 'replay_submit_iterator_release_deadline', 1, 120;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'STANDBY' and switchover_status = 'PREPARING', 1, 60;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_sys_parameter where name = 'server_role_info' and value <> '$role_info_before' and gmt_modified > $role_gmt_before and substring_index(value, ':', 3) = 'PRIMARY:STANDBY:PREPARING' and cast(substring_index(value, ':', -1) as unsigned) > 0, 1, 60;
db_p.z1.obs0.check_log_until_success -c "persisted server role state.*PRIMARY.*STANDBY.*PREPARING.*$cutover_scn";
db_s.check_until_timeout select count(*) from (select max(end_scn) as end_scn from oceanbase.__all_virtual_log_stat) t where t.end_scn >= $cutover_scn, 1, 120;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and sync_scn >= $cutover_scn, 1, 120;
db_s.mysql alter system set debug_sync_timeout = '300s';
db_s.mysql set ob_global_debug_sync = 'REPLAY_SUBMIT_TASK_BEFORE_UNLOCK signal replay_submit_rdlocked wait_for replay_submit_continue execute 1';
db_s.mysql set ob_global_debug_sync = 'REPLAY_SUBMIT_TASK_AFTER_TEST_REQUEUE wait_for replay_submit_rdlocked execute 1';
role_info_before	gmt_before	gmt_after	cutover_scn	standby_end_scn	standby_replay_scn
PRIMARY:INVALID:NORMAL:0	<value>	<value>	<value>	<value>	<value>
ERROR HY000: Timeout
db_s.z1.obs0.check_log_until_success -c "replay submit iterator release blocked.*phase.*submit_iterator_release.*last_state.*RWLOCK_BUSY.*iterator_generation=1.*release_retry_count=0";
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY', 1, 30;
ERROR HY000: standby tenant is read only
db_s.mysql set ob_global_debug_sync = 'now signal replay_submit_continue';
db_s.mysql set ob_global_debug_sync = 'REPLAY_SUBMIT_TASK_BEFORE_UNLOCK clear';
db_s.mysql set ob_global_debug_sync = 'REPLAY_SUBMIT_TASK_AFTER_TEST_REQUEUE clear';
db_s.mysql set ob_global_debug_sync = 'reset';
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 120;
db_s.z1.obs0.check_log_until_success -c "replay submit iterator release finished.*phase.*submit_iterator_release.*last_state.*RELEASED";
db_s.mysql alter system refresh memory stat;
