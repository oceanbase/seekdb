========== Case 2: Switchover in Cascade Topology ==========
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where log_restore_source like '%:$db_s2_rpc_port', 1, 30;
insert into test_cascade_standby values(3, 'before_switchover', 300);
db_s1.check_until_timeout select count(*) from test_cascade_standby where id = 3, 1, 120;
db_s2.check_until_timeout select count(*) from test_cascade_standby where id = 3, 1, 180;
db_s1.mysql alter system set debug_sync_timeout = '1000s';
db_s2.mysql alter system set debug_sync_timeout = '1000s';
db_s1.mysql set ob_global_debug_sync = 'BEFORE_STANDBY_LOG_SYNC_FETCH signal cascade_relay_paused wait_for cascade_relay_resume execute 1';
db_s2.mysql set ob_global_debug_sync = 'AFTER_STANDBY_PROMOTION_BOUNDARY_RESOLVED signal cascade_boundary_resolved execute 1';
db_s1.mysql set ob_global_debug_sync = 'now wait_for cascade_relay_paused';
update test_cascade_standby
set name = 'root_cutover_boundary', value = 301
where id = 3;
ALTER SYSTEM SWITCHOVER TO STANDBY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'STANDBY' and switchover_status = 'PREPARING', 1, 60;
db_p.check_until_timeout select count(*) as cnt from oceanbase.dba_ob_rootservice_jobs where JOB_TYPE = "LOAD_MYSQL_SYS_PACKAGE", 1, 10;
ALTER SYSTEM SWITCHOVER TO PRIMARY;
db_s2.mysql set ob_global_debug_sync = 'now wait_for cascade_boundary_resolved';
db_s2.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 30;
db_s2.check_until_timeout select count(*) from test_cascade_standby where id = 3 and value = 300, 1, 30;
db_s1.mysql set ob_global_debug_sync = 'now signal cascade_relay_resume';
db_s2.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 120;
db_s2.check_until_timeout select count(*) from test_cascade_standby where id = 3 and name = 'root_cutover_boundary' and value = 301, 1, 120;
db_p.force_stop;
db_p.nstart;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
db_s2.check_until_timeout select count(*) as cnt from oceanbase.dba_ob_rootservice_jobs where JOB_TYPE = "LOAD_MYSQL_SYS_PACKAGE" and JOB_STATUS = "SUCCESS" and RESULT_CODE = 0, 1, 120;
insert into test_cascade_standby values(4, 'after_switchover', 400);
db_p.check_until_timeout select count(*) from test_cascade_standby where id = 4, 1, 120;
db_s1.check_until_timeout select count(*) from test_cascade_standby where id = 4, 1, 180;
select count(*) from test_cascade_standby;
count(*)
4
create table standby_t1 (c1 int);
