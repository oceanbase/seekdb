========== Case 1: Primary Cluster Switchover to Standby ==========
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY', 1, 30;
create table if not exists test_table_primary(a int primary key, b int);
insert into test_table_primary values(1, 1);
ALTER SYSTEM SWITCHOVER TO STANDBY VERIFY;
db_p.mysql_p select role from oceanbase.__all_virtual_server_stat;
role
PRIMARY
alter system set log_restore_source = '127.0.0.1:42001';
ALTER SYSTEM SWITCHOVER TO STANDBY;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'STANDBY' and switchover_status = 'PREPARING', 1, 60;
db_p.mysql_p select role, pending_role, switchover_status from oceanbase.__all_virtual_server_stat;
role	pending_role	switchover_status
PRIMARY	STANDBY	PREPARING
create table test_table_standby(a int);
ERROR HY000: standby tenant is read only
insert into test_table_primary values(2, 2);
ERROR HY000: standby tenant is read only
ALTER SYSTEM SWITCHOVER TO PRIMARY;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'PRIMARY' and switchover_status = 'PREPARING', 1, 120;
db_p.force_stop;
db_s.force_stop;
db_s.nstart;
db_s.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'PRIMARY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
db_p.nstart;
db_p.check_until_timeout select count(*) from oceanbase.__all_virtual_server_stat where role = 'STANDBY' and pending_role = 'INVALID' and switchover_status = 'NORMAL', 1, 60;
Case 1 completed: Primary cluster successfully switched to standby
