ob1=OBI(cluster=1:1:1, proxy_num=0, init_unit_cpu=0, locality=HZ:HZ:HZ);
ob1.z1.obs0.set extra_config=$extra_conf;
ob1.z2.obs0.set extra_config=$extra_conf;
ob1.z3.obs0.set extra_config=$extra_conf;
ob1.reboot;
ob1.mysql create resource unit box1 max_cpu 10, min_cpu 10, memory_size '10G', log_disk_size '30G';
ob1.mysql create resource pool pool1 unit = 'box1', unit_num = 1;
ob1.mysql create tenant mysql replica_num = 3,primary_zone='z1,z2,z3', resource_pool_list=('pool1') set ob_tcp_invited_nodes='%';
ob1.check_until_timeout select count(*) c from oceanbase.__all_server where start_service_time <= 0 or status = "inactive", 0, 120;
alter system set _enable_active_txn_transfer = True;
alter system set partition_balance_schedule_interval='11s';
create table stu1(col1 int, col2 int, primary key(col1));
create table stu2(col1 int, col2 int, primary key(col1));
============= transfer empty tablet =======================
ob1.check_until_timeout select count(*) from oceanbase.__all_virtual_balance_job_history where tenant_id = $mysql_tenant_id, 1, 300;
ob1.check_until_timeout select count(*) from oceanbase.__all_virtual_balance_job where tenant_id = $mysql_tenant_id, 0, 60;
ob1.check_until_timeout select count(*) from oceanbase.CDB_OB_LS where tenant_id = $mysql_tenant_id and status != 'NORMAL', 0, 100;
SELECT LS_ID, STATUS, PRIMARY_ZONE FROM oceanbase.DBA_OB_LS;
LS_ID	STATUS	PRIMARY_ZONE
1	NORMAL	z1;z2,z3
1001	NORMAL	z1;z2,z3
1002	NORMAL	z2;z1,z3
1003	NORMAL	z3;z1,z2
SELECT DISTINCT TABLE_ID, TABLE_NAME, PARTITION_NAME, TABLET_ID, LS_ID FROM oceanbase.DBA_OB_TABLE_LOCATIONS WHERE TABLE_ID >= 500000 ORDER BY TABLE_ID, TABLET_ID;
TABLE_ID	TABLE_NAME	PARTITION_NAME	TABLET_ID	LS_ID
500002	stu1	NULL	200001	1001
500003	stu2	NULL	200002	1001
