#owner: minan
#owner group: transaction
#description: Explicit rollback waits for an already-aborted write context.

--disable_warnings
drop table if exists rollback_aborted_decision;
--enable_warnings
create table rollback_aborted_decision(id int primary key, payload varchar(2000), tag int);
insert into rollback_aborted_decision values (1, 'base', 1);
connect (writer,$OBMYSQL_MS0,$OBMYSQL_USR,$OBMYSQL_PWD,test,$OBMYSQL_PORT);
connect (contender,$OBMYSQL_MS0,$OBMYSQL_USR,$OBMYSQL_PWD,test,$OBMYSQL_PORT);
connection default;
--disable_query_log
let $old_sync_timeout = `select value from oceanbase.__all_virtual_sys_parameter_stat where name = 'debug_sync_timeout' limit 1`;
alter system set debug_sync_timeout = '30s';
--enable_query_log
set ob_global_debug_sync = 'reset';

# Exercise both successful completion and query-timeout propagation.
let $mode = 2;
while ($mode)
{
  connection writer;
  set ob_query_timeout = 60000000, ob_trx_timeout = 600000000, ob_trx_idle_timeout = 600000000;
  begin;
  --disable_query_log
  let $writer_id = `select connection_id()`;
  let $updates = 3000;
  while ($updates)
  {
    eval update rollback_aborted_decision set payload = repeat('pending$updates', 100) where id = 1;
    dec $updates;
  }
  --enable_query_log

  # Move the uncommitted rows to SSTable, making the transaction decision
  # necessary for lock visibility after descriptor abort.
  connection default;
  alter system minor freeze;
  --disable_query_log
  let $attempts = 1200;
  let $pending = 1;
  while ($pending)
  {
    let $pending = `select count(*) from oceanbase.__all_virtual_tablet_memstore_info where is_active = 'NO'`;
    dec $attempts;
    if (!$attempts)
    {
      die Timed out waiting for minor merge;
    }
    real_sleep 0.1;
  }
  --enable_query_log
  set ob_global_debug_sync = 'BEFORE_TX_ABORT_DECISION signal abort_paused wait_for release_abort timeout 30000000 execute 1';
  --disable_query_log
  eval alter system set_tp tp_name = 'EN_TX_RESULT_INCOMPLETE', error_code = 4016, occur = 1, match = $writer_id;
  --enable_query_log
  connection writer;
  --error 6002
  update rollback_aborted_decision set tag = 2 where id = 1;
  connection default;
  alter system set_tp tp_name = 'EN_TX_RESULT_INCOMPLETE', error_code = 0, frequency = 0;
  set ob_global_debug_sync = 'now wait_for abort_paused timeout 10000000';

  connection contender;
  --error 1205
  select id from rollback_aborted_decision where id = 1 for update nowait;

  if ($mode == 2)
  {
    connection writer;
    send rollback;
    connection default;
    # A successful signal wait alone does not prove the callback paused.
    # Require ROLLBACK to remain in flight before releasing the callback.
    --disable_query_log
    let $attempts = 50;
    let $in_rollback = 0;
    while (!$in_rollback)
    {
      let $in_rollback = `select count(*) from information_schema.processlist where id = $writer_id and lower(info) = 'rollback'`;
      dec $attempts;
      if (!$attempts)
      {
        die ROLLBACK did not wait for the aborted write context;
      }
      real_sleep 0.1;
    }
    --enable_query_log
    connection contender;
    --error 1205
    select id from rollback_aborted_decision where id = 1 for update nowait;
    connection default;
    set ob_global_debug_sync = 'now signal release_abort';
    connection writer;
    reap;
  }
  if ($mode == 1)
  {
    connection writer;
    set ob_query_timeout = 1000000;
    --error 4012
    rollback;
    # ROLLBACK timed out, so the lock may still be held until abort completes.
    connection contender;
    --error 1205
    select id from rollback_aborted_decision where id = 1 for update nowait;
    connection default;
    set ob_global_debug_sync = 'now signal release_abort';
  }
  connection default;
  set ob_global_debug_sync = 'reset';
  connection contender;
  # Blocking acquisition also synchronizes with the released abort callback.
  select id, payload, tag from rollback_aborted_decision where id = 1 for update;
  select id from rollback_aborted_decision where id = 1 for update nowait;
  connection writer;
  set ob_query_timeout = 60000000;
  begin;
  update rollback_aborted_decision set tag = 3 where id = 1;
  rollback;
  select tag from rollback_aborted_decision where id = 1;
  dec $mode;
}

connection default;
--disable_query_log
eval alter system set debug_sync_timeout = '$old_sync_timeout';
--enable_query_log
disconnect writer;
disconnect contender;
drop table rollback_aborted_decision;
