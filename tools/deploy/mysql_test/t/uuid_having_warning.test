#owner: minan
#owner group: sql
#description: Warning-producing rewrites preserve diagnostic counts.

--disable_warnings
drop database if exists uuid_having_warning;
--enable_warnings

create database uuid_having_warning character set utf8mb4;
use uuid_having_warning;

create table t1(c1 int primary key, c2 varchar(100), c8 varchar(100));
insert into t1 values (
  1,
  bin_to_uuid(uuid_to_bin('5fd29c12-493f-11ed-9307-7cd30abc95d8')),
  bin_to_uuid(uuid_to_bin('11d29c12-493f-11ed-9307-7cd30abc95d8')));
create view v1 as select * from t1;

select * from t1 group by bin_to_uuid(uuid_to_bin('11d29c12-493f-11ed-9307-7cd30abc95d8'))
having bin_to_uuid(uuid_to_bin('11d29c12-493f-11ed-9307-7cd30abc95d8'), 34) order by c1;

select * from v1 group by bin_to_uuid(uuid_to_bin('11d29c12-493f-11ed-9307-7cd30abc95d8'))
having bin_to_uuid(uuid_to_bin('11d29c12-493f-11ed-9307-7cd30abc95d8'), 34) order by c1;

create table t_sum(id int primary key, s varchar(20));
insert into t_sum values (1,'1x'),(2,'-2x'),(3,NULL);
select id, sum(s) from t_sum group by id, s having sum(s) > 0 order by id;

create table t_timeformat(id int, sal int, key idx_sal(sal));
insert into t_timeformat values (1,5000),(2,-4000),(3,0),(4,NULL),(5,6000),(6,8000),(7,3500);
select id, sum(sal) from t_timeformat
where time_format(sal, '%r %T %H %k %I %i %s %f') > 0
group by id
having sum(sal) > 5000
order by id;

create table t_any(c1 int primary key auto_increment, c2 varchar(100), c3 varchar(100));
insert into t_any(c2,c3) values(hex(uuid_to_bin('661be1c9-3f0b-11ed-8ff3-7cd30abc95d8')),hex(uuid_to_bin('658517a8-3f0b-11ed-9291-b8599f1d613a')));
insert into t_any(c2,c3) values(hex(uuid_to_bin('7945c0ae-3f0b-11ed-8ff3-7cd30abc95d8')),hex(uuid_to_bin('7e915fff-3f0b-11ed-9291-b8599f1d613a')));
insert into t_any(c2,c3) values(hex(uuid_to_bin('84cb3d42-3f0b-11ed-8ff3-7cd30abc95d8')),hex(uuid_to_bin('867c697c-3f0b-11ed-9291-b8599f1d613a')));
insert into t_any(c2,c3) values(hex(uuid_to_bin('854dc29c-3f0b-11ed-8ff3-7cd30abc95d8')),hex(uuid_to_bin('86d336c9-3f0b-11ed-9291-b8599f1d613a')));

select * from t_any where c2 > any(select c1 from t_any
where c2=hex(uuid_to_bin('854dc29c-3f0b-11ed-8ff3-7cd30abc95d8'))
  and c3=hex(uuid_to_bin('86d336c9-3f0b-11ed-9291-b8599f1d613a'))) order by c1;

select * from t_any where c2 < any(select c1 from t_any
where c2=hex(uuid_to_bin('854dc29c-3f0b-11ed-8ff3-7cd30abc95d8'))
  and c3=hex(uuid_to_bin('86d336c9-3f0b-11ed-9291-b8599f1d613a'))) order by c1;

--disable_warnings
drop database uuid_having_warning;
--enable_warnings
