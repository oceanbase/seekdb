drop database if exists hualong;
create database hualong;
use hualong;
create table using_hash_t1 (c1 int, c2 int, primary key using hash (c1));
create table using_btree_t1 (c1 int, c2 int, primary key using btree (c1));
select t.table_name, t.index_using_type from oceanbase.__all_table t join oceanbase.__all_database d on t.database_id = d.database_id where t.table_name = 'using_hash_t1' and d.database_name = 'hualong';
table_name	index_using_type
using_hash_t1	1
select t.table_name, t.index_using_type from oceanbase.__all_table t join oceanbase.__all_database d on t.database_id = d.database_id where t.table_name = 'using_btree_t1' and d.database_name = 'hualong';
table_name	index_using_type
using_btree_t1	0
select index_table.table_name as index_name, data_table.table_name as data_table_name, index_table.index_using_type
from oceanbase.__all_table index_table join oceanbase.__all_table data_table
on index_table.data_table_id = data_table.table_id
where index_table.index_using_type = 1
order by 1;
index_name	data_table_name	index_using_type
drop database hualong;
