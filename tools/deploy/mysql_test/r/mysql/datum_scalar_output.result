# Remaining scalar result values use Datum with unchanged wire formatting
DROP TABLE IF EXISTS datum_scalar_output;
CREATE TABLE datum_scalar_output (
id INT PRIMARY KEY,
f FLOAT, uf FLOAT UNSIGNED, zf FLOAT(9,3) UNSIGNED ZEROFILL,
d DOUBLE, ud DOUBLE UNSIGNED, zd DOUBLE(12,4) UNSIGNED ZEROFILL,
dt DATE, tm TIME(6), yr YEAR, b8 BIT(8), b64 BIT(64)
);
