CREATE TABLE bitpacked_int_rows (
id INT PRIMARY KEY,
v26 BIGINT,
v35 BIGINT,
v57 BIGINT,
v64 BIGINT UNSIGNED,
created DATETIME
) ROW_FORMAT=DYNAMIC;
SET @row_id=0;
INSERT INTO bitpacked_int_rows
SELECT /*+ NO_MERGE(seq_rows) */ i,
MOD(i*49000007,67108864)-33554432,
MOD(i*32452843873,34359738368)-17179869184,
IF(MOD(i,11)=0,NULL,
MOD(CAST(i AS DECIMAL(30,0))*72057594037927897,144115188075855872)-72057594037927936),
CASE MOD(i,4) WHEN 0 THEN 18446744073709551615 WHEN 1 THEN 0
ELSE MOD(CAST(i AS DECIMAL(30,0))*9223372036854775783,18446744073709551616) END,
TIMESTAMPADD(SECOND,MOD(i*7919,31536000),'2000-01-01 00:00:00')
FROM (SELECT (@row_id:=@row_id+1) AS i FROM TABLE(GENERATOR(4097))) seq_rows;
ALTER SYSTEM MAJOR FREEZE;
SELECT COUNT(*),SUM(v26),SUM(v35),SUM(CAST(v57 AS DECIMAL(40,0))),
SUM(CAST(v64 AS DECIMAL(40,0))),MIN(created),MAX(created)
FROM bitpacked_int_rows;
