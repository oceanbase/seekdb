# An async index must be ready before pinning the old RR snapshot.
connect (rr_writer,$OBMYSQL_MS0,root@sys,,test,$OBMYSQL_PORT);
connection rr_writer;
--disable_warnings
DROP DATABASE IF EXISTS vector_index_heap_rr_snapshot;
--enable_warnings
CREATE DATABASE vector_index_heap_rr_snapshot;
USE vector_index_heap_rr_snapshot;
SET autocommit = 1;
SET ob_query_timeout = 20000000;
SET ob_trx_timeout = 120000000;
CREATE TABLE rv_heap (id INT PRIMARY KEY, tag INT, v VECTOR(3), VECTOR INDEX idx(v) WITH (distance=l2,type=hnsw,lib=vsag,sync_mode=async)) ORGANIZATION HEAP;
INSERT INTO rv_heap VALUES (1,10,'[1,0,0]');
CALL dbms_vector.refresh_index('idx','rv_heap','v',1,'FAST');
let $wait_condition = SELECT COUNT(*) = 1 FROM (SELECT /*+ INDEX(rv_heap idx) */ id,tag FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10) q WHERE tag=10;
--source mysql_test/include/wait_condition.inc
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
connect (rr_reader,$OBMYSQL_MS0,root@sys,,vector_index_heap_rr_snapshot,$OBMYSQL_PORT);
connection rr_reader;
SET ob_query_timeout = 20000000;
SET ob_trx_timeout = 120000000;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
--echo # A pins the snapshot before B's update
SELECT id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') LIMIT 10;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
connection rr_writer;
UPDATE rv_heap SET tag=20,v='[2,0,0]' WHERE id=1;
CALL dbms_vector.refresh_index('idx','rv_heap','v',1,'FAST');
# Wait for async refresh visibility, then warm the newer bitmap view.
let $wait_condition = SELECT COUNT(*) = 1 FROM (SELECT /*+ INDEX(rv_heap idx) */ id,tag FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10) q WHERE tag=20;
--source mysql_test/include/wait_condition.inc
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
connection rr_reader;
--echo # A must retain its snapshot after B's update and warmup
SELECT id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') LIMIT 10;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
COMMIT;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
BEGIN;
--echo # A pins the snapshot before B's delete
SELECT id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') LIMIT 10;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
connection rr_writer;
BEGIN;
DELETE FROM rv_heap WHERE id=1;
INSERT INTO rv_heap VALUES (2,30,'[3,0,0]');
COMMIT;
CALL dbms_vector.refresh_index('idx','rv_heap','v',1,'FAST');
# Wait for async refresh visibility, then warm the newer bitmap view.
let $wait_condition = SELECT COUNT(*) = 1 FROM (SELECT /*+ INDEX(rv_heap idx) */ id,tag FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10) q WHERE tag=30;
--source mysql_test/include/wait_condition.inc
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
connection rr_reader;
--echo # A must retain its snapshot after B's delete and warmup
SELECT id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') LIMIT 10;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
COMMIT;
SELECT /*+ INDEX(rv_heap idx) */ id,tag,v FROM rv_heap ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
disconnect rr_reader;
connection rr_writer;
USE test;
DROP DATABASE vector_index_heap_rr_snapshot;
disconnect rr_writer;
connection default;
