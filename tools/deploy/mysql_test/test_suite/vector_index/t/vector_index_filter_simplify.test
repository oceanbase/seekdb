# owner: ftygu
# owner group: shenzhen
# description: approximate vector index queries simplify redundant filter predicates (issue #1489)

--disable_warnings
drop table if exists t_vfs;
--enable_warnings

create table t_vfs (
  id bigint not null primary key,
  embedding vector(4) not null,
  category int not null,
  age int not null,
  key idx_category(category),
  key idx_age(age)
) organization heap;
insert into t_vfs values
  (1, '[1,0,0,0]', 1, 10), (2, '[0,1,0,0]', 2, 20), (3, '[0.9,0.1,0,0]', 1, 30),
  (4, '[0,0,1,0]', 3, 1000), (5, '[0.8,0.2,0,0]', 1, 500), (6, '[0,0,0,1]', 2, 999),
  (7, '[0.7,0.3,0,0]', 4, 40), (8, '[0.6,0,0.4,0]', 1, 1);
create vector index t_vfs_hnsw on t_vfs(embedding) with (distance=l2, type=hnsw, lib=vsag, m=16, ef_construction=128);

--echo # duplicated OR operands are removed from the pre-filter, as they are for exact queries
--replace_regex /\|[0-9]+ *\|[0-9]+ *\|$/|ROWS|COST|/
explain select id from t_vfs
where category = 1 or age > 1000 or age > 1000 or age > 1000 or age > 1000
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;

--echo # duplicated AND operands
--replace_regex /\|[0-9]+ *\|[0-9]+ *\|$/|ROWS|COST|/
explain select id from t_vfs
where category = 1 and age < 600 and category = 1 and age < 600
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;

--echo # the simplified filters return the same rows as the original ones
select id from t_vfs where category = 1
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;
select id from t_vfs
where category = 1 or age > 1000 or age > 1000 or age > 1000 or age > 1000
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;
select id from t_vfs where category = 1 and age < 600
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;
select id from t_vfs
where category = 1 and age < 600 and category = 1 and age < 600
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;

--echo # exact (non-approximate) queries are unaffected
select id from t_vfs
where category = 1 or age > 1000 or age > 1000
order by l2_distance(embedding, '[1,0,0,0]') limit 3;

drop table t_vfs;
