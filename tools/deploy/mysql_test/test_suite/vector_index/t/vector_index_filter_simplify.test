# Parameter equality constraints must be rechecked on plan reuse.
PREPARE ann_filter_stmt FROM 'SELECT id FROM ann_filter_simplify WHERE category = ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? OR age > ? ORDER BY l2_distance(v, \'[0,0,0]\') APPROXIMATE LIMIT 10';
SET @category = 1, @high = 1000, @low = 25;
EXECUTE ann_filter_stmt USING @category, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high;
EXECUTE ann_filter_stmt USING @category, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @low;
EXECUTE ann_filter_stmt USING @category, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high, @high;
DEALLOCATE PREPARE ann_filter_stmt;
# The comparison budget may be exhausted with many distinct predicates.
# Partial simplification must preserve the remaining conditions and NULLs.
let $or_filter = age > 0;
let $and_filter = category = 1;
let $duplicate_filter = category = 1;
let $counter = 128;
while ($counter)
{
  let $or_filter = $or_filter OR age > $counter;
  let $and_filter = $and_filter AND category = 1;
  let $duplicate_filter = $duplicate_filter OR age > 1000;
  dec $counter;
}
--echo # Distinct OR predicates after exhausting the comparison budget
--disable_query_log
eval SELECT id FROM ann_filter_simplify WHERE $or_filter ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
--enable_query_log
--echo # Repeated top-level AND predicates also simplify
--disable_query_log
--replace_regex /filter_before_indexback\[([a-z]+)\], /filter_before_indexback[\1],/
eval EXPLAIN BASIC SELECT id FROM ann_filter_simplify WHERE $and_filter ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
eval SELECT id FROM ann_filter_simplify WHERE $and_filter ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
--enable_query_log
--echo # The shared deduplication budget also preserves exact search results
--disable_query_log
eval SELECT id FROM ann_filter_simplify WHERE $duplicate_filter ORDER BY l2_distance(v, '[0,0,0]') LIMIT 10;
--enable_query_log
DROP TABLE ann_filter_simplify;
