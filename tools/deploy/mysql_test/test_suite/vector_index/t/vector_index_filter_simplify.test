# SQL three-valued logic, nested predicates, aliases, and offset.
SELECT id FROM ann_filter_simplify
WHERE (category = 1 OR category = 1 OR NULL) AND (age > 0 OR age IS NULL)
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 1, 2;
SELECT id FROM ann_filter_simplify
WHERE NOT (category <> 1 AND category <> 1)
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
SELECT id FROM ann_filter_simplify WHERE category = 1 AND FALSE
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
SELECT id FROM (
  SELECT id, l2_distance(v, '[0,0,0]') AS distance FROM ann_filter_simplify
  WHERE category = 1 OR FALSE OR category = 1
  ORDER BY distance APPROXIMATE LIMIT 2
) AS nearest ORDER BY id;

# A later matching row must not be removed by simplification or plan caching.
INSERT INTO ann_filter_simplify VALUES (9, '[9,0,0]', NULL, 2000);
