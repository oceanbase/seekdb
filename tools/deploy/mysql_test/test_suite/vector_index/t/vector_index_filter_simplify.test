# Regression for #1489: simplify ANN filters without losing vector access.
SET ob_hnsw_ef_search = 64;
CREATE TABLE ann_filter_simplify (
  id INT PRIMARY KEY, v VECTOR(3), category INT, age INT,
  KEY idx_category(category), KEY idx_age(age),
  VECTOR INDEX idx_v(v) WITH (distance=l2, type=hnsw, lib=vsag,
    sync_mode=immediate)
) ORGANIZATION HEAP;
INSERT INTO ann_filter_simplify VALUES
  (1, '[1,0,0]', 1, 10), (2, '[2,0,0]', 2, 20),
  (3, '[3,0,0]', NULL, NULL), (4, '[4,0,0]', 1, NULL),
  (5, '[5,0,0]', NULL, 30), (6, '[6,0,0]', 2, NULL),
  (7, '[7,0,0]', 1, 1000), (8, '[8,0,0]', 2, 40);

# Both the ANN operator and simplified filter are part of the assertion.
--replace_regex /filter_before_indexback\[([a-z]+)\], /filter_before_indexback[\1],/
EXPLAIN BASIC SELECT id FROM ann_filter_simplify
WHERE category = 1 OR FALSE OR category = 1
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
SELECT id FROM ann_filter_simplify WHERE category = 1
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;

# Exceed the former 100-expression cutoff. Keep the nonconstant predicate:
# age > 1000 is false only for the initial data, not a SQL contradiction.
--replace_regex /filter_before_indexback\[([a-z]+)\], /filter_before_indexback[\1],/
EXPLAIN BASIC SELECT id FROM ann_filter_simplify
WHERE category = 1 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000
ORDER BY l2_distance(v, '[0,0,0]') APPROXIMATE LIMIT 10;
SELECT id FROM ann_filter_simplify
WHERE category = 1 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
  age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR age > 1000 OR
