# Regression for issue #1470: positive inner product must use the IP ANN index
# for descending APPROXIMATE order while preserving the SQL score.
--disable_warnings
drop table if exists t_ip_desc_approx;
drop table if exists t_ip_no_index;
drop table if exists t_ip_l2_index;
drop table if exists t_ip_ivf_index;
drop table if exists t_ip_sparse_index;
drop table if exists t_ip_join_indexed;
drop table if exists t_ip_join_plain;
drop table if exists t_ip_join_l2;
--enable_warnings

create table t_ip_desc_approx (
  id int primary key,
  v vector(3),
  vector index idx_ip(v) with (distance=inner_product, type=hnsw, lib=vsag)
);
insert into t_ip_desc_approx values
  (1, '[1,0,0]'), (2, '[0,1,0]'), (3, '[-1,0,0]'),
  (4, '[0.5,0,0]'), (5, null);

--replace_regex /_[0-9]+/_0/g
explain select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') desc approximate limit 3;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') desc approximate limit 3;
--replace_regex /_[0-9]+/_0/g
explain select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') desc approximate limit 4;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') desc approximate limit 4;
--replace_regex /_[0-9]+/_0/g
explain select id from t_ip_desc_approx
  order by negative_inner_product(v, '[1,0,0]') asc approximate limit 3;
select id, negative_inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by negative_inner_product(v, '[1,0,0]') asc approximate limit 3;
--replace_regex /_[0-9]+/_0/g
explain select id from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') desc limit 3;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') desc limit 3;

--replace_regex /_[0-9]+/_0/g
explain select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by score desc approximate limit 3;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by score desc approximate limit 3;
--replace_regex /_[0-9]+/_0/g
explain select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by 2 desc approximate limit 3;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by 2 desc approximate limit 3;

set @query_vector = '[1,0,0]';
prepare ip_plan_stmt from 'explain select id, inner_product(v, ?) as score from t_ip_desc_approx order by score desc approximate limit 3';
--replace_regex /_[0-9]+/_0/g
execute ip_plan_stmt using @query_vector;
deallocate prepare ip_plan_stmt;
prepare ip_stmt from 'select id, inner_product(v, ?) as score from t_ip_desc_approx order by score desc approximate limit 3';
execute ip_stmt using @query_vector;
set @query_vector = '[-1,0,0]';
execute ip_stmt using @query_vector;
deallocate prepare ip_stmt;

--replace_regex /_[0-9]+/_0/g
explain select id from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') asc approximate limit 3;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
  order by inner_product(v, '[1,0,0]') asc approximate limit 3;
select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx order by id;

create table t_ip_no_index (id int primary key, v vector(3));
insert into t_ip_no_index values (1, '[1,0,0]'), (2, '[0,1,0]');
--replace_regex /_[0-9]+/_0/g
explain select id from t_ip_no_index
  order by inner_product(v, '[1,0,0]') desc approximate limit 1;
select id, inner_product(v, '[1,0,0]') as score from t_ip_no_index
  order by inner_product(v, '[1,0,0]') desc approximate limit 1;

create table t_ip_l2_index (
  id int primary key,
  v vector(3),
  vector index idx_l2(v) with (distance=l2, type=hnsw, lib=vsag)
);
insert into t_ip_l2_index values (1, '[1,0,0]'), (2, '[0,1,0]');
--replace_regex /_[0-9]+/_0/g
explain select id from t_ip_l2_index
  order by inner_product(v, '[1,0,0]') desc approximate limit 1;
select id, inner_product(v, '[1,0,0]') as score from t_ip_l2_index
  order by inner_product(v, '[1,0,0]') desc approximate limit 1;

create table t_ip_ivf_index (
  id int primary key,
  v vector(3),
  vector index idx_ivf(v) with (distance=inner_product, type=ivf_flat)
);
insert into t_ip_ivf_index values (1, '[1,0,0]'), (2, '[0,1,0]'), (3, '[0.5,0,0]');
--replace_regex /_[0-9]+/_0/g
explain select id, inner_product(v, '[1,0,0]') as score from t_ip_ivf_index
  order by inner_product(v, '[1,0,0]') desc approximate limit 2;
select id, inner_product(v, '[1,0,0]') as score from t_ip_ivf_index
  order by inner_product(v, '[1,0,0]') desc approximate limit 2;

create table t_ip_sparse_index (
  id int primary key,
  v sparsevector,
  vector index idx_sparse(v) with (distance=inner_product, type=sindi, lib=vsag)
);
insert into t_ip_sparse_index values (1, '{1:1}'), (2, '{2:1}'), (3, '{1:0.5}');
--replace_regex /_[0-9]+/_0/g
explain select id, inner_product(v, '{1:1}') as score from t_ip_sparse_index
  order by inner_product(v, '{1:1}') desc approximate limit 2;
select id, inner_product(v, '{1:1}') as score from t_ip_sparse_index
  order by inner_product(v, '{1:1}') desc approximate limit 2;

# The indexed column of a different join table must not qualify b.v for ANN.
create table t_ip_join_indexed (
  id int primary key,
  v vector(3),
  vector index idx_ip(v) with (distance=inner_product, type=hnsw, lib=vsag)
);
create table t_ip_join_plain (id int primary key, v vector(3));
create table t_ip_join_l2 (
  id int primary key,
  v vector(3),
  vector index idx_l2(v) with (distance=l2, type=hnsw, lib=vsag)
);
insert into t_ip_join_indexed values (1, '[1,0,0]'), (2, '[0.5,0,0]'), (3, '[-1,0,0]');
insert into t_ip_join_plain values (1, '[1,0,0]'), (2, '[0.5,0,0]'), (3, '[-1,0,0]');
insert into t_ip_join_l2 values (1, '[1,0,0]'), (2, '[0.5,0,0]'), (3, '[-1,0,0]');
--replace_regex /_[0-9]+/_0/g
explain select a.v, b.id, inner_product(b.v, '[1,0,0]') as score
  from t_ip_join_indexed a join t_ip_join_plain b on a.id = b.id
  order by score desc approximate limit 2;
select a.v, b.id, inner_product(b.v, '[1,0,0]') as score
  from t_ip_join_indexed a join t_ip_join_plain b on a.id = b.id
  order by score desc approximate limit 2;
--replace_regex /_[0-9]+/_0/g
explain select a.v, b.id, inner_product(b.v, '[1,0,0]') as score
  from t_ip_join_indexed a join t_ip_join_l2 b on a.id = b.id
  order by score desc approximate limit 2;
select a.v, b.id, inner_product(b.v, '[1,0,0]') as score
  from t_ip_join_indexed a join t_ip_join_l2 b on a.id = b.id
  order by score desc approximate limit 2;

drop table t_ip_join_l2;
drop table t_ip_join_plain;
drop table t_ip_join_indexed;
drop table t_ip_sparse_index;
drop table t_ip_ivf_index;
drop table t_ip_l2_index;
drop table t_ip_no_index;
drop table t_ip_desc_approx;
