# Regression for #1469: shared DDL must escape column identifiers without SQL dependencies.
connect (conn_user,$OBMYSQL_MS0,root,,test,$OBMYSQL_PORT);
connection conn_user;

--disable_warnings
DROP TABLE IF EXISTS ddl_identifier_layering;
--enable_warnings
CREATE TABLE ddl_identifier_layering (
  id INT PRIMARY KEY,
  `e``name` ENUM('a', 'b'),
  `s``name` SET('x', 'y'),
  plain ENUM('a', 'b')
);
INSERT INTO ddl_identifier_layering VALUES (1, 'a', 'x', 'a'), (2, 'b', 'y', 'b');
# Unique index DDL generates unsigned casts and shadow aliases for enum/set columns.
CREATE UNIQUE INDEX idx_escaped_enum ON ddl_identifier_layering (`e``name`);
CREATE UNIQUE INDEX idx_escaped_set ON ddl_identifier_layering (`s``name`);
CREATE UNIQUE INDEX idx_plain_enum ON ddl_identifier_layering (plain);
SELECT id, `e``name`, `s``name`, plain FROM ddl_identifier_layering ORDER BY id;
SELECT id FROM ddl_identifier_layering FORCE INDEX (idx_escaped_enum) WHERE `e``name` = 'b';
SELECT id FROM ddl_identifier_layering FORCE INDEX (idx_escaped_set) WHERE `s``name` = 'x';
DROP TABLE ddl_identifier_layering;
disconnect conn_user;
