# Regression: quote identifiers in vector maintenance SQL.
# Use fresh dedicated databases; do not overwrite existing data.
# The independent backtick-partition rebuild/CREATE leads are not this regression.

SET ob_enable_index_direct_select = 1;
SET ob_query_timeout = 20000000;
SET ob_trx_timeout = 60000000;
CREATE DATABASE `seekdb_identifier_quoting`;

# plain
USE `seekdb_identifier_quoting`;
CREATE TABLE `c1_plain` (`id` INT PRIMARY KEY, v VECTOR(3),
  VECTOR INDEX `idx`(v) WITH (distance=l2,type=hnsw,lib=vsag));
INSERT INTO `c1_plain` VALUES (1,'[1,0,0]'),(2,'[0,1,0]'),(3,'[0,0,1]');
SET @c1_table_id = (SELECT table_id FROM oceanbase.__all_table WHERE table_name = 'c1_plain'
  AND database_id = (SELECT database_id FROM oceanbase.__all_database WHERE database_name = DATABASE()));
SET @c1_index_name = 'idx';
SET @c1_prefix = CONCAT('`', REPLACE(DATABASE(), '`', '``'),
  '`.`__idx_', @c1_table_id, '_', REPLACE(@c1_index_name, '`', '``'));
SET @c1_delta_sql = CONCAT('SELECT COUNT(*) AS delta_rows FROM ', @c1_prefix, '`');
SET @c1_ids_sql = CONCAT('SELECT COUNT(*) AS index_id_rows FROM ', @c1_prefix, '_index_id_table`');
PREPARE c1_delta FROM @c1_delta_sql;
PREPARE c1_ids FROM @c1_ids_sql;
EXECUTE c1_delta;
EXECUTE c1_ids;
CALL dbms_vector.refresh_index('idx','c1_plain','v',1,'FAST');
EXECUTE c1_delta;
EXECUTE c1_ids;
DEALLOCATE PREPARE c1_delta;
DEALLOCATE PREPARE c1_ids;
SELECT `id` AS id,v FROM `c1_plain` ORDER BY `id`;
CALL dbms_vector.rebuild_index('idx','c1_plain','v');
CALL dbms_vector.rebuild_index('idx','c1_plain','v',0);
SELECT `id` AS id,v FROM `c1_plain` ORDER BY `id`;

# partition_plain
USE `seekdb_identifier_quoting`;
CREATE TABLE `c1_partition_plain` (`id` INT PRIMARY KEY, v VECTOR(3),
  VECTOR INDEX `idx`(v) WITH (distance=l2,type=hnsw,lib=vsag))
PARTITION BY RANGE COLUMNS(`id`)
(PARTITION p0 VALUES LESS THAN (3), PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO `c1_partition_plain` VALUES (1,'[1,0,0]'),(2,'[0,1,0]'),(3,'[0,0,1]');
SET @c1_table_id = (SELECT table_id FROM oceanbase.__all_table WHERE table_name = 'c1_partition_plain'
  AND database_id = (SELECT database_id FROM oceanbase.__all_database WHERE database_name = DATABASE()));
SET @c1_index_name = 'idx';
SET @c1_prefix = CONCAT('`', REPLACE(DATABASE(), '`', '``'),
  '`.`__idx_', @c1_table_id, '_', REPLACE(@c1_index_name, '`', '``'));
SET @c1_delta_sql = CONCAT('SELECT COUNT(*) AS delta_rows FROM ', @c1_prefix, '`');
SET @c1_ids_sql = CONCAT('SELECT COUNT(*) AS index_id_rows FROM ', @c1_prefix, '_index_id_table`');
PREPARE c1_delta FROM @c1_delta_sql;
PREPARE c1_ids FROM @c1_ids_sql;
EXECUTE c1_delta;
EXECUTE c1_ids;
CALL dbms_vector.refresh_index('idx','c1_partition_plain','v',1,'FAST');
EXECUTE c1_delta;
EXECUTE c1_ids;
DEALLOCATE PREPARE c1_delta;
DEALLOCATE PREPARE c1_ids;
SELECT `id` AS id,v FROM `c1_partition_plain` ORDER BY `id`;
CALL dbms_vector.rebuild_index('idx','c1_partition_plain','v');
CALL dbms_vector.rebuild_index('idx','c1_partition_plain','v',0);
SELECT `id` AS id,v FROM `c1_partition_plain` ORDER BY `id`;

