# SEEK-1510: rebuilding a manual hybrid index must preserve pending deletes.
--disable_query_log
set session ob_enable_index_direct_select=1;
--disable_warnings
drop table if exists seek1510_rebuild_null;
--enable_warnings
let $embedding_url= $SEEKDB_TEST_EMBEDDING_URL;
CALL DBMS_AI_SERVICE.CREATE_AI_MODEL('seek1510_embedding_model', '{"type":"dense_embedding","model_name":"text-embedding-v3"}');
eval SET @endpoint_config= '{"ai_model_name":"seek1510_embedding_model","url":"$embedding_url","access_key":"test-only-key","request_model_name":"text-embedding-v3","provider":"ALIYUN-OPENAI"}';
CALL DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('seek1510_embedding_endpoint', @endpoint_config);
--enable_query_log
create table seek1510_rebuild_null(pk bigint primary key, body varchar(200)) ORGANIZATION INDEX;
insert into seek1510_rebuild_null values(2,'e');
create vector index seek1510_idx on seek1510_rebuild_null(body) with(distance=inner_product,lib=vsag,type=hnsw_bq,model=seek1510_embedding_model,dim=1024,sync_mode=manual);
# Complete initial adapter loading before creating the pending I/D pair.
call dbms_vector.rebuild_index('seek1510_idx','seek1510_rebuild_null','body',0);
update seek1510_rebuild_null set body='pending' where pk=2;
update seek1510_rebuild_null set body=NULL where pk=2;
call dbms_vector.rebuild_index('seek1510_idx','seek1510_rebuild_null','body',0);
--disable_query_log
let $base_table_id= `select table_id from oceanbase.__all_table where table_name='seek1510_rebuild_null' and database_id=(select database_id from oceanbase.__all_database where database_name=database())`;
let $log_table= `select concat('__idx_', $base_table_id, '_seek1510_idx')`;
eval select count(*) as pending_log_records from $log_table;
--enable_query_log
call dbms_vector.refresh_index('seek1510_idx','seek1510_rebuild_null','body',0);
select pk,body from seek1510_rebuild_null;
--disable_query_log
eval select count(*) as consumed_log_records from $log_table;
--enable_query_log
update seek1510_rebuild_null set body='restored' where pk=2;
call dbms_vector.refresh_index('seek1510_idx','seek1510_rebuild_null','body',0);
