INSERT INTO ann_range_1534 VALUES (8,20,0,8,'20','[8,0,0]');
INSERT INTO ann_range_1534 VALUES (9,21,1,9,'21','[9,0,0]');
INSERT INTO ann_range_1534 VALUES (10,30,2,10,'30','[10,0,0]');
INSERT INTO ann_range_1534 VALUES (11,9223372036854775807,3,11,'9223372036854775807','[11,0,0]');
INSERT INTO ann_range_1534 VALUES (12,-9223372036854775808,0,12,'-9223372036854775808','[12,0,0]');
CREATE VECTOR INDEX idx_vec ON ann_range_1534(embedding) WITH (distance=l2,type=hnsw,lib=vsag,m=16,ef_construction=64,sync_mode=immediate);
SET @saved_ef_search = @@ob_hnsw_ef_search;
SET ob_hnsw_ef_search=64;
--echo # Exact eligible IDs: original
SELECT id FROM ann_range_1534 WHERE age < 10 ORDER BY id;
--echo # Exact eligible IDs: balanced 129-term conjunction
