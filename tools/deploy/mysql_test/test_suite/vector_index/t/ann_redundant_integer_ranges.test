# Regression for GitHub issue #1534: equivalent ANN integer range predicates.
# Keep results deterministic; do not assert timing on shared CI runners.
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS ann_range_1534;
--enable_warnings
CREATE TABLE ann_range_1534 (id INT PRIMARY KEY, age BIGINT, other_age BIGINT, u BIGINT UNSIGNED, s VARCHAR(32), embedding VECTOR(3), INDEX idx_age(age)) ORGANIZATION=HEAP;
INSERT INTO ann_range_1534 VALUES (0,NULL,0,0,NULL,'[0,0,0]');
INSERT INTO ann_range_1534 VALUES (1,-10,1,1,'-10','[1,0,0]');
INSERT INTO ann_range_1534 VALUES (2,0,2,2,'0','[2,0,0]');
INSERT INTO ann_range_1534 VALUES (3,5,3,3,'5','[3,0,0]');
