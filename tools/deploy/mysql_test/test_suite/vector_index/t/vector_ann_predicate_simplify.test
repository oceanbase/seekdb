--echo #
--echo # Regression test: predicate simplification for HNSW ANN queries
--echo #

DROP TABLE IF EXISTS t_ann_predicate_simplify;

CREATE TABLE t_ann_predicate_simplify (
  id INT,
  category INT,
  age INT,
  embedding VECTOR(3),
  PRIMARY KEY (id),
  VECTOR INDEX idx_hnsw(embedding)
    WITH (distance=l2, type=hnsw, lib=vsag)
);

INSERT INTO t_ann_predicate_simplify VALUES
(1,  1,  20, '[0.10,0.20,0.30]'),
(2,  2,  30, '[0.20,0.30,0.40]'),
(3,  1,  40, '[0.30,0.40,0.50]'),
(4,  2,  50, '[0.40,0.50,0.60]'),
(5,  1,  60, '[0.50,0.60,0.70]'),
(6,  2,  70, '[0.60,0.70,0.80]'),
(7,  1,  80, '[0.70,0.80,0.90]'),
(8,  2,  90, '[0.80,0.90,1.00]'),
(9,  1, 100, '[0.90,1.00,1.10]'),
(10, 2, 110, '[1.00,1.10,1.20]'),
(11, 1, 120, '[1.10,1.20,1.30]'),
(12, 2, 130, '[1.20,1.30,1.40]');

--sleep 5

--echo # Baseline ANN query
EXPLAIN SELECT id
FROM t_ann_predicate_simplify
WHERE category = 1
ORDER BY l2_distance(embedding, [0.1,0.2,0.3]) APPROXIMATE
LIMIT 5;

SELECT id
FROM t_ann_predicate_simplify
WHERE category = 1
ORDER BY l2_distance(embedding, [0.1,0.2,0.3]) APPROXIMATE
LIMIT 5;

