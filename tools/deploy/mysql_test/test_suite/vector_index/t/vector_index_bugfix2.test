#owner: gehao.wh
#owner group: shenzhen
--echo # Vector Index Bugfix: duplicated predicates in an approximate vector query
--echo # issue 1489

--disable_warnings
drop table if exists t_issue1489_dup_pred;
--enable_warnings

create table t_issue1489_dup_pred(
  id bigint not null,
  embedding vector(3) not null,
  category int not null,
  primary key(id),
  vector key idx_embedding(embedding)
    with (distance=l2, type=hnsw, lib=vsag, m=16, ef_construction=128, ef_search=64));

--disable_query_log
--let $row = 0
while ($row < 100)
{
  eval insert into t_issue1489_dup_pred values ($row, '[$row,0,0]', $row);
  --inc $row
}
--enable_query_log

analyze table t_issue1489_dup_pred;
call dbms_stats.set_table_stats('TEST', 'T_ISSUE1489_DUP_PRED', numrows=>200000);

# build a logically equivalent filter: category = 1 OR category = 1 OR ... (16 times)
--let $duplicate_filter = category = 1
--let $loop = 1
while ($loop < 16)
{
  --let $duplicate_filter = $duplicate_filter OR category = 1
  --inc $loop
}

alter system flush plan cache;

# both queries return the same rows, so their results are not interesting here
--disable_query_log
--disable_result_log
select id from t_issue1489_dup_pred
 where category = 1
 order by l2_distance(embedding, '[0,0,0]') approximate limit 5;

eval select id from t_issue1489_dup_pred
 where $duplicate_filter
 order by l2_distance(embedding, '[0,0,0]') approximate limit 5;
--enable_result_log
--enable_query_log

# the duplicated predicates must not prevent the approximate search from using the
# vector index scan: every rewrite that changes the plan shape stays disabled
select count(distinct s.plan_id) as plans_with_vector_scan
  from oceanbase.`V$OB_PLAN_CACHE_PLAN_STAT` s
  join oceanbase.__all_virtual_sql_plan p on p.plan_id = s.plan_id
 where instr(s.statement, 't_issue1489_dup_pred') > 0
   and p.operator like 'VECTOR INDEX ADAPTIVE SCAN%';

# and the duplicated terms must be folded into one predicate, exactly like the query
# that spells the predicate once.  Before the fix these were two different filters and
# every candidate row produced by the vector scan was tested 16 times instead of once
select count(distinct p.filter_predicates) as distinct_filters
  from oceanbase.`V$OB_PLAN_CACHE_PLAN_STAT` s
  join oceanbase.__all_virtual_sql_plan p on p.plan_id = s.plan_id
 where instr(s.statement, 't_issue1489_dup_pred') > 0
   and p.operator like 'VECTOR INDEX ADAPTIVE SCAN%';

drop table t_issue1489_dup_pred;
alter system set vector_memory_limit = 0;
