# Regression for #1535: approximate searches must simplify scalar predicates.
# EXPLAIN verifies the redundant filter is removed, without timing assertions.
--disable_warnings
DROP TABLE IF EXISTS vector_absorption_t;
--enable_warnings
CREATE TABLE vector_absorption_t (
  id INT PRIMARY KEY,
  embedding VECTOR(3),
  category INT,
  parity VARCHAR(8),
  INDEX idx_category(category),
  VECTOR INDEX idx_vec(embedding)
    WITH (distance=l2, type=hnsw, lib=vsag, sync_mode=immediate)
) ORGANIZATION HEAP;
INSERT INTO vector_absorption_t VALUES
  (1, '[1,0,0]', 1, 'odd'),
  (2, '[2,0,0]', 2, 'even'),
  (3, '[3,0,0]', 1, 'even'),
  (4, '[4,0,0]', 2, 'odd'),
  (5, '[5,0,0]', NULL, 'even'),
  (6, '[6,0,0]', 1, NULL),
  (7, '[7,0,0]', NULL, NULL),
  (8, '[8,0,0]', NULL, 'odd');

--echo # P AND (P OR Q) reduces to P and keeps the vector index access path.
--replace_regex /rowset=[0-9]+/rowset=N/ /, +/,/
EXPLAIN BASIC SELECT /*+ INDEX(t idx_category) */ id FROM vector_absorption_t t
WHERE category = 1 AND (category = 1 OR parity = 'even')
ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 10;
SELECT id FROM vector_absorption_t
WHERE category = 1 AND (category = 1 OR parity = 'even')
ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 10;

--echo # P OR (P AND Q) also preserves SQL NULL semantics.
SELECT id FROM vector_absorption_t
WHERE category = 1 OR (category = 1 AND parity = 'even')
ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 10;

--echo # A balanced tree of 1024 OR branches must produce the same small plan.
--let $branch = (category = 1 OR parity = 'even')
--let $depth = 10
while ($depth)
{
  --let $branch = ($branch) AND ($branch)
  --dec $depth
}
--disable_query_log
--replace_regex /rowset=[0-9]+/rowset=N/ /, +/,/
eval EXPLAIN BASIC SELECT /*+ INDEX(t idx_category) */ id FROM vector_absorption_t t WHERE category = 1 AND ($branch) ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 10;
eval SELECT id FROM vector_absorption_t WHERE category = 1 AND ($branch) ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 10;
--enable_query_log

--echo # Different predicates must not be absorbed.
SELECT id FROM vector_absorption_t
WHERE category = 1 AND (category = 2 OR parity = 'even')
ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 10;

--echo # Reused prepared statements must respect parameter equality constraints.
PREPARE absorption_stmt FROM
'SELECT id FROM vector_absorption_t WHERE category = ? AND (category = ? OR parity = ?) ORDER BY l2_distance(embedding, ''[0,0,0]'') APPROXIMATE LIMIT 10';
SET @p = 1, @other = 1, @q = 'even';
EXECUTE absorption_stmt USING @p, @other, @q;
SET @other = 2;
EXECUTE absorption_stmt USING @p, @other, @q;
SET @p = 2;
EXECUTE absorption_stmt USING @p, @other, @q;
SET @p = NULL, @other = NULL;
EXECUTE absorption_stmt USING @p, @other, @q;
DEALLOCATE PREPARE absorption_stmt;
DROP TABLE vector_absorption_t;
