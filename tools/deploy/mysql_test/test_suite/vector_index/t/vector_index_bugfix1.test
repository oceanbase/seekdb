order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 20 and age <= 10
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
--replace_regex /filter_before_indexback(\[[a-z,]+\],) +/filter_before_indexback\1/
explain basic select /*+ index(t idx_age) */ id from t_ann1534 t where 20 > age and 10 > age and age >= 1 and age >= 5 and age > 5
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where 20 > age and 10 > age and age >= 1 and age >= 5 and age > 5
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;

--echo # Different columns, OR, contradiction and nullable rows.
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 and other_age < 10
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 or age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 and age > 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where (age < 10 and age < 20) or age is null
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < null and age < 10
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;

--echo # Explicitly disabled transformations must retain both filters.
--replace_regex /filter_before_indexback(\[[a-z,]+\],) +/filter_before_indexback\1/
explain basic select /*+ no_rewrite index(t idx_age) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
set @saved_transformation = @@ob_enable_transformation;
set ob_enable_transformation = 0;
--replace_regex /filter_before_indexback(\[[a-z,]+\],) +/filter_before_indexback\1/
explain basic select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
set ob_enable_transformation = @saved_transformation;

--echo # Prepared plans: reverse endpoint order, equal endpoints, NULL and types.
prepare ranges from 'select /*+ index(t idx_age) */ id from t_ann1534 t where age <= ? and age < ? order by l2_distance(embedding, ''[0,0,0]'') approximate limit 9';
set @a = 10, @b = 20;
execute ranges using @a, @b;
set @a = 20, @b = 5;
execute ranges using @a, @b;
set @a = 10, @b = 10;
execute ranges using @a, @b;
set @a = null, @b = 20;
execute ranges using @a, @b;
set @a = 20, @b = null;
execute ranges using @a, @b;
set @a = '20', @b = '5';
execute ranges using @a, @b;
set @a = 18446744073709551615, @b = 10;
execute ranges using @a, @b;
deallocate prepare ranges;

--echo # Automatic parameterization must revalidate endpoint ordering too.
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 20 and age < 5
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
--echo # Unsupported endpoint types and casts preserve SQL comparison behavior.
select /*+ index(t idx_age) */ id from t_ann1534 t where cast(age as unsigned) < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10.5 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 18446744073709551615 and age < 10
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;

--echo # Vector-index hint and nested Top-K keep the same result boundaries.
--replace_regex /filter_before_indexback(\[[a-z,]+\],) +/filter_before_indexback\1/
explain basic select /*+ index(t idx_vec) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select /*+ index(t idx_vec) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 9;
select id from (
  select /*+ index(t idx_age) */ id, age from t_ann1534 t
  where age < 10 and age < 20
  order by l2_distance(embedding, '[0,0,0]') approximate limit 3
) v where age >= 5 order by id;
select /*+ index(t idx_age) */ id from t_ann1534 t where age < 10 and age < 20
order by l2_distance(embedding, '[0,0,0]') approximate limit 2 offset 2;
drop table t_ann1534;


alter system set vector_memory_limit = 0;
