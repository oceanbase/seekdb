drop table if exists t_vfs;
create table t_vfs (
id bigint not null primary key,
embedding vector(4) not null,
category int not null,
age int not null,
key idx_category(category),
key idx_age(age)
) organization heap;
insert into t_vfs values
(1, '[1,0,0,0]', 1, 10), (2, '[0,1,0,0]', 2, 20), (3, '[0.9,0.1,0,0]', 1, 30),
(4, '[0,0,1,0]', 3, 1000), (5, '[0.8,0.2,0,0]', 1, 500), (6, '[0,0,0,1]', 2, 999),
(7, '[0.7,0.3,0,0]', 4, 40), (8, '[0.6,0,0.4,0]', 1, 1);
create vector index t_vfs_hnsw on t_vfs(embedding) with (distance=l2, type=hnsw, lib=vsag, m=16, ef_construction=128);
# duplicated OR operands are removed from the pre-filter, as they are for exact queries
explain select id from t_vfs
where category = 1 or age > 1000 or age > 1000 or age > 1000 or age > 1000
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;
Query Plan
========================================================================
|ID|OPERATOR                               |NAME |EST.ROWS|EST.TIME(us)|
------------------------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t_vfs|ROWS|COST|
========================================================================
Outputs & filters:
-------------------------------------
  0 - output([t_vfs.id]), filter([t_vfs.category = 1 OR t_vfs.age > 1000]), rowset=16
      access([t_vfs.__pk_increment], [t_vfs.category], [t_vfs.age], [t_vfs.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[false], 
      range_key([t_vfs.__pk_increment]), range(MIN ; MAX)always true
# duplicated AND operands
explain select id from t_vfs
where category = 1 and age < 600 and category = 1 and age < 600
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;
Query Plan
======================================================================================
|ID|OPERATOR                               |NAME               |EST.ROWS|EST.TIME(us)|
--------------------------------------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t_vfs(idx_category)|ROWS|COST|
======================================================================================
Outputs & filters:
-------------------------------------
  0 - output([t_vfs.id]), filter([t_vfs.age < 600], [t_vfs.category = 1]), rowset=16
      access([t_vfs.__pk_increment], [t_vfs.category], [t_vfs.age], [t_vfs.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[false,true], 
      range_key([t_vfs.category], [t_vfs.__pk_increment]), range(1,MIN ; 1,MAX)
# the simplified filters return the same rows as the original ones
select id from t_vfs where category = 1
order by l2_distance(embedding, '[1,0,0,0]') approximate limit 3;
id
1
3
5
