# Prepared statement values may change from repeated to distinct.
PREPARE duplicate_membership FROM 'SELECT /*+ OPT_PARAM(''inlist_rewrite_threshold'', 4) */ COUNT(*) AS matched FROM vector_inlist_duplicates WHERE category IN (?,?,?,?,?,?)';
SET @a=1, @b=2, @c=3, @d=1, @e=2, @f=3;
EXECUTE duplicate_membership USING @a,@b,@c,@d,@e,@f;
matched
3
SET @d=4, @e=5, @f=6;
EXECUTE duplicate_membership USING @a,@b,@c,@d,@e,@f;
matched
6
DEALLOCATE PREPARE duplicate_membership;
DROP TABLE vector_inlist_duplicates;
