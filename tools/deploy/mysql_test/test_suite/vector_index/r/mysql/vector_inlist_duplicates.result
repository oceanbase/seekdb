# NULLs, signed and unsigned boundaries retain SQL membership semantics.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold', 4) */ id
FROM vector_inlist_duplicates WHERE category IN (NULL,1,2,NULL,1,2) ORDER BY id;
id
