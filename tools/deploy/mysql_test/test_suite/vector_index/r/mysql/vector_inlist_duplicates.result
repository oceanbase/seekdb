# Preserve the explicit threshold of one.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold', 1) */ id
FROM vector_inlist_duplicates WHERE category IN (1,1,1)
ORDER BY l2_distance(embedding, '[0,0,0]') APPROXIMATE LIMIT 3;
