DROP TABLE IF EXISTS t_issue1512_regression;
CREATE TABLE t_issue1512_regression (
id INT PRIMARY KEY,
category5 INT,
embedding VECTOR(3),
VECTOR INDEX idx_embedding(embedding)
WITH (
distance=l2,
type=hnsw,
lib=vsag,
m=16,
ef_construction=128,
ef_search=64
)
);
