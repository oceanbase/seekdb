drop table if exists t_cuvs_ddl;
drop table if exists t_cuvs_cos;
drop table if exists t_cuvs_ip;
drop table if exists t_vsag_cos;
drop table if exists t_vsag_ip;
drop table if exists t_cuvs_ivf;
# lib=cuvs is accepted for a dense L2 HNSW vector index
create table t_cuvs_ddl(c1 int primary key, c2 vector(4), vector index idx(c2) with (distance=l2, type=hnsw, lib=cuvs));
# lib=cuvs rejects metrics that the GPU bridge cannot serve
create table t_cuvs_cos(c1 int primary key, c2 vector(4), vector index idx(c2) with (distance=cosine, type=hnsw, lib=cuvs));
ERROR 0A000: lib=cuvs only supports distance=l2 not supported
create table t_cuvs_ip(c1 int primary key, c2 vector(4), vector index idx(c2) with (distance=inner_product, type=hnsw, lib=cuvs));
ERROR 0A000: lib=cuvs only supports distance=l2 not supported
# lib=vsag keeps supporting cosine and inner product
create table t_vsag_cos(c1 int primary key, c2 vector(4), vector index idx(c2) with (distance=cosine, type=hnsw, lib=vsag));
create table t_vsag_ip(c1 int primary key, c2 vector(4), vector index idx(c2) with (distance=inner_product, type=hnsw, lib=vsag));
# lib=cuvs is rejected for IVF indexes (IVF requires lib=OB)
create table t_cuvs_ivf(c1 int primary key, c2 vector(4), vector index idx(c2) with (distance=l2, type=ivf_flat, lib=cuvs));
ERROR 0A000: ivf vector index lib name not equal to 'OB' is not supported
drop table t_cuvs_ddl;
drop table t_vsag_cos;
drop table t_vsag_ip;
