# Non-monotonic and undefined expressions retain their existing behavior.
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age * age > 100;
COUNT(*)
990
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE 1000 / age > 2;
COUNT(*)
499
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age / 0 > 1;
COUNT(*)
0
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age + NULL > 10;
COUNT(*)
0
# Prepared constants can change without changing the executed expression.
PREPARE arithmetic_filter_stmt FROM 'SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age + ? > ?';
SET @shift = 0, @bound = 10;
EXECUTE arithmetic_filter_stmt USING @shift, @bound;
COUNT(*)
990
SET @shift = 2, @bound = 12;
EXECUTE arithmetic_filter_stmt USING @shift, @bound;
COUNT(*)
990
SET @shift = -2, @bound = 8;
EXECUTE arithmetic_filter_stmt USING @shift, @bound;
COUNT(*)
990
SET @shift = NULL;
EXECUTE arithmetic_filter_stmt USING @shift, @bound;
COUNT(*)
0
DEALLOCATE PREPARE arithmetic_filter_stmt;
# A zero multiplier has one value, including strict and inclusive bounds.
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age * 0 >= 0;
COUNT(*)
1000
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age * 0 > 0;
COUNT(*)
0
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age * 0 <= 0;
COUNT(*)
1000
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age * 0 < 0;
COUNT(*)
0
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE 0 * age >= 0;
COUNT(*)
1000
SELECT COUNT(*) FROM arithmetic_filter_sel WHERE CAST(age * 0 AS DECIMAL(20,0)) >= 0;
COUNT(*)
1000
