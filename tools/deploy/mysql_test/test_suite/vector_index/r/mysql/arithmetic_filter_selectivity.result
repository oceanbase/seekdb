      is_index_back=false,is_global_index=false,filter_before_indexback[false],
      range_key([arithmetic_filter_dates.id]),range(MIN ; MAX)always true
DROP TABLE arithmetic_filter_dates;
# Zero, nonzero and NULL multipliers do not change prepared execution semantics.
PREPARE arithmetic_zero_stmt FROM 'SELECT COUNT(*) FROM arithmetic_filter_sel WHERE age * ? >= 0';
SET @multiplier = 0;
EXECUTE arithmetic_zero_stmt USING @multiplier;
COUNT(*)
1000
SET @multiplier = 1;
EXECUTE arithmetic_zero_stmt USING @multiplier;
COUNT(*)
1000
SET @multiplier = -1;
EXECUTE arithmetic_zero_stmt USING @multiplier;
COUNT(*)
0
SET @multiplier = NULL;
EXECUTE arithmetic_zero_stmt USING @multiplier;
COUNT(*)
0
DEALLOCATE PREPARE arithmetic_zero_stmt;
DROP TABLE arithmetic_filter_sel;
DROP TABLE arithmetic_filter_digits;
