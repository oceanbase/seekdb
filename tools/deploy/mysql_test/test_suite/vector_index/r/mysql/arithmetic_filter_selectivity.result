# Existing date bounds keep NULL propagation inside arithmetic too.
CREATE TABLE arithmetic_filter_dates (id INT PRIMARY KEY, d DATE);
INSERT INTO arithmetic_filter_dates
SELECT id, CASE WHEN nullable_age IS NULL THEN NULL ELSE '2025-01-01' END FROM arithmetic_filter_sel;
CALL dbms_stats.gather_table_stats('test', 'arithmetic_filter_dates',
estimate_percent=>100, method_opt=>'for all columns size 1');
SELECT COUNT(*) FROM arithmetic_filter_dates WHERE YEAR(d) + 0 >= 2025;
COUNT(*)
100
EXPLAIN SELECT /*+ NO_REWRITE */ id FROM arithmetic_filter_dates WHERE YEAR(d) + 0 >= 2025;
Query Plan
==================================================================
|ID|OPERATOR       |NAME                   |EST.ROWS|EST.TIME(us)|
------------------------------------------------------------------
|0 |TABLE FULL SCAN|arithmetic_filter_dates|100     |TIME|
==================================================================
Outputs & filters:
-------------------------------------
  0 - output([arithmetic_filter_dates.id]),filter([year(arithmetic_filter_dates.d) + 0 >= 2025]),rowset=256
