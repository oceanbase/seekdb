prepare ann_bounds_stmt from
'select id from t_issue1534 where age < ? and age < ?
   order by l2_distance(embedding, ''[1,0,0]'') approximate limit 10';
set @a = 20, @b = 10;
execute ann_bounds_stmt using @a, @b;
