create table t_ip_desc_approx (
id int primary key,
v vector(3),
vector index idx_ip(v) with (distance=inner_product, type=hnsw, lib=vsag)
);
insert into t_ip_desc_approx values
(1, '[1,0,0]'), (2, '[0,1,0]'), (3, '[-1,0,0]'),
(4, '[0.5,0,0]'), (5, null);
explain select id, inner_product(v, '[1,0,0]') as score from t_ip_desc_approx
order by inner_product(v, '[1,0,0]') desc approximate limit 3;
