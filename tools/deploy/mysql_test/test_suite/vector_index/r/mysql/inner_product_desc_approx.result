create table t_ip_join_indexed (
id int primary key,
v vector(3),
vector index idx_ip(v) with (distance=inner_product, type=hnsw, lib=vsag)
);
create table t_ip_join_plain (id int primary key, v vector(3));
create table t_ip_join_l2 (
id int primary key,
v vector(3),
vector index idx_l2(v) with (distance=l2, type=hnsw, lib=vsag)
);
insert into t_ip_join_indexed values (1, '[1,0,0]'), (2, '[0.5,0,0]'), (3, '[-1,0,0]');
insert into t_ip_join_plain values (1, '[1,0,0]'), (2, '[0.5,0,0]'), (3, '[-1,0,0]');
insert into t_ip_join_l2 values (1, '[1,0,0]'), (2, '[0.5,0,0]'), (3, '[-1,0,0]');
explain select a.v, b.id, inner_product(b.v, '[1,0,0]') as score
from t_ip_join_indexed a join t_ip_join_plain b on a.id = b.id
order by score desc approximate limit 2;
