# Prepared plans: reverse endpoint order, equal endpoints, NULL and types.
prepare ranges from 'select /*+ index(t idx_age) */ id from t_ann1534 t where age <= ? and age < ? order by l2_distance(embedding, ''[0,0,0]'') approximate limit 9';
set @a = 10, @b = 20;
execute ranges using @a, @b;
