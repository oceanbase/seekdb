# empty ranges between adjacent excluded integers are skipped, other ranges are kept
CREATE TABLE t_int (id INT PRIMARY KEY, a INT, b BIGINT, u BIGINT UNSIGNED, d DECIMAL(10,1),
KEY idx_a(a), KEY idx_b(b), KEY idx_u(u), KEY idx_d(d));
INSERT INTO t_int VALUES
(1, 1, -9223372036854775808, 0, 1.0),
(2, 2, -9223372036854775807, 1, 1.5),
(3, 3, -9223372036854775806, 2, 2.0),
(4, 4, 0, 18446744073709551613, 2.5),
(5, 5, 9223372036854775806, 18446744073709551614, 3.0),
(6, NULL, 9223372036854775807, 18446744073709551615, NULL);
EXPLAIN BASIC SELECT /*+ INDEX(t_int idx_a) */ id FROM t_int WHERE a NOT IN (2, 3, 4);
Query Plan
==================================
|ID|OPERATOR        |NAME        |
----------------------------------
|0 |TABLE RANGE SCAN|t_int(idx_a)|
==================================
Outputs & filters:
-------------------------------------
  0 - output([t_int.id]), filter(nil), rowset=16
      access([t_int.id]), partitions(p0)
      is_index_back=false, is_global_index=false, 
      range_key([t_int.a], [t_int.id]), range(NULL,MAX ; 2,MIN), (4,MAX ; MAX,MAX), 
      range_cond([(T_OP_NOT_IN, t_int.a, (2, 3, 4))])
SELECT /*+ INDEX(t_int idx_a) */ id FROM t_int WHERE a NOT IN (2, 3, 4) ORDER BY id;
id
