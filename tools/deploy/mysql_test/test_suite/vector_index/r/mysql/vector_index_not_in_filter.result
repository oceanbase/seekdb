# a decimal column keeps the range between adjacent integers
EXPLAIN BASIC SELECT /*+ INDEX(t_int idx_d) */ id FROM t_int WHERE d NOT IN (1, 2);
Query Plan
==================================
|ID|OPERATOR        |NAME        |
----------------------------------
|0 |TABLE RANGE SCAN|t_int(idx_d)|
==================================
Outputs & filters:
-------------------------------------
  0 - output([t_int.id]), filter(nil), rowset=16
      access([t_int.id]), partitions(p0)
      is_index_back=false, is_global_index=false, 
      range_key([t_int.d], [t_int.id]), range(NULL,MAX ; 1.0,MIN), (1.0,MAX ; 2.0,MIN), (2.0,MAX ; MAX,MAX), 
      range_cond([(T_OP_NOT_IN, t_int.d, (cast(1, DECIMAL_INT(10, 1)), cast(2, DECIMAL_INT(10, 1))))])
SELECT /*+ INDEX(t_int idx_d) */ id FROM t_int WHERE d NOT IN (1, 2) ORDER BY id;
id
