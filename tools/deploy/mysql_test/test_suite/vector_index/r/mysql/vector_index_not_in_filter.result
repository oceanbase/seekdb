# NOT (c IN (...)) also gets ranges when the rewrite is disabled by hint
EXPLAIN BASIC SELECT /*+ NO_REWRITE INDEX(t_ann idx_age) */ id FROM t_ann WHERE NOT (age IN (2, 4, 5, 6)) ORDER BY id;
Query Plan
======================================
|ID|OPERATOR          |NAME          |
--------------------------------------
|0 |SORT              |              |
|1 |└─TABLE RANGE SCAN|t_ann(idx_age)|
======================================
Outputs & filters:
-------------------------------------
  0 - output([t_ann.id]), filter(nil), rowset=16
      sort_keys([t_ann.id, ASC])
  1 - output([t_ann.id]), filter(nil), rowset=16
      access([t_ann.__pk_increment], [t_ann.id]), partitions(p0)
      is_index_back=true, is_global_index=false, 
      range_key([t_ann.age], [t_ann.__pk_increment]), range(NULL,MAX ; 2,MIN), (2,MAX ; 4,MIN), (6,MAX ; MAX,MAX), 
      range_cond([(T_OP_NOT, t_ann.age IN (2, 4, 5, 6))])
SELECT /*+ NO_REWRITE INDEX(t_ann idx_age) */ id FROM t_ann WHERE NOT (age IN (2, 4, 5, 6)) ORDER BY id;
