==========================================================================================
|ID|OPERATOR                               |NAME                   |EST.ROWS|EST.TIME(us)|
------------------------------------------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|t_not_in_range(idx_age)|1       |45          |
==========================================================================================
Outputs & filters:
-------------------------------------
  0 - output([t_not_in_range.id]), filter([(T_OP_NOT_IN, t_not_in_range.age, (2, 3, 4, 5, 6, 7, 8, 9, 10))]), rowset=16
      access([t_not_in_range.__pk_increment], [t_not_in_range.age], [t_not_in_range.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[true], 
      range_key([t_not_in_range.age], [t_not_in_range.__pk_increment]), range(NULL,MAX ; 2,MIN), (2,MAX ; 3,MIN), (3,MAX ; 4,MIN), (4,MAX ; 5,MIN), (5,MAX 
      ; 6,MIN), (6,MAX ; 7,MIN), (7,MAX ; 8,MIN), (8,MAX ; 9,MIN), (9,MAX ; 10,MIN), (10,MAX ; MAX,MAX)
select group_concat(id order by id)
from t_not_in_range
where not (age in (2,3,4,5,6,7,8,9,10));
group_concat(id order by id)
1
select group_concat(id order by id)
from t_not_in_range
where age not in (2,3,4,5,6,7,8,9,10);
group_concat(id order by id)
1
drop table t_not_in_range;
