# Rebinding changes the tightest bound without discarding any predicate.
PREPARE vector_range_stmt FROM 'SELECT id FROM vector_range_filter WHERE age < ? AND age < ? ORDER BY l2_distance(embedding,''[9999,1,0]'') APPROXIMATE LIMIT 5';
SET @bound1=10, @bound2=20;
EXECUTE vector_range_stmt USING @bound1,@bound2;
id
9009
9008
9007
9006
9005
SET @bound1=30, @bound2=4;
EXECUTE vector_range_stmt USING @bound1,@bound2;
id
9003
9002
9001
8003
8002
SET @bound1=NULL, @bound2=20;
EXECUTE vector_range_stmt USING @bound1,@bound2;
id
SET @bound1=1000, @bound2=900;
EXECUTE vector_range_stmt USING @bound1,@bound2;
id
9899
9898
9897
9896
9895
SET @bound1=4, @bound2=30;
EXECUTE vector_range_stmt USING @bound1,@bound2;
id
9003
9002
9001
8003
8002
DEALLOCATE PREPARE vector_range_stmt;
# The vector-index hint starts the adaptive iterative-filter path.
EXPLAIN BASIC SELECT /*+ INDEX(vector_range_filter idx_vector) */ id
FROM vector_range_filter WHERE age < 900 AND age < 1000
ORDER BY l2_distance(embedding,'[9999,1,0]') APPROXIMATE LIMIT 5;
Query Plan
===========================================================================
|ID|OPERATOR                                          |NAME               |
---------------------------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (POST-ITERATIVE-FILTER)|vector_range_filter|
===========================================================================
Outputs & filters:
-------------------------------------
  0 - output([vector_range_filter.id]), filter([vector_range_filter.age < 900], [vector_range_filter.age < 1000]), rowset=256
      access([vector_range_filter.__pk_increment], [vector_range_filter.age], [vector_range_filter.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[false,false],
      range_key([vector_range_filter.__pk_increment]), range(MIN ; MAX)always true
SELECT /*+ INDEX(vector_range_filter idx_vector) */ id
