3000
4000
# Prefix-index ranges are inexact and must retain the full predicate.
EXPLAIN BASIC SELECT /*+ INDEX(vector_range_filter idx_tag) */ id
FROM vector_range_filter WHERE tag='aba'
ORDER BY l2_distance(embedding,'[0,1,0]') APPROXIMATE LIMIT 5;
Query Plan
=========================================================================
|ID|OPERATOR                               |NAME                        |
-------------------------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (PRE-FILTER)|vector_range_filter(idx_tag)|
=========================================================================
Outputs & filters:
-------------------------------------
  0 - output([vector_range_filter.id]), filter([column_conv(VARCHAR,utf8mb4_general_ci,length:2,NOT NULL,substr(vector_range_filter.tag, 1, 2)) = substr('aba',
       1, 2)], [vector_range_filter.tag = 'aba']), rowset=256
      access([vector_range_filter.__pk_increment], [vector_range_filter.tag], [vector_range_filter.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[true,false],
      range_key([vector_range_filter.__substr2_20], [vector_range_filter.__pk_increment]), range(ab,MIN ; ab,MAX)
SELECT /*+ INDEX(vector_range_filter idx_tag) */ id
FROM vector_range_filter WHERE tag='aba'
