# Strict/inclusive boundaries and NULL retain their SQL semantics.
SELECT id FROM vector_range_filter WHERE age > 5 AND age <= 10 AND age < 20
ORDER BY l2_distance(embedding,'[0,1,0]') APPROXIMATE LIMIT 5;
id
6
7
8
9
10
SELECT id FROM vector_range_filter WHERE age < NULL AND age < 20
ORDER BY l2_distance(embedding,'[0,1,0]') APPROXIMATE LIMIT 5;
id
SELECT id FROM vector_range_filter WHERE age IS NULL
ORDER BY l2_distance(embedding,'[0,1,0]') APPROXIMATE LIMIT 5;
id
0
1000
