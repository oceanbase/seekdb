5
# A non-indexed residual predicate must still filter candidates.
SELECT id FROM vector_range_filter WHERE age < 10 AND age < 20 AND flag=0
ORDER BY l2_distance(embedding,'[0,1,0]') APPROXIMATE LIMIT 5;
id
2
