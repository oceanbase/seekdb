================  [10] check data_tpye for show parameters  =================
show parameters where name = 'enable_perf_event';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	True	specifies whether to enable perf event feature. The default value is True.	value	info	DEFAULT	DYNAMIC_EFFECTIVE	True	1
show parameters where name = 'max_string_print_length';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	500	truncate very long string when printing to log file. Range:[0,]	value	info	DEFAULT	DYNAMIC_EFFECTIVE	500	1
show parameters where name = 'default_row_format';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	dynamic	default row format in mysql mode	value	info	DEFAULT	DYNAMIC_EFFECTIVE	dynamic	1
show parameters where name = 'log_disk_size';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	0M	the size of disk space used by the log files. Range: [0, +∞)	value	info	DEFAULT	DYNAMIC_EFFECTIVE	0M	1
show parameters where name = 'rpc_timeout';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	2s	the time during which a RPC request is permitted to execute before it is terminated	value	info	DEFAULT	DYNAMIC_EFFECTIVE	2s	1
show parameters where name = 'enable_perf_event';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	True	specifies whether to enable perf event feature. The default value is True.	value	info	DEFAULT	DYNAMIC_EFFECTIVE	True	1
show parameters where name = 'open_cursors';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	50	specifies the maximum number of open cursors a session can have at once.can use this parameter to prevent a session from opening an excessive number of cursors.Range: [0, 65535] in integer	value	info	DEFAULT	DYNAMIC_EFFECTIVE	50	1
show parameters where name = 'cpu_quota_concurrency';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	10	max allowed concurrency for 1 CPU quota. Range: [1,20]	value	info	DEFAULT	DYNAMIC_EFFECTIVE	10	1
show parameters where name = 'default_row_format';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	dynamic	default row format in mysql mode	value	info	DEFAULT	DYNAMIC_EFFECTIVE	dynamic	1
show parameters where name = 'range_optimizer_max_mem_size';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	128M	to limit the memory consumption for the query range optimizer. Range: [0M,+∞), 0 stands for unlimited	value	info	DEFAULT	DYNAMIC_EFFECTIVE	128M	1
show parameters where name = 'merger_check_interval';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	10s	the time interval between the schedules of the task that checks on the progress of MERGE. Range: [10s, 60m]	value	info	DEFAULT	DYNAMIC_EFFECTIVE	10m	0
show parameters where name = 'major_freeze_duty_time';
svr_type	name	data_type	value	info	section	scope	source	edit_level	default_value	isdefault
observer	server_ip	server_port	02:00	the start time of system daily merge procedure. Range: [00:00, 24:00)	value	info	DEFAULT	DYNAMIC_EFFECTIVE	02:00	1
