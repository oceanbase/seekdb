--disable_warnings
DROP TABLE IF EXISTS fk_missing_child, fk_parent, fk_valid_child, fk_notnull_child;
--enable_warnings
SET @saved_fk_checks = @@SESSION.foreign_key_checks;
SET SESSION foreign_key_checks = 0;
CREATE TABLE fk_missing_child (k INT PRIMARY KEY);
--error 5031
ALTER TABLE fk_missing_child ADD CONSTRAINT fk_update FOREIGN KEY (c) REFERENCES fk_parent(c) ON UPDATE SET NULL;
--error 5031
ALTER TABLE fk_missing_child ADD CONSTRAINT fk_delete FOREIGN KEY (c) REFERENCES fk_parent(c) ON DELETE SET NULL;
--error 5031
ALTER TABLE fk_missing_child ADD CONSTRAINT fk_default FOREIGN KEY (c) REFERENCES fk_parent(c);
--error 5031
ALTER TABLE fk_missing_child ADD CONSTRAINT fk_composite FOREIGN KEY (c, k) REFERENCES fk_parent(c, k) ON UPDATE SET NULL;
SELECT COUNT(*) AS foreign_key_count FROM information_schema.table_constraints
WHERE table_schema = DATABASE() AND table_name = 'fk_missing_child' AND constraint_type = 'FOREIGN KEY';
CREATE TABLE fk_valid_child (c INT);
ALTER TABLE fk_valid_child ADD CONSTRAINT fk_valid FOREIGN KEY (c) REFERENCES fk_parent(c) ON UPDATE SET NULL;
CREATE TABLE fk_notnull_child (c INT NOT NULL);
--error ER_FK_COLUMN_NOT_NULL
ALTER TABLE fk_notnull_child ADD CONSTRAINT fk_notnull FOREIGN KEY (c) REFERENCES fk_parent(c) ON UPDATE SET NULL;
ALTER TABLE fk_missing_child ADD COLUMN c INT;
ALTER TABLE fk_missing_child ADD CONSTRAINT fk_update FOREIGN KEY (c) REFERENCES fk_parent(c) ON UPDATE SET NULL;
SELECT COUNT(*) AS foreign_key_count FROM information_schema.table_constraints
WHERE table_schema = DATABASE() AND table_name = 'fk_missing_child' AND constraint_type = 'FOREIGN KEY';
CREATE TABLE fk_parent (c INT PRIMARY KEY);
DROP TABLE fk_missing_child, fk_valid_child, fk_notnull_child;
CREATE TABLE fk_missing_child (k INT PRIMARY KEY);
--error 5031
ALTER TABLE fk_missing_child ADD CONSTRAINT fk_existing_parent FOREIGN KEY (c) REFERENCES fk_parent(c) ON UPDATE SET NULL;
DROP TABLE fk_missing_child, fk_parent;
SET SESSION foreign_key_checks = @saved_fk_checks;
