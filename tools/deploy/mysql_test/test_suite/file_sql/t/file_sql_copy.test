# owner: database-competition
# owner group: SQL
# description: The copy statement writes the result of a query to a csv file.
# tags: sql,executor,file_sql

--source mysql_test/test_suite/file_sql/include/copy_file_sql_data.inc
--source mysql_test/test_suite/file_sql/include/copy_file_sql_types_data.inc

--disable_query_log
let $FILE_SQL_DATA_DIR = $OBSERVER_DIR/data_for_mysqltest_file_sql;
let $FILE_SQL_TYPES_DIR = $OBSERVER_DIR/data_for_mysqltest_file_sql_types;
--enable_query_log

set session enable_file_sql = ON;

--echo # the result of the query is written to a csv file, the file holds a header
eval copy (select id, name, score, day, created, note
             from read_csv('$FILE_SQL_DATA_DIR/basic.csv')
            order by id)
       to '$FILE_SQL_DATA_DIR/export.csv'
       (format csv, header);

--echo # the file that was written is read back
eval select id, name, score, day, created, replace(note, char(10), '<NL>') as note
       from read_csv('$FILE_SQL_DATA_DIR/export.csv')
      order by id;

--echo # the null values are written as the null string of the copy statement and
--echo # they are read back as null values
eval copy (select id, day from read_csv('$FILE_SQL_DATA_DIR/basic.csv') order by id)
       to '$FILE_SQL_DATA_DIR/nulls.csv'
       (format csv, header, nullstr 'NULL');
eval select id, day from read_csv('$FILE_SQL_DATA_DIR/nulls.csv', nullstr = 'NULL') order by id;

--echo # the copy fails when the file already exists
--disable_result_log
--error 1086
eval copy (select id from read_csv('$FILE_SQL_DATA_DIR/basic.csv'))
       to '$FILE_SQL_DATA_DIR/export.csv'
       (format csv, header);
--enable_result_log

--echo # the file of a copy whose query fails is removed, the copy can be run again
--disable_result_log
--error 4016
eval copy (select id from read_csv('$FILE_SQL_TYPES_DIR/malformed.csv'))
       to '$FILE_SQL_DATA_DIR/broken.csv'
       (format csv, header);
--enable_result_log
eval copy (select id from read_csv('$FILE_SQL_DATA_DIR/basic.csv'))
       to '$FILE_SQL_DATA_DIR/broken.csv'
       (format csv, header);
eval select count(*) as row_count from read_csv('$FILE_SQL_DATA_DIR/broken.csv');

set session enable_file_sql = OFF;
--enable_query_log

--source mysql_test/test_suite/file_sql/include/remove_file_sql_types_data.inc
--source mysql_test/test_suite/file_sql/include/remove_file_sql_data.inc
