# the feature is disabled by default
default_enabled
0
# the options of the reader are named, a positional argument is a syntax error
# only the sample size that scans the whole file is supported
# an unknown option is not supported
# the format option must name the format of the function that reads the file
# the file must exist
# the extension of the file must be the one of the format that reads it
# a file is not read by another function than the one of its format
# the directory that secure_file_priv allows is set
secure_file_priv_is_set
1
# the directory of the files that can be read cannot be changed over a
# network connection, the boundary of the files is kept
# the path is resolved before it is checked, a path that stays inside the
# allowed directory is accepted
row_count
3
