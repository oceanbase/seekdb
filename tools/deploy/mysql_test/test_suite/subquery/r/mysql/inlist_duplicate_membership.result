SET ob_enable_plan_cache = 1;
# Four distinct values at the threshold must retain the VALUES rewrite.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) FULL(t_inlist_dup1512) */ id FROM t_inlist_dup1512 WHERE c IN (1,2,3,4,1,2,3,4);
