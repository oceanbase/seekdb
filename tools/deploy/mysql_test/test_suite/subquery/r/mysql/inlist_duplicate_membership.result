EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) FULL(t_inlist_dup1512) */ id FROM t_inlist_dup1512 WHERE c IN (1,2,3,1,2,3,1,2,3);
