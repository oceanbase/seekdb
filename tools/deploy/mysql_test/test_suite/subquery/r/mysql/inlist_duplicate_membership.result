SET ob_enable_plan_cache = 1;
CREATE TABLE t_inlist_dup1512 (id INT PRIMARY KEY, c BIGINT, u BIGINT UNSIGNED, s VARCHAR(16)) ORGANIZATION = HEAP;
INSERT INTO t_inlist_dup1512 VALUES (1,1,0,'1'),(2,2,1,'2'),(3,3,2,'3'),(4,4,9223372036854775807,'4'),(5,5,9223372036854775808,'01'),(6,NULL,18446744073709551615,NULL),(7,-1,NULL,'1'),(8,-9223372036854775808,3,'-1');
