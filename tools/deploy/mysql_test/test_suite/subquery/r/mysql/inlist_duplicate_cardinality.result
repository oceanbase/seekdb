PREPARE inlist_stmt FROM
'SELECT id FROM inlist_cardinality WHERE v IN (?,?,?,?,?,?) ORDER BY id';
SET @a=1,@b=2,@c=3,@d=1,@e=2,@f=3;
EXECUTE inlist_stmt USING @a,@b,@c,@d,@e,@f;
id
