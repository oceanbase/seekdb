# Literal parameterization and prepared statements retain every slot.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold',4) */ id
FROM inlist_cardinality WHERE v IN (1,2,3,1,2,3) ORDER BY id;
id
1
