# The scalar filter remains attached to the ANN operator.
CREATE TABLE inlist_cardinality_ann (
id INT PRIMARY KEY,
v INT,
embedding VECTOR(3),
VECTOR INDEX inlist_cardinality_idx(embedding)
WITH (distance=l2,type=hnsw,lib=vsag,sync_mode=immediate)
) ORGANIZATION HEAP;
INSERT INTO inlist_cardinality_ann VALUES
(1,1,'[0,0,0]'),(2,2,'[1,0,0]'),(3,3,'[2,0,0]'),
(4,4,'[3,0,0]'),(5,NULL,'[4,0,0]');
EXPLAIN BASIC
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold',4)
INDEX(inlist_cardinality_ann inlist_cardinality_idx) */ id
FROM inlist_cardinality_ann
WHERE v IN (1,2,3,1,2,3)
ORDER BY l2_distance(embedding,'[0,0,0]') APPROXIMATE LIMIT 3;
Query Plan
==============================================================================
|ID|OPERATOR                                          |NAME                  |
------------------------------------------------------------------------------
|0 |VECTOR INDEX ADAPTIVE SCAN (POST-ITERATIVE-FILTER)|inlist_cardinality_ann|
==============================================================================
Outputs & filters:
-------------------------------------
  0 - output([inlist_cardinality_ann.id]), filter([inlist_cardinality_ann.v IN (1, 2, 3, 1, 2, 3)]), rowset=ROWS
      access([inlist_cardinality_ann.__pk_increment], [inlist_cardinality_ann.v], [inlist_cardinality_ann.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[false],
      range_key([inlist_cardinality_ann.__pk_increment]), range(MIN ; MAX)always true
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold',4)
INDEX(inlist_cardinality_ann inlist_cardinality_idx) */ id
FROM inlist_cardinality_ann
