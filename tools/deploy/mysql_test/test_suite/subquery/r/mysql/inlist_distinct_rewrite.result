SELECT COUNT(*) > 0 AS has_matches, COALESCE(MIN(c IN (1,2,3)),0) AS matches_filter FROM (SELECT /*+ OPT_PARAM('inlist_rewrite_threshold', 4) */ id,c FROM inlist_vector WHERE c IN (1,2,3,1,2,3) ORDER BY l2_distance(v,'[0.1,0.2,0.3]') APPROXIMATE LIMIT 3) ann;
