CREATE TABLE inlist_vector (id INT PRIMARY KEY, c INT, v VECTOR(3)) ORGANIZATION HEAP;
INSERT INTO inlist_vector VALUES (1,1,'[1,0,0]'),(2,2,'[2,0,0]'),(3,3,'[3,0,0]'),(4,4,'[4,0,0]'),(5,5,'[5,0,0]'),(6,1,'[6,0,0]');
CREATE VECTOR INDEX inlist_hnsw ON inlist_vector(v) WITH (distance=l2,type=hnsw,lib=vsag,sync_mode=immediate);
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold', 4) */ id FROM inlist_vector WHERE c IN (1,2,3,1,2,3) ORDER BY l2_distance(v,'[0.1,0.2,0.3]') APPROXIMATE LIMIT 3;
