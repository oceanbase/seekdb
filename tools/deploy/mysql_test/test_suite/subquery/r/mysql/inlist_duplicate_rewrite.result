PREPARE inlist_stmt FROM
'SELECT /*+ opt_param(''inlist_rewrite_threshold'' 4) */ id
   FROM t_inlist_duplicate_rewrite
   WHERE category IN (?, ?, ?, ?) ORDER BY id';
SET @a = 1, @b = 1, @c = 1, @d = 1;
EXECUTE inlist_stmt USING @a, @b, @c, @d;
id
1
SET @a = 1, @b = 2, @c = 3, @d = 4;
EXECUTE inlist_stmt USING @a, @b, @c, @d;
id
