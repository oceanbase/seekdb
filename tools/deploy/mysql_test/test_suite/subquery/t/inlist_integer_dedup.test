# Regression for #1512: duplicate integer IN values must not force a values subquery.
--disable_warnings
DROP TABLE IF EXISTS inlist_integer_dedup;
--enable_warnings
CREATE TABLE inlist_integer_dedup(id INT PRIMARY KEY, category BIGINT);
INSERT INTO inlist_integer_dedup VALUES (1,1),(2,2),(3,3),(4,4),(5,NULL),
  (6,-1),(7,9223372036854775807);

# A low threshold exercises the same resolver path as the default 1000-value list.
# EXPLAIN must show a table filter without VALUES TABLE ACCESS or HASH DISTINCT.
--replace_regex /, $/,/
EXPLAIN BASIC SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id
  FROM inlist_integer_dedup WHERE category IN (1,2,3,1,2,3);

# Automatic parameterization: reuse equal positions, then break each duplicate pattern.
SET ob_enable_plan_cache = true;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,2,3,1,2,3) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (2,3,4,2,3,4) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,2,3,4,2,3) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,2,3,1,4,3) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,2,3,1,2,4) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,2,3,1,2,3) ORDER BY id;
SELECT MAX(hit_count) > 0 AS reused_plan FROM oceanbase.`V$OB_PLAN_CACHE_PLAN_STAT`
  WHERE query_sql LIKE '%FROM inlist_integer_dedup%'
    AND query_sql NOT LIKE '%OB_PLAN_CACHE_PLAN_STAT%';

# Explicit prepared binds have no values at prepare time. Recheck on execution/cache reuse.
PREPARE inlist_dedup_ps FROM 'SELECT /*+ opt_param(''inlist_rewrite_threshold'', 4) */ id FROM inlist_integer_dedup WHERE category IN (?,?,?,?,?,?) ORDER BY id';
SET @a=1,@b=2,@c=3,@d=1,@e=2,@f=3;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
SET @a=2,@b=3,@c=4,@d=2,@e=3,@f=4;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
SET @a=1,@b=2,@c=3,@d=4,@e=2,@f=3;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
SET @d=1,@f=4;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
SET @f=NULL;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
SET @a=1,@b=1,@c=1,@d=1,@e=1,@f=1;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
SET @f=4;
EXECUTE inlist_dedup_ps USING @a,@b,@c,@d,@e,@f;
DEALLOCATE PREPARE inlist_dedup_ps;

# NOT IN, signed boundaries, and unsupported list forms preserve SQL semantics.
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category NOT IN (1,2,3,1,2,3) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (-1,9223372036854775807,-1,9223372036854775807) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (-1,1,-1,1) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,1,1,1) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,NULL,1,NULL) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category NOT IN (1,NULL,1,NULL) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,'2',1,'2') ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1.0,2.0,1.0,2.0) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE category IN (1,18446744073709551615,1,18446744073709551615) ORDER BY id;
SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id FROM inlist_integer_dedup
  WHERE (id,category) IN ((1,1),(2,2),(1,1),(2,2)) ORDER BY id;

# If the distinct count still reaches the threshold, retain the values-table path.
--replace_regex /, $/,/
EXPLAIN BASIC SELECT /*+ opt_param('inlist_rewrite_threshold', 4) */ id
  FROM inlist_integer_dedup WHERE category IN (1,2,3,4,1,2);
DROP TABLE inlist_integer_dedup;
