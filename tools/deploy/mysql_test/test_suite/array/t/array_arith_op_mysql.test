select id, arr_int != array_remove([1], 1) from tt where id = 3;
select id, arr_int + null from tt;
select id, arr_int - null from tt;
select id, arr_int = null from tt;
select id, arr_int != null from tt;
select id, arr_dint + [[1]] from tt where id = 6;
select id, arr_dint - [[1]] from tt where id = 6;
select id, arr_dint = [[1]] from tt where id = 6;
select id, arr_dint != [[1]] from tt where id = 6;
select id, arr_dint + array_remove([[1]], [1]) from tt where id = 7;
select id, arr_dint = array_remove([[1]], [1]) from tt where id = 7;
select id, arr_dint != array_remove([[1]], [1]) from tt where id = 7;

