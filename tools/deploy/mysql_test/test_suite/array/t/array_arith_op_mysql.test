--echo # ----------------------------------------------------------------------
--echo # Test of array ddl/dml.
--echo # ----------------------------------------------------------------------

--disable_warnings
drop table if exists t,test,tt0,t2, t1;
--enable_warnings

--error 1235
set @a = [1,2,3,4];
--error 1235
set @a=(select [1,2,3] from dual);
--error 1235
set @a = array(1,2,3,4);
--error 1235
set @a=(select array(1,2,3,4) from dual);

--disable_warnings
drop table if exists arr_t1, arr_t2;
--enable_warnings

--error 1690
select [9223372036854775807] + [1];
--error 1690
select [-9223372036854775808] + [-1];
--error 1690
select [-9223372036854775808] - [1];
--error 1690
select [1.7976931348623157E+308] - [-1.1E+300];
--error 1690
select [1.7976931348623157E+308] + [1.0E+308];

CREATE TABLE arr_t1(c1 int, c2 ARRAY(ARRAY(FLOAT)), c3 ARRAY(ARRAY(FLOAT)), c4 array(int), c5 array(double));
insert into arr_t1 values(1, [[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]],[[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]], [1, 2, 3, 4], [1.33, 2.44, 3.55, 4.66]);
insert into arr_t1 values(2, [[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]],[[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]], [1, 2, 3, 4], [1.33, 2.44, 3.55, 4.66]);
insert into arr_t1 values(3, [[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]],[[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]], [1, 2, 3, 4], [1.33, 2.44, 3.55, 4.66]);
insert into arr_t1 values(4, [[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]],[[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]], [1, 2, 3, 4], [1.33, 2.44, 3.55, 4.66]);
--let $loop=30
while($loop > 0)
{
  insert into arr_t1 values(5, [[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]],[[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]], [1, 2, 3, 4], [1.33, 2.44, 3.55, 4.66]);
  dec $loop;
}

select c2+c3 from arr_t1;
select c4+c5 from arr_t1;
select c3-c2 from arr_t1;
select c2-c3 from arr_t1;
select c5-c4 from arr_t1;
select c4-c5 from arr_t1;
select c2+[[5.55,7.87,44],[66,123.67,95.27],[1.28,3.1415,289.33]] from arr_t1;
select c2-[[1.55,1.87,1.44],[1.66,123.67,1.9527],[1.28,3.1415,2.8933]] from arr_t1;
select c4+[4,3,2,1] from arr_t1;
select c4-[4,3,2,1] from arr_t1;
select [4,3,2,1]+c4 from arr_t1;
select [4,3,2,1]-c4 from arr_t1;

create table arr_t2 select * from arr_t1;
select t1.c2 + t2.c2 from arr_t1 t1, arr_t2 t2;
--error 1235
select @var1 := c2 from arr_t1;

drop table arr_t1;
drop table arr_t2;

--echo # ARRAY_AVG integer boundaries
# Integer AVG returns DOUBLE, so an overflowing 64-bit intermediate sum must
# not reject an average that is representable. Real columns exercise execution.
--disable_query_log

--echo row_avg_at_integer_bounds
SELECT AVG(s)=CAST('4611686018427387904' AS DECIMAL(20,0)) AS signed_ok,
       AVG(u)=CAST('9223372036854775808' AS DECIMAL(20,0)) AS unsigned_ok
FROM (
  SELECT CAST('9223372036854775807' AS SIGNED) AS s,
         CAST('18446744073709551615' AS UNSIGNED) AS u
  UNION ALL SELECT CAST(1 AS SIGNED),CAST(1 AS UNSIGNED)
) AS integer_rows;

--disable_warnings
DROP TABLE IF EXISTS array_avg_integer_bounds;
--enable_warnings
CREATE TABLE array_avg_integer_bounds(id INT PRIMARY KEY,s ARRAY(BIGINT),u ARRAY(BIGINT UNSIGNED),expected_s DOUBLE,expected_u DOUBLE);
INSERT INTO array_avg_integer_bounds VALUES
(1,[9223372036854775807,9223372036854775807],[CAST('18446744073709551615' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)],CAST('9223372036854775807' AS DOUBLE),CAST('18446744073709551615' AS DOUBLE)),
(2,[-9223372036854775808,-9223372036854775808],[CAST('0' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)],CAST('-9223372036854775808' AS DOUBLE),CAST('18446744073709551615' AS DOUBLE)/2),
(3,[-9223372036854775808,9223372036854775807],[CAST('18446744073709551615' AS UNSIGNED),CAST('0' AS UNSIGNED)],-0.5,CAST('18446744073709551615' AS DOUBLE)/2),
(4,[9223372036854775807,-9223372036854775808],[CAST('18446744073709551615' AS UNSIGNED),CAST('1' AS UNSIGNED)],-0.5,CAST('9223372036854775808' AS DOUBLE)),
(5,[9223372036854775807,1],[CAST('18446744073709551615' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED),CAST('0' AS UNSIGNED)],CAST('9223372036854775808' AS DOUBLE)/2,(CAST('18446744073709551615' AS DOUBLE)*2)/3),
(6,[0,-1],[CAST('0' AS UNSIGNED),CAST('1' AS UNSIGNED)],-0.5,0.5),
(7,[1,NULL],[CAST('1' AS UNSIGNED),NULL],0.5,0.5),
(8,NULL,NULL,NULL,NULL),
(9,[NULL,NULL],[NULL,NULL],0,0),
(10,[1,2,3],[CAST('1' AS UNSIGNED),CAST('2' AS UNSIGNED),CAST('3' AS UNSIGNED)],2,2),
(11,[9223372036854775807,9223372036854775807,-9223372036854775808,-9223372036854775808],[CAST('2' AS UNSIGNED),CAST('4' AS UNSIGNED)],-0.5,3),
(12,[-9223372036854775808,-9223372036854775808,9223372036854775807,9223372036854775807],[CAST('4' AS UNSIGNED),CAST('2' AS UNSIGNED)],-0.5,3),
(13,[9223372036854775807,1,-9223372036854775807],[CAST('1' AS UNSIGNED),CAST('2' AS UNSIGNED)],CAST(1 AS DOUBLE)/3,1.5),
(14,[-9223372036854775807,9223372036854775807,1],[CAST('2' AS UNSIGNED),CAST('1' AS UNSIGNED)],CAST(1 AS DOUBLE)/3,1.5);

--echo integer_column_averages
SELECT id,array_avg(s)<=>expected_s AS signed_ok,array_avg(u)<=>expected_u AS unsigned_ok FROM array_avg_integer_bounds ORDER BY id;

--echo scalar_subquery_average
SELECT array_avg((SELECT s FROM array_avg_integer_bounds WHERE id=1))=CAST('9223372036854775807' AS DOUBLE) AS scalar_signed_ok,array_avg((SELECT u FROM array_avg_integer_bounds WHERE id=1))=CAST('18446744073709551615' AS DOUBLE) AS scalar_unsigned_ok;

--echo cancellation_keeps_low_bits
SELECT array_avg(s) AS average FROM array_avg_integer_bounds WHERE id IN (3,4) ORDER BY id;

--echo existing_empty_null_semantics
SELECT array_avg(array_filter((x)->false,s)) IS NULL AS empty_is_null,array_avg(NULL) IS NULL AS null_is_null FROM array_avg_integer_bounds WHERE id=1;

--echo small_integer_and_float_controls
SELECT array_avg([1,2,3])=2 AS small_ok,array_avg([1.5,2.5])=2 AS float_ok;

--echo sum_still_rejects_signed_overflow
--error 1690
SELECT array_sum(s) FROM array_avg_integer_bounds WHERE id=1;
--echo sum_still_rejects_unsigned_overflow
--error 1690
SELECT array_sum(u) FROM array_avg_integer_bounds WHERE id=1;
DROP TABLE array_avg_integer_bounds;
--enable_query_log

--echo # ARRAY_DIFFERENCE integer boundaries
# ARRAY_DIFFERENCE returns signed BIGINT even when its inputs are unsigned.
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS array_difference_unsigned_bounds;
DROP TABLE IF EXISTS array_difference_signed_bounds;
--enable_warnings
CREATE TABLE array_difference_unsigned_bounds(id INT PRIMARY KEY,a ARRAY(BIGINT UNSIGNED));
INSERT INTO array_difference_unsigned_bounds VALUES(1,[CAST('18446744073709551614' AS UNSIGNED),CAST('1' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(2,[CAST('18446744073709551615' AS UNSIGNED),CAST('1' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(3,[CAST('0' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(4,[CAST('18446744073709551615' AS UNSIGNED),CAST('18446744073709551614' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(5,[CAST('18446744073709551614' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(6,[CAST('18446744073709551615' AS UNSIGNED),CAST('9223372036854775807' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(7,[CAST('9223372036854775808' AS UNSIGNED),CAST('0' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(8,[CAST('9223372036854775807' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(9,[CAST('0' AS UNSIGNED),CAST('9223372036854775807' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(10,[CAST('9223372036854775807' AS UNSIGNED),CAST('0' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(11,[CAST('18446744073709551615' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(12,[CAST('18446744073709551615' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(13,NULL);
INSERT INTO array_difference_unsigned_bounds VALUES(14,array_filter((x)->false,[CAST('1' AS UNSIGNED)]));
INSERT INTO array_difference_unsigned_bounds VALUES(15,[CAST('0' AS UNSIGNED),CAST('1' AS UNSIGNED),CAST('2' AS UNSIGNED)]);
INSERT INTO array_difference_unsigned_bounds VALUES(16,[CAST('1' AS UNSIGNED),NULL]);
INSERT INTO array_difference_unsigned_bounds VALUES
  (17,[CAST('9223372036854775807' AS UNSIGNED),
       CAST('9223372036854775808' AS UNSIGNED),
       CAST('9223372036854775807' AS UNSIGNED)]);
--echo unsigned_differences_cross_signed_boundary
SELECT array_difference(a) AS d FROM array_difference_unsigned_bounds WHERE id=17;
--echo unsigned_out_of_range_1
--error 1690
SELECT array_difference(a) FROM array_difference_unsigned_bounds WHERE id=1;
--echo unsigned_out_of_range_2
--error 1690
SELECT array_difference(a) FROM array_difference_unsigned_bounds WHERE id=2;
--echo unsigned_out_of_range_3
--error 1690
SELECT array_difference(a) FROM array_difference_unsigned_bounds WHERE id=3;
--echo unsigned_out_of_range_8
--error 1690
SELECT array_difference(a) FROM array_difference_unsigned_bounds WHERE id=8;
--echo unsigned_representable_differences
SELECT id,array_difference(a) AS d FROM array_difference_unsigned_bounds WHERE id IN (4,5,6,7,9,10,11,12,13,14,15) ORDER BY id;
--echo unsigned_batch_two_rows
SELECT /*+ OPT_PARAM('rowsets_max_rows',2) */ id,array_difference(a) AS d FROM array_difference_unsigned_bounds WHERE id IN (4,5,6,7,9,10,11,12,13,14,15) ORDER BY id;
--echo unsigned_scalar_subquery
SELECT array_difference((SELECT a FROM array_difference_unsigned_bounds WHERE id=6)) AS d;
CREATE TABLE array_difference_signed_bounds(id INT PRIMARY KEY,a ARRAY(BIGINT));
INSERT INTO array_difference_signed_bounds VALUES(1,[CAST('9223372036854775807' AS SIGNED),CAST('-1' AS SIGNED)]);
INSERT INTO array_difference_signed_bounds VALUES(2,[CAST('-9223372036854775808' AS SIGNED),CAST('-1' AS SIGNED)]);
