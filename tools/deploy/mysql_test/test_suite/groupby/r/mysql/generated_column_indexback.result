DROP TABLE IF EXISTS seek545;
result_format: 4
CREATE TABLE seek545 (c1 INT, c0 INT GENERATED ALWAYS AS (c1 + 1) VIRTUAL, KEY idx(c0));

SELECT AVG(DISTINCT t1.c0) af FROM seek545 t1 FORCE INDEX(idx)
JOIN seek545 t2 ON t1.c1 > t2.c1 GROUP BY t1.c0 HAVING af IS NULL;
