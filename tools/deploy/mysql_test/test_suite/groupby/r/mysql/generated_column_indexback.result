DROP TABLE seek545;

CREATE TABLE seek545 (c1 INT,
  c0 INT GENERATED ALWAYS AS (NULLIF(c1, 1) + 1) VIRTUAL, KEY idx(c0));
INSERT INTO seek545(c1) VALUES (-1), (0), (1), (1), (2), (NULL);
SELECT t1.c0, AVG(DISTINCT t1.c0) af FROM seek545 t1 FORCE INDEX(idx)
JOIN seek545 t2 ON t1.c1 > t2.c1 GROUP BY t1.c0 HAVING af IS NULL;
+------+------+
| c0   | af   |
+------+------+
| NULL | NULL |
+------+------+
SELECT t1.c0, AVG(DISTINCT t1.c0) af FROM seek545 t1 FORCE INDEX(idx)
JOIN seek545 t2 ON t1.c1 > t2.c1 GROUP BY t1.c0 HAVING af IS NOT NULL ORDER BY t1.c0;
+------+--------+
| c0   | af     |
+------+--------+
|    1 | 1.0000 |
|    3 | 3.0000 |
+------+--------+
SELECT t1.c0, SUM(DISTINCT t1.c0) s, COUNT(DISTINCT t1.c0) c FROM seek545 t1 FORCE INDEX(idx)
JOIN seek545 t2 ON t1.c1 > t2.c1 GROUP BY t1.c0 ORDER BY t1.c0;
+------+------+------+
| c0   | s    | c    |
+------+------+------+
| NULL | NULL |    0 |
|    1 |    1 |    1 |
|    3 |    3 |    1 |
+------+------+------+
SELECT t1.c0, AVG(DISTINCT t1.c0) af FROM seek545 t1 FORCE INDEX(idx)
JOIN seek545 t2 ON t1.c1 > t2.c1 GROUP BY t1.c0
HAVING (t1.c0 + CASE WHEN t1.c0 IS NULL THEN 1 ELSE 0 END) IS NULL;
+------+------+
| c0   | af   |
+------+------+
| NULL | NULL |
+------+------+
DROP TABLE seek545;
