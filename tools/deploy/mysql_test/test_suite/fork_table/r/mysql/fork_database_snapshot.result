DROP DATABASE IF EXISTS db_fork_snapshot_identity_src;
DROP DATABASE IF EXISTS db_fork_snapshot_identity_dst;
ALTER SYSTEM SET debug_sync_timeout = '60s';
SET ob_global_debug_sync = 'reset';
CREATE DATABASE db_fork_snapshot_identity_src;
CREATE TABLE db_fork_snapshot_identity_src.t1 (
id INT PRIMARY KEY,
v INT,
body TEXT,
KEY idx_v (v)
);
CREATE TABLE db_fork_snapshot_identity_src.t2 (
id INT PRIMARY KEY,
body BLOB
);
INSERT INTO db_fork_snapshot_identity_src.t1 VALUES (1, 10, 'source-one');
INSERT INTO db_fork_snapshot_identity_src.t2 VALUES (2, 'source-two');
SET ob_global_debug_sync = 'FORK_TABLE_BUILD_DATA wait_for fork_snapshot_identity_signal execute 10000';
FORK DATABASE db_fork_snapshot_identity_src TO db_fork_snapshot_identity_dst;
single_shared_snapshot
1
source_destination_versions_diverge
1
complete_acquisition_identity
1
SET ob_global_debug_sync = 'FORK_TABLE_BUILD_DATA clear';
SET ob_global_debug_sync = 'now broadcast fork_snapshot_identity_signal';
remaining_snapshot_rows
0
SELECT 't1' AS table_name, id, v, body FROM db_fork_snapshot_identity_dst.t1 ORDER BY id;
table_name	id	v	body
t1	1	10	source-one
SELECT 't2' AS table_name, id, body FROM db_fork_snapshot_identity_dst.t2 ORDER BY id;
table_name	id	body
t2	2	source-two
SET ob_global_debug_sync = 'reset';
DROP DATABASE db_fork_snapshot_identity_dst;
DROP DATABASE db_fork_snapshot_identity_src;
