# JSON_TYPE must provide a nonnegative result length before CASE type deduction.
# direct case
SELECT CASE WHEN 1=0 THEN JSON_TYPE(CAST('{}' AS JSON)) ELSE JSON_TYPE(CAST('{}' AS JSON)) END;

# json standalone
SELECT JSON_TYPE(CAST('{}' AS JSON));

# derived case
SELECT CASE WHEN 1=0 THEN d.c ELSE d.c END FROM (SELECT JSON_TYPE(CAST('{}' AS JSON)) AS c) d;

# json case OBJECT
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('{}' AS JSON)) ELSE JSON_TYPE(CAST('{}' AS JSON)) END;

# json case ARRAY
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('[]' AS JSON)) ELSE JSON_TYPE(CAST('[]' AS JSON)) END;

# json case NULL
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('null' AS JSON)) ELSE JSON_TYPE(CAST('null' AS JSON)) END;

# json case BOOLEAN
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('true' AS JSON)) ELSE JSON_TYPE(CAST('true' AS JSON)) END;

# json case INTEGER
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('1' AS JSON)) ELSE JSON_TYPE(CAST('1' AS JSON)) END;

# json case DOUBLE
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('1.5' AS JSON)) ELSE JSON_TYPE(CAST('1.5' AS JSON)) END;

# json case UNSIGNED INTEGER
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('9223372036854775808' AS JSON)) ELSE JSON_TYPE(CAST('9223372036854775808' AS JSON)) END;

# json case STRING
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('"x"' AS JSON)) ELSE JSON_TYPE(CAST('"x"' AS JSON)) END;

# sql null
SELECT CASE WHEN 0 THEN JSON_TYPE(NULL) ELSE JSON_TYPE(NULL) END;

# mixed string
SELECT CASE WHEN 1 THEN JSON_TYPE(CAST('{}' AS JSON)) ELSE 'fallback' END;

# coalesce control
SELECT COALESCE(JSON_TYPE(CAST('{}' AS JSON)),JSON_TYPE(CAST('[]' AS JSON)));

# constant control
SELECT CASE WHEN 0 THEN 'OBJECT' ELSE 'OBJECT' END;

# union
SELECT JSON_TYPE(CAST('{}' AS JSON)) UNION ALL SELECT JSON_TYPE(CAST('[]' AS JSON));

# Keep the SQLsmith fixture isolated from other CI cases.
--disable_warnings
DROP DATABASE IF EXISTS json_type_result_length;
--enable_warnings
CREATE DATABASE json_type_result_length;
USE json_type_result_length;
CREATE TABLE account (
  id BIGINT NOT NULL AUTO_INCREMENT,
  tenant_id BIGINT NOT NULL,
  name VARCHAR(128),
  balance DECIMAL(20,4) DEFAULT 0,
  active TINYINT DEFAULT 1,
  created_at TIMESTAMP(6) DEFAULT CURRENT_TIMESTAMP(6),
  PRIMARY KEY (id),
  KEY idx_account_tenant (tenant_id, active)
);

CREATE TABLE orders (
  order_id BIGINT NOT NULL,
  account_id BIGINT NOT NULL,
  status VARCHAR(32),
  amount DECIMAL(18,2),
  note TEXT,
  order_date DATE,
  updated_at DATETIME(6),
  PRIMARY KEY (order_id),
  KEY idx_orders_account (account_id, status)
);

CREATE TABLE inventory (
  sku VARCHAR(64) NOT NULL,
  warehouse_id INT NOT NULL,
  quantity INT,
  price DOUBLE,
  payload JSON,
  PRIMARY KEY (sku, warehouse_id)
);

CREATE TABLE event_log (
  event_id BIGINT NOT NULL AUTO_INCREMENT,
  event_type VARCHAR(64),
  source_ip VARCHAR(64),
  attributes JSON,
  event_time TIMESTAMP(6),
  PRIMARY KEY (event_id),
  KEY idx_event_type_time (event_type, event_time)
);

CREATE TABLE numeric_types (
  id INT NOT NULL,
  c_tiny TINYINT,
  c_small SMALLINT,
  c_int INT,
  c_big BIGINT,
  c_decimal DECIMAL(30,10),
  c_float FLOAT,
  c_double DOUBLE,
  PRIMARY KEY (id)
);

CREATE TABLE string_types (
  id INT NOT NULL,
  c_char CHAR(16),
  c_varchar VARCHAR(512),
  c_binary BINARY(16),
  c_varbinary VARBINARY(512),
  c_text TEXT,
  c_blob BLOB,
  PRIMARY KEY (id)
);

INSERT INTO account (tenant_id, name, balance, active) VALUES
  (1, 'alpha', 100.25, 1), (1, 'beta', -2.50, 0), (2, NULL, 0, 1);
INSERT INTO orders VALUES
  (1, 1, 'new', 12.30, 'first', CURRENT_DATE, NOW(6)),
  (2, 1, 'done', NULL, NULL, CURRENT_DATE, NOW(6));
INSERT INTO inventory VALUES
  ('sku-a', 1, 10, 3.5, '{"color":"red"}'),
  ('sku-b', 2, 0, NULL, NULL);
INSERT INTO numeric_types VALUES
  (1, -1, 2, 3, 4, 5.1234567890, 6.5, 7.25),
  (2, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
INSERT INTO string_types VALUES
  (1, 'fixed', 'variable', X'00112233445566778899AABBCCDDEEFF',
   X'0102', 'text value', X'0304');

# The empty input must not bypass result-type deduction.
SELECT CASE WHEN 95 BETWEEN 60 AND 8 THEN d.c ELSE d.c END FROM (SELECT DISTINCT JSON_TYPE(CAST('{}' AS JSON)) AS c FROM event_log WHERE 34>76 LIMIT 111) d;

