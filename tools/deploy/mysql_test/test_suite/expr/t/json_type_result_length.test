_type_result_length.orders order by 1 desc )  as c5,  case when (( not EXISTS ( select   (select warehouse_id from json_type_result_length.inventory order by 1 limit 1 offset 2)  as c0,  utc_timestamp( ) as c1,  subq_1.c3 as c2,  38 as c3,  ref_11.order_id as c4,  ref_11.status as c5,  subq_1.c1 as c6,  ref_11.account_id as c7 from  json_type_result_length.orders as ref_11 where ref_11.amount <= subq_1.c0 limit 112))  or (cast(null as CHAR) in ( cast(null as CHAR),  "\6\-\V\R%",  cast(null as CHAR))))  and (cast(null as CHAR) like "cast(null as CHAR)%") then subq_1.c5 else subq_1.c2 end  as c6,  cast(coalesce((select note from json_type_result_length.orders order by 1 limit 1 offset 5) , cast(null as CHAR)) as CHAR) as c7,  subq_1.c6 as c8,  utc_date( ) as c9,  subq_1.c1 as c10,  subq_1.c1 as c11,  subq_1.c6 as c12 from  (select   ref_7.id as c0,  ref_7.c_big as c1,  ref_7.c_double as c2,  utc_time( ) as c3,  ref_7.c_big as c4,  ref_7.c_decimal as c5,  ref_7.c_double as c6 from  json_type_result_length.numeric_types as ref_7 where 87 <= any ( select distinct  46 as c0 from  json_type_result_length.string_types as ref_8 where EXISTS ( select   (select id from json_type_result_length.account order by 1 limit 1 offset 72)  as c0,  locate( cast(cast(null as CHAR) as CHAR), cast(cast(null as CHAR) as CHAR) ) as c1,  ref_7.c_tiny as c2,  ref_9.price as c3,  89 as c4,  7 as c5,  case when 7 in ( 34) then 88 else 39 end  as c6,  ref_9.sku as c7,  (select VAR_POP(id) from json_type_result_length.string_types order by 1)  as c8,  52 as c9,  ref_9.quantity as c10,  24 as c11,  ref_9.price as c12,  utc_date( ) as c13,  ref_7.c_decimal as c14 from  json_type_result_length.inventory as ref_9 where 14 in ( select   10 as c0 from  json_type_result_length.account as ref_10 where ref_9.quantity = ref_7.c_small limit 76) limit 138) limit 133) limit 169) as subq_1 where (86 < any ( select   subq_1.c3 as c0 from  json_type_result_length.event_log as ref_12 where ref_12.event_type <= sub