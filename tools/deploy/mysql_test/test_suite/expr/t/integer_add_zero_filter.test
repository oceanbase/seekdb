# Regression for issue #1538: preserve signed integer range estimates for +0.
# Keep projections, mixed types, nonzero constants and dynamic parameters safe.
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS issue1538_integer, issue1538_projection;
--enable_warnings
CREATE TABLE issue1538_integer (
  id INT PRIMARY KEY, n INT, b BIGINT, u BIGINT UNSIGNED,
  d DOUBLE, decval DECIMAL(30,2), s VARCHAR(32));
INSERT INTO issue1538_integer VALUES
  (1,NULL,NULL,NULL,NULL,NULL,NULL),
  (2,-2147483648,-9223372036854775808,0,-1,-1,'-1'),
  (3,-1,-1,1,0,0,'0'), (4,0,0,2,2,2,'2'),
  (5,8,8,8,8,8,'8'), (6,9,9,9,9,9,'9'),
  (7,10,10,10,10,10,'10'), (8,11,11,11,11,11,'0011'),
  (9,100,100,100,100,100,'100'),
  (10,2147483647,9223372036854775807,18446744073709551615,
   9007199254740992,9007199254740993,'9');

--echo # NULLs, narrow integers, BIGINT boundaries, both addition/comparison sides
SELECT SUM(NOT ((((n + 0) + 0) > 10) <=> (n > 10))) AS mismatches
FROM issue1538_integer;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE ((n + 0) + 0) > 10;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE 10 < (0 + (0 + n));
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (b + 0) > 9223372036854775806;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (b + 0) < -9223372036854775807;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer
WHERE ((n + 0) > 10 AND id < 10) OR NOT ((0 + n) >= -1);

--echo # Cached plans preserve nonzero outer and inner arithmetic
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE ((n + 0) + 0) > 10;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE ((n + 2) + 0) > 10;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE ((n + 0) + 2) > 10;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE ((n + 0) + 0) > 10;
PREPARE issue1538_ps FROM 'SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE ((n + ?) + ?) > ?';
SET @issue1538_zero = 0, @issue1538_two = 2, @issue1538_limit = 10;
EXECUTE issue1538_ps USING @issue1538_zero, @issue1538_zero, @issue1538_limit;
EXECUTE issue1538_ps USING @issue1538_two, @issue1538_zero, @issue1538_limit;
EXECUTE issue1538_ps USING @issue1538_zero, @issue1538_two, @issue1538_limit;
DEALLOCATE PREPARE issue1538_ps;

--echo # Mixed types and non-identity expressions retain their SQL semantics
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (s + 0) > 10;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (u + 0) > 9223372036854775807;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (d + 0.0) > 9007199254740991;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (decval + 0) > 9007199254740992;
SELECT COUNT(*) AS matched FROM issue1538_integer WHERE (n + NULL) > 10;
SELECT GROUP_CONCAT(id ORDER BY id) AS ids FROM issue1538_integer WHERE (0 - n) > 10;
CREATE TABLE issue1538_projection AS SELECT n + 0 AS widened FROM issue1538_integer;
SELECT data_type FROM information_schema.columns
WHERE table_schema = DATABASE() AND table_name = 'issue1538_projection' AND column_name = 'widened';
DROP TABLE issue1538_projection;

DROP TABLE issue1538_integer;
--echo # integer add-zero filter regression finished
