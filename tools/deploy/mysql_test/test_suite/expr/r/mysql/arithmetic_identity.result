drop table if exists arithmetic_identity_t;
create table arithmetic_identity_t (
  id int primary key,
  age int,
  key idx_age(age)
);
insert into arithmetic_identity_t values
  (1, null), (2, 0), (3, 10), (4, 11), (5, 100);
select id from arithmetic_identity_t where age > 10 order by id;
id
