SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('{}' AS JSON)) ELSE JSON_TYPE(CAST('{}' AS JSON)) END AS type_name;
type_name
OBJECT
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('9223372036854775808' AS JSON)) ELSE JSON_TYPE(CAST('9223372036854775808' AS JSON)) END AS type_name;
type_name
UNSIGNED INTEGER
WITH cte AS (SELECT JSON_TYPE(CAST('[]' AS JSON)) AS c)
SELECT CASE WHEN 0 THEN d.c ELSE d.c END AS type_name FROM (SELECT c FROM cte) AS d;
type_name
ARRAY
SELECT CASE WHEN 0 THEN d.c ELSE d.c END AS type_name
FROM (SELECT DISTINCT JSON_TYPE(CAST('{}' AS JSON)) AS c WHERE 0) AS d;
type_name
SELECT CASE WHEN 0 THEN JSON_TYPE(NULL) ELSE JSON_TYPE(NULL) END AS type_name;
