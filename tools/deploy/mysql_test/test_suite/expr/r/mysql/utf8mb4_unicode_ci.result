drop table if exists utf8mb4_unicode_ci_test;
drop table if exists utf8mb4_unicode_ci_sort_test;
drop table if exists utf8mb4_unicode_ci_unique_test;
drop table if exists utf8mb4_unicode_ci_regexp_test;
select COLLATION_NAME, CHARACTER_SET_NAME, ID, IS_COMPILED, SORTLEN
from information_schema.COLLATIONS
where COLLATION_NAME = 'utf8mb4_unicode_ci';
COLLATION_NAME	CHARACTER_SET_NAME	ID	IS_COMPILED	SORTLEN
utf8mb4_unicode_ci	utf8mb4	224	Yes	8
select 'A' collate utf8mb4_unicode_ci = 'a' collate utf8mb4_unicode_ci as case_insensitive,
'é' collate utf8mb4_unicode_ci = 'e' collate utf8mb4_unicode_ci as accent_insensitive,
'a' collate utf8mb4_unicode_ci = 'a ' collate utf8mb4_unicode_ci as pad_space,
'ß' collate utf8mb4_unicode_ci = 'ss' collate utf8mb4_unicode_ci as sharp_s_expansion,
'ß' collate utf8mb4_unicode_ci = 's' collate utf8mb4_unicode_ci as sharp_s_not_s,
'Œ' collate utf8mb4_unicode_ci = 'OE' collate utf8mb4_unicode_ci as ligature_expansion,
'ÀÁÅåāă' collate utf8mb4_unicode_ci = 'AAAAAA' collate utf8mb4_unicode_ci as accent_sequence;
case_insensitive	accent_insensitive	pad_space	sharp_s_expansion	sharp_s_not_s	ligature_expansion	accent_sequence
1	1	1	1	0	1	1
select hex(weight_string('ß' collate utf8mb4_unicode_ci)) as sharp_s_weight,
hex(weight_string('ss' collate utf8mb4_unicode_ci)) as ss_weight,
hex(weight_string('café' collate utf8mb4_unicode_ci)) as accented_weight,
hex(weight_string('CAFE' collate utf8mb4_unicode_ci)) as plain_upper_weight;
sharp_s_weight	ss_weight	accented_weight	plain_upper_weight
0FEA0FEA	0FEA0FEA	0E600E330EB90E8B	0E600E330EB90E8B
select weight_string('ß' collate utf8mb4_unicode_ci) =
weight_string('ss' collate utf8mb4_unicode_ci) as expansion_sortkey_equal,
weight_string('café' collate utf8mb4_unicode_ci) =
weight_string('CAFE' collate utf8mb4_unicode_ci) as accent_case_sortkey_equal;
expansion_sortkey_equal	accent_case_sortkey_equal
1	1
create table utf8mb4_unicode_ci_test (
c1 varchar(100),
c2 int
) default charset = utf8mb4 collate = utf8mb4_unicode_ci;
insert into utf8mb4_unicode_ci_test values
('ß', 1), ('s', 2), ('ss', 3),
('cafe', 4), ('caff', 5), ('café', 6);
select c1, c2 from utf8mb4_unicode_ci_test where c1 = 'ß' order by c2;
c1	c2
ß	1
ss	3
select c1, c2 from utf8mb4_unicode_ci_test where c1 like '%ß%' order by c2;
c1	c2
ß	1
select sum(c2) as total from utf8mb4_unicode_ci_test group by c1 order by total;
total
2
4
5
10
update utf8mb4_unicode_ci_test set c2 = 100 where c1 = 'ß';
select count(*) as updated_rows from utf8mb4_unicode_ci_test where c2 = 100;
updated_rows
2
drop table utf8mb4_unicode_ci_test;
create table utf8mb4_unicode_ci_sort_test (
c1 varchar(100)
) default charset = utf8mb4 collate = utf8mb4_unicode_ci;
insert into utf8mb4_unicode_ci_sort_test values
('겄겶'), ('中国'), ('かか'), ('Würzburg'), ('a'), ('café');
select c1 from utf8mb4_unicode_ci_sort_test order by c1;
c1
a
café
Würzburg
かか
中国
겄겶
drop table utf8mb4_unicode_ci_sort_test;
create table utf8mb4_unicode_ci_unique_test (
v varchar(64) collate utf8mb4_unicode_ci,
unique key uk_v(v)
) default charset = utf8mb4 collate = utf8mb4_unicode_ci;
insert into utf8mb4_unicode_ci_unique_test values ('café');
insert into utf8mb4_unicode_ci_unique_test values ('CAFE');
ERROR 23000: Duplicate entry 'CAFE' for key 'uk_v'
select count(*) from utf8mb4_unicode_ci_unique_test;
count(*)
1
drop table utf8mb4_unicode_ci_unique_test;
select regexp_replace(_utf8mb4'abc' collate utf8mb4_unicode_ci, 'a', 'x') as replaced;
replaced
xbc
select regexp_substr(_utf8mb4'abc' collate utf8mb4_unicode_ci, 'b.') as matched;
matched
bc
select hex(regexp_replace(_utf8mb4'中😀国' collate utf8mb4_unicode_ci, '😀', 'é')) as replaced_utf8,
hex(regexp_substr(_utf8mb4'中😀国' collate utf8mb4_unicode_ci, '.', 2, 1)) as matched_utf8;
replaced_utf8	matched_utf8
E4B8ADC3A9E59BBD	F09F9880
select collation(regexp_replace(_utf8mb4'abc' collate utf8mb4_unicode_ci, 'a', 'x')) as replace_collation,
collation(regexp_substr(_utf8mb4'abc' collate utf8mb4_unicode_ci, 'b.')) as substr_collation;
replace_collation	substr_collation
utf8mb4_unicode_ci	utf8mb4_unicode_ci
select length(regexp_replace(_utf8mb4'abc' collate utf8mb4_unicode_ci, 'abc', '')) as empty_length,
regexp_substr(_utf8mb4'abc' collate utf8mb4_unicode_ci, 'z') is null as no_match;
empty_length	no_match
0	1
create table utf8mb4_unicode_ci_regexp_test (
id int primary key,
v varchar(64),
t text
) default charset = utf8mb4 collate = utf8mb4_unicode_ci;
insert into utf8mb4_unicode_ci_regexp_test values
(1, 'Abc', 'Abc'), (2, '中😀国', '中😀国'), (3, '', ''), (4, null, null);
select id, regexp_replace(v, '.', 'X', 2, 1) as replaced_v,
hex(regexp_substr(v, '.', 2, 1)) as matched_v,
regexp_replace(t, '.', 'X', 2, 1) as replaced_t,
hex(regexp_substr(t, '.', 2, 1)) as matched_t
from utf8mb4_unicode_ci_regexp_test where id <= 2 order by id;
id	replaced_v	matched_v	replaced_t	matched_t
1	AXc	62	AXc	62
2	中X国	F09F9880	中X国	F09F9880
select id, hex(regexp_replace(v, '.', 'X')) as replaced_v,
regexp_substr(v, '.') is null as null_v,
hex(regexp_replace(t, '.', 'X')) as replaced_t,
regexp_substr(t, '.') is null as null_t
from utf8mb4_unicode_ci_regexp_test where id >= 3 order by id;
id	replaced_v	null_v	replaced_t	null_t
3		1		1
4	NULL	1	NULL	1
select regexp_replace(v, 'a', 'x') as case_insensitive,
regexp_replace(v, 'a', 'x', 1, 0, 'c') as case_sensitive,
regexp_substr(v, 'a', 1, 1, 'i') as matched_case_insensitive
from utf8mb4_unicode_ci_regexp_test where id = 1;
case_insensitive	case_sensitive	matched_case_insensitive
xbc	Abc	A
drop table utf8mb4_unicode_ci_regexp_test;
set names utf8mb4 collate utf8mb4_unicode_ci;
select @@collation_connection as connection_collation,
collation('Abc') as literal_collation,
regexp_replace('Abc', 'a', 'x') as replaced,
regexp_substr('中😀国', '😀') as matched;
connection_collation	literal_collation	replaced	matched
utf8mb4_unicode_ci	utf8mb4_unicode_ci	xbc	😀
drop database if exists utf8mb4_unicode_ci_ddl;
create database utf8mb4_unicode_ci_ddl default character set utf8mb4 collate utf8mb4_unicode_ci;
use utf8mb4_unicode_ci_ddl;
create table inherited (v varchar(64), b varchar(64) collate utf8mb4_bin);
select default_character_set_name, default_collation_name
from information_schema.schemata where schema_name = database();
default_character_set_name	default_collation_name
utf8mb4	utf8mb4_unicode_ci
select table_collation from information_schema.tables
where table_schema = database() and table_name = 'inherited';
table_collation
utf8mb4_unicode_ci
select column_name, collation_name from information_schema.columns
where table_schema = database() and table_name = 'inherited' order by ordinal_position;
column_name	collation_name
v	utf8mb4_unicode_ci
b	utf8mb4_bin
create table converting (v varchar(64)) default charset = utf8mb4 collate = utf8mb4_general_ci;
insert into converting values ('ß'), ('ss');
select count(distinct v) as general_distinct from converting;
general_distinct
2
alter table converting convert to character set utf8mb4 collate utf8mb4_unicode_ci;
select count(distinct v) as unicode_distinct from converting;
unicode_distinct
1
select table_collation from information_schema.tables
where table_schema = database() and table_name = 'converting';
table_collation
utf8mb4_unicode_ci
select column_name, collation_name from information_schema.columns
where table_schema = database() and table_name = 'converting' order by ordinal_position;
column_name	collation_name
v	utf8mb4_unicode_ci
select v, hex(v) as bytes from converting order by hex(v);
v	bytes
ss	7373
ß	C39F
use test;
drop database utf8mb4_unicode_ci_ddl;
