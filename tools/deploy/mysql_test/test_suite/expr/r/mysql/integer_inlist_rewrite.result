# NULL must preserve three-valued IN and NOT IN semantics.
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where v in (1,NULL,1,NULL,1,NULL) order by id;
id
1
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where v not in (1,NULL,1,NULL,1,NULL) order by id;
id
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where v in (NULL,NULL,NULL,NULL) order by id;
id
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where v not in (1,2,3,1,2,3) order by id;
id
4
5
7
# Unsigned boundary values must not be truncated to signed integers.
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite
where v in (18446744073709551615,18446744073709551615,
18446744073709551615,18446744073709551615) order by id;
id
7
# Strings, decimal literals and row values keep the existing path.
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where v in ('1','2','1','2') order by id;
id
1
2
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where v in (1.5,2.0,1.5,2.0) order by id;
id
2
select /*+ opt_param('inlist_rewrite_threshold', 4) */ id
from integer_inlist_rewrite where (id,v) in ((1,1),(2,2),(1,1),(2,2)) order by id;
id
1
2
# Prepared statements must retain every independently bound parameter.
prepare inlist_stmt from
'select /*+ opt_param(''inlist_rewrite_threshold'', 4) */ id from integer_inlist_rewrite where v in (?,?,?,?,?,?) order by id';
set @a=1, @b=2, @c=3, @d=1, @e=2, @f=3;
execute inlist_stmt using @a,@b,@c,@d,@e,@f;
id
