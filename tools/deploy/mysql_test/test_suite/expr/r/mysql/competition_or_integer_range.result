SELECT id FROM t_competition_or_range
WHERE age = 1 OR age = 2 OR age = 3 OR age = 4 OR age = 5 OR age = 6
   OR age = 7 OR age = 8 OR age = 9 OR age = 10 OR age = 11 OR age = 13
ORDER BY id;
id
