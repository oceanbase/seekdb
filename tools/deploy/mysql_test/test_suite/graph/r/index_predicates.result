FROM GRAPH_TABLE(graph_index_predicates MATCH
(a IS node WHERE a.id=1)
-[e IS link WHERE e.kind='EVOLVES' AND e.tenant=1
AND e.valid_from<=10 AND (e.valid_until IS NULL OR e.valid_until>10)
AND e.enabled=1]->{0,3}(b IS node)
COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g
GROUP BY destination,hops ORDER BY hops,destination;
destination	hops	multiplicity
