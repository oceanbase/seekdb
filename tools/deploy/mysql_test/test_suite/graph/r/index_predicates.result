PREPARE graph_ip_query FROM
'SELECT destination,hops,COUNT(*) AS multiplicity FROM GRAPH_TABLE(graph_index_predicates MATCH (a IS node WHERE a.id=?) -[e IS link WHERE e.kind=? AND e.tenant=? AND e.valid_from<=? AND (e.valid_until IS NULL OR e.valid_until>?) AND e.enabled=1]->{1,3}(b IS node) COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g GROUP BY destination,hops ORDER BY hops,destination';
SET @seed=1,@kind='EVOLVES',@tenant=1,@at=10;
EXECUTE graph_ip_query USING @seed,@kind,@tenant,@at,@at;
destination	hops	multiplicity
