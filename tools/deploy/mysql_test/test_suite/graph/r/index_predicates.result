DROP INDEX graph_ip_out ON graph_ip_edge;
DROP INDEX graph_ip_in ON graph_ip_edge;
CREATE INDEX graph_ip_out ON graph_ip_edge(src,kind,tenant,valid_from,dst);
CREATE INDEX graph_ip_in ON graph_ip_edge(dst,kind,tenant,valid_from,src);
