CREATE TABLE graph_ip_vertex (id INT PRIMARY KEY);
CREATE TABLE graph_ip_edge (
id INT PRIMARY KEY, src INT, dst INT, kind VARCHAR(16), tenant INT,
valid_from INT, valid_until INT, enabled INT
);
INSERT INTO graph_ip_vertex VALUES (1),(2),(3),(4),(7),(8);
INSERT INTO graph_ip_edge VALUES
