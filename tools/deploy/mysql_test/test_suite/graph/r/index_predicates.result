(4,3,4,'EVOLVES',1,0,NULL,1),
(5,7,8,'EVOLVES',1,0,NULL,1),
(10,1,7,'OTHER',1,0,NULL,1),
(11,2,7,'OTHER',1,0,NULL,1),
(12,1,7,'EVOLVES',2,0,NULL,1),
(13,2,7,'EVOLVES',2,0,NULL,1),
(14,1,7,'EVOLVES',1,11,NULL,1),
(15,2,7,'EVOLVES',1,11,NULL,1),
(16,1,7,'EVOLVES',1,0,10,1),
