shortest_bound_goal_and_cross_hop_visited
EXPLAIN INTO plan_table SET statement_id='shortest_goal'
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
(a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=2)
COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
EXPLAIN INTO plan_table SET statement_id='shortest_reach'
SELECT DISTINCT personId FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
(a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person)
COLUMNS(b.id AS personId)) g WHERE personId<>1 ORDER BY personId;
EXPLAIN INTO plan_table SET statement_id='shortest_extra_target'
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
(a IS person WHERE a.id=1)-[e IS knows]->{1,6}
(b IS person WHERE b.id=2 AND b.age>=18)
COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
SELECT COUNT(*)=1 AS bound_goal FROM plan_table
WHERE statement_id='shortest_goal' AND operator='GRAPH FEEDBACK LOOP'
AND special_predicates LIKE '%visited=cross_hop, goal=bound_key%';
bound_goal
1
