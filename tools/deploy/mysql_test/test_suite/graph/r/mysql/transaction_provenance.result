SELECT s.binding,g.endpoint,g.hops,g.edges FROM tp_seed s,LATERAL (
SELECT * FROM GRAPH_TABLE(tp_graph MATCH
(a IS entity WHERE a.tenant=s.tenant AND a.id=3)
<-[e IS fact WHERE e.kind='depends' AND e.valid_from<=2024
AND (e.valid_to IS NULL OR e.valid_to>2024)]-{0,2}(b IS entity)
COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) p) g
ORDER BY s.binding,g.hops;
binding	endpoint	hops	edges
1	3	0	NULL
1	2	1	[11]
1	1	2	[11, 10]
2	3	0	NULL
2	2	1	[11]
2	1	2	[11, 10]
SELECT COUNT(*) AS trail_original_scan_paths FROM tp_seed s,LATERAL (
SELECT * FROM GRAPH_TABLE(tp_graph MATCH TRAIL
(a IS entity WHERE a.tenant=s.tenant AND a.id=s.entity_id)
-[e IS fact WHERE e.kind='depends' AND e.valid_from<=2024
AND (e.valid_to IS NULL OR e.valid_to>2024)]->{0,2}(b IS entity)
COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) p) g;
trail_original_scan_paths
6
own_version_update_and_second_hop_expiry_then_rollback
