SELECT COUNT(*) AS mismatched_bag_groups FROM (
SELECT binding_id,score,destination,hops,edges,SUM(n) AS difference FROM (
SELECT binding_id,score,destination,hops,edges,1 AS n FROM gl_expected
UNION ALL
SELECT binding_id,score,destination,hops,edges,-1 AS n FROM gl_actual
) all_rows GROUP BY binding_id,score,destination,hops,edges HAVING SUM(n)<>0
) differences;
mismatched_bag_groups
0
SELECT * FROM gl_actual ORDER BY binding_id,hops,destination,edges;
binding_id	score	destination	hops	edges
1	10	1	0	NULL
1	10	3	2	[10, 12]
1	10	3	2	[11, 12]
2	20	1	0	NULL
3	30	3	1	[12]
3	30	1	2	[12, 13]
4	40	1	0	NULL
5	50	1	0	NULL
5	50	3	2	[10, 12]
5	50	3	2	[11, 12]
DROP TABLE gl_actual;
SELECT s.binding_id,g.destination,g.hops FROM gl_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)<-[e IS knows WHERE e.since>=s.min_since]-{1,2}
(b IS person WHERE b.age>=s.min_age)
COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g
) g ORDER BY s.binding_id,g.hops,g.destination;
binding_id	destination	hops
1	3	1
2	3	1
5	3	1
SELECT s.binding_id,g.destination FROM gl_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.min_since]->{1}
(b IS person WHERE b.age>=s.min_age) COLUMNS(b.id AS destination)) g
) g ORDER BY s.binding_id,g.destination;
binding_id	destination
3	3
SELECT s.binding_id,g.sn,g.edge_id,g.to_id FROM gl_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.min_since]->{0,2}
(b IS person WHERE b.age>=s.min_age) ONE ROW PER STEP(v1,se,v2)
COLUMNS(ELEMENT_NUMBER(se) AS sn,se.id AS edge_id,v2.id AS to_id)) g
) g ORDER BY s.binding_id,g.sn,g.edge_id,g.to_id;
binding_id	sn	edge_id	to_id
1	NULL	NULL	NULL
1	2	10	2
1	2	11	2
1	4	12	3
1	4	12	3
2	NULL	NULL	NULL
3	2	12	3
3	2	12	3
3	4	13	1
4	NULL	NULL	NULL
5	NULL	NULL	NULL
5	2	10	2
5	2	11	2
5	4	12	3
5	4	12	3
PREPARE gl_cached FROM 'SELECT s.binding_id,g.destination,g.hops FROM gl_seeds s,LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.min_since AND e.since>=?]->{0,2}(b IS person WHERE b.age>=s.min_age) COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g) g ORDER BY s.binding_id,g.hops,g.destination';
SET @since=2020;
EXECUTE gl_cached USING @since;
binding_id	destination	hops
1	1	0
1	3	2
1	3	2
2	1	0
3	3	1
3	1	2
4	1	0
5	1	0
5	3	2
5	3	2
SET @since=2023;
EXECUTE gl_cached USING @since;
binding_id	destination	hops
1	1	0
2	1	0
4	1	0
5	1	0
DEALLOCATE PREPARE gl_cached;
