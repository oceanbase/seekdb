INSERT INTO graph_das_edge VALUES
(1,10,1,1,1,2,1),
(2,20,1,2,2,3,1),
(3,30,2,3,3,4,1),
(4,40,3,4,4,5,1),
(4,41,1,1,2,3,1);
CREATE PROPERTY GRAPH graph_das_access
VERTEX TABLES (
graph_das_vertex KEY (tenant,id)
LABEL item PROPERTIES (tenant,id,kind,payload)
)
EDGE TABLES (
graph_das_edge KEY (tenant,id)
SOURCE KEY (src_tenant,src)
REFERENCES graph_das_vertex (tenant,id)
DESTINATION KEY (dst_tenant,dst)
REFERENCES graph_das_vertex (tenant,id)
LABEL link PROPERTIES (tenant,id,enabled)
);
partitioned_graph_plan_with_covering_global_vertex_index
SELECT * FROM GRAPH_TABLE(graph_das_access MATCH
(a IS item WHERE a.kind='seed')-[e IS link WHERE e.enabled=1]->{1,3}
(b IS item WHERE b.kind='node')
COLUMNS(a.id AS source,b.id AS destination,COUNT(e.id) AS hops,
JSON_ARRAYAGG(e.id) AS edge_ids)) g
ORDER BY hops,destination,edge_ids;
source	destination	hops	edge_ids
