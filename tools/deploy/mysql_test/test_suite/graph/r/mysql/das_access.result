CREATE TABLE graph_das_vertex (
tenant INT NOT NULL,
id INT NOT NULL,
kind VARCHAR(16) NOT NULL,
payload VARCHAR(64),
PRIMARY KEY (tenant,id)
) PARTITION BY HASH(tenant) PARTITIONS 4;
CREATE INDEX graph_das_vertex_cover
ON graph_das_vertex(kind,tenant,id)
GLOBAL PARTITION BY HASH(tenant) PARTITIONS 3;
CREATE TABLE graph_das_edge (
tenant INT NOT NULL,
id INT NOT NULL,
src_tenant INT,
src INT,
dst_tenant INT,
dst INT,
enabled INT,
PRIMARY KEY (tenant,id)
) PARTITION BY HASH(tenant) PARTITIONS 4;
CREATE INDEX graph_das_edge_filter ON graph_das_edge(enabled);
INSERT INTO graph_das_vertex VALUES
