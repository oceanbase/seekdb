full_scan_path_multiset_matches_independent_joins
SELECT COUNT(*) AS mismatched_groups FROM (
SELECT seed,middle,endpoint,hops,edges,suffix FROM (
SELECT seed,middle,endpoint,hops,edges,suffix,1 AS weight FROM composition_expected
UNION ALL
SELECT seed,middle,endpoint,hops,CAST(edges AS CHAR(200)),suffix,-1 FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=1)-[e IS knows]->{0,2}(b IS person)<-[f IS knows]-(c IS person)
COLUMNS(a.id AS seed,b.id AS middle,c.id AS endpoint,COUNT(e.id) AS hops,
JSON_ARRAYAGG(e.id) AS edges,f.id AS suffix)) g
) bags GROUP BY seed,middle,endpoint,hops,edges,suffix HAVING SUM(weight)<>0
) differences;
mismatched_groups
0
