independent_dense_and_lexical_ranks
WITH dense_candidates AS (
SELECT c.tenant,c.id AS chunk_id,c.entity_id,l2_distance(c.embedding,@hr_query) AS distance
FROM hr_chunks c JOIN hr_documents d ON d.tenant=c.tenant AND d.id=c.document_id
AND d.version=c.source_version AND d.deleted=0
WHERE c.tenant=@hr_tenant ORDER BY distance,c.id LIMIT 2
), lexical_candidates AS (
SELECT c.tenant,c.id AS chunk_id,c.entity_id,MATCH(c.content) AGAINST ('audit') AS relevance
FROM hr_chunks c JOIN hr_documents d ON d.tenant=c.tenant AND d.id=c.document_id
AND d.version=c.source_version AND d.deleted=0
WHERE c.tenant=@hr_tenant AND MATCH(c.content) AGAINST ('audit')>0
ORDER BY relevance DESC,c.id LIMIT 2
), ranked_channels AS (
SELECT tenant,chunk_id,entity_id,'dense' AS channel,
ROW_NUMBER() OVER(ORDER BY distance,chunk_id) AS signal_rank FROM dense_candidates
UNION ALL
SELECT tenant,chunk_id,entity_id,'lexical',
ROW_NUMBER() OVER(ORDER BY relevance DESC,chunk_id) FROM lexical_candidates
), seeds AS (
SELECT tenant,chunk_id,entity_id,SUM(CAST(1 AS DECIMAL(24,16))/(60+signal_rank)) AS seed_score
FROM ranked_channels GROUP BY tenant,chunk_id,entity_id
ORDER BY seed_score DESC,chunk_id LIMIT 3
) SELECT channel,chunk_id,signal_rank FROM ranked_channels ORDER BY channel,signal_rank;
channel	chunk_id	signal_rank
dense	100	1
dense	101	2
lexical	105	1
lexical	103	2
explicit_seed_budget_and_rank_fusion
WITH dense_candidates AS (
SELECT c.tenant,c.id AS chunk_id,c.entity_id,l2_distance(c.embedding,@hr_query) AS distance
FROM hr_chunks c JOIN hr_documents d ON d.tenant=c.tenant AND d.id=c.document_id
AND d.version=c.source_version AND d.deleted=0
WHERE c.tenant=@hr_tenant ORDER BY distance,c.id LIMIT 2
), lexical_candidates AS (
SELECT c.tenant,c.id AS chunk_id,c.entity_id,MATCH(c.content) AGAINST ('audit') AS relevance
FROM hr_chunks c JOIN hr_documents d ON d.tenant=c.tenant AND d.id=c.document_id
AND d.version=c.source_version AND d.deleted=0
WHERE c.tenant=@hr_tenant AND MATCH(c.content) AGAINST ('audit')>0
ORDER BY relevance DESC,c.id LIMIT 2
), ranked_channels AS (
SELECT tenant,chunk_id,entity_id,'dense' AS channel,
ROW_NUMBER() OVER(ORDER BY distance,chunk_id) AS signal_rank FROM dense_candidates
UNION ALL
SELECT tenant,chunk_id,entity_id,'lexical',
ROW_NUMBER() OVER(ORDER BY relevance DESC,chunk_id) FROM lexical_candidates
), seeds AS (
SELECT tenant,chunk_id,entity_id,SUM(CAST(1 AS DECIMAL(24,16))/(60+signal_rank)) AS seed_score
FROM ranked_channels GROUP BY tenant,chunk_id,entity_id
ORDER BY seed_score DESC,chunk_id LIMIT 3
) SELECT chunk_id,entity_id,CAST(seed_score AS DECIMAL(18,12)) AS seed_score
FROM seeds ORDER BY seed_score DESC,chunk_id;
chunk_id	entity_id	seed_score
100	1	0.016393442623
105	6	0.016393442623
101	2	0.016129032258
SELECT COUNT(*) AS mismatched_evidence_bags FROM (
SELECT tenant,seed_chunk,seed_entity,seed_score,endpoint,hops,edges,chunk_id,
document_id,source_version,source_uri,document_score,SUM(n) AS difference FROM (
SELECT a.*,1 AS n FROM hr_actual a UNION ALL SELECT e.*,-1 AS n FROM hr_expected e
) bags GROUP BY tenant,seed_chunk,seed_entity,seed_score,endpoint,hops,edges,chunk_id,
document_id,source_version,source_uri,document_score HAVING SUM(n)<>0
) differences;
mismatched_evidence_bags
0
