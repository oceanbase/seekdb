drop table if exists plan_table;
create table plan_table (
statement_id varchar(30),
plan_id int,
gmt_create timestamp,
remarks varchar(4000),
operator varchar(255),
options varchar(255),
object_node varchar(40),
object_owner varchar(128),
object_name varchar(128),
object_alias varchar(261),
object_instance int,
object_type varchar(30),
optimizer varchar(4000),
search_columns int,
id int,
parent_id int,
depth int,
position int,
is_last_child int,
cost int,
cardinality int,
bytes int,
rowset int,
other_tag varchar(4000),
partition_start varchar(4000),
partition_stop varchar(4000),
partition_id int,
other varchar(4000),
distribution varchar(64),
cpu_cost int,
io_cost int,
temp_space int,
access_predicates varchar(4000),
filter_predicates varchar(4000),
startup_predicates varchar(4000),
projection varchar(4000),
special_predicates longtext,
time int,
qblock_name varchar(128),
other_xml varchar(4000)
);
EXPLAIN INTO plan_table SET statement_id='fullscan_reuse'
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=1)-[e IS knows WHERE e.since>=2020]->{0,4}(b IS person)
COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) g;
EXPLAIN INTO plan_table SET statement_id='fullscan_correlated'
SELECT s.binding_id,g.endpoint FROM fs_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.cutoff]->{1,2}(b IS person)
COLUMNS(b.id AS endpoint)) p) g;
SELECT COUNT(*)=1 AS fullscan_reuse_eligible FROM plan_table
WHERE statement_id='fullscan_reuse' AND operator='GRAPH FEEDBACK LOOP'
 AND special_predicates LIKE '%access=full-scan, mode=WALK, runtime=native%adjacency_reuse=eligible%';
fullscan_reuse_eligible
1
SELECT COUNT(*) AS unsafe_correlated_reuse FROM plan_table
WHERE statement_id='fullscan_correlated' AND operator='GRAPH FEEDBACK LOOP'
 AND special_predicates LIKE '%adjacency_reuse=eligible%';
unsafe_correlated_reuse
0
DROP TABLE plan_table;
