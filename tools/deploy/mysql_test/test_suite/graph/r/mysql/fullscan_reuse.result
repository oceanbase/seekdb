incoming_reuse_keeps_edge_and_step_evidence
SELECT s.binding_id,g.hops,g.step_no,g.src,g.eid,g.dst FROM fs_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)<-[e IS knows WHERE e.since>=2020]-{1,2}(b IS person)
ONE ROW PER STEP(v1,se,v2)
COLUMNS(COUNT(e.id) AS hops,ELEMENT_NUMBER(se) AS step_no,v1.id AS src,se.id AS eid,v2.id AS dst)) p
) g ORDER BY s.binding_id,g.hops,g.eid,g.step_no,g.src,g.dst;
