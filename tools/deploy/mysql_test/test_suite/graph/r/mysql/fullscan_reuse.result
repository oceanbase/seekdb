SELECT s.binding_id,COUNT(*) AS paths FROM fs_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE RAND(1)<1]->{1,2}(b IS person)
COLUMNS(b.id AS endpoint)) p
) g GROUP BY s.binding_id ORDER BY s.binding_id;
