statement_boundaries_and_read_your_writes
PREPARE fs_cached FROM 'SELECT s.binding_id,COUNT(*) AS paths FROM fs_seeds s,LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=?]->{1}(b IS person) COLUMNS(b.id AS endpoint)) p) g GROUP BY s.binding_id ORDER BY s.binding_id';
SET @cutoff=2020;
EXECUTE fs_cached USING @cutoff;
binding_id	paths
1	3
2	3
5	1
START TRANSACTION;
DELETE FROM graph_person WHERE id=2;
EXECUTE fs_cached USING @cutoff;
binding_id	paths
1	1
2	1
5	1
ROLLBACK;
SET @cutoff=2022;
EXECUTE fs_cached USING @cutoff;
binding_id	paths
1	1
2	1
5	1
DEALLOCATE PREPARE fs_cached;
