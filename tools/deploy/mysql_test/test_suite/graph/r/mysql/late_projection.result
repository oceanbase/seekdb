PREPARE gl_cached FROM 'SELECT id,LENGTH(body) AS bytes FROM GRAPH_TABLE(gl_graph MATCH (a IS node WHERE a.id=?)-[e IS link]->{0,2}(b IS node) COLUMNS(b.id AS id,b.body AS body)) g ORDER BY id DESC LIMIT ? OFFSET ?';
SET @seed=1,@lim=3,@off=1;
EXECUTE gl_cached USING @seed,@lim,@off;
id	bytes
10000	1024
9999	NULL
9999	NULL
SET @seed=10000,@off=0;
EXECUTE gl_cached USING @seed,@lim,@off;
id	bytes
10000	1024
SET @seed=20000;
EXECUTE gl_cached USING @seed,@lim,@off;
id	bytes
DEALLOCATE PREPARE gl_cached;
DROP PROPERTY GRAPH gl_graph;
DROP TABLE gl_v,gl_e,gl_digit,plan_table;
