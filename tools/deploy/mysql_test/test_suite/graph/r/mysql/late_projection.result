SELECT COUNT(*) AS narrow_topn FROM plan_table WHERE statement_id='path_rank'
  AND operator='TOP-N SORT' AND projection NOT LIKE '%body%';
narrow_topn
1
SELECT COUNT(*) AS native_paths FROM plan_table WHERE statement_id='path_rank'
  AND special_predicates LIKE '%runtime=native%';
native_paths
1
SELECT COUNT(*) AS lazy_property_gets FROM plan_table WHERE statement_id='path_rank'
  AND object_alias LIKE '__g_result_%' AND operator='TABLE GET';
lazy_property_gets
2
SELECT id,LENGTH(source_body) AS source_bytes,LENGTH(body) AS bytes FROM GRAPH_TABLE(gl_graph MATCH
(a IS node WHERE a.id=1)-[e IS link]->{1,2}(b IS node)
COLUMNS(a.body AS source_body,b.id AS id,b.body AS body)) g ORDER BY id DESC LIMIT 6;
id	source_bytes	bytes
10000	1024	1024
10000	1024	1024
9999	1024	NULL
9999	1024	NULL
9998	1024	1024
9998	1024	1024
endpoint_filter_runs_before_limit
