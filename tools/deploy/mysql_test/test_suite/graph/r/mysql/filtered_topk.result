SELECT COUNT(*) AS changed_joined_bag FROM (
SELECT id,doc_id,body,SUM(n) AS balance FROM (
SELECT id,doc_id,body,1 AS n FROM gf_expected
UNION ALL SELECT id,doc_id,body,-1 AS n FROM gf_actual
) rows_with_sign GROUP BY id,doc_id,body HAVING SUM(n)<>0
) changed;
