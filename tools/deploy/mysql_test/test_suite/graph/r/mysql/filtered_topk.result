SELECT 'expected' AS shape,COUNT(*) AS rows_found,MIN(id),MAX(id) FROM gf_expected
UNION ALL SELECT 'auto',COUNT(*),MIN(id),MAX(id) FROM gf_actual
UNION ALL SELECT 'forced',COUNT(*),MIN(id),MAX(id) FROM gf_forced;
shape	rows_found	MIN(id)	MAX(id)
expected	20	9991	9999
auto	20	9991	9999
forced	20	9991	9999
SELECT COUNT(*) AS changed_bag FROM
(SELECT id,body,COUNT(*) AS n FROM gf_expected GROUP BY id,body) e
LEFT JOIN (SELECT id,body,COUNT(*) AS n FROM gf_actual GROUP BY id,body) a ON a.id=e.id AND a.body<=>e.body
LEFT JOIN (SELECT id,body,COUNT(*) AS n FROM gf_forced GROUP BY id,body) f ON f.id=e.id AND f.body<=>e.body
WHERE a.n IS NULL OR f.n IS NULL OR a.n<>e.n OR f.n<>e.n;
changed_bag
0
