PREPARE gf_cached FROM 'SELECT /*+ USE_LATE_MATERIALIZATION */ id,LEFT(body,5) AS prefix FROM GRAPH_TABLE(gf_graph MATCH (a IS node WHERE a.id=?)-[e IS link]->{0,2}(b IS node WHERE b.active=?) COLUMNS(b.id AS id,b.body AS body)) g ORDER BY id DESC LIMIT ? OFFSET ?';
SET @seed=1,@active=0,@lim=3,@off=3;
EXECUTE gf_cached USING @seed,@active,@lim,@off;
id	prefix
9999	9999:
9997	NULL
9997	NULL
SET @seed=10000,@active=1,@off=0;
EXECUTE gf_cached USING @seed,@active,@lim,@off;
id	prefix
10000	10000
SET @seed=20000;
EXECUTE gf_cached USING @seed,@active,@lim,@off;
id	prefix
DEALLOCATE PREPARE gf_cached;
DROP PROPERTY GRAPH gf_graph;
DROP TABLE gf_v,gf_e,gf_digit,plan_table;
complete_typed_composite_key_lookup
CREATE TABLE gf_v(tenant INT,id DECIMAL(20,2),code VARCHAR(20) COLLATE utf8mb4_general_ci,
body VARCHAR(20),active INT,PRIMARY KEY(tenant,id,code));
CREATE TABLE gf_e(edge_id INT PRIMARY KEY,st INT,si DECIMAL(20,2),sc VARCHAR(20) COLLATE utf8mb4_general_ci,
dt INT,di DECIMAL(20,2),dc VARCHAR(20) COLLATE utf8mb4_general_ci);
INSERT INTO gf_v VALUES(1,1.25,'Root','seed',1),(1,2.50,'TARGET','wanted',1),
(2,2.50,'TARGET','wrong-tenant',1),(1,2.50,'OTHER','wrong-code',1);
INSERT INTO gf_e VALUES(1,1,1.25,'root',1,2.50,'target'),(2,1,1.25,'root',1,2.50,'target');
CREATE PROPERTY GRAPH gf_graph VERTEX TABLES(gf_v KEY(tenant,id,code) LABEL node PROPERTIES(tenant,id,code,body,active))
EDGE TABLES(gf_e KEY(edge_id) SOURCE KEY(st,si,sc) REFERENCES gf_v(tenant,id,code)
DESTINATION KEY(dt,di,dc) REFERENCES gf_v(tenant,id,code) LABEL link PROPERTIES(edge_id));
SELECT /*+ USE_LATE_MATERIALIZATION */ * FROM GRAPH_TABLE(gf_graph MATCH
(a IS node WHERE a.body='seed')-[e IS link]->{0,2}(b IS node WHERE b.active=1)
COLUMNS(b.tenant AS tenant,b.id AS id,b.code AS code,b.body AS body)) g ORDER BY id DESC,code,tenant LIMIT 2;
tenant	id	code	body
1	2.50	TARGET	wanted
1	2.50	TARGET	wanted
DROP PROPERTY GRAPH gf_graph;
DROP TABLE gf_v,gf_e;
