collated_string_keys_keep_the_vertex_table_representation
CREATE TABLE gk_v(id VARCHAR(20) COLLATE utf8mb4_general_ci PRIMARY KEY);
CREATE TABLE gk_e(edge_id INT PRIMARY KEY,src VARCHAR(20) COLLATE utf8mb4_general_ci,dst VARCHAR(20) COLLATE utf8mb4_general_ci);
INSERT INTO gk_v VALUES ('SOURCE'),('TARGET');
INSERT INTO gk_e VALUES (1,'source','target');
CREATE PROPERTY GRAPH gk_graph VERTEX TABLES(gk_v KEY(id) LABEL node PROPERTIES(id))
EDGE TABLES(gk_e KEY(edge_id) SOURCE KEY(src) REFERENCES gk_v(id)
DESTINATION KEY(dst) REFERENCES gk_v(id) LABEL link PROPERTIES(edge_id));
SELECT * FROM GRAPH_TABLE(gk_graph MATCH (a IS node WHERE a.id='source')
-[e IS link]->{0,1}(b IS node) COLUMNS(a.id AS source,b.id AS destination,COUNT(e.edge_id) AS hops)) g
ORDER BY hops;
source	destination	hops
