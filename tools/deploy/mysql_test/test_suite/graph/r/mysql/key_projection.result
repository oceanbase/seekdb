18446744073709551615	7	18446744073709551614	2	1	{"KEY_VALUE": {"id": 18446744073709551614, "part": 2, "tenant": 7}, "ELEM_TABLE": "gk_v", "GRAPH_NAME": "gk_graph", "GRAPH_OWNER": "test"}
