composite_unsigned_keys_preserve_order_and_identity_values
CREATE TABLE gk_v(tenant INT,id BIGINT UNSIGNED,part SMALLINT,name VARCHAR(20),PRIMARY KEY(tenant,id,part));
CREATE TABLE gk_e(edge_id INT PRIMARY KEY,st INT,si BIGINT UNSIGNED,sp SMALLINT,dt INT,di BIGINT UNSIGNED,dp SMALLINT);
INSERT INTO gk_v VALUES (7,18446744073709551615,1,'root'),(7,18446744073709551614,2,'target');
INSERT INTO gk_e VALUES (1,7,18446744073709551615,1,7,18446744073709551614,2),
(2,7,18446744073709551615,1,7,18446744073709551614,2),
(3,7,18446744073709551615,1,8,18446744073709551614,2);
CREATE PROPERTY GRAPH gk_graph VERTEX TABLES(gk_v KEY(tenant,id,part) LABEL node PROPERTIES(tenant,id,part,name))
EDGE TABLES(gk_e KEY(edge_id) SOURCE KEY(st,si,sp) REFERENCES gk_v(tenant,id,part)
DESTINATION KEY(dt,di,dp) REFERENCES gk_v(tenant,id,part) LABEL link PROPERTIES(edge_id));
SELECT * FROM GRAPH_TABLE(gk_graph MATCH (a IS node WHERE a.part=1)
-[e IS link]->{0,2}(b IS node)
COLUMNS(a.id AS source,b.tenant AS tenant,b.id AS destination,b.part AS part,
COUNT(e.edge_id) AS hops,VERTEX_ID(b) AS identity)) g ORDER BY hops,destination;
source	tenant	destination	part	hops	identity
