(a IS person)-[e IS knows]->{1,}(b IS person) COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: unbounded graph path quantifiers (*, + or {n,}) not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{17}(b IS person) COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: graph path upper bounds greater than 16 not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{2,1}(b IS person) COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: graph path bounds with lower greater than upper not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]-{1}(b IS person) COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: undirected graph path segments not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH SIMPLE
(a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: SIMPLE and ACYCLIC graph path modes not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
(a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: SIMPLE and ACYCLIC graph path modes not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person)-[f IS knows]->{1}(c IS person)
COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: multiple or nested quantified graph path segments not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person)-[f IS knows]->(c IS person)
COLUMNS(COUNT(e.id) AS hops)) g;
ERROR 0A000: a quantified segment combined with another graph segment not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person)
ONE ROW PER VERTEX (v) COLUMNS(v.id AS id)) g;
ERROR 0A000: ONE ROW PER VERTEX graph results not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(e.id AS edge_id)) g;
ERROR 0A000: a quantified edge property outside COUNT or JSON_ARRAYAGG not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(COUNT(b.id) AS hops)) g;
ERROR 0A000: COUNT or JSON_ARRAYAGG over the quantified edge variable not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(b.missing AS value)) g;
ERROR 0A000: an unknown graph property not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(COUNT(e.missing) AS hops)) g;
ERROR 0A000: an unknown graph property not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person)
COLUMNS(ELEMENT_NUMBER(a) AS element_no)) g;
ERROR 0A000: ELEMENT_NUMBER on a ONE ROW PER STEP iteration variable not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows]->{1}(b IS person)
ONE ROW PER STEP (v1,e,v2) COLUMNS(e.id AS edge_id)) g;
ERROR 0A000: an iterator variable redeclared from the graph pattern not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE e.since>2020)-[e IS knows]->{1}(b IS person)
COLUMNS(b.id AS id)) g;
ERROR 0A000: a graph variable outside its element filter not supported
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person)-[e IS knows WHERE b.id>1]->{1}(b IS person)
COLUMNS(b.id AS id)) g;
ERROR 0A000: a graph variable outside its element filter not supported
