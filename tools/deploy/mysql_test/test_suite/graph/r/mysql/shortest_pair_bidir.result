shortest_pair_without_adjacency_index
EXPLAIN INTO plan_table SET statement_id='shortest_pair_no_index'
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=3) COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
SELECT COUNT(*)=1 AS reverse_unavailable FROM plan_table WHERE statement_id='shortest_pair_no_index' AND operator='GRAPH FEEDBACK LOOP' AND special_predicates LIKE '%reverse_access=none%';
reverse_unavailable
1
