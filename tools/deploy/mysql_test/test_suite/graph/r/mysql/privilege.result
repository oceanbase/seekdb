DROP USER IF EXISTS graph_reader;
CREATE USER graph_reader IDENTIFIED BY 'graph_test';
GRANT SELECT ON test.graph_person TO graph_reader;
SHOW CREATE PROPERTY GRAPH graph_social;
Graph	Create Property Graph
graph_social	CREATE PROPERTY GRAPH `graph_social`
  VERTEX TABLES (
    `graph_person` KEY (`id`) LABEL `person` PROPERTIES (`id`, `name`, `age`),
    `graph_company` KEY (`id`) LABEL `company` PROPERTIES (`id`, `name`)
  )
  EDGE TABLES (
    `graph_knows` KEY (`id`) SOURCE KEY (`src`) REFERENCES `graph_person` (`id`) DESTINATION KEY (`dst`) REFERENCES `graph_person` (`id`) LABEL `knows` PROPERTIES (`id`, `since`),
    `graph_works` KEY (`id`) SOURCE KEY (`src`) REFERENCES `graph_person` (`id`) DESTINATION KEY (`dst`) REFERENCES `graph_company` (`id`) LABEL `works` PROPERTIES (`id`)
  )
SELECT COUNT(*) FROM GRAPH_TABLE(graph_social MATCH(p IS person) COLUMNS(p.id AS id)) g;
COUNT(*)
5
