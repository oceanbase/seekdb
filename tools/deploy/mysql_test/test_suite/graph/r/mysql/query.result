SELECT * FROM GRAPH_TABLE(graph_social MATCH (p IS person)
COLUMNS (p.id AS id,p.name AS name,p.age AS age)) g ORDER BY id;
id	name	age
1	Alice	30
2	Bob	NULL
3	Carol	25
4	NULL	40
5	Isolated	50
WITH graph_person AS (SELECT 999 AS id)
SELECT id FROM GRAPH_TABLE(graph_social MATCH(p IS person) COLUMNS(p.id AS id)) g ORDER BY id;
id
1
2
3
4
5
SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person)-[e IS knows]->(b IS person)
COLUMNS (a.id AS source,e.id AS edge_id,b.id AS destination)) g ORDER BY edge_id;
source	edge_id	destination
1	10	2
1	11	2
2	12	3
3	13	1
4	14	4
SELECT a.id AS source,e.id AS edge_id,b.id AS destination
FROM graph_person a JOIN graph_knows e ON a.id=e.src JOIN graph_person b ON e.dst=b.id ORDER BY edge_id;
source	edge_id	destination
1	10	2
1	11	2
2	12	3
3	13	1
4	14	4
SELECT * FROM GRAPH_TABLE(graph_social MATCH (b IS person)<-[e IS knows]-(a IS person)
COLUMNS (a.id AS source,e.id AS edge_id,b.id AS destination)) g ORDER BY edge_id;
source	edge_id	destination
1	10	2
1	11	2
2	12	3
3	13	1
4	14	4
SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person WHERE a.id=1)-[e IS knows]->(b IS person)-[f IS knows]->(c IS person)
COLUMNS (a.id AS source,e.id AS first_edge,f.id AS second_edge,c.id AS destination)) g ORDER BY first_edge,second_edge;
source	first_edge	second_edge	destination
1	10	12	3
1	11	12	3
SELECT a.id AS source,e.id AS first_edge,f.id AS second_edge,c.id AS destination
FROM graph_person a JOIN graph_knows e ON a.id=e.src JOIN graph_person b ON e.dst=b.id
JOIN graph_knows f ON b.id=f.src JOIN graph_person c ON f.dst=c.id WHERE a.id=1 ORDER BY first_edge,second_edge;
source	first_edge	second_edge	destination
1	10	12	3
1	11	12	3
SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person)-[e IS works]->(b IS company)
COLUMNS (a.id AS person_id,a.name AS person_name,b.id AS company_id,b.name AS company_name)) g;
person_id	person_name	company_id	company_name
1	Alice	1	Acme
