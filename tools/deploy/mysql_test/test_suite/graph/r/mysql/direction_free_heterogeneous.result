LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.id AND RAND(1)<1)-[e IS works]-{0,3}(b IS company)
COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) p) g ORDER BY s.binding,g.hops;
binding	endpoint	hops
