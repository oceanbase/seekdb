LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=1)-[e IS works WHERE e.id=s.id]-{1,3}(b IS company)
COLUMNS(COUNT(e.id) AS hops)) p) g ORDER BY g.hops;
