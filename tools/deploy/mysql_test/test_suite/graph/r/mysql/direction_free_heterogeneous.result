SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=1)-[e IS works]-{0,4}(b IS person)
COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY hops;
seed	endpoint	hops	edges
1	1	0	NULL
1	1	2	[20, 20]
1	1	4	[20, 20, 20, 20]
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=1)-[e IS works]-{0,4}(b IS company)
COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY hops;
seed	endpoint	hops	edges
1	1	1	[20]
1	1	3	[20, 20, 20]
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS company WHERE a.id=1)-[e IS works]-{0,3}(b IS person)
ONE ROW PER STEP(v1,se,v2)
COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,v1.name AS src,se.id AS eid,v2.name AS dst,
COUNT(e.id) AS hops)) g ORDER BY m,n;
m	n	src	eid	dst	hops
2	2	Acme	20	Alice	1
4	2	Acme	20	Alice	3
4	4	Alice	20	Acme	3
4	6	Acme	20	Alice	3
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=1)-[e IS works]-{0,2}(b IS person)
ONE ROW PER STEP(v1,se,v2)
COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,v1.name AS src,se.id AS eid,v2.name AS dst,
v1.age AS from_age,v2.age AS to_age,COUNT(e.id) AS hops)) g ORDER BY m,n;
m	n	src	eid	dst	from_age	to_age	hops
