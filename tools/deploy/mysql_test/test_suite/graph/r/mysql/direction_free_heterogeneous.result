DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;
CREATE TABLE df_a(id BIGINT PRIMARY KEY,name VARCHAR(20));
CREATE TABLE df_b(tenant VARBINARY(8),code DECIMAL(8,2),name VARCHAR(20),PRIMARY KEY(tenant,code));
CREATE TABLE df_e(id BIGINT PRIMARY KEY,src BIGINT,dt VARBINARY(8),dc DECIMAL(8,2));
INSERT INTO df_a VALUES(1,'A1'),(2,'A2');
INSERT INTO df_b VALUES(X'4100',1.25,'B1');
INSERT INTO df_e VALUES(10,1,X'4100',1.25),(11,2,X'4100',1.25);
CREATE PROPERTY GRAPH df_graph VERTEX TABLES
(df_a KEY(id) LABEL a PROPERTIES(name),df_b KEY(tenant,code) LABEL b PROPERTIES(name))
EDGE TABLES(df_e KEY(id) SOURCE KEY(src) REFERENCES df_a(id)
DESTINATION KEY(dt,dc) REFERENCES df_b(tenant,code) LABEL e PROPERTIES(id));
SELECT * FROM GRAPH_TABLE(df_graph MATCH (a IS a WHERE a.name='A1')-[e IS e]-{0,2}(b IS a)
ONE ROW PER STEP(v1,se,v2)
COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,v1.name AS src,se.id AS eid,v2.name AS dst,
COUNT(e.id) AS hops)) g ORDER BY m,n;
m	n	src	eid	dst	hops
1	NULL	A1	NULL	NULL	0
3	2	A1	10	B1	2
3	4	B1	10	A1	2
6	2	A1	10	B1	2
6	4	B1	11	A2	2
INSERT INTO df_e VALUES(12,1,X'4100',1.25);
SELECT * FROM GRAPH_TABLE(df_graph MATCH TRAIL (a IS b)-[e IS e]-{0,3}(b IS a)
COLUMNS(b.name AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY hops,endpoint,CAST(edges AS CHAR);
endpoint	hops	edges
A1	1	[10]
A1	1	[12]
A2	1	[11]
A2	3	[10, 12, 11]
A2	3	[12, 10, 11]
SELECT m,n,JSON_UNQUOTE(JSON_EXTRACT(src,'$.ELEM_TABLE')) AS src_table,
JSON_UNQUOTE(JSON_EXTRACT(dst,'$.ELEM_TABLE')) AS dst_table FROM GRAPH_TABLE(df_graph MATCH
(a IS a WHERE a.name='A1')-[e IS e WHERE e.id=10]-{2}(b IS a)
ONE ROW PER STEP(v1,se,v2)
COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,VERTEX_ID(v1) AS src,VERTEX_ID(v2) AS dst)) g ORDER BY m,n;
m	n	src_table	dst_table
1	2	df_a	df_b
1	4	df_b	df_a
DROP PROPERTY GRAPH df_graph;
DROP TABLE df_e,df_b,df_a;
