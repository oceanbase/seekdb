SELECT m,s,JSON_VALUE(vi,'$.KEY_VALUE.id') AS src,
JSON_VALUE(ei,'$.KEY_VALUE.tenant') AS tenant,
JSON_VALUE(ei,'$.KEY_VALUE.code') AS edge_code,
JSON_VALUE(ei,'$.KEY_VALUE.edge_no') AS edge_no,
JSON_VALUE(vj,'$.KEY_VALUE.id') AS dst
FROM GRAPH_TABLE(graph_steps MATCH
(a IS node WHERE a.id=3)<-[e IS link]-{0,3}(b IS node WHERE b.id!=2)
ONE ROW PER STEP(v1,se,v2)
COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS s,
VERTEX_ID(v1) AS vi,EDGE_ID(se) AS ei,VERTEX_ID(v2) AS vj)) g
ORDER BY m,s;
