JSON_ARRAYAGG(e.edge_id) AS ids,JSON_ARRAYAGG(e.weight) AS weights,
JSON_ARRAYAGG(e.note) AS notes,JSON_ARRAYAGG(e.doc) AS docs)) g
ORDER BY hops,ids;
