CREATE TABLE graph_pa_vertex (id INT PRIMARY KEY);
CREATE TABLE graph_pa_edge (
tenant INT, edge_id VARCHAR(32), src INT, dst INT,
weight DECIMAL(18,3), note VARCHAR(128), doc JSON,
PRIMARY KEY (tenant,edge_id)
);
INSERT INTO graph_pa_vertex VALUES (1),(2),(3);
INSERT INTO graph_pa_edge VALUES
(1,'first',1,2,1.250,'alpha',JSON_OBJECT('n',1)),
(1,'parallel',1,2,2.500,NULL,JSON_ARRAY(1,2)),
(2,'next',2,3,NULL,'beta',NULL),
(2,'cycle',3,1,3.750,'gamma',JSON_OBJECT('n',3)),
(2,'orphan',1,99,9.000,'ignored',JSON_OBJECT('n',99));
CREATE PROPERTY GRAPH graph_path_arrays
VERTEX TABLES (graph_pa_vertex KEY (id) LABEL node PROPERTIES (id))
EDGE TABLES (graph_pa_edge KEY (tenant,edge_id)
SOURCE KEY (src) REFERENCES graph_pa_vertex (id)
DESTINATION KEY (dst) REFERENCES graph_pa_vertex (id)
LABEL link PROPERTIES (tenant,edge_id,weight,note,doc));
drop table if exists plan_table;
create table plan_table (
statement_id varchar(30),
plan_id int,
gmt_create timestamp,
remarks varchar(4000),
operator varchar(255),
options varchar(255),
object_node varchar(40),
object_owner varchar(128),
object_name varchar(128),
object_alias varchar(261),
object_instance int,
object_type varchar(30),
optimizer varchar(4000),
search_columns int,
id int,
parent_id int,
depth int,
position int,
is_last_child int,
cost int,
cardinality int,
bytes int,
rowset int,
other_tag varchar(4000),
partition_start varchar(4000),
partition_stop varchar(4000),
partition_id int,
other varchar(4000),
distribution varchar(64),
cpu_cost int,
io_cost int,
temp_space int,
access_predicates varchar(4000),
filter_predicates varchar(4000),
startup_predicates varchar(4000),
projection varchar(4000),
special_predicates longtext,
time int,
qblock_name varchar(128),
other_xml varchar(4000)
);
DELETE FROM plan_table;
EXPLAIN INTO plan_table SET statement_id='path_arrays'
  SELECT * FROM GRAPH_TABLE(graph_path_arrays MATCH
(a IS node WHERE a.id=1)-[e IS link]->{0,4}(b IS node)
COLUMNS(b.id AS destination,COUNT(e.edge_id) AS hops,
JSON_ARRAYAGG(e.edge_id) AS ids,JSON_ARRAYAGG(e.weight) AS weights,
JSON_ARRAYAGG(e.note) AS notes,JSON_ARRAYAGG(e.doc) AS docs,
JSON_ARRAYAGG(EDGE_ID(e)) AS identities)) g;
SELECT COUNT(*)=1 AS uses_native_path_arrays FROM plan_table
WHERE statement_id='path_arrays' AND operator='GRAPH FEEDBACK LOOP'
    AND special_predicates LIKE '%runtime=native%';
uses_native_path_arrays
1
