SELECT destination,hops,
JSON_VALUE(identities,'$[0].GRAPH_NAME') AS graph_name,
JSON_VALUE(identities,'$[0].KEY_VALUE.tenant') AS first_tenant,
JSON_VALUE(identities,'$[0].KEY_VALUE.edge_id') AS first_edge,
JSON_VALUE(identities,'$[1].KEY_VALUE.tenant') AS second_tenant,
JSON_VALUE(identities,'$[1].KEY_VALUE.edge_id') AS second_edge
FROM GRAPH_TABLE(graph_path_arrays MATCH
(a IS node WHERE a.id=1)-[e IS link]->{0,2}(b IS node)
COLUMNS(b.id AS destination,COUNT(e.edge_id) AS hops,
JSON_ARRAYAGG(EDGE_ID(e)) AS identities)) g
ORDER BY hops,first_edge;
destination	hops	graph_name	first_tenant	first_edge	second_tenant	second_edge
