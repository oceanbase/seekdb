SELECT s.seed,s.score,p.destination,p.ids
FROM (SELECT 1 AS seed,10 AS score UNION ALL SELECT 1,20 UNION ALL SELECT 3,30) s,
LATERAL (
SELECT * FROM GRAPH_TABLE(graph_path_arrays MATCH
(a IS node WHERE a.id=s.seed)-[e IS link]->{0,2}(b IS node)
COLUMNS(b.id AS destination,JSON_ARRAYAGG(e.edge_id) AS ids)) g
) p
ORDER BY s.score,p.ids,p.destination;
