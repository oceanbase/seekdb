PREPARE graph_pa_cached FROM
'SELECT * FROM GRAPH_TABLE(graph_path_arrays MATCH (a IS node WHERE a.id=?)-[e IS link]->{0,2}(b IS node) COLUMNS(b.id AS destination,JSON_ARRAYAGG(e.edge_id) AS ids)) g ORDER BY ids,destination';
SET @seed=1;
EXECUTE graph_pa_cached USING @seed;
destination	ids
1	NULL
3	["first", "next"]
2	["first"]
3	["parallel", "next"]
2	["parallel"]
SET @seed=3;
EXECUTE graph_pa_cached USING @seed;
destination	ids
3	NULL
2	["cycle", "first"]
2	["cycle", "parallel"]
1	["cycle"]
DEALLOCATE PREPARE graph_pa_cached;
