typed_contexts_preserve_binary_strings_dates_decimals_and_nulls
SELECT s.id,g.eid FROM pr_bindings s,LATERAL (
SELECT * FROM GRAPH_TABLE(pr_graph MATCH
(a IS person WHERE a.id=1)-[e IS knows WHERE e.tenant=s.tenant
AND e.valid_at>=s.since AND e.weight>=s.weight]->{1}(b IS person)
COLUMNS(JSON_ARRAYAGG(e.id) AS eid)) p) g ORDER BY s.id,CAST(g.eid AS CHAR);
id	eid
1	[10]
3	[11]
4	[10]
6	[12]
8	[10]
