drop table if exists plan_table;
create table plan_table (
statement_id varchar(30),
plan_id int,
gmt_create timestamp,
remarks varchar(4000),
operator varchar(255),
options varchar(255),
object_node varchar(40),
object_owner varchar(128),
object_name varchar(128),
object_alias varchar(261),
object_instance int,
object_type varchar(30),
optimizer varchar(4000),
search_columns int,
id int,
parent_id int,
depth int,
position int,
is_last_child int,
cost int,
cardinality int,
bytes int,
rowset int,
other_tag varchar(4000),
partition_start varchar(4000),
partition_stop varchar(4000),
partition_id int,
other varchar(4000),
distribution varchar(64),
cpu_cost int,
io_cost int,
temp_space int,
access_predicates varchar(4000),
filter_predicates varchar(4000),
startup_predicates varchar(4000),
projection varchar(4000),
special_predicates longtext,
time int,
qblock_name varchar(128),
other_xml varchar(4000)
);
EXPLAIN INTO plan_table SET statement_id='parameter_reuse'
  SELECT s.binding_id,g.endpoint FROM pr_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.cutoff AND e.since<=s.ceiling]->{0,2}
(b IS person) COLUMNS(b.id AS endpoint)) p) g;
SELECT COUNT(*)=1 AS parameter_reuse_eligible FROM plan_table
WHERE statement_id='parameter_reuse' AND operator='GRAPH FEEDBACK LOOP'
   AND special_predicates LIKE '%runtime=native%adjacency_reuse=eligible%';
parameter_reuse_eligible
1
DROP TABLE plan_table;
SELECT COUNT(*) AS mismatched_bag_groups FROM (
SELECT binding_id,endpoint,hops,edges,SUM(n) AS difference FROM (
SELECT binding_id,endpoint,hops,edges,1 AS n FROM pr_expected
UNION ALL
SELECT s.binding_id,g.endpoint,g.hops,CAST(g.edges AS CHAR(200)),-1 AS n
FROM pr_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.cutoff AND e.since<=s.ceiling]->{0,2}
(b IS person) COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) p) g
) bags GROUP BY binding_id,endpoint,hops,edges HAVING SUM(n)<>0
) differences;
mismatched_bag_groups
0
SELECT s.binding_id,g.endpoint,g.hops,g.edges FROM pr_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.cutoff AND e.since<=s.ceiling]->{0,4}
(b IS person) COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) p) g
ORDER BY s.binding_id,g.hops,CAST(g.edges AS CHAR);
binding_id	endpoint	hops	edges
