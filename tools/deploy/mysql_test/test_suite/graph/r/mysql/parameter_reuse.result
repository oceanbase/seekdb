SELECT COUNT(*) AS complete_bindings_after_cache_pressure FROM pr_bindings s,LATERAL (
SELECT * FROM GRAPH_TABLE(pr_graph MATCH
(a IS person WHERE a.id=1)-[e IS knows WHERE e.tenant<s.tenant]->{0,1}(b IS person)
COLUMNS(b.id AS endpoint)) p) g WHERE s.id>=100;
complete_bindings_after_cache_pressure
400
