SELECT s.binding_id,g.hops,g.sn,g.eid,g.dst FROM pr_seeds s,LATERAL (
SELECT * FROM GRAPH_TABLE(graph_social MATCH
(a IS person WHERE a.id=s.seed)<-[e IS knows WHERE e.since>=s.cutoff AND e.since<=s.ceiling]-{0,2}
(b IS person) ONE ROW PER STEP(v1,se,v2)
COLUMNS(COUNT(e.id) AS hops,ELEMENT_NUMBER(se) AS sn,se.id AS eid,v2.id AS dst)) p) g
ORDER BY s.binding_id,g.hops,g.sn,g.eid,g.dst;
binding_id	hops	sn	eid	dst
1	0	NULL	NULL	NULL
1	1	2	13	3
1	2	2	13	3
1	2	4	12	2
2	0	NULL	NULL	NULL
2	1	2	13	3
2	2	2	13	3
2	2	4	12	2
3	0	NULL	NULL	NULL
3	1	2	13	3
3	2	2	13	3
3	2	4	12	2
4	0	NULL	NULL	NULL
5	0	NULL	NULL	NULL
6	0	NULL	NULL	NULL
7	0	NULL	NULL	NULL
7	1	2	13	3
7	2	2	13	3
7	2	4	12	2
PREPARE pr_cached FROM 'SELECT s.binding_id,COUNT(*) AS paths FROM pr_seeds s,LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=s.cutoff AND e.since>=?]->{0,2}(b IS person) COLUMNS(b.id AS endpoint)) p) g GROUP BY s.binding_id ORDER BY s.binding_id';
SET @cutoff=2020;
EXECUTE pr_cached USING @cutoff;
binding_id	paths
1	5
2	1
3	5
4	1
5	5
6	1
7	5
SET @cutoff=2022;
EXECUTE pr_cached USING @cutoff;
binding_id	paths
1	1
2	1
3	1
4	1
5	1
6	1
7	1
START TRANSACTION;
DELETE FROM graph_person WHERE id=2;
SET @cutoff=2020;
EXECUTE pr_cached USING @cutoff;
binding_id	paths
1	1
2	1
3	1
4	1
5	1
6	1
7	1
ROLLBACK;
EXECUTE pr_cached USING @cutoff;
binding_id	paths
1	5
2	1
3	5
4	1
5	5
6	1
7	5
DEALLOCATE PREPARE pr_cached;
CREATE INDEX pr_src ON graph_knows(src,since,dst);
CREATE INDEX pr_dst ON graph_knows(dst,since,src);
