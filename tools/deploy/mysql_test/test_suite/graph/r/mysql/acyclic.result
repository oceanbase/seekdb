PREPARE acyclic_cached FROM 'SELECT COUNT(*) AS paths FROM GRAPH_TABLE(graph_social MATCH ACYCLIC (a IS person WHERE a.id=?)-[e IS knows]->{0,4}(b IS person) COLUMNS(b.id AS endpoint)) g';
SET @seed=1;
EXECUTE acyclic_cached USING @seed;
paths
5
SET @seed=4;
EXECUTE acyclic_cached USING @seed;
paths
1
DEALLOCATE PREPARE acyclic_cached;
