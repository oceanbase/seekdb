INSERT INTO ac_actual SELECT seed,endpoint,hops,
COALESCE(REPLACE(REPLACE(REPLACE(CAST(edges AS CHAR),'[',''),']',''),' ',''),'')
FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
(a IS person)-[e IS knows]->{0,4}(b IS person)
COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
SELECT COUNT(*) AS indexed_differing_path_bags FROM (
SELECT seed,endpoint,hops,edges,SUM(delta) AS difference FROM (
SELECT seed,endpoint,hops,edges,1 AS delta FROM ac_expected
UNION ALL SELECT seed,endpoint,hops,edges,-1 FROM ac_actual) u
GROUP BY seed,endpoint,hops,edges HAVING SUM(delta)<>0) bad;
indexed_differing_path_bags
0
composed_path_bags_match_complete_oracle
DELETE FROM ac_actual;
INSERT INTO ac_actual SELECT seed,endpoint,hops+2,
CONCAT(first_edge,IF(hops=0,'',CONCAT(',',REPLACE(REPLACE(REPLACE(CAST(edges AS CHAR),'[',''),']',''),' ',''))),',',last_edge)
FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
(a IS person)-[f IS knows]->(b IS person)-[e IS knows]->{0,2}(c IS person)
-[z IS knows]->(d IS person)
COLUMNS(a.id AS seed,d.id AS endpoint,f.id AS first_edge,z.id AS last_edge,
COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
SELECT COUNT(*) AS composed_differing_path_bags FROM (
SELECT seed,endpoint,hops,edges,SUM(delta) AS difference FROM (
SELECT seed,endpoint,hops,edges,1 AS delta FROM ac_expected WHERE hops>=2
UNION ALL SELECT seed,endpoint,hops,edges,-1 FROM ac_actual) u
GROUP BY seed,endpoint,hops,edges HAVING SUM(delta)<>0) bad;
composed_differing_path_bags
0
