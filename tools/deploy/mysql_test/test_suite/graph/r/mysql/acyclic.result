CREATE TABLE ac_a(id BIGINT PRIMARY KEY,name VARCHAR(20));
CREATE TABLE ac_b(tenant VARBINARY(8),code DECIMAL(8,2),name VARCHAR(20),PRIMARY KEY(tenant,code));
CREATE TABLE ac_e(id BIGINT PRIMARY KEY,src BIGINT,dt VARBINARY(8),dc DECIMAL(8,2));
INSERT INTO ac_a VALUES(1,'A1'),(2,'A2');
INSERT INTO ac_b VALUES(X'4100',1.25,'B1'),(X'4100',2.25,'B2');
INSERT INTO ac_e VALUES(10,1,X'4100',1.25),(11,2,X'4100',1.25),
(12,1,X'4100',1.25),(13,2,X'4100',2.25),(14,1,X'4100',2.25);
CREATE PROPERTY GRAPH ac_graph VERTEX TABLES
(ac_a KEY(id) LABEL a PROPERTIES(name),ac_b KEY(tenant,code) LABEL b PROPERTIES(name))
EDGE TABLES(ac_e KEY(id) SOURCE KEY(src) REFERENCES ac_a(id)
DESTINATION KEY(dt,dc) REFERENCES ac_b(tenant,code) LABEL e PROPERTIES(id));
