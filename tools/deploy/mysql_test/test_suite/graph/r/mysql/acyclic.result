(a IS person WHERE a.id=s.id)-[e IS knows]->{0,4}(b IS person WHERE b.id<>2)
COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) p) g ORDER BY s.binding,g.hops,g.endpoint;
