independent_full_path_bag_oracle
INSERT INTO graph_knows VALUES(30,3,4,2024),(31,4,5,2024),(32,5,2,2024),(33,1,1,2024);
CREATE TABLE ac_expected AS WITH RECURSIVE paths(seed,endpoint,hops,visited,edges) AS (
SELECT id,id,0,CAST(CONCAT(',',id,',') AS CHAR(256)),CAST('' AS CHAR(256)) FROM graph_person
UNION ALL
SELECT p.seed,v.id,p.hops+1,CONCAT(p.visited,v.id,','),
CONCAT(p.edges,IF(p.hops=0,'',','),e.id)
FROM paths p JOIN graph_knows e ON e.src=p.endpoint JOIN graph_person v ON v.id=e.dst
WHERE p.hops<4 AND LOCATE(CONCAT(',',v.id,','),p.visited)=0
) SELECT seed,endpoint,hops,edges FROM paths;
CREATE TABLE ac_actual AS SELECT seed,endpoint,hops,
COALESCE(REPLACE(REPLACE(REPLACE(CAST(edges AS CHAR),'[',''),']',''),' ',''),'') AS edges
FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
(a IS person)-[e IS knows]->{0,4}(b IS person)
COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
SELECT COUNT(*) AS differing_path_bags FROM (
SELECT seed,endpoint,hops,edges,SUM(delta) AS difference FROM (
SELECT seed,endpoint,hops,edges,1 AS delta FROM ac_expected
UNION ALL SELECT seed,endpoint,hops,edges,-1 FROM ac_actual) u
GROUP BY seed,endpoint,hops,edges HAVING SUM(delta)<>0) bad;
differing_path_bags
0
CREATE INDEX ac_adj ON graph_knows(src,since,dst);
