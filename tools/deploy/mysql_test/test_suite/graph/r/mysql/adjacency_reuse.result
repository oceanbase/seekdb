PREPARE gr_cached FROM 'SELECT s.binding_id,COUNT(*) AS paths FROM gr_seeds s,LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person WHERE a.id=s.seed)-[e IS knows WHERE e.since>=?]->{0,2}(b IS person) COLUMNS(b.id AS destination)) g) g GROUP BY s.binding_id ORDER BY s.binding_id';
SET @cutoff=2020;
EXECUTE gr_cached USING @cutoff;
binding_id	paths
