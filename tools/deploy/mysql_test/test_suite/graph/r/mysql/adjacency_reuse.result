PREPARE gr_writes FROM 'SELECT s.binding_id,COUNT(*) AS paths FROM gr_seeds s,LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH (a IS person WHERE a.id=s.seed)-[e IS knows]->{1}(b IS person) COLUMNS(b.id AS destination)) g) g GROUP BY s.binding_id ORDER BY s.binding_id';
EXECUTE gr_writes;
ERROR HY000: Internal error
START TRANSACTION;
EXECUTE gr_writes;
binding_id	paths
