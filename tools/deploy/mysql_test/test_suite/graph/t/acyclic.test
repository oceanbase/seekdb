 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) g;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=1)-[f IS knows]->(b IS person)
 <-[z IS knows]-(c IS person)-[e IS works]->{1}(d IS company)
