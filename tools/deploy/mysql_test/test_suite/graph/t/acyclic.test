--echo cycles_parallel_edges_and_zero_hop
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=1)-[e IS knows]->{0,16}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g
 ORDER BY hops,CAST(edges AS CHAR);
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=4)-[e IS knows]->{0,16}(b IS person)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(v1.id AS src,se.id AS edge_id,v2.id AS dst,ELEMENT_NUMBER(se) AS step_no)) g;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=3)<-[e IS knows]-{1,4}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g
 ORDER BY hops,CAST(edges AS CHAR);
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=1)-[e IS knows]-{1,4}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g
 ORDER BY hops,CAST(edges AS CHAR);
--echo fixed_segments_share_boundaries_but_not_other_vertices
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=1)-[f IS knows]->(b IS person)
 -[e IS knows]->{0,3}(c IS person)-[z IS knows]->(d IS person)
 COLUMNS(f.id AS first_edge,COUNT(e.id) AS hops,z.id AS last_edge,d.id AS endpoint)) g
 ORDER BY first_edge,hops,last_edge;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person WHERE a.id=1)-[f IS knows]->(b IS person)
 -[e IS knows]->{0,3}(c IS person)-[z IS knows]->(d IS person)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(f.id AS first_edge,COUNT(e.id) AS hops,ELEMENT_NUMBER(se) AS step_no,
 v1.id AS src,se.id AS edge_id,v2.id AS dst)) g ORDER BY first_edge,step_no;
SELECT COUNT(*) AS no_fixed_cycle FROM GRAPH_TABLE(graph_social MATCH ACYCLIC
 (a IS person)-[e IS knows]->(b IS person)-[f IS knows]->(c IS person)
 -[h IS knows]->(d IS person) COLUMNS(d.id AS endpoint)) g;
