--echo graph_metadata_shapes
SET NAMES utf8mb4;
SELECT COUNT(*) AS graphs_before FROM information_schema.PROPERTY_GRAPHS WHERE GRAPH_SCHEMA=DATABASE();
CREATE TABLE meta_person(
 tenant INT, id BIGINT UNSIGNED,
 `na``me` VARCHAR(40) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
 amount DECIMAL(12,3), rating DOUBLE, happened DATETIME(6),
 code VARBINARY(8), attrs JSON, status ENUM('new','done'), body TEXT,
 PRIMARY KEY(tenant,id));
CREATE TABLE meta_edge(
 tenant INT,id BIGINT UNSIGNED,src_tenant INT,src BIGINT UNSIGNED,
 dst_tenant INT,dst BIGINT UNSIGNED,weight FLOAT,
 PRIMARY KEY(tenant,id));
CREATE PROPERTY GRAPH meta_graph
 VERTEX TABLES(meta_person KEY(tenant,id) LABEL person PROPERTIES(tenant,id,`na``me`,amount,rating,happened,code,attrs,status,body))
 EDGE TABLES(meta_edge KEY(tenant,id)
 SOURCE KEY(src_tenant,src) REFERENCES meta_person(tenant,id)
 DESTINATION KEY(dst_tenant,dst) REFERENCES meta_person(tenant,id)
 LABEL knows PROPERTIES(id,weight));
SELECT * FROM information_schema.PROPERTY_GRAPHS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY GRAPH_NAME;
SELECT * FROM information_schema.PROPERTY_GRAPH_ELEMENTS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY ELEMENT_NAME;
SELECT * FROM information_schema.PROPERTY_GRAPH_KEYS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY ELEMENT_NAME,ORDINAL_POSITION;
SELECT * FROM information_schema.PROPERTY_GRAPH_EDGE_RELATIONSHIPS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY EDGE_ELEMENT_NAME,ENDPOINT_TYPE,ORDINAL_POSITION;
SELECT * FROM information_schema.PROPERTY_GRAPH_LABELS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY LABEL_NAME;
SELECT * FROM information_schema.PROPERTY_GRAPH_ELEMENT_LABELS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY ELEMENT_NAME,LABEL_NAME;
SELECT * FROM information_schema.PROPERTY_GRAPH_LABEL_PROPERTIES
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY LABEL_NAME,ORDINAL_POSITION;
SELECT * FROM information_schema.PROPERTY_GRAPH_PROPERTY_DEFINITIONS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta_graph' ORDER BY ELEMENT_NAME,PROPERTY_NAME;
--echo graph_metadata_type_parity
SELECT COUNT(*) AS properties_checked,
 SUM(p.DATA_TYPE <=> c.DATA_TYPE) AS data_types,
 SUM(p.COLUMN_TYPE <=> c.COLUMN_TYPE) AS column_types,
 SUM(p.CHARACTER_MAXIMUM_LENGTH <=> c.CHARACTER_MAXIMUM_LENGTH) AS char_lengths,
 SUM(p.CHARACTER_OCTET_LENGTH <=> c.CHARACTER_OCTET_LENGTH) AS byte_lengths,
 SUM(p.NUMERIC_PRECISION <=> c.NUMERIC_PRECISION) AS precisions,
 SUM(p.NUMERIC_SCALE <=> c.NUMERIC_SCALE) AS scales,
 SUM(p.DATETIME_PRECISION <=> c.DATETIME_PRECISION) AS datetime_precisions,
 SUM(p.CHARACTER_SET_NAME <=> c.CHARACTER_SET_NAME) AS charsets,
 SUM(p.COLLATION_NAME <=> c.COLLATION_NAME) AS collations
FROM information_schema.PROPERTY_GRAPH_LABEL_PROPERTIES p
JOIN information_schema.PROPERTY_GRAPH_ELEMENT_LABELS l
 USING(GRAPH_SCHEMA,GRAPH_NAME,LABEL_NAME)
JOIN information_schema.PROPERTY_GRAPH_ELEMENTS e
 USING(GRAPH_SCHEMA,GRAPH_NAME,ELEMENT_NAME)
JOIN information_schema.PROPERTY_GRAPH_PROPERTY_DEFINITIONS d
 USING(GRAPH_SCHEMA,GRAPH_NAME,ELEMENT_NAME,PROPERTY_NAME)
JOIN information_schema.COLUMNS c
 ON c.TABLE_SCHEMA=e.OBJECT_SCHEMA AND c.TABLE_NAME=e.OBJECT_NAME AND c.COLUMN_NAME=d.COLUMN_NAME
WHERE p.GRAPH_SCHEMA=DATABASE() AND p.GRAPH_NAME='meta_graph';
--echo graph_metadata_filters_and_rescan
CREATE PROPERTY GRAPH meta_z VERTEX TABLES(meta_person KEY(tenant,id) LABEL other PROPERTIES(id));
CREATE DATABASE graph_meta_other;
USE graph_meta_other;
CREATE TABLE meta_person(id INT PRIMARY KEY);
CREATE PROPERTY GRAPH meta_graph VERTEX TABLES(meta_person KEY(id) LABEL person PROPERTIES(id));
USE test;
SELECT GRAPH_SCHEMA,GRAPH_NAME FROM information_schema.PROPERTY_GRAPHS
 WHERE GRAPH_SCHEMA IN ('test','graph_meta_other') AND GRAPH_NAME='meta_graph' ORDER BY GRAPH_SCHEMA;
SELECT GRAPH_NAME FROM information_schema.PROPERTY_GRAPHS
 WHERE GRAPH_SCHEMA='test' AND GRAPH_NAME>'meta_graph' AND GRAPH_NAME<='meta_z';
SELECT COUNT(*) AS missing FROM information_schema.PROPERTY_GRAPH_KEYS
 WHERE GRAPH_SCHEMA='missing_database' OR GRAPH_NAME='missing_graph';
SELECT GRAPH_NAME FROM information_schema.PROPERTY_GRAPHS
 WHERE GRAPH_SCHEMA='test' AND GRAPH_NAME IN ('meta_graph','meta_z') ORDER BY GRAPH_NAME DESC LIMIT 1;
PREPARE graph_metadata_cached FROM
 'SELECT ELEMENT_NAME FROM information_schema.PROPERTY_GRAPH_ELEMENTS WHERE GRAPH_SCHEMA=? AND GRAPH_NAME=? ORDER BY ELEMENT_NAME';
SET @db='test',@graph='meta_graph';
EXECUTE graph_metadata_cached USING @db,@graph;
SET @db='graph_meta_other';
EXECUTE graph_metadata_cached USING @db,@graph;
SET @db='missing_database';
EXECUTE graph_metadata_cached USING @db,@graph;
DEALLOCATE PREPARE graph_metadata_cached;
--echo graph_metadata_permissions
CREATE USER graph_meta_reader IDENTIFIED BY 'graph_test';
GRANT SELECT(id) ON test.meta_person TO graph_meta_reader;
connect (meta_reader,$OBMYSQL_MS0,graph_meta_reader,graph_test,test,$OBMYSQL_PORT);
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPHS WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_ELEMENTS WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_KEYS WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_EDGE_RELATIONSHIPS WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_LABELS WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_ELEMENT_LABELS WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_LABEL_PROPERTIES WHERE GRAPH_NAME='meta_graph';
SELECT COUNT(*) AS visible_rows FROM information_schema.PROPERTY_GRAPH_PROPERTY_DEFINITIONS WHERE GRAPH_NAME='meta_graph';
PREPARE graph_metadata_priv FROM 'SELECT COUNT(*) AS visible_graphs FROM information_schema.PROPERTY_GRAPHS WHERE GRAPH_SCHEMA=?';
SET @db='test';
EXECUTE graph_metadata_priv USING @db;
connection default;
REVOKE SELECT(id) ON test.meta_person FROM graph_meta_reader;
connection meta_reader;
EXECUTE graph_metadata_priv USING @db;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPHS;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_ELEMENTS;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_KEYS;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_EDGE_RELATIONSHIPS;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_LABELS;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_ELEMENT_LABELS;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_LABEL_PROPERTIES;
SELECT COUNT(*) AS hidden_rows FROM information_schema.PROPERTY_GRAPH_PROPERTY_DEFINITIONS;
DEALLOCATE PREPARE graph_metadata_priv;
connection default;
disconnect meta_reader;
DROP USER graph_meta_reader;
--echo graph_metadata_lifecycle
PREPARE graph_metadata_lifecycle FROM 'SELECT COUNT(*) AS definitions FROM information_schema.PROPERTY_GRAPH_PROPERTY_DEFINITIONS WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME=?';
SET @graph='meta_z';
EXECUTE graph_metadata_lifecycle USING @graph;
DROP PROPERTY GRAPH meta_z;
EXECUTE graph_metadata_lifecycle USING @graph;
CREATE PROPERTY GRAPH meta_z VERTEX TABLES(meta_person KEY(tenant,id) LABEL renamed PROPERTIES(id,amount));
EXECUTE graph_metadata_lifecycle USING @graph;
DEALLOCATE PREPARE graph_metadata_lifecycle;
DROP PROPERTY GRAPH meta_z;
CREATE PROPERTY GRAPH `meta"图` VERTEX TABLES(meta_person KEY(tenant,id) LABEL `人"类` PROPERTIES(id));
SELECT GRAPH_NAME,LABEL_NAME FROM information_schema.PROPERTY_GRAPH_LABELS
 WHERE GRAPH_SCHEMA=DATABASE() AND GRAPH_NAME='meta"图';
DROP PROPERTY GRAPH `meta"图`;
DROP PROPERTY GRAPH meta_graph;
DROP TABLE meta_edge,meta_person;
USE graph_meta_other;
DROP PROPERTY GRAPH meta_graph;
USE test;
DROP DATABASE graph_meta_other;
SELECT COUNT(*) AS graphs_after FROM information_schema.PROPERTY_GRAPHS WHERE GRAPH_SCHEMA=DATABASE();
