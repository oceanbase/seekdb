--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person)-[e IS knows]->{3,2}(b IS person) COLUMNS(b.id AS endpoint)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person)-[e IS knows]->*(b IS person) COLUMNS(b.id AS endpoint)) g;
--echo shortest_search_avoids_exponential_walk_enumeration
INSERT INTO graph_knows VALUES (40,4,4,2024),(41,4,4,2024),(42,4,4,2024),(43,4,4,2024),
 (44,4,4,2024),(45,4,4,2024),(46,4,4,2024);
--disable_query_log
let $saved_hash_area_size=query_get_value(select value from oceanbase.__all_virtual_sys_parameter_stat where name='_hash_area_size', value, 1);
ALTER SYSTEM SET _hash_area_size='4M';
sleep 6;
--enable_query_log
SELECT hops,JSON_LENGTH(edges) AS edge_count FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=4)-[e IS knows]->{16}(b IS person)
 COLUMNS(COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
--error 11049
SELECT COUNT(*) FROM GRAPH_TABLE(graph_social MATCH
 (a IS person WHERE a.id=4)-[e IS knows]->{0,16}(b IS person) COLUMNS(b.id AS endpoint)) g;
SELECT COUNT(*) AS recovered FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=4)-[e IS knows]->{0,16}(b IS person) COLUMNS(b.id AS endpoint)) g;
--disable_query_log
eval ALTER SYSTEM SET _hash_area_size='$saved_hash_area_size';
sleep 6;
--enable_query_log
--echo shortest_bound_goal_and_cross_hop_visited
--disable_result_log
--disable_query_log
EXPLAIN INTO plan_table SET statement_id='shortest_goal'
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=2)
 COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
EXPLAIN INTO plan_table SET statement_id='shortest_reach'
SELECT DISTINCT personId FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person)
 COLUMNS(b.id AS personId)) g WHERE personId<>1 ORDER BY personId;
EXPLAIN INTO plan_table SET statement_id='shortest_extra_target'
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}
 (b IS person WHERE b.id=2 AND b.age>=18)
 COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
--enable_query_log
--enable_result_log
SELECT COUNT(*)=1 AS bound_goal FROM plan_table
WHERE statement_id='shortest_goal' AND operator='GRAPH FEEDBACK LOOP'
AND special_predicates LIKE '%visited=cross_hop, goal=bound_key%';
SELECT COUNT(*)=1 AS cross_hop_visited FROM plan_table
WHERE statement_id='shortest_reach' AND operator='GRAPH FEEDBACK LOOP'
AND special_predicates LIKE '%visited=cross_hop, goal=none%';
SELECT COUNT(*)=1 AS extra_terminal_filter_disables_goal FROM plan_table
WHERE statement_id='shortest_extra_target' AND operator='GRAPH FEEDBACK LOOP'
AND special_predicates LIKE '%goal=none%';
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=2)
 COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=3)
 COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=5)
 COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=1)
 COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0;
SELECT personId FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person)
 COLUMNS(b.id AS personId)) g WHERE personId<>1 ORDER BY personId;
PREPARE shortest_goal_cached FROM 'SELECT MIN(hops) AS distance FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST (a IS person WHERE a.id=1)-[e IS knows]->{1,6}(b IS person WHERE b.id=?) COLUMNS(COUNT(e.id) AS hops)) g HAVING COUNT(*)>0';
SET @goal=2;
EXECUTE shortest_goal_cached USING @goal;
SET @goal=3;
EXECUTE shortest_goal_cached USING @goal;
DEALLOCATE PREPARE shortest_goal_cached;
DROP TABLE shortest_expected,plan_table;
DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;

--disable_query_log
# A -> T is ineligible at kind=1; only A -> B -> T survives.
# B fails the terminal predicate but must still enter the next frontier.
CREATE TABLE pruning_v(id INT PRIMARY KEY,name VARCHAR(8));
CREATE TABLE pruning_e(id INT PRIMARY KEY,src INT,dst INT,kind INT);
INSERT INTO pruning_v VALUES(1,'A'),(2,'B'),(3,'T');
INSERT INTO pruning_e VALUES(10,1,3,0),(11,1,2,1),(12,2,3,1);
CREATE PROPERTY GRAPH pruning_graph
 VERTEX TABLES(pruning_v KEY(id) LABEL node PROPERTIES(id,name))
 EDGE TABLES(pruning_e KEY(id) SOURCE KEY(src) REFERENCES pruning_v(id)
 DESTINATION KEY(dst) REFERENCES pruning_v(id) LABEL link PROPERTIES(id,kind));
--source mysql_test/include/create_plan_table.inc
--let $pruning_passes=2
while ($pruning_passes)
{
  if ($pruning_passes == 1)
  {
    CREATE INDEX pruning_out ON pruning_e(src,kind,dst);
  }
  --echo shortest_filter_before_distance_and_terminal_after_expansion
  --disable_result_log
  DELETE FROM plan_table;
  EXPLAIN INTO plan_table SET statement_id='pruning_native'
  SELECT * FROM GRAPH_TABLE(pruning_graph MATCH ANY SHORTEST
   (a IS node WHERE a.id=1)-[e IS link WHERE e.kind>=1]->{1,2}
   (b IS node WHERE b.name='T')
   COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
  EXPLAIN INTO plan_table SET statement_id='pruning_fallback'
  SELECT * FROM GRAPH_TABLE(pruning_graph MATCH ANY SHORTEST TRAIL
   (a IS node WHERE a.id=1)-[e IS link WHERE e.kind>=1]->{1,2}
   (b IS node WHERE b.name='T')
   COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
  --enable_result_log
  if ($pruning_passes == 2)
  {
    SELECT COUNT(*)=1 AS native_full_scan FROM plan_table
     WHERE statement_id='pruning_native' AND operator='GRAPH FEEDBACK LOOP'
     AND special_predicates LIKE '%access=full-scan%runtime=native, states=binding_vertex_hop, search=any_shortest%';
  }
  if ($pruning_passes == 1)
  {
    SELECT COUNT(*)=1 AS native_index_scan FROM plan_table
     WHERE statement_id='pruning_native' AND operator='GRAPH FEEDBACK LOOP'
     AND special_predicates LIKE '%access=index-scan%runtime=native, states=binding_vertex_hop, search=any_shortest%';
  }
  SELECT COUNT(*)=1 AS verified_fallback FROM plan_table
   WHERE statement_id='pruning_fallback' AND operator='GRAPH FEEDBACK LOOP'
   AND special_predicates LIKE '%runtime=fallback, states=paths, search=any_shortest%';
  SELECT endpoint,hops,JSON_LENGTH(edges) AS edge_count,
   JSON_VALUE(edges,'$[0]') AS first_edge,JSON_VALUE(edges,'$[1]') AS second_edge
  FROM GRAPH_TABLE(pruning_graph MATCH ANY SHORTEST
   (a IS node WHERE a.id=1)-[e IS link WHERE e.kind>=1]->{1,2}
   (b IS node WHERE b.name='T')
   COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
  SELECT endpoint,hops,JSON_LENGTH(edges) AS edge_count,
   JSON_VALUE(edges,'$[0]') AS first_edge,JSON_VALUE(edges,'$[1]') AS second_edge
  FROM GRAPH_TABLE(pruning_graph MATCH ANY SHORTEST
   (a IS node WHERE a.id=1)-[e IS link WHERE e.kind>=0]->{1,2}
   (b IS node WHERE b.name='T')
   COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
  SELECT endpoint,hops,JSON_LENGTH(edges) AS edge_count,
   JSON_VALUE(edges,'$[0]') AS first_edge,JSON_VALUE(edges,'$[1]') AS second_edge
  FROM GRAPH_TABLE(pruning_graph MATCH ANY SHORTEST TRAIL
   (a IS node WHERE a.id=1)-[e IS link WHERE e.kind>=1]->{1,2}
   (b IS node WHERE b.name='T')
   COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
  SELECT endpoint,hops,JSON_LENGTH(edges) AS edge_count,
   JSON_VALUE(edges,'$[0]') AS first_edge,JSON_VALUE(edges,'$[1]') AS second_edge
  FROM GRAPH_TABLE(pruning_graph MATCH ANY SHORTEST TRAIL
   (a IS node WHERE a.id=1)-[e IS link WHERE e.kind>=0]->{1,2}
   (b IS node WHERE b.name='T')
   COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g;
  --dec $pruning_passes
}
DROP TABLE plan_table;
DROP PROPERTY GRAPH pruning_graph;
DROP TABLE pruning_e,pruning_v;
--enable_query_log
