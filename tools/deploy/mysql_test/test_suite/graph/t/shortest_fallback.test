--disable_query_log
--source mysql_test/test_suite/graph/mapping_fixture.sql
--source mysql_test/include/create_plan_table.inc
--enable_query_log
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST TRAIL
 (a IS person WHERE a.id=1)-[e IS knows]->{1,4}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]-{0,4}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS works]-{1,4}(b IS company)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,v1.name AS src,se.id AS eid,v2.name AS dst,
 COUNT(e.id) AS hops)) g ORDER BY m,n;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS works]->{0,4}(b IS company)
 COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops)) g;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=3)-[f IS knows]->(b IS person)-[e IS knows]->{0,3}(c IS person)
 COLUMNS(a.id AS seed,c.id AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=3)-[f IS knows]->(b IS person)-[e IS knows]->{0,3}(c IS person)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,v1.id AS src,v2.id AS dst,c.id AS endpoint,
 COUNT(e.id) AS hops)) g ORDER BY endpoint,n;
INSERT INTO graph_works VALUES(21,1,1),(22,2,1);
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{0,3}(b IS person)-[f IS works]->(c IS company)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(ELEMENT_NUMBER(se) AS n,v1.name AS src,v2.name AS dst,COUNT(e.id) AS hops)) g ORDER BY n;
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=3)-[f IS knows]->(b IS person)-[e IS works]->{0,4}(c IS company)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(ELEMENT_NUMBER(se) AS n,v1.name AS src,v2.name AS dst,COUNT(e.id) AS hops)) g ORDER BY n;
SELECT s.id,g.endpoint,g.hops FROM (SELECT 1 AS id) s,
LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=s.id AND RAND(1)<1)-[e IS knows]->{0,3}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) p) g ORDER BY endpoint;
SELECT __g_step_matches.id,g.endpoint,g.hops FROM (SELECT 1 AS id) __g_step_matches,
LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=__g_step_matches.id)-[e IS knows]->{0,3}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) p) g ORDER BY endpoint;
SELECT __g_shortest_candidates.id,g.endpoint,g.hops FROM (SELECT 1 AS id) __g_shortest_candidates,
LATERAL (SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{0,3}(b IS person WHERE b.id=__g_shortest_candidates.id)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) p) g ORDER BY endpoint;
--disable_result_log
EXPLAIN INTO plan_table SET statement_id='volatile_shortest'
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{0,3}(b IS person WHERE RAND(1)<1)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) g;
--enable_result_log
SELECT COUNT(*)=1 AS volatile_keeps_paths FROM plan_table
 WHERE statement_id='volatile_shortest' AND operator='GRAPH FEEDBACK LOOP'
 AND special_predicates LIKE '%states=paths%';
SELECT * FROM GRAPH_TABLE(graph_social MATCH ANY SHORTEST
 (a IS person WHERE a.id=1)-[e IS knows]->{0,3}(b IS person WHERE RAND(1)<1)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
DROP TABLE plan_table;
DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;
CREATE TABLE sp_a(id BIGINT PRIMARY KEY,name VARCHAR(20));
CREATE TABLE sp_b(tenant VARBINARY(8),code DECIMAL(8,2),name VARCHAR(20),PRIMARY KEY(tenant,code));
CREATE TABLE sp_e(id BIGINT PRIMARY KEY,src BIGINT,dt VARBINARY(8),dc DECIMAL(8,2));
INSERT INTO sp_a VALUES(1,'A1'),(2,'A2');
INSERT INTO sp_b VALUES(X'4100',1.25,'B1');
INSERT INTO sp_e VALUES(10,1,X'4100',1.25),(11,2,X'4100',1.25),(12,1,X'4100',1.25);
CREATE PROPERTY GRAPH sp_graph VERTEX TABLES
 (sp_a KEY(id) LABEL a PROPERTIES(name),sp_b KEY(tenant,code) LABEL b PROPERTIES(name))
 EDGE TABLES(sp_e KEY(id) SOURCE KEY(src) REFERENCES sp_a(id)
 DESTINATION KEY(dt,dc) REFERENCES sp_b(tenant,code) LABEL e PROPERTIES(id));
SELECT * FROM GRAPH_TABLE(sp_graph MATCH ANY SHORTEST (a IS a WHERE a.name='A1')-[e IS e]-{2,4}(b IS a)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(b.name AS endpoint,ELEMENT_NUMBER(se) AS n,v1.name AS src,v2.name AS dst,COUNT(e.id) AS hops)) g ORDER BY endpoint,n;
SELECT * FROM GRAPH_TABLE(sp_graph MATCH ANY SHORTEST (a IS b)-[e IS e]-{0,3}(b IS a)
 COLUMNS(b.name AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
--disable_query_log
# Equal first key components must not merge distinct composite endpoints.
# Undirected heterogeneous traversal uses the recursive SQL fallback and
# ROW_NUMBER ranking; a directed one-hop mapping would bypass that executor.
INSERT INTO sp_b VALUES(X'4100',2.50,'B2');
INSERT INTO sp_e VALUES(13,1,X'4100',2.50);
--source mysql_test/include/create_plan_table.inc
--disable_result_log
EXPLAIN INTO plan_table SET statement_id='composite_shortest'
SELECT * FROM GRAPH_TABLE(sp_graph MATCH ANY SHORTEST
 (a IS a WHERE a.name='A1')-[e IS e]-{1,3}(b IS b)
 COLUMNS(b.name AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
--enable_result_log
--echo shortest_fallback_preserves_all_composite_endpoint_keys
SELECT COUNT(*)=1 AS composite_fallback FROM plan_table
 WHERE statement_id='composite_shortest' AND operator='RECURSIVE UNION ALL';
SELECT COUNT(*)>=1 AS composite_shortest_ranking FROM plan_table
 WHERE statement_id='composite_shortest' AND operator='WINDOW FUNCTION'
 AND LOWER(special_predicates) LIKE '%row_number%';
SELECT * FROM GRAPH_TABLE(sp_graph MATCH ANY SHORTEST
 (a IS a WHERE a.name='A1')-[e IS e]-{1,3}(b IS b)
 COLUMNS(b.name AS endpoint,COUNT(e.id) AS hops)) g ORDER BY endpoint;
DROP TABLE plan_table;
--enable_query_log
DROP PROPERTY GRAPH sp_graph;
DROP TABLE sp_e,sp_b,sp_a;
