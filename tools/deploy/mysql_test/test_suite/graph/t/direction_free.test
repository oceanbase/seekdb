SELECT * FROM GRAPH_TABLE(graph_social MATCH
 (a IS person WHERE a.id=1)-[e IS knows]-{0,2}(b IS person)
 COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g
ORDER BY hops,endpoint,CAST(edges AS CHAR);
SELECT * FROM GRAPH_TABLE(graph_social MATCH
 (a IS person WHERE a.id=1)-[e IS knows]-{1,2}(b IS person)
 ONE ROW PER STEP(v1,se,v2)
 COLUMNS(MATCHNUM() AS m,ELEMENT_NUMBER(se) AS n,v1.id AS src,se.id AS edge_id,v2.id AS dst,
 COUNT(e.id) AS hops)) g ORDER BY m,n;
SELECT * FROM GRAPH_TABLE(graph_social MATCH
 (a IS person WHERE a.id=4)-[e IS knows]-{0,3}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY hops;
SELECT * FROM GRAPH_TABLE(graph_social MATCH TRAIL
 (a IS person WHERE a.id=4)-[e IS knows]-{0,3}(b IS person)
 COLUMNS(b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY hops;
DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;
--disable_query_log
--source mysql_test/test_suite/graph/mapping_fixture.sql
--enable_query_log
CREATE TABLE direction_expected AS
WITH RECURSIVE paths(seed,endpoint,hops,edges) AS (
 SELECT id,id,0,JSON_ARRAY() FROM graph_person
 UNION ALL
 SELECT p.seed,v.id,p.hops+1,JSON_ARRAY_APPEND(p.edges,'$',e.id)
 FROM paths p JOIN graph_knows e ON p.endpoint=e.src OR p.endpoint=e.dst
 JOIN graph_person v ON (p.endpoint=e.src AND v.id=e.dst) OR (p.endpoint=e.dst AND v.id=e.src)
 WHERE p.hops<3
) SELECT seed,endpoint,hops,CAST(edges AS CHAR(4000)) AS edges FROM paths;
SELECT COUNT(*) AS mismatch_groups FROM (
 SELECT seed,endpoint,hops,edges,SUM(weight) AS balance FROM (
 SELECT seed,endpoint,hops,edges,1 AS weight FROM direction_expected
 UNION ALL
 SELECT seed,endpoint,hops,CAST(COALESCE(edges,JSON_ARRAY()) AS CHAR(4000)),-1
 FROM GRAPH_TABLE(graph_social MATCH (a IS person)-[e IS knows]-{0,3}(b IS person)
 COLUMNS(a.id AS seed,b.id AS endpoint,COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edges)) g
 ) combined GROUP BY seed,endpoint,hops,edges HAVING balance<>0
) differences;
SELECT seed,hops,COUNT(*) AS paths FROM direction_expected GROUP BY seed,hops ORDER BY seed,hops;
DROP TABLE direction_expected;
DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;
