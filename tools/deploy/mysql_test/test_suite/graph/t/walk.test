  (a IS person)-[e IS knows WHERE b.id>1]->{1}(b IS person)
  COLUMNS(b.id AS id)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person WHERE a.id>1)
  COLUMNS(b.id AS id)) g;

DROP PROPERTY GRAPH graph_composite;
DROP TABLE gp_binding,gp_works,gp_company,gp_edge,gp_vertex;
DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;
