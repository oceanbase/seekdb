--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person)
  ONE ROW PER VERTEX (v) COLUMNS(v.id AS id)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(e.id AS edge_id)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(COUNT(b.id) AS hops)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(b.missing AS value)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person) COLUMNS(COUNT(e.missing) AS hops)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person)
  COLUMNS(ELEMENT_NUMBER(a) AS element_no)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person)-[e IS knows]->{1}(b IS person)
  ONE ROW PER STEP (v1,e,v2) COLUMNS(e.id AS edge_id)) g;
--error ER_NOT_SUPPORTED_YET
SELECT * FROM GRAPH_TABLE(graph_social MATCH
  (a IS person WHERE e.since>2020)-[e IS knows]->{1}(b IS person)
  COLUMNS(b.id AS id)) g;
