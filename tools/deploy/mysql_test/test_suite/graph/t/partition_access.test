--disable_query_log
DROP PROPERTY GRAPH IF EXISTS graph_partition_access;
--disable_warnings
DROP TABLE IF EXISTS graph_partition_edge,graph_partition_vertex;
--enable_warnings
--enable_query_log

CREATE TABLE graph_partition_vertex (
  tenant BIGINT NOT NULL,
  id BIGINT NOT NULL,
  name VARCHAR(16),
  PRIMARY KEY (tenant,id)
) PARTITION BY HASH(tenant) PARTITIONS 4;
CREATE TABLE graph_partition_edge (
  edge_tenant BIGINT NOT NULL,
  id BIGINT NOT NULL,
  src_tenant BIGINT,
  src BIGINT,
  dst_tenant BIGINT,
  dst BIGINT,
  PRIMARY KEY (edge_tenant,id)
) PARTITION BY HASH(edge_tenant) PARTITIONS 4;

INSERT INTO graph_partition_vertex VALUES
  (1,1,'A'),(2,2,'B'),(3,3,'C'),(4,4,'D');
INSERT INTO graph_partition_edge VALUES
  (1,10,1,1,2,2),
  (2,11,1,1,2,2),
  (3,12,2,2,3,3),
  (4,13,3,3,1,1),
  (1,14,4,4,4,4),
  (2,15,1,1,9,9),
  (3,16,9,9,3,3);

CREATE PROPERTY GRAPH graph_partition_access
  VERTEX TABLES (
    graph_partition_vertex KEY (tenant,id)
      LABEL node PROPERTIES (tenant,id,name)
  )
  EDGE TABLES (
    graph_partition_edge KEY (edge_tenant,id)
      SOURCE KEY (src_tenant,src)
        REFERENCES graph_partition_vertex (tenant,id)
      DESTINATION KEY (dst_tenant,dst)
        REFERENCES graph_partition_vertex (tenant,id)
      LABEL link PROPERTIES (edge_tenant,id)
  );

--echo partitioned_full_scan_out_paths
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=1 AND a.id=1)-[e IS link]->{0,3}(b IS node)
  COLUMNS(b.tenant AS destination_tenant,b.id AS destination_id,
          COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edge_ids)) g
ORDER BY hops,destination_tenant,destination_id,edge_ids;

--echo partitioned_full_scan_in_paths
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=3 AND a.id=3)<-[e IS link]-{1,3}(b IS node)
  COLUMNS(b.tenant AS destination_tenant,b.id AS destination_id,
          COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edge_ids)) g
ORDER BY hops,destination_tenant,destination_id,edge_ids;

--source mysql_test/include/create_plan_table.inc
--disable_result_log
EXPLAIN INTO plan_table SET statement_id='partition_out_full_scan'
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=1 AND a.id=1)-[e IS link]->{0,3}(b IS node)
  COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g;
EXPLAIN INTO plan_table SET statement_id='partition_in_full_scan'
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=3 AND a.id=3)<-[e IS link]-{1,3}(b IS node)
  COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g;
--enable_result_log
SELECT COUNT(*)=1 AS out_uses_partitioned_full_scan
FROM plan_table
WHERE statement_id='partition_out_full_scan'
  AND operator='GRAPH FEEDBACK LOOP'
  AND special_predicates LIKE '%direction=OUT, hops={0,3}, access=full-scan%';
SELECT COUNT(*)=1 AS in_uses_partitioned_full_scan
FROM plan_table
WHERE statement_id='partition_in_full_scan'
  AND operator='GRAPH FEEDBACK LOOP'
  AND special_predicates LIKE '%direction=IN, hops={1,3}, access=full-scan%';

CREATE INDEX graph_partition_out
  ON graph_partition_edge(src_tenant,src,edge_tenant,id);
CREATE INDEX graph_partition_in
  ON graph_partition_edge(dst_tenant,dst,edge_tenant,id);

--echo partitioned_out_index_matches_full_scan
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=1 AND a.id=1)-[e IS link]->{0,3}(b IS node)
  COLUMNS(b.tenant AS destination_tenant,b.id AS destination_id,
          COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edge_ids)) g
ORDER BY hops,destination_tenant,destination_id,edge_ids;

--echo partitioned_in_index_matches_full_scan
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=3 AND a.id=3)<-[e IS link]-{1,3}(b IS node)
  COLUMNS(b.tenant AS destination_tenant,b.id AS destination_id,
          COUNT(e.id) AS hops,JSON_ARRAYAGG(e.id) AS edge_ids)) g
ORDER BY hops,destination_tenant,destination_id,edge_ids;

--disable_result_log
EXPLAIN INTO plan_table SET statement_id='partition_out_index'
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=1 AND a.id=1)-[e IS link]->{0,3}(b IS node)
  COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g;
EXPLAIN INTO plan_table SET statement_id='partition_in_index'
SELECT * FROM GRAPH_TABLE(graph_partition_access MATCH
  (a IS node WHERE a.tenant=3 AND a.id=3)<-[e IS link]-{1,3}(b IS node)
  COLUMNS(b.id AS destination,COUNT(e.id) AS hops)) g;
--enable_result_log
SELECT COUNT(*)=1 AS out_uses_partitioned_adjacency_index
FROM plan_table
WHERE statement_id='partition_out_index'
  AND operator='GRAPH FEEDBACK LOOP'
  AND special_predicates LIKE '%direction=OUT, hops={0,3}, access=index-scan%';
SELECT COUNT(*)=1 AS in_uses_partitioned_adjacency_index
FROM plan_table
WHERE statement_id='partition_in_index'
  AND operator='GRAPH FEEDBACK LOOP'
  AND special_predicates LIKE '%direction=IN, hops={1,3}, access=index-scan%';

DROP TABLE plan_table;
DROP PROPERTY GRAPH graph_partition_access;
DROP TABLE graph_partition_edge,graph_partition_vertex;
