--disable_query_log
DROP PROPERTY GRAPH IF EXISTS graph_social;
--disable_warnings
DROP TABLE IF EXISTS graph_works,graph_knows,graph_company,graph_person;
--enable_warnings
--source mysql_test/test_suite/graph/mapping_fixture.sql
--enable_query_log
--disable_warnings
DROP USER IF EXISTS graph_reader;
--enable_warnings
CREATE USER graph_reader IDENTIFIED BY 'graph_test';
GRANT SELECT ON test.graph_person TO graph_reader;
connect (graph_reader_conn,$OBMYSQL_MS0,graph_reader,graph_test,test,$OBMYSQL_PORT);
SHOW CREATE PROPERTY GRAPH graph_social;
SELECT COUNT(*) FROM GRAPH_TABLE(graph_social MATCH(p IS person) COLUMNS(p.id AS id)) g;
--error ER_TABLEACCESS_DENIED_ERROR
SELECT COUNT(*) FROM GRAPH_TABLE(graph_social MATCH(a IS person)-[e IS knows]->(b IS person) COLUMNS(e.id AS id)) g;
--error ER_TABLEACCESS_DENIED_ERROR
SELECT * FROM GRAPH_TABLE(graph_social MATCH(a IS person WHERE a.id=1)-[e IS knows]->{1,2}(b IS person) COLUMNS(b.id AS destination,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY destination,CAST(edges AS CHAR);
--error ER_DBACCESS_DENIED_ERROR,ER_TABLEACCESS_DENIED_ERROR
DROP PROPERTY GRAPH graph_social;
connection default;
REVOKE SELECT ON test.graph_person FROM graph_reader;
connection graph_reader_conn;
--error ER_DBACCESS_DENIED_ERROR
SHOW CREATE PROPERTY GRAPH graph_social;
--error ER_TABLEACCESS_DENIED_ERROR
SELECT COUNT(*) FROM GRAPH_TABLE(graph_social MATCH(p IS person) COLUMNS(p.id AS id)) g;
connection default;
GRANT SELECT(id) ON test.graph_person TO graph_reader;
connection graph_reader_conn;
SELECT id FROM GRAPH_TABLE(graph_social MATCH(p IS person) COLUMNS(p.id AS id)) g ORDER BY id;
--error ER_COLUMNACCESS_DENIED_ERROR,ER_TABLEACCESS_DENIED_ERROR
SELECT name FROM GRAPH_TABLE(graph_social MATCH(p IS person) COLUMNS(p.name AS name)) g;
--error ER_DBACCESS_DENIED_ERROR
CREATE PROPERTY GRAPH graph_denied VERTEX TABLES(graph_person KEY(id) LABEL person PROPERTIES(id));
connection default;
--error ER_NO_SUCH_TABLE
SHOW CREATE PROPERTY GRAPH graph_denied;
GRANT SELECT(id,src,dst) ON test.graph_knows TO graph_reader;
connection graph_reader_conn;
--echo native_path_with_only_required_columns
SELECT * FROM GRAPH_TABLE(graph_social MATCH(a IS person WHERE a.id=1)-[e IS knows]->{1,2}(b IS person) COLUMNS(b.id AS destination,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY destination,CAST(edges AS CHAR);
--echo filter_only_column_requires_select
--error ER_COLUMNACCESS_DENIED_ERROR,ER_TABLEACCESS_DENIED_ERROR
SELECT * FROM GRAPH_TABLE(graph_social MATCH(a IS person WHERE a.id=1)-[e IS knows WHERE e.since>=2021]->{1,2}(b IS person) COLUMNS(b.id AS destination,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY destination,CAST(edges AS CHAR);
connection default;
GRANT SELECT(since) ON test.graph_knows TO graph_reader;
connection graph_reader_conn;
PREPARE graph_native_auth FROM 'SELECT * FROM GRAPH_TABLE(graph_social MATCH(a IS person WHERE a.id=1)-[e IS knows WHERE e.since>=2021]->{1,2}(b IS person) COLUMNS(b.id AS destination,JSON_ARRAYAGG(e.id) AS edges)) g ORDER BY destination,CAST(edges AS CHAR)';
EXECUTE graph_native_auth;
connection default;
REVOKE SELECT(since) ON test.graph_knows FROM graph_reader;
connection graph_reader_conn;
--error ER_COLUMNACCESS_DENIED_ERROR,ER_TABLEACCESS_DENIED_ERROR
EXECUTE graph_native_auth;
connection default;
GRANT SELECT(since) ON test.graph_knows TO graph_reader;
connection graph_reader_conn;
EXECUTE graph_native_auth;
DEALLOCATE PREPARE graph_native_auth;
connection default;
disconnect graph_reader_conn;
DROP USER graph_reader;
DROP PROPERTY GRAPH graph_social;
DROP TABLE graph_works,graph_knows,graph_company,graph_person;
