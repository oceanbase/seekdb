SELECT COUNT(*) = 4 AS fixed_component_rows
FROM oceanbase.V$OB_COMPONENT_MEMORY;
fixed_component_rows
1
SELECT GROUP_CONCAT(COMPONENT_NAME ORDER BY COMPONENT_NAME SEPARATOR ',') AS components
FROM oceanbase.V$OB_COMPONENT_MEMORY;
components
KV_CACHE,META_OBJECT,SQL_WORKAREA,VECTOR
SELECT COUNT(*) = 0 AS invalid_atomic_fields
FROM oceanbase.V$OB_COMPONENT_MEMORY
WHERE LIMIT_BYTES < 0 OR COMMITTED_BYTES < 0 OR RESERVED_BYTES < 0
OR REJECT_COUNT < 0 OR RECLAIM_COUNT < 0;
invalid_atomic_fields
1
SELECT COUNT(*) = 0 AS forbidden_consistency_columns
FROM information_schema.columns
WHERE table_schema = 'oceanbase'
  AND lower(table_name) = 'v$ob_component_memory'
  AND upper(column_name) IN ('IS_CONSISTENT', 'SNAPSHOT_EPOCH');
forbidden_consistency_columns
1
