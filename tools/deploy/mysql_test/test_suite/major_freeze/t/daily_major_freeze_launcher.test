#owner: donglou.zl
#owner group: rootserver
#tags: daily major freeze launcher

connect (sys_conn,$OBMYSQL_MS0,admin,$OBMYSQL_PWD,oceanbase,$OBMYSQL_PORT);
connection sys_conn;

--disable_query_log
let $major_freeze_duty_time_ori = query_get_value(select value from oceanbase.__all_virtual_sys_parameter_stat where name = 'major_freeze_duty_time' limit 1, value, 1);
let $enable_major_freeze_ori = query_get_value(select value from oceanbase.__all_virtual_sys_parameter_stat where name = 'enable_major_freeze' limit 1, value, 1);
--enable_query_log
let $frozen_scn_ori = query_get_value(select frozen_scn from oceanbase.DBA_OB_MAJOR_COMPACTION, frozen_scn, 1);
alter system set major_freeze_duty_time = 'Disable';
alter system set enable_major_freeze = true;
let $interval_minute = 1;
let $interval_second = query_get_value(select '$interval_minute' * 60 as value, value, 1);
--source mysql_test/include/wait_daily_merge.inc

connection sys_conn;
alter system set enable_major_freeze = true;
let $next_launch_time = query_get_value("select substr(date_add(current_time(), interval $interval_minute minute), 1, 5) as value;", value, 1);
--disable_query_log
eval alter system set major_freeze_duty_time = '$next_launch_time';
--enable_query_log
sleep $interval_second;
# sleep another 10s to ensure daily_major_freeze_launcher launch one round of major_freeze
sleep 10;
--source mysql_test/include/wait_daily_merge.inc

connection sys_conn;
--disable_query_log
eval alter system set major_freeze_duty_time = '$major_freeze_duty_time_ori';
eval alter system set enable_major_freeze = '$enable_major_freeze_ori';
sleep 3;
--enable_query_log
let $cur_frozen_scn = query_get_value(select frozen_scn from oceanbase.DBA_OB_MAJOR_COMPACTION, frozen_scn, 1);
if ($cur_frozen_scn == $frozen_scn_ori)
{
    --echo daily major freeze launch failed
}
