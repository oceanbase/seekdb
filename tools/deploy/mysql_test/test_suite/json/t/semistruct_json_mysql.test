# owner: aozeliu.azl
# owner group: shenzhen
# description: verify semistruct encoding is no longer supported

--disable_warnings
drop table if exists json_test;
--enable_warnings

--error 1235
create table json_test(pk int primary key, j json) row_format=COMPRESSED SEMISTRUCT_ENCODING_TYPE='encoding';

create table json_test(pk int primary key, j json);
--error 1235
alter table json_test set SEMISTRUCT_ENCODING_TYPE = 'encoding';
drop table json_test;
