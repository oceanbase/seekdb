DROP DATABASE IF EXISTS ddl_identifier_quoting;
CREATE DATABASE ddl_identifier_quoting;
USE ddl_identifier_quoting;
CREATE TABLE quoted_columns (
id INT PRIMARY KEY,
`enum``value` ENUM('a','b'),
`set````value` SET('x','y'),
n INT);
INSERT INTO quoted_columns VALUES
(1,'a','x',NULL),(2,'b','x,y',2),(3,'a','y',3);
CREATE UNIQUE INDEX type_idx
ON quoted_columns (`enum``value`,`set````value`,n);
SET @table_id = (
SELECT table_id FROM oceanbase.__all_table
WHERE table_name = 'quoted_columns'
AND database_id = (
SELECT database_id FROM oceanbase.__all_database
WHERE database_name = DATABASE()));
SELECT COUNT(*) AS usable_index
FROM oceanbase.__all_table
WHERE table_name = CONCAT('__idx_', @table_id, '_type_idx')
AND index_status = 2;
usable_index
1
SELECT id,
CAST(`enum``value` AS UNSIGNED) AS enum_ordinal,
CAST(`set````value` AS UNSIGNED) AS set_bits,
n
FROM quoted_columns ORDER BY id;
id	enum_ordinal	set_bits	n
1	1	1	NULL
2	2	3	2
3	1	2	3
USE test;
DROP DATABASE ddl_identifier_quoting;
