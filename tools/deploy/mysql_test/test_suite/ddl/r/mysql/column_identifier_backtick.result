result_format: 4


drop table if exists column_identifier_backtick;
create table column_identifier_backtick (
  id bigint primary key,
  `plain``name` int,
  ```leading` enum('one', 'two'),
  `trailing``` set('red', 'blue'),
  `中文``列` varchar(20),
  unique key `uk``quoted` (`plain``name`)
);
insert into column_identifier_backtick values
  (1, 10, 'one', 'red,blue', 'value');
alter table column_identifier_backtick add unique key `uk``enum` (```leading`);
alter table column_identifier_backtick add unique key `uk``set` (`trailing```);
alter table column_identifier_backtick add unique key `uk``utf8` (`中文``列`);
select id,
       `plain``name` as plain_name,
       ```leading` as leading_value,
       `trailing``` as trailing_value
  from column_identifier_backtick;
+----+------------+---------------+----------------+
| id | plain_name | leading_value | trailing_value |
+----+------------+---------------+----------------+
|  1 |         10 | one           | red,blue       |
+----+------------+---------------+----------------+
drop table column_identifier_backtick;
