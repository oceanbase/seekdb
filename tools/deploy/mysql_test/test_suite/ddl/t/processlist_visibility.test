# PROCESSLIST only exposes peer sessions to users with PROCESS privilege.
--disable_warnings
DROP USER IF EXISTS 'processlist_owner'@'%';
DROP USER IF EXISTS 'processlist_plain'@'%';
DROP USER IF EXISTS 'processlist_admin'@'%';
DROP ROLE IF EXISTS processlist_monitor;
--enable_warnings
CREATE USER 'processlist_owner'@'%';
CREATE USER 'processlist_plain'@'%';
CREATE USER 'processlist_admin'@'%';
CREATE ROLE processlist_monitor;
GRANT PROCESS ON *.* TO processlist_monitor;
GRANT processlist_monitor TO 'processlist_admin'@'%';
connect (processlist_victim,$OBMYSQL_MS0,processlist_owner,,information_schema,$OBMYSQL_PORT);
--disable_reconnect
let $victim_id = query_get_value(SELECT CONNECTION_ID() AS id, id, 1);
connect (processlist_plain,$OBMYSQL_MS0,processlist_plain,,information_schema,$OBMYSQL_PORT);
SELECT CURRENT_USER() AS actor;
--disable_query_log
eval SET @victim_id = $victim_id;
--enable_query_log
SELECT COUNT(*) AS visible_peer_sessions FROM information_schema.processlist WHERE ID = @victim_id;
connection processlist_victim;
SELECT 1 AS victim_alive;
connection default;
disconnect processlist_plain;
connect (processlist_admin,$OBMYSQL_MS0,processlist_admin,,information_schema,$OBMYSQL_PORT);
SELECT CURRENT_USER() AS actor;
--disable_query_log
eval SET @victim_id = $victim_id;
--enable_query_log
SET ROLE NONE;
SELECT COUNT(*) AS visible_peer_sessions FROM information_schema.processlist WHERE ID = @victim_id;
SET ROLE ALL;
SELECT COUNT(*) AS visible_peer_sessions FROM information_schema.processlist WHERE ID = @victim_id;
connection processlist_victim;
SELECT 1 AS victim_alive;
connection default;
disconnect processlist_victim;
disconnect processlist_admin;
DROP USER 'processlist_owner'@'%';
DROP USER 'processlist_plain'@'%';
DROP USER 'processlist_admin'@'%';
DROP ROLE processlist_monitor;
