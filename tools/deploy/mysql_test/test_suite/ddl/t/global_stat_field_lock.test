##owner: wangyunlai.wyl
##description: Verify that GlobalStat incremental updates lock only their target field
##tags: ddl bootstrap global_stat concurrency

--disable_warnings
drop table if exists seek541_cross_field;
drop table if exists seek541_same_field;
drop table if exists seek541_missing_normal;
drop table if exists seek541_global_stat_eav;
--enable_warnings

connect (lock_sys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connect (probe_sys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connect (eav_low,$OBMYSQL_MS0,admin,admin,test,$OBMYSQL_PORT);
connect (eav_high,$OBMYSQL_MS0,admin,admin,test,$OBMYSQL_PORT);

connection default;
set ob_query_timeout = 10000000;
set ob_trx_timeout = 10000000;

--echo T1: holding baseline_schema_version must not block a real DDL normal-schema update
connection lock_sys;
set ob_query_timeout = 10000000;
set ob_trx_timeout = 10000000;
start transaction;
select count(*) as locked_baseline_rows
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'baseline_schema_version'
 for update;
connection default;
send create table seek541_cross_field(c1 int);
connection probe_sys;
--sleep 1
connection default;
reap;
connection lock_sys;
rollback;
connection default;
drop table seek541_cross_field;

--echo T3: two writers of normal_schema_version remain serialized
connection probe_sys;
select cast(column_value as signed) into @normal_before
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'normal_schema_version';
connection lock_sys;
start transaction;
select count(*) as locked_normal_rows
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'normal_schema_version'
 for update;
connection default;
let $ddl_session_id=query_get_value(select connection_id() as id, id, 1);
send create table seek541_same_field(c1 int);
connection probe_sys;
--sleep 1
let $ddl_pending=query_get_value(select count(*) as pending from oceanbase.__all_virtual_processlist where id = $ddl_session_id and info like '%seek541_same_field%', pending, 1);
--disable_query_log
eval select $ddl_pending as ddl_pending_before_release;
--enable_query_log
connection lock_sys;
rollback;
connection default;
reap;
connection probe_sys;
select cast(column_value as signed) > @normal_before as normal_schema_version_advanced
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'normal_schema_version';
connection default;
drop table seek541_same_field;

--echo T4: an existing logical row with a missing normal field is restored at row_id 1
connection lock_sys;
select column_value into @baseline_before
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'baseline_schema_version';
delete from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'normal_schema_version';
select count(*) = 0 as normal_is_missing
  from __all_core_table
 where table_name = '__all_global_stat'
   and column_name = 'normal_schema_version';
connection default;
create table seek541_missing_normal(c1 int);
connection lock_sys;
select count(*) = 1 as normal_restored_once
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'normal_schema_version';
select count(*) = 0 as no_extra_logical_row
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id <> 1;
select @baseline_before = column_value as baseline_unchanged
  from __all_core_table
 where table_name = '__all_global_stat'
   and row_id = 1
   and column_name = 'baseline_schema_version';
connection default;
drop table seek541_missing_normal;

--echo T6: the same atomic ODKU shape handles a missing field under two writers
create table seek541_global_stat_eav (
  table_name varchar(128) not null,
  row_id bigint not null,
  column_name varchar(128) not null,
  column_value varchar(128) not null,
  primary key (table_name, row_id, column_name)
);
insert into seek541_global_stat_eav values ('__all_global_stat', 1, 'sentinel', 'unchanged');

--echo Low value is inserted first, then the higher value wins after waiting
connection eav_low;
start transaction;
insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values (X'5f5f616c6c5f676c6f62616c5f73746174', 1, X'626173656c696e655f736368656d615f76657273696f6e', X'313030')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
connection eav_high;
start transaction;
send insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values (X'5f5f616c6c5f676c6f62616c5f73746174', 1, X'626173656c696e655f736368656d615f76657273696f6e', X'323030')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
connection probe_sys;
--sleep 1
connection eav_low;
commit;
connection eav_high;
reap;
commit;
connection default;
select column_value as low_then_high_value
  from seek541_global_stat_eav
 where column_name = 'baseline_schema_version';

--echo Higher value is inserted first, then the lower writer succeeds without rollback
delete from seek541_global_stat_eav where column_name = 'baseline_schema_version';
connection eav_high;
start transaction;
insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values (X'5f5f616c6c5f676c6f62616c5f73746174', 1, X'626173656c696e655f736368656d615f76657273696f6e', X'323030')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
connection eav_low;
start transaction;
send insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values (X'5f5f616c6c5f676c6f62616c5f73746174', 1, X'626173656c696e655f736368656d615f76657273696f6e', X'313030')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
connection probe_sys;
--sleep 1
connection eav_high;
commit;
connection eav_low;
reap;
commit;
connection default;
select column_value as high_then_low_value
  from seek541_global_stat_eav
 where column_name = 'baseline_schema_version';
select count(*) = 1 as target_field_unique
  from seek541_global_stat_eav
 where row_id = 1 and column_name = 'baseline_schema_version';
select count(*) = 0 as no_row_id_2
  from seek541_global_stat_eav
 where row_id = 2;
select column_value = 'unchanged' as sentinel_unchanged
  from seek541_global_stat_eav
 where row_id = 1 and column_name = 'sentinel';

--echo Different target fields do not block one another in the equivalent EAV schema
connection eav_low;
start transaction;
insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values ('__all_global_stat', 1, 'normal_schema_version', '300')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
connection eav_high;
start transaction;
insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values ('__all_global_stat', 1, 'baseline_schema_version', '400')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
commit;
connection eav_low;
commit;

--echo Smaller values are no-ops and -1 retains its existing special overwrite behavior
connection default;
insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values ('__all_global_stat', 1, 'baseline_schema_version', '350')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
select column_value as lower_value_noop
  from seek541_global_stat_eav
 where column_name = 'baseline_schema_version';
insert into seek541_global_stat_eav (table_name, row_id, column_name, column_value)
values ('__all_global_stat', 1, 'baseline_schema_version', '-1')
on duplicate key update column_value = if(cast(column_value as signed) > values(column_value)
  and values(column_value) != -1, column_value, values(column_value));
select column_value as invalid_version_overwrite
  from seek541_global_stat_eav
 where column_name = 'baseline_schema_version';

disconnect lock_sys;
disconnect probe_sys;
disconnect eav_low;
disconnect eav_high;
drop table seek541_global_stat_eav;
