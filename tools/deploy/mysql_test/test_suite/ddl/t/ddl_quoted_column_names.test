# DDL copy SQL must escape each literal backtick in column names, including
# ENUM/SET column values and the primary key of a nullable unique index.
--disable_query_log
SET @saved_query_timeout = @@session.ob_query_timeout;
SET @saved_trx_timeout = @@session.ob_trx_timeout;
SET SESSION ob_query_timeout = 60000000;
SET SESSION ob_trx_timeout = 120000000;
--enable_query_log
--disable_warnings
DROP DATABASE IF EXISTS ddl_quoted_column_names;
--enable_warnings
CREATE DATABASE ddl_quoted_column_names;
USE ddl_quoted_column_names;

CREATE TABLE quoted_enum_set (
  `key````id` INT PRIMARY KEY,
  `plain``value` INT,
  `enum````kind` ENUM('red', 'green', 'blue'),
  `set````flags` SET('x', 'y'));
INSERT INTO quoted_enum_set VALUES
  (1, 10, 'red', 'x'), (2, 20, 'green', 'x,y'), (3, 30, 'blue', 'y'),
  (4, 40, NULL, NULL), (5, 50, NULL, NULL);
CREATE UNIQUE INDEX uq_enum_set ON quoted_enum_set (`enum````kind`, `set````flags`);
SELECT `key````id` AS id, `plain``value` AS plain_value,
  `enum````kind` AS enum_value, CAST(`enum````kind` AS UNSIGNED) AS enum_number,
  `set````flags` AS set_value, CAST(`set````flags` AS UNSIGNED) AS set_number
FROM quoted_enum_set FORCE INDEX (uq_enum_set) ORDER BY `key````id`;

# A zero delta threshold forces a rebuild, even for this small fixture.
# Plain table/database/vector-column names isolate column-name formatting
# from the separate database/table-name quoting paths in vector maintenance.
CREATE TABLE quoted_vectors (
  `key````id` INT PRIMARY KEY,
  `plain``value` INT,
  embedding VECTOR(3),
  VECTOR INDEX v_idx(embedding) WITH (distance=l2, type=hnsw, lib=vsag));
INSERT INTO quoted_vectors VALUES
  (1, 10, '[1,0,0]'), (2, 20, '[0,1,0]'), (3, 30, '[0,0,1]');
SELECT /*+ INDEX(quoted_vectors v_idx) */ `key````id` AS nearest_id
FROM quoted_vectors ORDER BY l2_distance(embedding, '[1,0,0]') APPROXIMATE LIMIT 1;
CALL DBMS_VECTOR.REBUILD_INDEX('v_idx', 'quoted_vectors', 'embedding', 0.0);
SELECT `key````id` AS id, `plain``value` AS plain_value
FROM quoted_vectors ORDER BY `key````id`;
--replace_column 7 #
SHOW INDEX FROM quoted_vectors;
SELECT /*+ INDEX(quoted_vectors v_idx) */ `key````id` AS nearest_id
FROM quoted_vectors ORDER BY l2_distance(embedding, '[1,0,0]') APPROXIMATE LIMIT 1;

DROP DATABASE ddl_quoted_column_names;
USE test;
--disable_query_log
SET SESSION ob_query_timeout = @saved_query_timeout;
SET SESSION ob_trx_timeout = @saved_trx_timeout;
--enable_query_log
