# owner: shenwei
# owner group: competition
# description: DDL identifier escaping for database and table names (#1469)
#
# Shared DDL builds inner SQL by interpolating database and table names between
# backticks. A legal identifier containing a backtick was therefore emitted
# unescaped and the generated statement failed to parse (ERROR 1064). These
# cases cover CHECK validation, foreign-key validation, backtick database
# names, and the plain-identifier regression path.

--result_format 4
connect (obsys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connection obsys;

--disable_warnings
drop database if exists ddl_ident;
drop database if exists `ddl``bt`;
--enable_warnings

#
# 1. plain identifiers must keep working (regression control)
#
create database ddl_ident;
use ddl_ident;

create table t_plain (id int primary key, v int);
insert into t_plain values (1, 10);
alter table t_plain add constraint ck_plain check (v > 0);
show create table t_plain;
insert into t_plain values (2, 20);
select id, v from t_plain order by id;

#
# 2. backtick table name + CHECK constraint
#
create table `t``ck` (id int primary key, v int);
insert into `t``ck` values (1, 5);
alter table `t``ck` add constraint ck_bt check (v > 0);
show create table `t``ck`;
insert into `t``ck` values (2, 6);
update `t``ck` set v = 7 where id = 2;
select id, v from `t``ck` order by id;

#
# 3. backtick table names in a foreign key
#
create table `p``k` (id int primary key);
create table `c``k` (id int primary key, pid int);
insert into `p``k` values (1);
insert into `c``k` values (10, 1);
alter table `c``k` add constraint fk_bt foreign key (pid) references `p``k`(id);
show create table `c``k`;
insert into `c``k` values (11, 1);
select id, pid from `c``k` order by id;

#
# 4. backtick database name and backtick table name together
#
create database `ddl``bt`;
create table `ddl``bt`.`t``db` (id int primary key, v int);
insert into `ddl``bt`.`t``db` values (1, 1);
alter table `ddl``bt`.`t``db` add constraint ck_db check (v > 0);
show create table `ddl``bt`.`t``db`;
insert into `ddl``bt`.`t``db` values (2, 2);
select id, v from `ddl``bt`.`t``db` order by id;

#
# 5. constraint metadata is visible in the dictionary
#
select table_name, constraint_name, constraint_type
  from information_schema.table_constraints
 where table_schema in ('ddl_ident', 'ddl`bt')
 order by table_schema, table_name, constraint_name;

#
# cleanup
#
drop database ddl_ident;
drop database `ddl``bt`;
