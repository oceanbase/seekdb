SET NAMES utf8mb4;
SET ob_query_timeout = 100000000;
CREATE DATABASE IF NOT EXISTS fts_score_regression;
USE fts_score_regression;
DROP TABLE IF EXISTS docs;
CREATE TABLE docs (id INT PRIMARY KEY, body TEXT, FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO docs VALUES (1,'ocean database database'),(2,'ocean search'),(3,'unrelated document'),(4,''),(5,NULL);
SELECT id FROM docs WHERE MATCH(body) AGAINST('ocean') ORDER BY id;
id
1
2
SELECT id FROM docs WHERE MATCH(body) AGAINST('ocean') > 0 ORDER BY id;
id
1
2
SELECT id FROM docs WHERE 0 < MATCH(body) AGAINST('ocean') ORDER BY id;
id
1
2
SELECT id, ROUND(MATCH(body) AGAINST('ocean'),6) AS score FROM docs WHERE MATCH(body) AGAINST('ocean') > 0 ORDER BY score DESC,id;
id	score
2	0.500161
1	0.471490
SELECT id FROM docs WHERE MATCH(body) AGAINST('ocean') > 0.5 ORDER BY id;
id
2
SELECT id FROM docs WHERE MATCH(body) AGAINST('ocean') > 0 ORDER BY MATCH(body) AGAINST('ocean') DESC,id LIMIT 1;
id
2
SELECT COUNT(*) AS missing_hits FROM docs WHERE MATCH(body) AGAINST('xyzunknown') > 0;
missing_hits
0
SELECT COUNT(*) AS empty_hits FROM docs WHERE MATCH(body) AGAINST('') > 0;
empty_hits
0
PREPARE stmt FROM 'SELECT id FROM docs WHERE MATCH(body) AGAINST(?) > ? ORDER BY id';
SET @term = 'ocean', @threshold = 0;
EXECUTE stmt USING @term,@threshold;
id
1
2
SET @threshold = 1;
EXECUTE stmt USING @term,@threshold;
id
SET @threshold = 0;
EXECUTE stmt USING @term,@threshold;
id
1
2
DEALLOCATE PREPARE stmt;
SELECT TOKENIZE(_utf8mb4'café CAFE cafe' COLLATE utf8mb4_general_ci,'beng','[{"output":"all"}]');
TOKENIZE(_utf8mb4'café CAFE cafe' COLLATE utf8mb4_general_ci,'beng','[{"output":"all"}]')
{"tokens": [{"cafe": 3}], "doc_len": 3}
SELECT TOKENIZE(_utf8mb4'THE thé database database' COLLATE utf8mb4_bin,'beng','[{"output":"all"}]');
TOKENIZE(_utf8mb4'THE thé database database' COLLATE utf8mb4_bin,'beng','[{"output":"all"}]')
{"tokens": [{"database": 2}], "doc_len": 2}
SELECT TOKENIZE(_latin1'hello world hello','beng','[{"output":"all"}]');
ERROR 42000: Incorrect parameters in the call to native function 'TOKENIZE'
SELECT id FROM docs FORCE INDEX(ft) WHERE MATCH(body) AGAINST('ocean') > 0 ORDER BY id;
id
1
2
SELECT id FROM docs FORCE INDEX(ft) WHERE MATCH(body) AGAINST('ocean database') > 0 ORDER BY id;
id
1
2
