SET NAMES utf8mb4;
CREATE DATABASE IF NOT EXISTS fts_beng_ascii;
USE fts_beng_ascii;
DROP TABLE IF EXISTS codes;
CREATE TABLE codes(n INT PRIMARY KEY);
INSERT INTO codes VALUES(0),(1),(2),(3),(4),(5),(6),(7);
INSERT INTO codes SELECT n+8 FROM codes;
INSERT INTO codes SELECT n+16 FROM codes;
INSERT INTO codes SELECT n+32 FROM codes;
INSERT INTO codes SELECT n+64 FROM codes;
SELECT n,TOKENIZE(CONCAT('alpha',CONVERT(CHAR(n) USING utf8mb4),'beta'),'beng','[{"output":"all"}]') FROM codes ORDER BY n;
