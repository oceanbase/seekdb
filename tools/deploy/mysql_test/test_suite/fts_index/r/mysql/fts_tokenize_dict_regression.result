========= block 1: ik fixed literal outputs =========
select tokenize('全文索引是数据库的一种高效检索技术', 'ik') as i1;
i1
["一种", "高效", "是", "数据库", "技术", "全文索引", "检索", "的"]
select tokenize('倒排索引倒排索引检索检索检索', 'ik') as i2;
i2
["倒排", "索引", "检索"]
select tokenize('a,,b;;;c,,,d!!!???。。。？？！', 'ik') as i3;
i3
["a", "c", "b", "d"]
select tokenize('中English混合text测试2026', 'ik') as i4;
i4
["text", "中", "混合", "2026", "english", "测试"]
select tokenize('一', 'ik') as i5;
i5
["一"]
select tokenize('一一一', 'ik') as i6;
i6
["一一一"]
========= block 2: beng fixed literal outputs =========
select tokenize('The quick brown fox jumps over the lazy dog', 'beng') as b1;
b1
["lazy", "over", "quick", "dog", "brown", "fox", "jumps"]
select tokenize('database database Database DATABASE', 'beng') as b2;
b2
["database"]
select tokenize('full-text well-known state-of-the-art', 'beng') as b3;
b3
["text", "well", "full", "known", "state", "art"]
select tokenize('a', 'beng') as b4;
b4
[]
select tokenize('aaa', 'beng') as b5;
b5
["aaa"]
========= block 3: repeated words keep aggregated counts =========
select tokenize('alpha beta alpha gamma alpha', 'beng', '[{"output": "all"}]') as n1;
n1
{"tokens": [{"gamma": 1}, {"alpha": 3}, {"beta": 1}], "doc_len": 5}
select tokenize('优化 优化 数据库 优化 全文索引 数据库 优化', 'ik', '[{"output": "all"}]') as n2;
n2
{"tokens": [{"优化": 4}, {"数据库": 2}, {"全文索引": 1}], "doc_len": 7}
select tokenize('检索 系统 检索 数据库 检索', 'ik', '[{"output": "all"}]') as n3;
n3
{"tokens": [{"数据库": 1}, {"检索": 3}, {"系统": 1}], "doc_len": 5}
