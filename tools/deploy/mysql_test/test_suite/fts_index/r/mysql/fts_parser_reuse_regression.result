========= two sessions interleaved (thread-local pools, no cross-talk) =========
select tokenize('会话一：中文分词', 'ik');
tokenize('会话一：中文分词', 'ik')
["会话", "分词", "中文", "一"]
select tokenize('session two: english tokenization', 'beng');
tokenize('session two: english tokenization', 'beng')
["session", "tokenization", "two", "english"]
select tokenize('会话一：中文分词', 'ik');
tokenize('会话一：中文分词', 'ik')
["会话", "分词", "中文", "一"]
select tokenize('session two: english tokenization', 'beng');
tokenize('session two: english tokenization', 'beng')
["session", "tokenization", "two", "english"]
select tokenize('并发会话一：ik', 'ik');;
select tokenize('并发会话二：beng english', 'beng');
tokenize('并发会话二：beng english', 'beng')
["并发会话二：beng", "english"]
tokenize('并发会话一：ik', 'ik')
["会话", "并发", "一", "ik"]
select tokenize('并发会话二：ik', 'ik');;
select tokenize('并发会话一：beng english', 'beng');
tokenize('并发会话一：beng english', 'beng')
["并发会话一：beng", "english"]
tokenize('并发会话二：ik', 'ik')
["二", "会话", "并发", "ik"]
========= output mode and other parser kinds still fine =========
select tokenize('hello world', 'ik', '[{"output": "all"}]');
tokenize('hello world', 'ik', '[{"output": "all"}]')
{"tokens": [{"world": 1}, {"hello": 1}], "doc_len": 2}
select tokenize('a b c', 'space');
tokenize('a b c', 'space')
[]
select tokenize('你好，世界！这是一个测试：分词器，能处理标点吗？', 'ik');
tokenize('你好，世界！这是一个测试：分词器，能处理标点吗？', 'ik')
["吗", "处理", "能", "分词器", "世界", "一个", "这是", "测试", "你好", "标点"]
========= repeat of the alternating block (run-to-run stability) =========
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik');
tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik')
["full-text", "oceanbase", "稳定", "是", "支持", "的", "一款", "search", "分布式数据库"]
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng');
tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng')
["text", "oceanbase是一款稳定的分布式数据库，支持full", "search"]
