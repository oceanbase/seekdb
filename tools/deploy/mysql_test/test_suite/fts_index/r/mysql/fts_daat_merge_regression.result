DROP TABLE IF EXISTS fts_daat_merge_regression;
create table fts_daat_merge_regression(
id bigint auto_increment primary key,
title varchar(256) not null,
content text not null,
fulltext key fts_dmr_tc(title, content) with parser ik PARSER_PROPERTIES=(ik_mode='smart'),
fulltext key fts_dmr_c(content) with parser ik PARSER_PROPERTIES=(ik_mode='smart')
);
insert into fts_daat_merge_regression(title, content) values
('数据库全文索引', '数据库与全文索引基础概念'),
('分词器入门', '分词器把文本切分为词项'),
('倒排索引原理', '倒排索引是全文索引的核心结构'),
('分词器分词器分词器', '分词器 分词器 分词器 重复词项'),
('OceanBase 数据库', 'OceanBase 是稳定的数据库'),
('数据库数据库数据库', '数据库 数据库 数据库 重复词项'),
('检索与分词器', '检索质量取决于分词器实现'),
('稳定的搜索引擎', '稳定高效的全文检索引擎'),
('OceanBase 稳定内核', 'OceanBase 数据库内核稳定高效'),
('性能优化', '查询性能优化与索引设计'),
('倒排索引压缩', '倒排索引压缩编码降低存储成本'),
('数据库与倒排索引', '数据库与倒排索引结合使用'),
('分词器与数据库', '分词器配合数据库支撑全文索引');
