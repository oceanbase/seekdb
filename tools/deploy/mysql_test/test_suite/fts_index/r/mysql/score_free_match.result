drop database if exists fts_score_free_match;
create database fts_score_free_match;
use fts_score_free_match;
create table t_ik(
id int primary key,
title varchar(100),
body varchar(200),
category varchar(10),
fulltext index ft_ik(title, body) with parser ik);
create table t_def(
id int primary key,
body varchar(200),
category varchar(10),
fulltext index ft_def(body));
insert into t_ik values
(1, 'oceanbase storage engine', 'storage engine keeps rows on disk', 'a'),
(2, 'query optimizer notes', 'the optimizer chooses a plan for each query', 'b'),
(3, 'fulltext index basics', 'a fulltext index speeds up the text query', 'a'),
(4, 'relevance scoring', 'bm25 relevance scoring ranks the matching rows', 'c'),
(5, 'vector search intro', 'vector search returns the nearest neighbours', 'd'),
(6, 'storage benchmark report', 'a storage benchmark measures disk throughput', 'b'),
(7, 'query rewrite tips', 'query rewrite changes the plan of a query', 'c'),
(8, 'index merge notes', 'an index merge combines two index scans', 'd'),
(9, 'disk space report', 'disk space usage of the storage layer', 'a'),
(10, 'text analysis basics', 'text analysis splits a document into tokens', 'b');
insert into t_def values
(1, 'storage engine keeps rows on disk', 'a'),
(2, 'the optimizer chooses a plan for each query', 'b'),
(3, 'a fulltext index speeds up the text query', 'a'),
(4, 'bm25 relevance scoring ranks the matching rows', 'c'),
(5, 'vector search returns the nearest neighbours', 'd'),
(6, 'a storage benchmark measures disk throughput', 'b'),
(7, 'query rewrite changes the plan of a query', 'c'),
(8, 'an index merge combines two index scans', 'd'),
(9, 'disk space usage of the storage layer', 'a'),
(10, 'text analysis splits a document into tokens', 'b');
result_format: 4
select count(*) from t_ik where match(title, body) against('storage');
+----------+
| count(*) |
+----------+
|        3 |
+----------+
select count(1) from t_ik where match(title, body) against('storage');
+----------+
| count(1) |
+----------+
|        3 |
+----------+
select sum(id) from t_ik where match(title, body) against('storage');
+---------+
| sum(id) |
+---------+
|      16 |
+---------+
select min(id) as lo, max(id) as hi from t_ik where match(title, body) against('storage');
+------+------+
| lo   | hi   |
+------+------+
|    1 |    9 |
+------+------+

select count(*) from t_ik where match(title, body) against('storage') and category = 'a';
+----------+
| count(*) |
+----------+
|        2 |
+----------+
select category, count(*) from t_ik where match(title, body) against('storage') group by category;
+----------+----------+
| category | count(*) |
+----------+----------+
| a        |        2 |
| b        |        1 |
+----------+----------+

select count(*) from t_ik where match(title, body) against('zebra');
+----------+
| count(*) |
+----------+
|        0 |
+----------+
select count(*) from t_ik where match(title, body) against('');
+----------+
| count(*) |
+----------+
|        0 |
+----------+

select count(*) from t_def where match(body) against('storage');
+----------+
| count(*) |
+----------+
|        3 |
+----------+
select sum(id) from t_def where match(body) against('storage');
+---------+
| sum(id) |
+---------+
|      16 |
+---------+

explain select id from t_ik where match(title, body) against('storage');
Query Plan
============================================================
|ID|OPERATOR             |NAME       |EST.ROWS|EST.TIME(us)|
------------------------------------------------------------
|0 |SORT                 |           |3       |27          |
|1 |└─TEXT RETRIEVAL SCAN|t_ik(ft_ik)|3       |26          |
============================================================
Outputs & filters:
-------------------------------------
  0 - output([t_ik.id]), filter(nil), rowset=16
      sort_keys([MATCH(t_ik.title, t_ik.body) AGAINST('storage'), DESC])
  1 - output([t_ik.id], [MATCH(t_ik.title, t_ik.body) AGAINST('storage')]), filter(nil), rowset=16
      access([t_ik.id]), partitions(p0)
      is_index_back=true, is_global_index=false, 
      calc_relevance=true, match_expr(MATCH(t_ik.title, t_ik.body) AGAINST('storage')), 
      pushdown_match_filter(MATCH(t_ik.title, t_ik.body) AGAINST('storage'))
