===== single cn word, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('索引') ORDER BY id;
id
2
4
8
===== single en word, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('index') ORDER BY id;
id
