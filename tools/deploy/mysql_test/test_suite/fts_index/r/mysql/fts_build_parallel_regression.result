===== multi word, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('database search') ORDER BY id;
id
3
5
9
13
===== ordered desc =====
SELECT id, title FROM fts_reg_main WHERE MATCH(title, content) AGAINST('倒排索引') ORDER BY id DESC;
id	title
8	数据检索
4	倒排索引
2	全文索引原理
===== hit count =====
SELECT COUNT(*) FROM fts_reg_main WHERE MATCH(title, content) AGAINST('全文索引');
COUNT(*)
3
===== ordered with limit =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('the') ORDER BY id LIMIT 3;
id
3
7
9
===== boolean mode, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('检索' IN BOOLEAN MODE) ORDER BY id;
id
