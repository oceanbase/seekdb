DROP TABLE IF EXISTS fts_sc_hotpath;
DROP TABLE IF EXISTS fts_sc_hotpath_cmp;
========= C1: tokenize json escaping (quote, backslash, slash, control) =========
select tokenize('a"b\\c/d', 'beng');
tokenize('a"b\\c/d', 'beng')
[]
select tokenize('真正的换行\n第二行', 'ik');
tokenize('真正的换行\n第二行', 'ik')
["第二行", "真正", "的", "换行"]
select tokenize('真正的制表\t第二列', 'ik');
tokenize('真正的制表\t第二列', 'ik')
["第二列", "制表", "真正", "的"]
select tokenize('中文"引号"\\反斜杠/斜杠🔥emoji', 'beng');
tokenize('中文"引号"\\反斜杠/斜杠🔥emoji', 'beng')
["斜杠🔥emoji", "引号", "反斜杠", "中文"]
select tokenize('{"a": "b"}', 'beng');
tokenize('{"a": "b"}', 'beng')
[]
select tokenize('C:\\path\\to\\file.txt', 'beng');
tokenize('C:\\path\\to\\file.txt', 'beng')
["txt", "file", "path"]
select tokenize('http://example.com/a/b?c=1&d=2', 'beng');
tokenize('http://example.com/a/b?c=1&d=2', 'beng')
["example", "http"]
select tokenize('"\\"/"', 'beng');
tokenize('"\\"/"', 'beng')
[]
select tokenize('🔥数据库🚀优化😀😀😀 全文🔥索引 test', 'ik');
tokenize('🔥数据库🚀优化😀😀😀 全文🔥索引 test', 'ik')
["索引", "优化", "全文", "数据库", "test"]
select tokenize('', 'ik');
tokenize('', 'ik')
[]
select tokenize('   ', 'ik');
tokenize('   ', 'ik')
[]
select tokenize('!!!???', 'ik');
tokenize('!!!???', 'ik')
[]
========= C1: repeated tokens, mixed language, long text =========
select tokenize('数据库数据库全文索引全文索引全文索引数据库', 'ik');
tokenize('数据库数据库全文索引全文索引全文索引数据库', 'ik')
["数据库", "全文索引"]
select tokenize('the quick brown fox jumps over the lazy dog the end', 'beng');
tokenize('the quick brown fox jumps over the lazy dog the end', 'beng')
["lazy", "over", "end", "quick", "dog", "brown", "fox", "jumps"]
select tokenize('优化 优化 数据库 优化 全文索引 数据库 优化', 'ik');
tokenize('优化 优化 数据库 优化 全文索引 数据库 优化', 'ik')
["优化", "数据库", "全文索引"]
