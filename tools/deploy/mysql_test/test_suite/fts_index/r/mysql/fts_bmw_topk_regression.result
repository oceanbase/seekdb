DROP TABLE IF EXISTS fts_bmw_topk_regression;
create table fts_bmw_topk_regression(
id bigint auto_increment primary key,
title varchar(256) not null,
content text not null,
title_en varchar(256) not null,
content_en text not null,
fulltext key fts_bmw_cn(title, content) with parser ik PARSER_PROPERTIES=(ik_mode='smart'),
fulltext key fts_bmw_content(content) with parser ik PARSER_PROPERTIES=(ik_mode='smart'),
fulltext key fts_bmw_en(title_en, content_en) with parser beng PARSER_PROPERTIES=(min_token_size=3,max_token_size=84)
);
insert into fts_bmw_topk_regression(title, content, title_en, content_en) values
('倒排索引基础', '倒排索引把文档切分成词项并建立映射，检索系统依赖倒排索引完成召回。', 'inverted index basics', 'the inverted index maps terms to documents for retrieval'),
('倒排索引结构', '倒排索引由词典与倒排链组成，倒排链记录词项出现的文档编号。', 'inverted structure', 'the dictionary and posting lists form the inverted index structure'),
('倒排索引压缩', '倒排索引压缩使用差值编码降低存储，压缩后的倒排索引读取更快。', 'index compression', 'difference encodings compress the posting lists of the inverted index'),
('倒排索引查询', '查询时倒排索引按词项取倒排链，多条倒排链归并得到结果。', 'index query', 'queries fetch posting lists from the inverted index and merge them'),
('倒排索引构建', '构建倒排索引先分词再排序，倒排索引的构建是离线流水线。', 'index build', 'building the inverted index tokenizes and sorts documents offline'),
('倒排索引演进', '倒排索引从静态结构演进为动态可更新结构，倒排索引支持实时插入。', 'index evolution', 'the inverted index evolves from static to dynamic structures'),
('分词器与索引', '分词器把句子切成词项，词项是倒排索引的基本单元。', 'tokenizer terms', 'the tokenizer splits sentences into terms for the index'),
('稳定检索平台', '稳定检索平台依赖稳定的倒排索引与可靠的分词流程。', 'stable platform', 'a stable retrieval platform needs a reliable inverted index'),
('稳定缓存层', '缓存层让稳定检索的响应更快，稳定的缓存策略减少回源。', 'stable cache', 'a stable cache layer speeds up stable retrieval responses'),
('量子计算概览', '量子计算与经典计算并行发展，量子计算使用量子比特。', 'quantum overview', 'quantum computing uses qubits alongside classical computing'),
('量子计算算法', '量子算法在量子计算模型下加速特定问题求解。', 'quantum algorithms', 'quantum algorithms speed up specific problems on quantum machines'),
('融合检索展望', '倒排索引与向量索引融合是检索系统的未来方向。', 'hybrid outlook', 'hybrid retrieval combines inverted and vector indexes');
========= multi token match + limit without order by: rows and order =========
select id from fts_bmw_topk_regression where match(content) against('倒排索引 分词器') limit 6;
id
7
5
6
3
12
1
select count(*) from (select id from fts_bmw_topk_regression where match(content) against('倒排索引 分词器') limit 4) t;
count(*)
4
select id from fts_bmw_topk_regression where match(content) against('倒排索引 分词器') limit 3 offset 2;
id
6
3
12
========= benchmark shape: count over subquery limit =========
select count(*) from (select id from fts_bmw_topk_regression where match(content) against('倒排索引 tokenizer') limit 20) t;
count(*)
9
select count(*) from (select id from fts_bmw_topk_regression where match(content) against('倒排索引 分词器') limit 3) t;
count(*)
3
