========= block 2: repeated words, groupby aggregation =========
select tokenize('数据库数据库全文索引全文索引全文索引数据库', 'ik');
tokenize('数据库数据库全文索引全文索引全文索引数据库', 'ik')
["数据库", "全文索引"]
select tokenize('the quick brown fox jumps over the lazy dog the end', 'beng');
tokenize('the quick brown fox jumps over the lazy dog the end', 'beng')
["lazy", "over", "end", "quick", "dog", "brown", "fox", "jumps"]
select tokenize('优化 优化 数据库 优化 全文索引 数据库 优化', 'ik');
tokenize('优化 优化 数据库 优化 全文索引 数据库 优化', 'ik')
["优化", "数据库", "全文索引"]
select tokenize('数据库数据库全文索引全文索引全文索引数据库', 'ik', '[{"output": "all"}]');
tokenize('数据库数据库全文索引全文索引全文索引数据库', 'ik', '[{"output": "all"}]')
{"tokens": [{"数据库": 3}, {"全文索引": 3}], "doc_len": 6}
select tokenize('the quick brown fox jumps over the lazy dog the end', 'beng', '[{"output": "all"}]');
tokenize('the quick brown fox jumps over the lazy dog the end', 'beng', '[{"output": "all"}]')
{"tokens": [{"lazy": 1}, {"over": 1}, {"end": 1}, {"quick": 1}, {"dog": 1}, {"brown": 1}, {"fox": 1}, {"jumps": 1}], "doc_len": 8}
