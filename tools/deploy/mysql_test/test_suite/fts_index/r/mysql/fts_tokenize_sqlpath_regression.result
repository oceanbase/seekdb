select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng');
tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng')
["text", "oceanbase是一款稳定的分布式数据库，支持full", "search"]
select tokenize('第2026届OceanBase数据库大赛第1名', 'ik');
tokenize('第2026届OceanBase数据库大赛第1名', 'ik')
["2026届", "第", "1名", "oceanbase", "大赛", "数据库"]
select tokenize('database performance tuning', 'beng');
tokenize('database performance tuning', 'beng')
["tuning", "database", "performance"]
select tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'ik');
tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'ik')
["文本检索", "数据库系统", "一种", "高效", "是", "技术", "提供", "全文索引", "的"]
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');
tokenize('The quick brown fox jumps over the lazy dog', 'beng')
["lazy", "over", "quick", "dog", "brown", "fox", "jumps"]
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik');
tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik')
["full-text", "oceanbase", "稳定", "是", "支持", "的", "一款", "search", "分布式数据库"]
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng');
tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng')
