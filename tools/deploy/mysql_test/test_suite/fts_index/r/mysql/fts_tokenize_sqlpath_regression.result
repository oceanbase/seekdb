========= block 1: fixed literals, ik/beng alternation, run twice =========
select tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'ik');
tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'ik')
["文本检索", "数据库系统", "一种", "高效", "是", "技术", "提供", "全文索引", "的"]
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');
tokenize('The quick brown fox jumps over the lazy dog', 'beng')
["lazy", "over", "quick", "dog", "brown", "fox", "jumps"]
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik');
tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik')
