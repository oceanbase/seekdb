drop database if exists fts_query_pipeline;
create database fts_query_pipeline;
use fts_query_pipeline;
create table docs (
id int primary key,
content varchar(1024),
fulltext index idx_content(content)
);
insert into docs values
(1, 'alpha database engine'),
(2, 'beta database storage'),
(3, 'alpha beta optimizer'),
(4, 'gamma transaction'),
(5, 'alpha execution pipeline');
select count(*) from docs where match(content) against('alpha');
count(*)
3
select count(*) from docs where match(content) against('alpha beta');
count(*)
4
select count(*) from docs where match(content) against('alpha alpha beta');
count(*)
4
select count(*) from docs where match(content) against('alpha beta gamma');
count(*)
5
select count(*) from docs where match(content) against('alpha beta gamma transaction');
count(*)
5
select count(*) from docs where match(content) against('+alpha +beta' in boolean mode);
count(*)
1
select count(*) from (
select id from docs where match(content) against('alpha beta') limit 2
) t;
count(*)
2
select count(*) from (
select id from docs where match(content) against('alpha beta') limit 1, 2
) t;
count(*)
2
select count(*) from (
select id from docs where match(content) against('alpha beta') limit 0
) t;
count(*)
0
select count(*) from (
select id from docs where match(content) against('alpha beta') limit 10, 2
) t;
count(*)
0
select count(id) from (
select id from docs where match(content) against('alpha beta') limit 2
) t;
count(id)
2
create table partitioned_docs (
id int,
content varchar(1024),
primary key (id),
fulltext index idx_content(content)
) partition by hash(id) partitions 4;
insert into partitioned_docs select * from docs;
select count(*) from partitioned_docs where match(content) against('alpha');
count(*)
3
select count(*) from partitioned_docs where match(content) against('alpha beta');
count(*)
4
select count(*) from (
select id from partitioned_docs where match(content) against('alpha beta') limit 2
) t;
count(*)
2
select count(*) from (
select id from partitioned_docs where match(content) against('alpha beta') limit 1, 2
) t;
count(*)
2
drop database fts_query_pipeline;
