drop database if exists fts;
create database fts;
use fts;
create table t_reuse(
id int primary key,
detail varchar(4096));
insert into t_reuse values (1, 'qqzzxmarker');
insert into t_reuse(id, detail)
select a.n * 30 + b.n + 2,
concat('filler document ', a.n * 30 + b.n + 2, ' distributed database oceanbase')
from (select 0 as n union all select 1 union all select 2 union all select 3 union all select 4
union all select 5 union all select 6 union all select 7 union all select 8 union all select 9) a,
(select 0 as n union all select 1 union all select 2 union all select 3 union all select 4
union all select 5 union all select 6 union all select 7 union all select 8 union all select 9
union all select 10 union all select 11 union all select 12 union all select 13 union all select 14
union all select 15 union all select 16 union all select 17 union all select 18 union all select 19
union all select 20 union all select 21 union all select 22 union all select 23 union all select 24
union all select 25 union all select 26 union all select 27 union all select 28 union all select 29) b;
insert into t_reuse values (302, 'wwvvmfinalmarker');
alter table t_reuse add fulltext index i1(detail) with parser ik;
create table t_reuse_beng(
id int primary key,
detail varchar(4096));
insert into t_reuse_beng values (1, 'qqzzxmarker');
insert into t_reuse_beng(id, detail)
select a.n * 30 + b.n + 2,
concat('filler document ', a.n * 30 + b.n + 2, ' distributed database oceanbase')
from (select 0 as n union all select 1 union all select 2 union all select 3 union all select 4
union all select 5 union all select 6 union all select 7 union all select 8 union all select 9) a,
(select 0 as n union all select 1 union all select 2 union all select 3 union all select 4
union all select 5 union all select 6 union all select 7 union all select 8 union all select 9
union all select 10 union all select 11 union all select 12 union all select 13 union all select 14
union all select 15 union all select 16 union all select 17 union all select 18 union all select 19
union all select 20 union all select 21 union all select 22 union all select 23 union all select 24
union all select 25 union all select 26 union all select 27 union all select 28 union all select 29) b;
insert into t_reuse_beng values (302, 'wwvvmfinalmarker');
alter table t_reuse_beng add fulltext index i1(detail) with parser beng;
result_format: 4
select count(*) from t_reuse;
+----------+
| count(*) |
+----------+
|      302 |
+----------+
select count(*) from t_reuse_beng;
+----------+
| count(*) |
+----------+
|      302 |
+----------+

