select tokenize('qqzzxmarker', 'ik');
+-------------------------------+
| tokenize('qqzzxmarker', 'ik') |
+-------------------------------+
| ["qqzzxmarker"]               |
+-------------------------------+
select tokenize('', 'ik');
+--------------------+
| tokenize('', 'ik') |
+--------------------+
| []                 |
+--------------------+
select tokenize('filler document 5', 'ik');
+-------------------------------------+
| tokenize('filler document 5', 'ik') |
+-------------------------------------+
| ["5", "filler", "document"]         |
+-------------------------------------+
select tokenize('filler document 5', 'ik');
+-------------------------------------+
| tokenize('filler document 5', 'ik') |
+-------------------------------------+
| ["5", "filler", "document"]         |
+-------------------------------------+
select tokenize('分布式数据库', 'ik');
+--------------------------------------+
| tokenize('分布式数据库', 'ik')       |
+--------------------------------------+
| ["分布式数据库"]                     |
+--------------------------------------+
select tokenize('filler document 5', 'ik');
+-------------------------------------+
| tokenize('filler document 5', 'ik') |
+-------------------------------------+
| ["5", "filler", "document"]         |
+-------------------------------------+

select tokenize('qqzzxmarker', 'beng');
+---------------------------------+
| tokenize('qqzzxmarker', 'beng') |
+---------------------------------+
| ["qqzzxmarker"]                 |
+---------------------------------+
select tokenize('', 'beng');
+----------------------+
| tokenize('', 'beng') |
+----------------------+
| []                   |
+----------------------+
select tokenize('filler document 5', 'beng');
+---------------------------------------+
| tokenize('filler document 5', 'beng') |
+---------------------------------------+
| ["filler", "document"]                |
+---------------------------------------+
select tokenize('filler document 5', 'beng');
+---------------------------------------+
| tokenize('filler document 5', 'beng') |
+---------------------------------------+
| ["filler", "document"]                |
+---------------------------------------+

