create table strings(id varchar(20) primary key, body varchar(100), fulltext index ft(body));
insert into strings select cast(id as char),body from docs;
select count(*) from strings where match(body) against('alpha beta gamma');
count(*)
586
select count(*) from strings where match(body) against('alpha alpha beta');
count(*)
533
create table heap_docs(body varchar(100), fulltext index ft(body));
insert into heap_docs select body from docs;
select count(*) from heap_docs where match(body) against('alpha beta gamma');
count(*)
586
select count(*) from heap_docs where match(body) against('alpha');
count(*)
400
create table partitioned(id int primary key,body varchar(100),fulltext index ft(body)) partition by range(id)(partition p0 values less than(400),partition p1 values less than maxvalue);
insert into partitioned select * from docs;
select count(*),sum(id) from partitioned where match(body) against('alpha beta gamma');
count(*)	sum(id)
586	234532
