select tokenize('database performance tuning ' , 'beng');
select tokenize('database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning database performance tuning', 'beng');

--echo ========= two sessions interleaved (thread-local pools, no cross-talk) =========
connect (reuse_conn2, $OBMYSQL_MS0,admin,$OBMYSQL_PWD,test,$OBMYSQL_PORT);
connection default;
select tokenize('会话一：中文分词', 'ik');
connection reuse_conn2;
select tokenize('session two: english tokenization', 'beng');
connection default;
select tokenize('会话一：中文分词', 'ik');
connection reuse_conn2;
select tokenize('session two: english tokenization', 'beng');
connection default;
--send select tokenize('并发会话一：ik', 'ik');
connection reuse_conn2;
select tokenize('并发会话二：beng english', 'beng');
connection default;
--reap
connection reuse_conn2;
--send select tokenize('并发会话二：ik', 'ik');
connection default;
select tokenize('并发会话一：beng english', 'beng');
connection reuse_conn2;
--reap
connection default;
disconnect reuse_conn2;

--echo ========= output mode and other parser kinds still fine =========
select tokenize('hello world', 'ik', '[{"output": "all"}]');
select tokenize('a b c', 'space');
select tokenize('你好，世界！这是一个测试：分词器，能处理标点吗？', 'ik');

--echo ========= repeat of the alternating block (run-to-run stability) =========
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik');
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng');
select tokenize('数据库全文索引', 'ik');
select tokenize('数据库全文索引', 'beng');
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');
select tokenize('The quick brown fox jumps over the lazy dog', 'ik');
select tokenize('第1名和第2名', 'ik');
select tokenize('12一二三', 'ik');
select tokenize('🔥数据库检索🔥', 'ik');
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]');
