# owner: seekdb-task4
# owner group: storage
# tags: fts
# description: parser reuse (reuse_parser) regression. The tokenize parser
#   objects (ik context/segmenters, beng analyzer pipeline) are now pooled
#   per-thread and reused across TOKENIZE calls, so every block below
#   interleaves parser kinds, ik modes and texts that are adversarial for
#   stale cross-call state: pending connector counts, pending CJK numbers,
#   pending surrogate pairs, the >1000-char ik batch boundary and collation
#   switches. A stale char_infos_ table or a dirty segmenter would change
#   one of these outputs. The fixed-literal block runs twice; any
#   run-to-run difference fails the byte comparison.

--echo ========= alternating ik/beng on the same and different texts =========
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik');
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng');
select tokenize('数据库全文索引', 'ik');
select tokenize('数据库全文索引', 'beng');
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');
select tokenize('The quick brown fox jumps over the lazy dog', 'ik');
select tokenize('数据库全文索引', 'ik');
select tokenize('数据库全文索引', 'beng');
select tokenize('Full-text search indexing requires efficient tokenization', 'beng');
select tokenize('Full-text search indexing requires efficient tokenization', 'ik');

--echo ========= same parser repeated twice, byte-stable =========
select tokenize('倒排索引与检索系统设计是海量文档场景下的核心问题', 'ik');
select tokenize('倒排索引与检索系统设计是海量文档场景下的核心问题', 'ik');
select tokenize('Performance tuning of the tokenizer hot path', 'beng');
select tokenize('Performance tuning of the tokenizer hot path', 'beng');

--echo ========= ik smart vs max_word alternation (properties re-applied) =========
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]');
select tokenize('中华人民共和国人民大会堂', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');
select tokenize('研究生命起源', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]');
select tokenize('研究生命起源', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');
select tokenize('研究生命起源', 'ik');
select tokenize('研究生命起源', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]');

--echo ========= stale-state traps: connectors, CJK numbers, surrogates =========
select tokenize('3-4', 'ik');
select tokenize('56', 'ik');
select tokenize('第1名和第2名', 'ik');
select tokenize('一二三四五六', 'ik');
select tokenize('七', 'ik');
select tokenize('12一二三', 'ik');
select tokenize('45六七八', 'ik');
select tokenize('a,,b;;;c', 'ik');
select tokenize('d,e', 'ik');
select tokenize('🔥数据库检索🔥', 'ik');
select tokenize('🔥 again 😀 tests', 'ik');
select tokenize('🔥数据库检索🔥', 'beng');
select tokenize('state-of-the-art peer-to-peer', 'ik');
select tokenize('full-text', 'ik');
select tokenize('x1y2z3', 'ik');
select tokenize('another english text', 'beng');
select tokenize('x1y2z3', 'ik');

--echo ========= empty / single char / non-ascii / long batch boundary =========
select tokenize('', 'ik');
select tokenize('a', 'ik');
select tokenize('词', 'ik');
select tokenize('   ', 'beng');
select tokenize('龘靐齉爩鱻麤龗灪', 'ik');
select tokenize('hello   world   with   multiple   spaces', 'beng');
select tokenize('超长句：数据库全文索引性能优化涉及分词、倒排、压缩与缓存等环节，这是第一句。' , 'ik');
