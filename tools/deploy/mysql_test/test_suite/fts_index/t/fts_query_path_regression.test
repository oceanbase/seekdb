--echo ========= multi token natural language: hit set and output order =========
select id from fts_query_regression where match(title, content) against('分词器 数据库');
select count(*) from fts_query_regression where match(title, content) against('分词器 数据库');
select id from fts_query_regression where match(title, content) against('OceanBase 稳定 数据库');
--echo ========= match + limit without order by (row order is semantics) =========
select id from fts_query_regression where match(content) against('倒排索引 tokenizer') limit 5;
select id from fts_query_regression where match(content) against('倒排索引 tokenizer') limit 20;
select count(*) from (select id from fts_query_regression where match(content) against('倒排索引 tokenizer') limit 3) t;
select id from fts_query_regression where match(content) against('倒排索引 tokenizer') limit 4 offset 2;
--echo ========= single token with limit =========
select id from fts_query_regression where match(title, content) against('全文索引') limit 4;
select id from fts_query_regression where match(title, content) against('全文索引') limit 30;
select id, title from fts_query_regression where match(title, content) against('全文索引') limit 2 offset 3;
select count(*) from fts_query_regression where match(title, content) against('全文索引');
--echo ========= order by id with match =========
select id from fts_query_regression where match(title, content) against('全文索引') order by id limit 3;
select id from fts_query_regression where match(title, content) against('全文索引') order by id desc limit 3;
--echo ========= boolean mode: and / or / not =========
select id from fts_query_regression where match(content) against('+数据库 +倒排' in boolean mode);
select id from fts_query_regression where match(content) against('分词器 倒排' in boolean mode);
select id from fts_query_regression where match(title_en, content_en) against('+tokenizer -audit' in boolean mode);
select count(*) from fts_query_regression where match(content) against('+全文索引 +分词器' in boolean mode);
--echo ========= beng english path =========
select id from fts_query_regression where match(title_en, content_en) against('database performance');
select id from fts_query_regression where match(title_en, content_en) against('database performance') limit 4;
select count(*) from fts_query_regression where match(title_en, content_en) against('database tokenizer');
--echo ========= empty hit set edge =========
select id from fts_query_regression where match(content) against('不存在的词条') limit 5;
select count(*) from fts_query_regression where match(content) against('不存在的词条');
