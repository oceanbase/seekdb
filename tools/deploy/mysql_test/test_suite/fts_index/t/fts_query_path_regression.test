# owner: seekdb-task3
# owner group: storage
# tags: fts
# description: fts MATCH query path regression. Freezes the client-visible
#   MATCH pipeline across the query-path optimizations (per-candidate match
#   filter fast-path decision in the DAAT merge iter and removal of the
#   redundant relevance re-evaluation in the per-token iter): multi-token
#   natural-language hit sets AND output row order, MATCH + LIMIT/OFFSET
#   without ORDER BY (the LIMIT picks the first rows of the engine output
#   order, so the row order is part of the frozen semantics), single-token
#   LIMIT forms, ORDER BY id variants, boolean-mode AND/OR/NOT hit sets and
#   the beng-parser English path. All outputs are deterministic doc ids and
#   counts; the whole case must be byte-stable across repeated runs.

--disable_warnings
DROP TABLE IF EXISTS fts_query_regression;
--enable_warnings

create table fts_query_regression(
    id bigint auto_increment primary key,
    title varchar(256) not null,
    content text not null,
    title_en varchar(256) not null,
    content_en text not null,
    fulltext key fts_qr_cn(title, content) with parser ik PARSER_PROPERTIES=(ik_mode='smart'),
    fulltext key fts_qr_content(content) with parser ik PARSER_PROPERTIES=(ik_mode='smart'),
    fulltext key fts_qr_en(title_en, content_en) with parser beng PARSER_PROPERTIES=(min_token_size=3,max_token_size=84)
);

insert into fts_query_regression(title, content, title_en, content_en) values
