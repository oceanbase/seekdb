SET NAMES utf8mb4;
--echo Built-in stopwords, case variants, and ordinary words
SELECT TOKENIZE('a about an are as at be by com de en for from how i in is it la of on or that the this to was what when where who will with und www database fulltext', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]');
SELECT TOKENIZE('A ABOUT An ARE AS AT BE BY COM DE EN FOR FROM HOW I IN IS IT LA OF ON OR THAT THE THIS TO WAS WHAT WHEN WHERE WHO WILL WITH UND WWW DATABASE FULLTEXT', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]');
--echo Accent-equivalent stopwords must retain the original collation lookup
SELECT TOKENIZE(_utf8mb4'thé thére á à â âbout fróm und database café CAFÉ' COLLATE utf8mb4_bin, 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]');
SELECT TOKENIZE(_utf8mb4'thé thére á à â âbout fróm und database café CAFÉ' COLLATE utf8mb4_general_ci, 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]');
SELECT TOKENIZE('the The tHE theatre database databasex abcdefghi abcdefghijk', 'ik', '[{"output":"all"}]');
SELECT TOKENIZE(CONCAT('the about ', CHAR(0), 'the ', CHAR(9), 'what database'), 'space', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]');
SELECT TOKENIZE('the! about, THE? theatre thé database', 'space', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]');
PREPARE stop_stmt FROM 'SELECT TOKENIZE(?, "beng", ''[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]'')';
SET @words='the about database database';
EXECUTE stop_stmt USING @words;
SET @words='THÉ ÁBOUT café CAFÉ';
EXECUTE stop_stmt USING @words;
SET @words='a an i that database';
EXECUTE stop_stmt USING @words;
DEALLOCATE PREPARE stop_stmt;
