SET NAMES utf8mb4;
--disable_warnings
CREATE DATABASE IF NOT EXISTS fts_char_classification;
USE fts_char_classification;
DROP TABLE IF EXISTS bytes;
--enable_warnings
CREATE TABLE bytes (n INT PRIMARY KEY);
INSERT INTO bytes VALUES(0),(1),(2),(3),(4),(5),(6),(7);
INSERT INTO bytes SELECT n+8 FROM bytes;
INSERT INTO bytes SELECT n+16 FROM bytes;
INSERT INTO bytes SELECT n+32 FROM bytes;
INSERT INTO bytes SELECT n+64 FROM bytes;
SELECT n,TOKENIZE(CONCAT('alpha',CONVERT(CHAR(n) USING utf8mb4),'beta'),'ik','[{"output":"all"}]') FROM bytes ORDER BY n;
SELECT TOKENIZE('ＡＢＣ１２３ ａｂｃ 一二三四五六七八九十 1,234.56 foo-bar foo_bar foo@bar', 'ik', '[{"output":"all"}]');
