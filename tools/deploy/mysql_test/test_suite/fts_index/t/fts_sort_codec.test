SELECT /*+ opt_param('enable_newsort', 'true') */ @encoded_order:=SHA2(GROUP_CONCAT(id ORDER BY rn SEPARATOR ','),256) AS order_digest FROM (SELECT id,ROW_NUMBER() OVER(ORDER BY word COLLATE utf8mb4_bin DESC,docid DESC,id) AS rn FROM keys_to_sort)t;
SELECT @plain_order=@encoded_order AS same_order;
SELECT /*+ opt_param('enable_newsort', 'false') */ @plain_order:=SHA2(GROUP_CONCAT(id ORDER BY rn SEPARATOR ','),256) AS order_digest FROM (SELECT id,ROW_NUMBER() OVER(ORDER BY CAST(word AS BINARY) ASC,docid ASC,id) AS rn FROM keys_to_sort)t;
SELECT /*+ opt_param('enable_newsort', 'true') */ @encoded_order:=SHA2(GROUP_CONCAT(id ORDER BY rn SEPARATOR ','),256) AS order_digest FROM (SELECT id,ROW_NUMBER() OVER(ORDER BY CAST(word AS BINARY) ASC,docid ASC,id) AS rn FROM keys_to_sort)t;
SELECT @plain_order=@encoded_order AS same_order;
