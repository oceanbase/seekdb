--disable_query_log
SET NAMES utf8mb4;
SET group_concat_max_len=65535;
--disable_warnings
CREATE DATABASE IF NOT EXISTS fts_sort_codec_regression;
USE fts_sort_codec_regression;
DROP TABLE IF EXISTS keys_to_sort;
--enable_warnings
CREATE TABLE keys_to_sort(id BIGINT PRIMARY KEY, word VARCHAR(256) CHARACTER SET utf8mb4, docid VARBINARY(40));
