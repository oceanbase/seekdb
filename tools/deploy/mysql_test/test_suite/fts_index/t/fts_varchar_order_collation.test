# owner: wb-coder
# owner group: storage
# tags: fts
# description: regression for the shared encode-sortkey gate scope (task-5). The
#   order-preserving sortkey encoder is only opened for VARCHAR columns whose
#   collation has been proven order-equivalent (utf8mb4_general_ci, binary); all
#   other collations keep the legacy compare path. This test exercises plain
#   user-query ORDER BY on VARCHAR columns of both classes and pins the exact
#   sorted output, so any observable order change (either direction) fails here.
#   All ORDER BY keys are followed by the primary key, making every expected
#   result a deterministic total order independent of the sort implementation.

--disable_warnings
DROP DATABASE IF EXISTS fts_order_collation_reg;
PURGE RECYCLEBIN;
CREATE DATABASE fts_order_collation_reg;
USE fts_order_collation_reg;
--enable_warnings

# allowed collation (proven order-equivalent encoded key)
CREATE TABLE t_general(
    id BIGINT PRIMARY KEY,
    v  VARCHAR(200) COLLATE utf8mb4_general_ci);
# fallback collations (legacy compare path, must stay byte-identical)
CREATE TABLE t_bin(
    id BIGINT PRIMARY KEY,
    v  VARCHAR(200) COLLATE utf8mb4_bin);
CREATE TABLE t_uci(
    id BIGINT PRIMARY KEY,
    v  VARCHAR(200) COLLATE utf8mb4_unicode_ci);

INSERT INTO t_general(id, v) VALUES
(1, 'apple'), (2, 'Apple'), (3, 'APPLE'), (4, 'banana'), (5, 'Banana '),
(6, 'apple '), (7, '数据库'), (8, '數據庫'), (9, 'Database'), (10, 'database'),
(11, 'z'), (12, 'Z'), (13, 'z '), (14, '0abc'), (15, '!bang'),
(16, 'café'), (17, 'CAFE'), (18, 'eclair'), (19, ' ÉCLAIR '), (20, '中');
INSERT INTO t_bin(id, v) SELECT id, v FROM t_general;
INSERT INTO t_uci(id, v) SELECT id, v FROM t_general;

--echo ===== general_ci: asc =====
SELECT id, v FROM t_general ORDER BY v, id;
--echo ===== general_ci: desc =====
SELECT id, v FROM t_general ORDER BY v DESC, id;
--echo ===== bin: asc =====
SELECT id, v FROM t_bin ORDER BY v, id;
--echo ===== bin: desc =====
SELECT id, v FROM t_bin ORDER BY v DESC, id;
--echo ===== unicode_ci: asc =====
SELECT id, v FROM t_uci ORDER BY v, id;
--echo ===== unicode_ci: desc =====
SELECT id, v FROM t_uci ORDER BY v DESC, id;

--echo ===== general_ci: min max group =====
SELECT MIN(v), MAX(v), COUNT(DISTINCT v) FROM t_general;
--echo ===== bin: min max group =====
SELECT MIN(v), MAX(v), COUNT(DISTINCT v) FROM t_bin;

--disable_warnings
DROP DATABASE fts_order_collation_reg;
--enable_warnings
