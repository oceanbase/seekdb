# owner: seekdb-taskE
# owner group: storage
# tags: fts
# description: single-core hot-path regression (Task E). Covers the two
#   single-core optimizations. (C1) TOKENIZE serializes its token array
#   directly into binary JSON instead of materializing one JSON string object
#   per token and re-serializing the tree, so every escaping form (double
#   quote, backslash, slash, tab/newline, emoji, CJK), the element order and
#   the array shape must stay byte identical, including empty token sets and
#   texts long enough to cross the value/obj-size varint widths. (C2) the
#   datum string comparator reads the already published charset info instead
#   of re-resolving it on every comparison, so case-insensitive, binary,
#   trailing-space, NULL and raw-byte comparison semantics must stay
#   identical. All outputs are deterministic doc ids / counts / JSON text and
#   the whole case must be byte stable when run twice.

--disable_warnings
DROP TABLE IF EXISTS fts_sc_hotpath;
DROP TABLE IF EXISTS fts_sc_hotpath_cmp;
--enable_warnings

--echo ========= C1: tokenize json escaping (quote, backslash, slash, control) =========
select tokenize('a"b\\c/d', 'beng');
select tokenize('真正的换行\n第二行', 'ik');
select tokenize('真正的制表\t第二列', 'ik');
select tokenize('中文"引号"\\反斜杠/斜杠🔥emoji', 'beng');
select tokenize('{"a": "b"}', 'beng');
select tokenize('C:\\path\\to\\file.txt', 'beng');
select tokenize('http://example.com/a/b?c=1&d=2', 'beng');
select tokenize('"\\"/"', 'beng');
select tokenize('🔥数据库🚀优化😀😀😀 全文🔥索引 test', 'ik');
select tokenize('', 'ik');
select tokenize('   ', 'ik');
select tokenize('!!!???', 'ik');

--echo ========= C1: repeated tokens, mixed language, long text =========
