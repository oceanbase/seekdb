--echo ========= C2: comparison semantics (collation, trailing space, null) =========
select 'A' = 'a' collate utf8mb4_general_ci, 'A' = 'a' collate utf8mb4_bin, 'A' = 'a' collate utf8mb4_unicode_ci;
select 'A' < 'a' collate utf8mb4_bin, 'a' < 'A' collate utf8mb4_bin;
select 'a ' = 'a' collate utf8mb4_general_ci, 'a ' = 'a' collate utf8mb4_bin;
select null <=> null, 'a' <=> null, null <=> 'a', 'a' <=> 'a';
select strcmp('A' collate utf8mb4_general_ci, 'a' collate utf8mb4_general_ci), strcmp('a' collate utf8mb4_bin, 'A' collate utf8mb4_bin);
select x'C328' = x'C3A9', x'C328' < x'C3A9', strcmp(x'C328', x'C3A9'), x'C328' = x'C328';

--echo ========= C2: comparator through table scans and aggregation =========
create table fts_sc_hotpath_cmp(
    v varchar(32) collate utf8mb4_general_ci not null
);
insert into fts_sc_hotpath_cmp values ('alpha'),('Alpha'),('ALPHA'),('beta'),('Beta'),('gamma'),('gamma ');
select count(*) from fts_sc_hotpath_cmp where v = 'alpha';
select count(*) from fts_sc_hotpath_cmp where v = 'alpha' collate utf8mb4_bin;
select count(*) from fts_sc_hotpath_cmp where v > 'beta';
select count(distinct v) from fts_sc_hotpath_cmp;
select min(v), max(v) from fts_sc_hotpath_cmp;
select n, count(*) from (select v as n from fts_sc_hotpath_cmp order by v, binary v) t group by n order by n;

--echo ========= MATCH + LIMIT without order by: hit set and row order =========
create table fts_sc_hotpath(
    id bigint auto_increment primary key,
    title varchar(128) not null,
    content text not null,
    fulltext key fts_sc_hp_cn(title, content) with parser ik PARSER_PROPERTIES=(ik_mode='smart')
);
insert into fts_sc_hotpath(title, content) values
('数据库全文索引入门', '全文索引是数据库的核心能力，倒排索引支撑快速检索。'),
('分词器概述', '分词器 tokenizer 把文本切分成词项，倒排索引由词项指向文档。'),
('OceanBase 全文检索', 'OceanBase 数据库内置全文索引与分词器，检索稳定高效。'),
('倒排索引原理', '倒排索引记录词项到文档列表的映射关系。'),
('检索性能优化', '数据库检索性能取决于索引结构与分词器实现。'),
('分词器与检索', '分词器质量直接影响全文检索的召回与排序。'),
('稳定的核心', '分布式数据库需要稳定的全文索引实现。'),
('性能审计报告', '性能审计发现检索延迟主要来自倒排索引扫描。'),
('搜索引擎架构', '现代搜索引擎以倒排索引与分词器为基石。'),
('数据库与大数据', '数据库与大数据平台共享检索与聚合技术。'),
('全文索引进阶', '全文索引支持布尔模式、相关性排序与分词器扩展。'),
('倒排索引压缩', '倒排索引的压缩编码显著降低存储成本。');
select id from fts_sc_hotpath where match(title, content) against('倒排索引 tokenizer') limit 5;
select id from fts_sc_hotpath where match(title, content) against('倒排索引 tokenizer') limit 20;
select id from fts_sc_hotpath where match(title, content) against('倒排索引 tokenizer') limit 3 offset 2;
select count(*) from fts_sc_hotpath where match(title, content) against('倒排索引 tokenizer');
select id from fts_sc_hotpath where match(title, content) against('全文索引') limit 4;
select id from fts_sc_hotpath where match(title, content) against('全文索引') order by id desc limit 3;
select id from fts_sc_hotpath where match(title, content) against('不存在的词条') limit 5;

