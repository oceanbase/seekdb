# owner: seekdb-taskB
# owner group: storage
# tags: fts
# description: tokenize container regression (Task B). The ik token
#   containers (sorted token list, result queue, CJK DAT hit list,
#   quantifier hit list) were replaced by chunked reuse arrays and the
#   segmenter list is a fixed slot array now. Every block below is
#   adversarial for container reuse bugs: exact SEGMENT_LIMIT boundary
#   text (1000 useful chars then a useless char triggers the batch cut),
#   multi-batch >1000-char texts, long-then-short-then-long container
#   reuse, DAT words whose hits survive an erase-then-push sequence in
#   one hit list slot (性能优化 / 超长句), smart vs max_word
#   re-arbitration, ik/beng/other-parser alternation, and the
#   fixed-literal block run twice for run-to-run byte stability.

--echo ========= fixed literals: ik vs beng, repeated twice =========
select tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'ik');
select tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'ik');
select tokenize('全文索引是数据库系统提供的一种高效的文本检索技术', 'beng');
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'ik');
select tokenize('OceanBase是一款稳定的分布式数据库，支持Full-text search', 'beng');
select tokenize('第2026届OceanBase数据库大赛第1名', 'ik');
select tokenize('数据库全文索引性能优化涉及分词、倒排、压缩与缓存', 'ik');
select tokenize('数据库全文索引性能优化涉及分词、倒排、压缩与缓存', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');
select tokenize('数据库全文索引性能优化涉及分词、倒排、压缩与缓存', 'beng');
select tokenize('The quick brown fox jumps over the lazy dog', 'ik');
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');
select tokenize('性能优化', 'ik');
select tokenize('性能优化', 'ik');
select tokenize('超长句', 'ik');
select tokenize('超长句', 'ik');
select tokenize('性能优化', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');
select tokenize('超长句', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');

--echo ========= parser alternation (container state must not bleed) =========
select tokenize('数据库全文索引', 'ngram');
select tokenize('数据库全文索引', 'ik');
select tokenize('数据库全文索引', 'space');
select tokenize('数据库全文索引', 'beng');
select tokenize('数据库全文索引', 'ik', '[{"additional_args": [{"ik_mode": "smart"}]}]');

