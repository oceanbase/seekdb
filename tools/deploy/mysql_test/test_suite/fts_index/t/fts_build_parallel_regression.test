# owner: wb-coder
# owner group: storage
# tags: fts
# description: regression for full-text index build determinism: build FTS index on a
#   populated table (explicit PK, TABLET_SEQUENCE docid path) and on a partitioned table,
#   then verify MATCH results are deterministic and ordered by the primary key, and the
#   four generated aux tables have the expected deterministic row counts. All data are
#   fixed literals; all MATCH outputs are ORDER BY id so the recorded result is
#   independent of docid assignment and internal iteration order.

--disable_warnings
DROP DATABASE IF EXISTS fts_reg;
CREATE DATABASE fts_reg;
USE fts_reg;
--enable_warnings

# ---------- non-partitioned table with explicit primary key ----------
CREATE TABLE fts_reg_main(
    id      BIGINT PRIMARY KEY,
    title   VARCHAR(256),
    content VARCHAR(512));

INSERT INTO fts_reg_main(id, title, content) VALUES
(1,  'OceanBase 数据库', 'OceanBase 是一款分布式数据库，支持全文索引与检索。'),
(2,  '全文索引原理', '全文索引通过倒排索引加速关键词检索。'),
(3,  'database engine', 'The database engine processes queries efficiently.'),
(4,  '倒排索引', '倒排索引将词项映射到文档列表，是搜索引擎的核心结构。'),
(5,  'search engine', 'A search engine ranks documents by relevance and freshness.'),
(6,  '分布式系统', '分布式系统需要处理一致性、可用性与分区容错。'),
(7,  'query optimizer', 'The query optimizer rewrites plans to reduce cost.'),
(8,  '数据检索', '海量数据检索依赖索引结构与缓存优化。'),
(9,  'inverted index', 'An inverted index is the core of modern search systems.'),
(10, '高可用架构', '高可用架构通过多副本与自动切换保障服务。'),
(11, 'tokenizer', 'The tokenizer splits text into tokens for indexing.'),
(12, '分词器', '分词器决定中文全文索引的质量与性能。'),
(13, 'full text search', 'Full text search combines tokenization, indexing and ranking.');

# build the fulltext index afterwards, on a populated table (same path as the benchmark)
ALTER SYSTEM SET _ENABLE_ADD_FULLTEXT_INDEX_TO_EXISTING_TABLE = TRUE;
sleep 2;
CREATE FULLTEXT INDEX fts_reg_idx ON fts_reg_main(title, content) WITH PARSER ik;

# aux tables generated by the build: expect 4 tables and deterministic row counts
set ob_enable_index_direct_select = 'ON';
--disable_query_log
let $data_table_id = query_get_value("SELECT table_id FROM oceanbase.__all_table WHERE table_name = 'fts_reg_main'", table_id, 1);
let $rowkey_doc_table_name = query_get_value(SELECT table_name FROM oceanbase.__all_table WHERE index_type = 11 AND data_table_id = $data_table_id, table_name, 1);
let $doc_rowkey_table_name = query_get_value(SELECT table_name FROM oceanbase.__all_table WHERE index_type = 12 AND data_table_id = $data_table_id, table_name, 1);
let $fts_index_table_name = query_get_value(SELECT table_name FROM oceanbase.__all_table WHERE index_type = 13 AND data_table_id = $data_table_id, table_name, 1);
let $doc_word_table_name = query_get_value(SELECT table_name FROM oceanbase.__all_table WHERE index_type = 14 AND data_table_id = $data_table_id, table_name, 1);
--replace_regex /__idx_[0-9]*/__idx_DATA_TABLE_ID/g
eval SELECT table_name FROM oceanbase.__all_table WHERE data_table_id = $data_table_id AND table_name LIKE '__idx_%' ORDER BY table_name;
eval SELECT COUNT(*) FROM $rowkey_doc_table_name;
eval SELECT COUNT(*) FROM $doc_rowkey_table_name;
eval SELECT COUNT(*) FROM $fts_index_table_name;
eval SELECT COUNT(*) FROM $doc_word_table_name;
--enable_query_log

# ordered MATCH results on the non-partitioned table
--echo ===== single cn word, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('索引') ORDER BY id;
--echo ===== single en word, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('index') ORDER BY id;
--echo ===== multi word, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('database search') ORDER BY id;
--echo ===== ordered desc =====
SELECT id, title FROM fts_reg_main WHERE MATCH(title, content) AGAINST('倒排索引') ORDER BY id DESC;
--echo ===== hit count =====
SELECT COUNT(*) FROM fts_reg_main WHERE MATCH(title, content) AGAINST('全文索引');
--echo ===== ordered with limit =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('the') ORDER BY id LIMIT 3;
--echo ===== boolean mode, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('检索' IN BOOLEAN MODE) ORDER BY id;
--echo ===== mixed cn en words, ordered =====
SELECT id FROM fts_reg_main WHERE MATCH(title, content) AGAINST('全文索引 数据库') ORDER BY id;

# ---------- partitioned table (per-partition build path) ----------
CREATE TABLE fts_reg_part(
    id     BIGINT PRIMARY KEY,
    detail VARCHAR(512),
    FULLTEXT INDEX fts_reg_part_idx(detail) WITH PARSER ik
) PARTITION BY HASH(id) PARTITIONS 2;

INSERT INTO fts_reg_part(id, detail) VALUES
(1, 'The quick brown fox jumps over the lazy dog'),
(2, '全文索引支持分区表的文档检索'),
(3, 'A distributed database spans multiple servers'),
(4, '倒排索引在分区场景下按分区构建与合并'),
(5, 'Search relevance depends on tokenization quality'),
(6, '分区表的全文索引为每个分区维护独立倒排'),
(7, 'OceanBase stores data in distributed tablets'),
(8, '检索系统需要统一处理多分区的查询结果');

--echo ===== partitioned: cn word, ordered =====
SELECT id FROM fts_reg_part WHERE MATCH(detail) AGAINST('全文索引') ORDER BY id;
--echo ===== partitioned: en word, ordered =====
SELECT id FROM fts_reg_part WHERE MATCH(detail) AGAINST('database') ORDER BY id;
--echo ===== partitioned: hit count =====
SELECT COUNT(*) FROM fts_reg_part WHERE MATCH(detail) AGAINST('distributed');
--echo ===== partitioned: ordered desc with limit =====
SELECT id FROM fts_reg_part WHERE MATCH(detail) AGAINST('倒排') ORDER BY id DESC LIMIT 2;

--disable_warnings
DROP DATABASE fts_reg;
--enable_warnings
