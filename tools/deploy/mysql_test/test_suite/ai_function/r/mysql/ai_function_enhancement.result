select ai_prompt('{0}/{0}/{1}', json_array(1,true), json_object('k',2));
ai_prompt('{0}/{0}/{1}', json_array(1,true), json_object('k',2))
{"args": [[1, true], {"k": 2}], "template": "{0}/{0}/{1}"}
drop table if exists ai_enhance_prompt;
create table ai_enhance_prompt(t longtext, a text);
insert into ai_enhance_prompt values('{0}-ok', 'lob');
select ai_prompt(t, a) from ai_enhance_prompt;
ai_prompt(t, a)
{"args": ["lob"], "template": "{0}-ok"}
drop table ai_enhance_prompt;
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_complete');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_complete_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_complete', '{"type":"completion","model_name":"qwen3-32b"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_complete_ep', '{"ai_model_name":"enhance_complete","scope":"all","url":"http://0.0.0.0:8000/compatible-mode/v1/chat/completions","access_key":"mock-key","provider":"openai"}');
select length(ai_complete('enhance_complete', 'hello', null)) > 0 as complete_ok;
complete_ok
1
select length(ai_complete(
'enhance_complete', ai_prompt('describe {0}', json_object('text','你好')),
'{"temperature":0.2,"max_tokens":16}')) > 0 as complete_config_ok;
complete_config_ok
1
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_embed_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_embed', '{"type":"dense_embedding","model_name":"text-embedding-v1"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_embed_ep', '{"ai_model_name":"enhance_embed","scope":"all","url":"http://0.0.0.0:8000/compatible-mode/v1/embeddings","access_key":"mock-key","provider":"openai"}');
select json_length(ai_embed('enhance_embed', 'single-row')) as embed_dimension;
embed_dimension
768
select json_length(ai_embed('enhance_embed', 'dimension-row', 768)) as requested_dimension;
requested_dimension
768
drop table if exists ai_enhance_batch;
create table ai_enhance_batch(id int primary key, content text);
insert into ai_enhance_batch values(1,'first'),(2,null),(3,'third');
select id, json_length(ai_embed('enhance_embed', content)) as dimension
from ai_enhance_batch order by id;
id	dimension
1	768
2	NULL
3	768
drop table ai_enhance_batch;
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_rerank');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_rerank_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_rerank', '{"type":"rerank","model_name":"BAAI/bge-reranker-v2-m3"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_rerank_ep', '{"ai_model_name":"enhance_rerank","scope":"all","url":"http://0.0.0.0:8000/v1/rerank","access_key":"mock-key","provider":"siliconflow"}');
select json_length(ai_rerank('enhance_rerank','apple',
'["apple","banana","fruit","vegetable"]', null)) as rerank_count;
rerank_count
4
select json_unquote(json_extract(r, '$[0].id')) as first_id,
json_length(r) as rerank_count
from (select ai_rerank('enhance_rerank','apple',
'[{"id":"a","text":"apple"},{"id":"b","text":"banana"}]',
'text') as r) x;
first_id	rerank_count
a	2
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_complete');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_ollama_complete', '{"type":"completion","model_name":"qwen2.5"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_ollama_complete_ep', '{"ai_model_name":"enhance_ollama_complete","scope":"all","url":"http://0.0.0.0:8000/api/generate","access_key":"","provider":"ollama"}');
select provider from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS
where endpoint_name = 'enhance_ollama_complete_ep';
provider
ollama
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT(
'enhance_ollama_complete_ep', '{"provider":"Ollama"}');
select provider from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS
where endpoint_name = 'enhance_ollama_complete_ep';
provider
Ollama
select length(ai_complete('enhance_ollama_complete', 'hello')) > 0 as ollama_complete_ok;
ollama_complete_ok
1
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_embed_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
'enhance_ollama_embed', '{"type":"dense_embedding","model_name":"nomic-embed-text"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
'enhance_ollama_embed_ep', '{"ai_model_name":"enhance_ollama_embed","scope":"all","url":"http://0.0.0.0:8000/api/embed","access_key":"","provider":"OLLAMA"}');
select json_valid(ai_embed('enhance_ollama_embed', 'hello')) as ollama_embed_ok;
ollama_embed_ok
1
