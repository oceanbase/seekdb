#owner: shenyunlong.syl
#owner group: shenzhen

connection default;

--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_completion');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_embedding');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_rerank');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_ollama');

--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_openai');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_ollama');

# 1. Create AI models
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_model_completion', '{"type": "completion", "model_name": "gpt-4"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_model_embedding', '{"type": "dense_embedding", "model_name": "text-embedding-v1"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_model_rerank', '{"type": "rerank", "model_name": "Qwen/Qwen3-Reranker-0.6B"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('enh_model_ollama', '{"type": "completion", "model_name": "llama3"}');

# 2. Create AI model endpoints
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_endpoint_openai', '{
  "ai_model_name": "enh_model_completion",
  "url": "http://127.0.0.1:8000/v1/",
  "access_key": "sk-mock-key",
  "request_model_name": "gpt-4",
  "provider": "openai"
}');

call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_endpoint_ollama', '{
  "ai_model_name": "enh_model_ollama",
  "url": "http://127.0.0.1:8000/",
  "access_key": "",
  "request_model_name": "llama3",
  "provider": "ollama"
}');

# Associate embedding and rerank models with the openai endpoint for simplicity in this test
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enh_endpoint_openai', '{"ai_model_name": "enh_model_embedding"}');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enh_endpoint_openai', '{"ai_model_name": "enh_model_rerank"}');
# NOTE: The above ALTER might overwrite associations if not handled correctly by the system, 
# but usually one endpoint can serve multiple models if the provider/URL matches.
# Re-creating or using multiple endpoints is safer if the system expects 1:1.
# Let's just create specific ones.

--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_embed');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_endpoint_embed', '{
  "ai_model_name": "enh_model_embedding",
  "url": "http://127.0.0.1:8000/v1/",
  "access_key": "sk-mock-key",
  "request_model_name": "text-embedding-v1",
  "provider": "openai"
}');

--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_rerank');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('enh_endpoint_rerank', '{
  "ai_model_name": "enh_model_rerank",
  "url": "http://127.0.0.1:8000/v1/",
  "access_key": "sk-mock-key",
  "request_model_name": "Qwen/Qwen3-Reranker-0.6B",
  "provider": "openai"
}');

# 3. Test AI_PROMPT
select ai_prompt('Task: {0}, Data: {1}', 'analyze', json_array(1, 2, 3)) as prompt_json;
select ai_prompt('Nested: {0}', ai_prompt('Inner: {0}', 'val')) as nested_prompt;
select ai_prompt('Repeat: {0} and {0}', 'test') as repeat_prompt;

# 4. Test AI_COMPLETE
select ai_complete('enh_model_completion', ai_prompt('Hello, how are you?')) as completion;
select ai_complete('enh_model_ollama', ai_prompt('Hello from Ollama')) as ollama_completion;

# 5. Test AI_EMBED single-row
select ai_embed('enh_model_embedding', 'Hello world') as single_embedding;

# 6. Test AI_EMBED cross-row batching with NULL/WHERE/LIMIT
create table ai_test_table (id int primary key, content text);
insert into ai_test_table values (1, 'row 1'), (2, NULL), (3, 'row 3'), (4, 'row 4'), (5, 'row 5');

select id, ai_embed('enh_model_embedding', content) as embedding 
from ai_test_table 
where id > 1 
order by id 
limit 3;

# 7. Test AI_RERANK with string/object arrays and tie ordering
# String array
select ai_rerank('enh_model_rerank', 'What is OceanBase?', json_array('Database', 'Fruit', 'OceanBase is a DB')) as rerank_strings;

# Object array
select ai_rerank('enh_model_rerank', 'Query', json_array(
  json_object('text', 'Result 1', 'id', 101),
  json_object('text', 'Result 2', 'id', 102)
), '$.text') as rerank_objects;

# Tie ordering (Mock returns scores based on index, we can't easily force ties unless we modify mock again)
# But we can test that it returns the expected structure.
select ai_rerank('enh_model_rerank', 'Tie Test', json_array('A', 'B', 'C')) as tie_test;

# 8. Cleanup
drop table ai_test_table;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_openai');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_ollama');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enh_endpoint_rerank');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_completion');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_embedding');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_rerank');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enh_model_ollama');
