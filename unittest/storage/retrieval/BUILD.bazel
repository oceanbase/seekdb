load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "block_stat_range_cases",
    srcs = ["test_block_stat_range.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/storage:block_stat_range_test_headers",
    ],
)

cc_test(
    name = "test_block_stat_range",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":block_stat_range_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
