load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "memtable_mutator_cases",
    srcs = ["test_memtable_mutator.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/storage:memtable_mutator_test_headers",
    ],
)

cc_test(
    name = "test_memtable_mutator",
    linkstatic = True,
    # Keep rules_cc's $ORIGIN rpath while linking the C++ runtime used by gtest.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    linkopts = ["-lstdc++"],
    deps = [
        ":memtable_mutator_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
