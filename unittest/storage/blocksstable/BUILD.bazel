load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "bit_stream_cases",
    srcs = ["test_bit_stream.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/storage:bit_stream_test_headers",
    ],
)

cc_test(
    name = "test_bit_stream",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":bit_stream_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
