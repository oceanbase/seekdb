load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "ddl_identifier_escape_cases",
    srcs = ["test_ddl_identifier_escape.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/share:ddl_identifier_escape_test_headers",
    ],
)

cc_test(
    name = "test_ddl_identifier_escape",
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime. Use rules_cc's $ORIGIN rpath,
    # rather than its $EXEC_ORIGIN path for tests with static C++ runtimes.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ddl_identifier_escape_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
