--disable_warnings
DROP TABLE IF EXISTS expression_program_values;
--enable_warnings
CREATE TABLE expression_program_values(id BIGINT PRIMARY KEY, a BIGINT, b BIGINT, c BIGINT);
INSERT INTO expression_program_values VALUES
  (1,2,3,NULL),(2,-3,7,0),(3,NULL,4,1),
  (4,9223372036854775807,0,1),(5,-9223372036854775808,0,NULL);

SELECT id,a+b,(a+b)*2,(a+b)+(a+b),a<b,a<=>b
  FROM expression_program_values WHERE id<4 ORDER BY id;
SELECT id,CASE WHEN id<4 THEN a+b+1 ELSE 0 END
  FROM expression_program_values ORDER BY id;
SELECT id,CASE WHEN a IS NULL THEN 0 WHEN c IS NULL THEN a+b ELSE a-b END,
  (a IS NULL OR b>0) AND (c IS NULL OR c=0),NOT c
  FROM expression_program_values WHERE id<4 ORDER BY id;
SELECT id,CASE WHEN id<4 AND a>0 THEN a+b ELSE a END,
  CASE WHEN id<4 AND a<=0 THEN a+b ELSE b END
  FROM expression_program_values ORDER BY id;
SELECT id,CASE WHEN id<4 THEN a+b ELSE 0 END
  FROM expression_program_values WHERE id<0;
SELECT id,a DIV b FROM expression_program_values WHERE id<4 ORDER BY id;
SELECT id,a DIV b FROM expression_program_values WHERE id=4;
SELECT id,a+1 FROM expression_program_values WHERE id=1;
--error 1690
SELECT id,a+1 FROM expression_program_values WHERE id=4;
SELECT id,CASE WHEN id=4 THEN 1 ELSE a+1 END
  FROM expression_program_values WHERE id=4;
SELECT id,CASE WHEN id=5 THEN 1 ELSE a-1 END
  FROM expression_program_values WHERE id=5;

PREPARE expression_rebind FROM 'SELECT id,CASE WHEN c IS NULL THEN a+? ELSE b+? END FROM expression_program_values WHERE id<4 ORDER BY id';
SET @expression_p=10,@expression_q=20;
EXECUTE expression_rebind USING @expression_p,@expression_q;
SET @expression_p=-5,@expression_q=NULL;
EXECUTE expression_rebind USING @expression_p,@expression_q;
SET @expression_p=NULL,@expression_q=2;
EXECUTE expression_rebind USING @expression_p,@expression_q;
DEALLOCATE PREPARE expression_rebind;

SELECT x.id,y.id,CASE WHEN x.a IS NULL THEN y.b ELSE x.a+y.b END
  FROM expression_program_values x JOIN expression_program_values y ON x.id=y.id
  WHERE x.id<4 ORDER BY x.id;
SELECT id,a+1 AS v FROM
  (SELECT id,a FROM expression_program_values WHERE id<4 LIMIT 3) t
  WHERE a+1 ORDER BY id;
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ id,a+1 AS v FROM
  (SELECT id,a FROM expression_program_values WHERE id<4 LIMIT 3) t
  WHERE a+1 ORDER BY id;
SELECT id,a,c,NULL,7 FROM
  (SELECT id,a,c FROM expression_program_values WHERE id<4 LIMIT 3) t
  WHERE a+1 ORDER BY id;
SELECT id,a+1 AS v FROM
  (SELECT id,a FROM expression_program_values WHERE id<4 LIMIT 3) t
  WHERE a+1 ORDER BY id LIMIT 1 OFFSET 1;
PREPARE expression_filter_output FROM 'SELECT id,?,a+? FROM (SELECT id,a FROM expression_program_values WHERE id<4 LIMIT 3) t WHERE ? IS NULL OR a+? ORDER BY id';
SET @expression_p=10;
EXECUTE expression_filter_output USING @expression_p,@expression_p,@expression_p,@expression_p;
SET @expression_p=-5;
EXECUTE expression_filter_output USING @expression_p,@expression_p,@expression_p,@expression_p;
SET @expression_p=NULL;
EXECUTE expression_filter_output USING @expression_p,@expression_p,@expression_p,@expression_p;
DEALLOCATE PREPARE expression_filter_output;

SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ DISTINCT b+1 AS x
  FROM expression_program_values WHERE id<4 ORDER BY 1;
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ DISTINCT b+1 AS x
  FROM expression_program_values WHERE id<4 ORDER BY x;
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ b+1 AS x
  FROM expression_program_values WHERE id<4 GROUP BY 1 ORDER BY 1;
SELECT DISTINCT b+1 AS x FROM expression_program_values WHERE id<4 ORDER BY 1;
SELECT b+1 AS x FROM expression_program_values WHERE id<4 GROUP BY 1 ORDER BY 1;

SELECT id,CASE WHEN id<4 THEN a+b ELSE 0 END,
  CASE WHEN c IS NULL THEN b ELSE c END
  FROM (SELECT id,a,b,c FROM expression_program_values LIMIT 5) t
  WHERE id>0 ORDER BY id;
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ id,CASE WHEN id<4 THEN a+b ELSE 0 END,
  CASE WHEN c IS NULL THEN b ELSE c END
  FROM (SELECT id,a,b,c FROM expression_program_values LIMIT 5) t
  WHERE id>0 ORDER BY id;
SELECT id,a+1 FROM
  (SELECT id,a FROM expression_program_values LIMIT 5) t WHERE id<0;
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ id,a+1 FROM
  (SELECT id,a FROM expression_program_values LIMIT 5) t WHERE id<0;
--error 1690
SELECT id,a+1 FROM
  (SELECT id,a FROM expression_program_values WHERE id=4 LIMIT 1) t;
--error 1690
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ id,a+1 FROM
  (SELECT id,a FROM expression_program_values WHERE id=4 LIMIT 1) t;
SELECT x+1 FROM
  (SELECT DISTINCT b+1 AS x FROM expression_program_values WHERE id<4 ORDER BY 1 LIMIT 3) t
  WHERE x>0 ORDER BY 1;
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS',0) */ x+1 FROM
  (SELECT DISTINCT b+1 AS x FROM expression_program_values WHERE id<4 ORDER BY 1 LIMIT 3) t
  WHERE x>0 ORDER BY 1;

--sorted_result
SELECT b+1 AS x FROM expression_program_values WHERE id<4
  GROUP BY b+1 WITH ROLLUP;
SELECT x+1 FROM
  (SELECT b+1 AS x FROM expression_program_values WHERE id<4 GROUP BY b+1 WITH ROLLUP) t
  ORDER BY 1;

SELECT id,CAST('invalid_integer' AS SIGNED)+a FROM expression_program_values WHERE id=1;
SHOW WARNINGS;
DROP TABLE expression_program_values;
