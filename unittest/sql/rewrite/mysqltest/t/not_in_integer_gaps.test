# Regression for issue #1513: open gaps between consecutive excluded integers
# contain no keys. Keep genuine gaps, fractional domains and NULL semantics.
--disable_warnings
DROP TABLE IF EXISTS t1513, t1513_long, t1513_multi, t1513_real, t1513_signed, t1513_unsigned;
--enable_warnings

CREATE TABLE t1513 (v BIGINT PRIMARY KEY);
INSERT INTO t1513 VALUES (-1), (0), (1), (2), (3), (4), (5), (6), (7);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513 FORCE INDEX(PRIMARY) WHERE v NOT IN (3,4,5);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513 FORCE INDEX(PRIMARY) WHERE v NOT IN (5,3,4,3);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513 FORCE INDEX(PRIMARY) WHERE v NOT IN (2,4);
SELECT COUNT(*) AS selected FROM t1513 FORCE INDEX(PRIMARY) WHERE v NOT IN (3,NULL,4);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513 FORCE INDEX(PRIMARY) WHERE v NOT IN (3.5,4.5);

# Check the access ranges without depending on row estimates, costs or pointers.
--replace_regex /rowset=[0-9]+/rowset=N/ /, $/,/
EXPLAIN BASIC SELECT v FROM t1513 FORCE INDEX(PRIMARY) WHERE v NOT IN (3,4,5);

CREATE TABLE t1513_long (v BIGINT PRIMARY KEY);
INSERT INTO t1513_long VALUES (-1), (0), (1), (10), (11), (500), (1000), (1001);
# The issue's 990 excluded values must form two ranges, without assuming a
# finite column universe or dropping values greater than the excluded run.
--disable_query_log
let $values = 11;
let $value = 12;
while ($value <= 1000)
{
  let $values = $values,$value;
  inc $value;
}
eval SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_long FORCE INDEX(PRIMARY) WHERE v NOT IN ($values);
--enable_query_log

CREATE TABLE t1513_multi (k INT, v BIGINT, w INT, PRIMARY KEY(k,v,w));
INSERT INTO t1513_multi VALUES (1,2,1), (1,2,2), (1,3,1), (1,4,2), (1,5,1), (1,6,1), (1,6,2), (2,2,1), (2,3,1), (2,6,2);
SELECT GROUP_CONCAT(v ORDER BY v DESC) AS selected FROM t1513_multi WHERE k=1 AND v NOT IN (3,4,5) AND w=2;
SELECT GROUP_CONCAT(CONCAT(k,':',v,':',w) ORDER BY k,v,w) AS selected FROM t1513_multi WHERE (k=1 AND v NOT IN (3,4,5)) OR (k=2 AND v=3);

CREATE TABLE t1513_real (id INT PRIMARY KEY, v DOUBLE, n DECIMAL(10,2), INDEX iv(v), INDEX inum(n));
INSERT INTO t1513_real VALUES (1,1,1), (2,1.5,1.5), (3,2,2), (4,NULL,NULL);
SELECT GROUP_CONCAT(id ORDER BY id) AS selected FROM t1513_real FORCE INDEX(iv) WHERE v NOT IN (1,2);
SELECT GROUP_CONCAT(id ORDER BY id) AS selected FROM t1513_real FORCE INDEX(inum) WHERE n NOT IN (1,2);
SELECT COUNT(*) AS selected FROM t1513_real FORCE INDEX(iv) WHERE v NOT IN (1,NULL,2);

CREATE TABLE t1513_signed (v BIGINT PRIMARY KEY);
INSERT INTO t1513_signed VALUES (-9223372036854775808), (-9223372036854775807), (-1), (0), (1), (9223372036854775806), (9223372036854775807);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_signed WHERE v NOT IN (-9223372036854775808,-9223372036854775807,9223372036854775806,9223372036854775807);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_signed WHERE v NOT IN (-9223372036854775808,9223372036854775807);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_signed WHERE v NOT IN (9223372036854775807,9223372036854775807);

CREATE TABLE t1513_unsigned (v BIGINT UNSIGNED PRIMARY KEY);
INSERT INTO t1513_unsigned VALUES (0), (1), (2), (3), (18446744073709551613), (18446744073709551614), (18446744073709551615);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_unsigned WHERE v NOT IN (0,1,0);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_unsigned WHERE v NOT IN (18446744073709551614,18446744073709551615,18446744073709551615);
SELECT GROUP_CONCAT(v ORDER BY v) AS selected FROM t1513_unsigned WHERE v NOT IN (0,18446744073709551615);

DROP TABLE t1513, t1513_long, t1513_multi, t1513_real, t1513_signed, t1513_unsigned;
