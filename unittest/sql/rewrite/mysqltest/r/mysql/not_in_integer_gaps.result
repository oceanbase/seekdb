selected
2
SELECT GROUP_CONCAT(id ORDER BY id) AS selected FROM t1513_real FORCE INDEX(inum) WHERE n NOT IN (1,2);
selected
2
SELECT COUNT(*) AS selected FROM t1513_real FORCE INDEX(iv) WHERE v NOT IN (1,NULL,2);
selected
0
