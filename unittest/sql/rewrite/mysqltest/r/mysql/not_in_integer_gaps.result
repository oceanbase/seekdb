CREATE TABLE t1513_multi (k INT, v BIGINT, w INT, PRIMARY KEY(k,v,w));
INSERT INTO t1513_multi VALUES (1,2,1), (1,2,2), (1,3,1), (1,4,2), (1,5,1), (1,6,1), (1,6,2), (2,2,1), (2,3,1), (2,6,2);
SELECT GROUP_CONCAT(v ORDER BY v DESC) AS selected FROM t1513_multi WHERE k=1 AND v NOT IN (3,4,5) AND w=2;
selected
6,2
SELECT GROUP_CONCAT(CONCAT(k,':',v,':',w) ORDER BY k,v,w) AS selected FROM t1513_multi WHERE (k=1 AND v NOT IN (3,4,5)) OR (k=2 AND v=3);
selected
1:2:1,1:2:2,1:6:1,1:6:2,2:3:1
CREATE TABLE t1513_real (id INT PRIMARY KEY, v DOUBLE, n DECIMAL(10,2), INDEX iv(v), INDEX inum(n));
