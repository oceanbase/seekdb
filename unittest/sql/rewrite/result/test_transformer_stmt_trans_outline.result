***************   Case 244   ***************
SQL: select lnnvl(k1) from (select (c1 + 1) as k1, (c2 + 1) as k2  from t1 where c1  > 0) as s1, (select (c1 - 1) as d1, (c2 - 1) as d2  from t2) as s2 where k1 = d1 and k2=d2 group by k1; 
