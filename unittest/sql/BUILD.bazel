load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "file_sql_cases",
    srcs = [
        "engine/basic/test_file_scan_utils.cpp",
        "parser/test_file_sql_parser.cpp",
    ],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:file_sql_test_headers",
    ],
)

cc_test(
    name = "test_file_sql",
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":file_sql_cases",
        "//src/observer:liboceanbase",
    ],
)
