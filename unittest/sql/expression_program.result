DROP TABLE IF EXISTS expression_program_growth;
CREATE TABLE expression_program_growth(id BIGINT PRIMARY KEY, a BIGINT, b BIGINT, c BIGINT);
INSERT INTO expression_program_growth
SELECT id,id+100,MOD(id,11),CASE WHEN MOD(id,7)=0 THEN NULL ELSE MOD(id,17)-8 END
FROM (
SELECT 100*h.n+10*t.n+u.n+1 AS id
FROM (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5) h,
(SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) t,
(SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) u
) rows_to_insert;
SELECT /*+ NO_MERGE(t) OPT_PARAM('ROWSETS_MAX_ROWS',300) */
id,(a+b)*(a-b)+7 AS v,
CASE WHEN c IS NULL OR c<0 THEN a+b ELSE c-a END AS w,
(a+b)>0 AND (b<8 OR c IS NULL) AS p,c+1 AS n
FROM (
SELECT id,a,b,c FROM expression_program_growth WHERE id<=3
UNION ALL
SELECT id,a,b,c FROM expression_program_growth WHERE id>=4 AND id<=65
UNION ALL
SELECT id,a,b,c FROM expression_program_growth WHERE id>65
LIMIT 600
) t
WHERE (a+b)>0 AND (b<8 OR c IS NULL)
AND (id<4 OR (id>=63 AND id<=67) OR id>595)
ORDER BY id;
id	v	w	p	n
1	10207	102	1	-6
2	10407	104	1	-5
3	10607	106	1	-4
63	26512	171	1	NULL
66	27563	-159	1	8
67	27895	-159	1	9
596	484419	698	1	-6
597	485807	700	1	-5
598	487195	702	1	-4
599	488583	704	1	-3
600	489971	706	1	-2
DROP TABLE expression_program_growth;
