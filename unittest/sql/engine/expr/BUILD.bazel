load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

# The ai function logic lives in SQL internals, so both cases reuse the SQL
# module's test header seam and the shared test runtime instead of pulling the
# SQL implementation targets apart.
cc_library(
    name = "ai_prompt_cases",
    srcs = ["ob_expr_ai_prompt_test.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:ai_func_test_headers",
    ],
)

cc_test(
    name = "ob_expr_ai_prompt_test",
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime; select rules_cc's $ORIGIN rpath.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ai_prompt_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "ai_provider_cases",
    srcs = ["test_ob_openai_utils.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:ai_func_test_headers",
    ],
)

cc_test(
    name = "test_ob_openai_utils",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ai_provider_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
