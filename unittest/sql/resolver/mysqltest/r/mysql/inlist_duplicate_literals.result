-------------------------------------
  0 - output([inlist_duplicates.id]), filter([inlist_duplicates.c IN (1, 2, 3, 1, 2, 3)]), rowset=16
      access([inlist_duplicates.__pk_increment], [inlist_duplicates.c], [inlist_duplicates.id]), partitions(p0)
      is_index_back=true, is_global_index=false, filter_before_indexback[false],
      range_key([inlist_duplicates.__pk_increment]), range(MIN ; MAX)always true
# At the threshold, the existing VALUES rewrite stays enabled.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,2,3,4,1,2) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 3;
