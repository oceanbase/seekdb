# Prepared statements retain every bind position across executions.
PREPARE inlist_ps FROM 'SELECT /*+ OPT_PARAM(''inlist_rewrite_threshold'' 4) */ id FROM inlist_distinct WHERE category IN (?,?,?,?,?,?) ORDER BY id';
SET @a=1, @b=2, @c=3, @d=1, @e=2, @f=3;
EXECUTE inlist_ps USING @a,@b,@c,@d,@e,@f;
id
1
2
3
SET @a=4, @b=5, @c=6, @d=7, @e=8, @f=9;
EXECUTE inlist_ps USING @a,@b,@c,@d,@e,@f;
id
4
5
6
DEALLOCATE PREPARE inlist_ps;
# ANN retains its scalar filter instead of adding a values-table subplan.
CREATE TABLE inlist_distinct_ann (
id INT PRIMARY KEY,
category INT,
embedding VECTOR(3),
VECTOR INDEX ann_idx(embedding)
WITH (distance=l2,type=hnsw,lib=vsag,sync_mode=immediate)
) ORGANIZATION HEAP;
INSERT INTO inlist_distinct_ann VALUES
(1,1,'[0,0,0]'),(2,2,'[1,0,0]'),(3,3,'[2,0,0]'),
(4,4,'[3,0,0]'),(5,NULL,'[4,0,0]');
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) INDEX(inlist_distinct_ann ann_idx) */ id
FROM inlist_distinct_ann WHERE category IN (1,2,3,1,2,3,1,2,3)
ORDER BY l2_distance(embedding,'[0,0,0]') APPROXIMATE LIMIT 3;
