# Four distinct values still reach the threshold, including a distinct NULL.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_distinct WHERE category IN (1,2,3,4,1,2,3,4);
Query Plan
==============================================
|ID|OPERATOR                 |NAME           |
----------------------------------------------
|0 |HASH JOIN                |               |
|1 |├─SUBPLAN SCAN           |VIEW2          |
|2 |│ └─HASH DISTINCT        |               |
|3 |│   └─VALUES TABLE ACCESS|VALUES_TABLE1  |
|4 |└─TABLE FULL SCAN        |inlist_distinct|
==============================================
Outputs & filters:
-------------------------------------
  0 - output([inlist_distinct.id]), filter(nil), rowset=ROWS
      equal_conds([inlist_distinct.category = VIEW2.column_0]), other_conds(nil)
  1 - output([VIEW2.column_0]), filter(nil), rowset=ROWS
      access([VIEW2.column_0])
  2 - output([VALUES_TABLE1.column_0]), filter(nil), rowset=ROWS
      distinct([VALUES_TABLE1.column_0])
  3 - output([VALUES_TABLE1.column_0]), filter(nil)
      access([VALUES_TABLE1.column_0])
  4 - output([inlist_distinct.id], [inlist_distinct.category]), filter(nil), rowset=ROWS
      access([inlist_distinct.id], [inlist_distinct.category]), partitions(p0)
      is_index_back=false, is_global_index=false,
      range_key([inlist_distinct.id]), range(MIN ; MAX)always true
