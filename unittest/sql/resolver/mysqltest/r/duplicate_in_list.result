# Integer constants preserve comparison coercion for a string left operand.
CREATE TABLE inlist_distinct_varchar (id INT PRIMARY KEY, category VARCHAR(20));
INSERT INTO inlist_distinct_varchar VALUES (1,'01'),(2,'1'),(3,'2'),(4,'3'),(5,'4'),(6,NULL);
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id
FROM inlist_distinct_varchar WHERE category IN (1,2,3,1,2,3,1,2,3) ORDER BY id;
id
