--enable_query_log
SET @default_inlist_plan_id=(SELECT MAX(plan_id) FROM oceanbase.__all_virtual_plan_stat WHERE query_sql LIKE 'SELECT id AS default_inlist_id%' AND is_in_pc=1);
SELECT @default_inlist_plan_id IS NOT NULL AS default_plan_cached;
SELECT COUNT(*) AS default_values_operators FROM oceanbase.__all_virtual_plan_cache_plan_explain WHERE plan_id=@default_inlist_plan_id AND operator LIKE '%VALUES%';
--echo # Ordinary and exact queries preserve the existing VALUES strategy.
