SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE (id,c) IN ((1,1),(2,2),(1,1),(2,2),(1,1),(2,2)) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
--echo # The cached plan for ANN SQL must also avoid the VALUES operator.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id AS cached_inlist_id FROM inlist_duplicates WHERE c IN (1,2,3,1,2,3) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 3;
SET @inlist_plan_id=(SELECT MAX(plan_id) FROM oceanbase.__all_virtual_plan_stat WHERE query_sql LIKE 'SELECT /*+ OPT_PARAM%id AS cached_inlist_id%' AND is_in_pc=1);
SELECT @inlist_plan_id IS NOT NULL AS plan_cached;
SELECT COUNT(*) AS values_operators FROM oceanbase.__all_virtual_plan_cache_plan_explain WHERE plan_id=@inlist_plan_id AND operator LIKE '%VALUES%';
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id AS cached_inlist_id FROM inlist_duplicates WHERE c IN (4,4,4,4,4,4) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 3;
SELECT hit_count > 0 AS cache_reused FROM oceanbase.__all_virtual_plan_stat WHERE plan_id=@inlist_plan_id;
--echo # Reuse parameterized SQL with different literal values and NULLs.
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,1,1,1,1,1) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (4,4,4,4,4,4) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,2,3,4,6,7) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (4,4,NULL,4,4,NULL) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
--echo # Explicit bind parameters retain all slots across executions.
PREPARE inlist_stmt FROM 'SELECT /*+ OPT_PARAM(''inlist_rewrite_threshold'' 4) */ GROUP_CONCAT(id ORDER BY id) AS ids FROM inlist_duplicates WHERE c IN (?,?,?,?,?,?)';
SET @a=1,@b=2,@c=3,@d=1,@e=2,@f=3;
EXECUTE inlist_stmt USING @a,@b,@c,@d,@e,@f;
SET @a=4,@b=4,@c=NULL,@d=4,@e=4,@f=NULL;
EXECUTE inlist_stmt USING @a,@b,@c,@d,@e,@f;
DEALLOCATE PREPARE inlist_stmt;
--enable_ps_protocol
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,2,3,1,2,3) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (4,4,4,4,4,4) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 10;
--disable_ps_protocol
CREATE TABLE inlist_ann (id INT PRIMARY KEY, c INT, v VECTOR(3)) ORGANIZATION HEAP;
INSERT INTO inlist_ann VALUES (1,1,'[1,0,0]'),(2,2,'[0,1,0]'),(3,3,'[0,0,1]'),(4,4,'[-1,0,0]');
CREATE VECTOR INDEX inlist_hnsw ON inlist_ann(v) WITH (distance=l2,type=hnsw,lib=vsag,sync_mode=immediate);
SELECT id FROM inlist_ann WHERE c IN (1,2,3) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 1;
SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_ann WHERE c IN (1,2,3,1,2,3) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 1;
DROP TABLE inlist_ann;
DROP TABLE inlist_duplicates;
