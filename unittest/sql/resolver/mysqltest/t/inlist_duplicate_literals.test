# Regression for #1512: keep duplicate-heavy integer membership inside ANN scans.
SET ob_enable_plan_cache=1;
CREATE TABLE inlist_duplicates (id INT PRIMARY KEY, c BIGINT, u BIGINT UNSIGNED, s VARCHAR(10), d DECIMAL(20,1), v VECTOR(3)) ORGANIZATION HEAP;
INSERT INTO inlist_duplicates VALUES (1,1,1,'1',1,'[1,0,0]'),(2,2,2,'2',2,'[2,0,0]'),(3,3,3,'3',3,'[3,0,0]'),(4,4,4,'4',4,'[4,0,0]'),(5,NULL,NULL,NULL,NULL,'[5,0,0]'),(6,-1,18446744073709551615,'-1',-1,'[6,0,0]'),(7,-9223372036854775808,9223372036854775808,'min',-1,'[7,0,0]');
CREATE VECTOR INDEX inlist_dup_hnsw ON inlist_duplicates(v) WITH (distance=l2,type=hnsw,lib=vsag,sync_mode=immediate);
--echo # Three distinct values below a four-value threshold stay inline.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,2,3,1,2,3) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 3;
--echo # At the threshold, the existing VALUES rewrite stays enabled.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,2,3,4,1,2) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 3;
--echo # Above the threshold, a unique list also keeps the VALUES rewrite.
EXPLAIN BASIC SELECT /*+ OPT_PARAM('inlist_rewrite_threshold' 4) */ id FROM inlist_duplicates WHERE c IN (1,2,3,4,5,6) ORDER BY l2_distance(v,'[1,0,0]') APPROXIMATE LIMIT 3;
