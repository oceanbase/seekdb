load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "identifier_escape_cases",
    srcs = ["test_identifier_escape.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_base",
        "//bazel/third_party:gtest",
    ],
)

cc_test(
    name = "test_identifier_escape",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [":identifier_escape_cases", "//src/observer:liboceanbase"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "jemalloc_hook_cases",
    srcs = ["test_jemalloc_hook.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//bazel/third_party:gtest",
    ],
    target_compatible_with = select({
        "//bazel:sanity_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "test_jemalloc_hook",
    linkstatic = True,
    deps = [":jemalloc_hook_cases", "//src/oblib:oblib_test_runtime"],
)
