use oceanbase;
select * from __all_virtual_engine;
ENGINE	SUPPORT	COMMENT	TRANSACTIONS	SAVEPOINTS
InnoDB	DEFAULT	Supports transactions	YES	YES
select Engine, Support, Comment, Transactions, Savepoints from __all_virtual_engine;
Engine	Support	Comment	Transactions	Savepoints
InnoDB	DEFAULT	Supports transactions	YES	YES
show create table __all_virtual_engine;
Table	Create Table
__all_virtual_engine	CREATE TABLE `__all_virtual_engine` (
  `ENGINE` varchar(64) NOT NULL,
  `SUPPORT` varchar(8) NOT NULL,
  `COMMENT` varchar(2048) NOT NULL,
  `TRANSACTIONS` varchar(4) NOT NULL,
  `SAVEPOINTS` varchar(4) NOT NULL
) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 COMPRESSION = 'none' BLOCK_SIZE = SIZE TABLET_SIZE = SIZE PCTFREE = 10
