ERROR 42000: INSERT command denied to user 'maintenance_authz_caller'@'%' for table 't_stats'
SELECT DBMS_STATS.GET_PREFS('STALE_PERCENT', 'maintenance_authz_db', 't_stats') AS stale_percent;
stale_percent
