load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rust_crates//:crates.bzl", "aliases", "all_crate_deps", "crate_edition")
load(":features.bzl", "FEATURES")

package(default_visibility = ["//rust:__subpackages__"])

exports_files(["src/bridge.rs","include/callbacks.h"], visibility = ["//rust:__pkg__"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
)

rust_library(
    name = "sql_nio",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    lint_config = ":lints",
    version = "0.1.0",
    crate_features = select(FEATURES),
    deps = ["//rust/compression"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    aliases = aliases(),
    tags = ["no-remote"],
)

rust_test(
    name = "compression_test",
    crate_root = "src/compress.rs",
    srcs = ["src/compress.rs", "src/compress_tests.rs"],
    edition = crate_edition(),
    deps = ["//rust/compression"],
)
