load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rust_crates//:crates.bzl", "aliases", "all_crate_deps", "crate_edition")
load("//bazel:defs.bzl", "cc_library")

package(default_visibility = ["//rust:__subpackages__"])

exports_files(["src/bridge.rs", "include/sdk.h"], visibility = ["//rust:__pkg__"])

cc_library(
    name = "sdk_headers",
    hdrs = ["include/sdk.h"],
    deps = ["//rust:cxx_headers", "//bazel/third_party:curl"],
    target_compatible_with = select({
        "@platforms//os:emscripten": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//rust:__pkg__"],
)
cc_library(
    name = "sdk",
    srcs = ["src/sdk.cpp"],
    deps = [":sdk_headers", "//rust:http_client_headers"],
)

rust_library(
    name = "http_client",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
    link_deps = select({
        "@platforms//os:emscripten": [],
        "//conditions:default": [":sdk", "//rust:http_client_bridge"],
    }),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    aliases = aliases(),
    tags = ["no-remote"],
)

rust_test(
    name = "http_client_test",
    crate = ":http_client",
    deps = all_crate_deps(normal_dev = True),
    compile_data = glob(["src/testdata/*"]),
    target_compatible_with = select({
        "@platforms//os:emscripten": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
