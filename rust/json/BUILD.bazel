load("//bazel:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rust_crates//:crates.bzl", "aliases", "all_crate_deps", "crate_edition")

package(default_visibility = ["//rust:__subpackages__"])

exports_files(["src/bridge.rs", "include/binary_source.h", "include/schema_pattern.h", "include/read.h"], visibility = ["//rust:__pkg__"])

rust_library(
    name = "json",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    aliases = aliases(),
    tags = ["no-remote"],
)

rust_test(
    name = "test",
    crate = ":json",
    edition = crate_edition(),
    tags = ["no-remote"],
)

cc_library(
    name = "schema_pattern",
    srcs = ["src/schema_pattern.cpp"],
    hdrs = ["include/schema_pattern.h"],
    deps = ["//rust:cxx_headers"],
    visibility = ["//rust:__pkg__"],
)
