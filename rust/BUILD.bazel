load("//bazel:defs.bzl", cc_library = "seekdb_cc_library")

package(default_visibility = ["//visibility:private"])

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

_SQL_NIO_INPUTS = [
    "Cargo.toml",
    "rust-toolchain.toml",
    "sql-nio/Cargo.toml",
] + glob(["sql-nio/src/*.rs"])

# Cargo remains the authoritative Rust dependency resolver used by the
# upstream CMake build.  Keep the action local and outside the sandbox until
# Cargo dependencies are vendored: cargo currently updates the registry under
# ~/.cargo, which Bazel's sandbox deliberately mounts read-only.
genrule(
    name = "_sql_nio_static_unix",
    srcs = _SQL_NIO_INPUTS,
    outs = ["libsql_nio.a"],
    cmd = """
set -eu
export CARGO_TARGET_DIR="$(@D)/sql_nio-cargo-target"
cargo build --release --manifest-path "$(location Cargo.toml)" --package sql-nio
cp "$$CARGO_TARGET_DIR/release/libsql_nio.a" "$@"
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    target_compatible_with = select({
        ":windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "_sql_nio_static_windows",
    srcs = _SQL_NIO_INPUTS,
    outs = ["sql_nio.lib"],
    cmd_bat = """
set CARGO_TARGET_DIR=$(@D)\\sql_nio-cargo-target
cargo build --release --manifest-path "$(location Cargo.toml)" --package sql-nio
copy /Y "%CARGO_TARGET_DIR%\\release\\sql_nio.lib" "$@"
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    target_compatible_with = select({
        ":windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "sql_nio_archive",
    srcs = select({
        ":windows": [":_sql_nio_static_windows"],
        "//conditions:default": [":_sql_nio_static_unix"],
    }),
    visibility = ["//src/observer:__pkg__"],
)

cc_library(
    name = "sql_nio_headers",
    hdrs = ["sql-nio/include/nio.h"],
    includes = ["sql-nio/include"],
    visibility = [
        "//src/oblib:__pkg__",
        "//src/observer:__pkg__",
        "//src/query:__pkg__",
        "//unittest/oblib:__pkg__",
    ],
)
