load("//bazel:defs.bzl", cc_library = "seekdb_cc_library")
load(":ffi_build.bzl", "rust_ffi_archive")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["rust-toolchain.toml"],
    visibility = ["//deps/external:__pkg__"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

# Workspace resolution reads both manifests even when building one package.
_WORKSPACE_INPUTS = [
    "Cargo.toml",
    "rust-toolchain.toml",
    "build-support/ffi.rs",
    "sql-nio/Cargo.toml",
    "embedding-response/Cargo.toml",
]
_SQL_NIO_INPUTS = _WORKSPACE_INPUTS + [
    "sql-nio/build.rs",
    "sql-nio/cbindgen.toml",
] + glob(["sql-nio/src/**/*.rs"])
_EMBEDDING_INPUTS = _WORKSPACE_INPUTS + [
    "embedding-response/build.rs",
    "embedding-response/cbindgen.toml",
] + glob(["embedding-response/src/**/*.rs"])

rust_ffi_archive(
    name = "sql_nio",
    package = "sql-nio",
    srcs = _SQL_NIO_INPUTS,
)

rust_ffi_archive(
    name = "embedding_response",
    package = "embedding-response",
    srcs = _EMBEDDING_INPUTS,
)

cc_library(
    name = "embedding_response_headers",
    hdrs = [
        "embedding-response/include/embedding.h",
    ],
    includes = ["embedding-response/include"],
    visibility = ["//src/query:__pkg__"],
)

cc_library(
    name = "sql_nio_headers",
    hdrs = ["sql-nio/include/nio.h"],
    includes = ["sql-nio/include"],
    visibility = [
        "//src/oblib:__pkg__",
        "//src/observer:__pkg__",
        "//src/query:__pkg__",
        "//unittest/oblib:__pkg__",
    ],
)
