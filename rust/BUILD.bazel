load("//bazel:defs.bzl", cc_library = "seekdb_cc_library")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["rust-toolchain.toml"],
    visibility = ["//deps/external:__pkg__"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

_RUST_INPUTS = [
    "Cargo.toml",
    "rust-toolchain.toml",
    "sql-nio/Cargo.toml",
    "sql-nio/cbindgen.toml",
    "sql-nio/build.rs",
    "auto-config/Cargo.toml",
    "auto-config/cbindgen.toml",
    "auto-config/build.rs",
] + glob(["sql-nio/src/*.rs", "auto-config/src/*.rs"])

# Cargo remains the authoritative Rust dependency resolver used by the
# upstream CMake build.  Keep the action local and outside the sandbox until
# Cargo dependencies are vendored: cargo currently updates the registry under
# ~/.cargo, which Bazel's sandbox deliberately mounts read-only.
genrule(
    name = "_rust_static_unix",
    srcs = _RUST_INPUTS,
    outs = ["libsql_nio.a", "libseekdb_auto_config.a"],
    cmd = """
set -eu
export CARGO_TARGET_DIR="$(@D)/rust-cargo-target"
cargo build --release --manifest-path "$(location Cargo.toml)" --package sql-nio --package seekdb-auto-config
cp "$$CARGO_TARGET_DIR/release/libsql_nio.a" "$(@D)/libsql_nio.a"
cp "$$CARGO_TARGET_DIR/release/libseekdb_auto_config.a" "$(@D)/libseekdb_auto_config.a"
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    target_compatible_with = select({
        ":windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "_rust_static_windows",
    srcs = _RUST_INPUTS,
    outs = ["sql_nio.lib", "seekdb_auto_config.lib"],
    cmd_bat = """
set CARGO_TARGET_DIR=$(@D)\\rust-cargo-target
cargo build --release --manifest-path "$(location Cargo.toml)" --package sql-nio --package seekdb-auto-config
copy /Y "%CARGO_TARGET_DIR%\\release\\sql_nio.lib" "$(@D)\\sql_nio.lib"
copy /Y "%CARGO_TARGET_DIR%\\release\\seekdb_auto_config.lib" "$(@D)\\seekdb_auto_config.lib"
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    target_compatible_with = select({
        ":windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "sql_nio_archive",
    srcs = select({
        ":windows": ["sql_nio.lib"],
        "//conditions:default": ["libsql_nio.a"],
    }),
    visibility = ["//src/observer:__pkg__"],
)

filegroup(
    name = "auto_config_archive",
    srcs = select({
        ":windows": ["seekdb_auto_config.lib"],
        "//conditions:default": ["libseekdb_auto_config.a"],
    }),
    visibility = ["//src/observer:__pkg__"],
)

cc_library(
    name = "sql_nio_headers",
    hdrs = ["sql-nio/include/nio.h"],
    includes = ["sql-nio/include"],
    visibility = [
        "//src/oblib:__pkg__",
        "//src/observer:__pkg__",
        "//src/query:__pkg__",
        "//unittest/oblib:__pkg__",
    ],
)

cc_library(
    name = "auto_config_headers",
    hdrs = ["auto-config/include/auto_config.h"],
    includes = ["auto-config/include"],
    visibility = ["//src/share:__pkg__"],
)
