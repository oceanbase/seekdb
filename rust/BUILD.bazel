load("@cargo_exports//:exports.bzl", "EXPORTS")
load("//bazel:cargo.bzl", "cargo_workspace")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["rust-toolchain.toml"],
    visibility = ["//deps/external:__pkg__"],
)
exports_files(["exports.json"])
exports_files(["Cargo.lock"], visibility = ["//src/observer:__pkg__"])
exports_files(["in-process/include/seekdb.h"], visibility = ["//src/observer:__pkg__"])

# Cargo resolves all Rust dependencies; Bazel tracks build inputs and exposes
# only the libraries explicitly exported to C++.
cargo_workspace(
    exports = EXPORTS,
    srcs = glob(
        ["**/*.rs", "**/*.h", "**/*.py", "**/*.toml", "**/*.yaml", "**/*.yml", "**/*.json", "*.lock"],
        exclude = ["target/**"],
        allow_empty = True,
    ),
)
