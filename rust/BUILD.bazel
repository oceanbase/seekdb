load("//bazel:defs.bzl", cc_library = "seekdb_cc_library")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["rust-toolchain.toml"],
    visibility = ["//deps/external:__pkg__"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

_RUST_INPUTS = [
    "Cargo.toml",
    "rust-toolchain.toml",
    "sql-nio/Cargo.toml",
    "sql-nio/cbindgen.toml",
    "sql-nio/build.rs",
    "auto-config/Cargo.toml",
    "auto-config/cbindgen.toml",
    "auto-config/build.rs",
    "auto-config/parameters.tsv",
    "auto-config/internal_state.tsv",
] + glob(["sql-nio/src/*.rs", "auto-config/src/*.rs"])

# Cargo remains the authoritative Rust dependency resolver used by the
# upstream CMake build.  Keep the action local and outside the sandbox until
# Cargo dependencies are vendored: cargo currently updates the registry under
# ~/.cargo, which Bazel's sandbox deliberately mounts read-only.
genrule(
    name = "_rust_static_unix",
    srcs = _RUST_INPUTS,
    outs = ["libsql_nio.a", "libauto_config.a", "unix/config_bridge.h", "unix/config_checkers.h"],
    cmd = """
set -eu
export CARGO_TARGET_DIR="$(@D)/rust-cargo-target"
export SEEKDB_CXX_HEADER_DIR="$$PWD/$(@D)/unix"
export SEEKDB_DEFAULT_LOG_LEVEL=OB_LOG_LEVEL_ERROR
cargo build --release --manifest-path "$(location Cargo.toml)" --package sql-nio --package auto-config
cp "$$CARGO_TARGET_DIR/release/libsql_nio.a" "$(@D)/libsql_nio.a"
cp "$$CARGO_TARGET_DIR/release/libauto_config.a" "$(@D)/libauto_config.a"
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    target_compatible_with = select({
        ":windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "_rust_static_windows",
    srcs = _RUST_INPUTS,
    outs = ["sql_nio.lib", "auto_config.lib", "windows/config_bridge.h", "windows/config_checkers.h"],
    cmd_bat = """
set CARGO_TARGET_DIR=$(@D)\\rust-cargo-target
set SEEKDB_CXX_HEADER_DIR=%CD%\\$(@D)\\windows
set SEEKDB_DEFAULT_LOG_LEVEL=OB_LOG_LEVEL_ERROR
cargo build --release --manifest-path "$(location Cargo.toml)" --package sql-nio --package auto-config
copy /Y "%CARGO_TARGET_DIR%\\release\\sql_nio.lib" "$(@D)\\sql_nio.lib"
copy /Y "%CARGO_TARGET_DIR%\\release\\auto_config.lib" "$(@D)\\auto_config.lib"
""",
    tags = [
        "no-remote",
        "no-sandbox",
    ],
    target_compatible_with = select({
        ":windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "sql_nio_archive",
    srcs = select({
        ":windows": ["sql_nio.lib"],
        "//conditions:default": ["libsql_nio.a"],
    }),
    visibility = ["//src/observer:__pkg__"],
)

filegroup(
    name = "auto_config_archive",
    srcs = select({
        ":windows": ["auto_config.lib"],
        "//conditions:default": ["libauto_config.a"],
    }),
    visibility = ["//src/observer:__pkg__"],
)

cc_library(
    name = "sql_nio_headers",
    hdrs = ["sql-nio/include/nio.h"],
    includes = ["sql-nio/include"],
    visibility = [
        "//src/oblib:__pkg__",
        "//src/observer:__pkg__",
        "//src/query:__pkg__",
        "//unittest/oblib:__pkg__",
    ],
)

cc_library(
    name = "auto_config_headers",
    hdrs = ["auto-config/include/auto_config.h"],
    includes = ["auto-config/include"],
    visibility = ["//src/share:__pkg__", "//src/observer:__pkg__"],
)

cc_library(
    name = "config_bridge_headers",
    hdrs = select({
        ":windows": ["windows/config_bridge.h", "windows/config_checkers.h"],
        "//conditions:default": ["unix/config_bridge.h", "unix/config_checkers.h"],
    }),
    includes = select({
        ":windows": ["windows"],
        "//conditions:default": ["unix"],
    }),
    visibility = ["//src/share:__pkg__", "//src/observer:__pkg__", "//src/rootserver:__pkg__", "//src/sql:__subpackages__", "//src/storage:__pkg__", "//src/pl:__pkg__", "//src/standby:__pkg__"],
)
