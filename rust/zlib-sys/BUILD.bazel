load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rust_crates//:crates.bzl", "aliases", "all_crate_deps", "crate_edition")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = [
        "@@rules_rust++crate+rust_crates__libz-sys-1.1.31//:src/zlib/zconf.h",
        "@@rules_rust++crate+rust_crates__libz-sys-1.1.31//:src/zlib/zlib.h",
    ],
    strip_include_prefix = "/src/zlib",
)

rust_library(
    name = "library",
    crate_name = "zlib_sys",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
    aliases = aliases(),
    tags = ["no-remote"],
)

alias(
    name = "zlib",
    actual = "//rust:archive",
)
