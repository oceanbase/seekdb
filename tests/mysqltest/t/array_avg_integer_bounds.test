# Integer AVG returns DOUBLE, so an overflowing 64-bit intermediate sum must
# not reject an average that is representable. Real columns exercise execution.
--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS array_avg_integer_bounds;
--enable_warnings
CREATE TABLE array_avg_integer_bounds(id INT PRIMARY KEY,s ARRAY(BIGINT),u ARRAY(BIGINT UNSIGNED),expected_s DOUBLE,expected_u DOUBLE);
INSERT INTO array_avg_integer_bounds VALUES
(1,[9223372036854775807,9223372036854775807],[CAST('18446744073709551615' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)],CAST('9223372036854775807' AS DOUBLE),CAST('18446744073709551615' AS DOUBLE)),
(2,[-9223372036854775808,-9223372036854775808],[CAST('0' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED)],CAST('-9223372036854775808' AS DOUBLE),CAST('18446744073709551615' AS DOUBLE)/2),
(3,[-9223372036854775808,9223372036854775807],[CAST('18446744073709551615' AS UNSIGNED),CAST('0' AS UNSIGNED)],-0.5,CAST('18446744073709551615' AS DOUBLE)/2),
(4,[9223372036854775807,-9223372036854775808],[CAST('18446744073709551615' AS UNSIGNED),CAST('1' AS UNSIGNED)],-0.5,CAST('9223372036854775808' AS DOUBLE)),
(5,[9223372036854775807,1],[CAST('18446744073709551615' AS UNSIGNED),CAST('18446744073709551615' AS UNSIGNED),CAST('0' AS UNSIGNED)],CAST('9223372036854775808' AS DOUBLE)/2,(CAST('18446744073709551615' AS DOUBLE)*2)/3),
(6,[0,-1],[CAST('0' AS UNSIGNED),CAST('1' AS UNSIGNED)],-0.5,0.5),
(7,[1,NULL],[CAST('1' AS UNSIGNED),NULL],0.5,0.5),
(8,NULL,NULL,NULL,NULL),
(9,[NULL,NULL],[NULL,NULL],0,0),
(10,[1,2,3],[CAST('1' AS UNSIGNED),CAST('2' AS UNSIGNED),CAST('3' AS UNSIGNED)],2,2),
(11,[9223372036854775807,9223372036854775807,-9223372036854775808,-9223372036854775808],[CAST('2' AS UNSIGNED),CAST('4' AS UNSIGNED)],-0.5,3),
(12,[-9223372036854775808,-9223372036854775808,9223372036854775807,9223372036854775807],[CAST('4' AS UNSIGNED),CAST('2' AS UNSIGNED)],-0.5,3),
(13,[9223372036854775807,1,-9223372036854775807],[CAST('1' AS UNSIGNED),CAST('2' AS UNSIGNED)],CAST(1 AS DOUBLE)/3,1.5),
(14,[-9223372036854775807,9223372036854775807,1],[CAST('2' AS UNSIGNED),CAST('1' AS UNSIGNED)],CAST(1 AS DOUBLE)/3,1.5);

--echo integer_column_averages
SELECT id,array_avg(s)<=>expected_s AS signed_ok,array_avg(u)<=>expected_u AS unsigned_ok FROM array_avg_integer_bounds ORDER BY id;

--echo scalar_subquery_average
SELECT array_avg((SELECT s FROM array_avg_integer_bounds WHERE id=1))=CAST('9223372036854775807' AS DOUBLE) AS scalar_signed_ok,array_avg((SELECT u FROM array_avg_integer_bounds WHERE id=1))=CAST('18446744073709551615' AS DOUBLE) AS scalar_unsigned_ok;

--echo cancellation_keeps_low_bits
SELECT array_avg(s) AS average FROM array_avg_integer_bounds WHERE id IN (3,4) ORDER BY id;

--echo existing_empty_null_semantics
SELECT array_avg(array_filter((x)->false,s)) IS NULL AS empty_is_null,array_avg(NULL) IS NULL AS null_is_null FROM array_avg_integer_bounds WHERE id=1;

--echo small_integer_and_float_controls
SELECT array_avg([1,2,3])=2 AS small_ok,array_avg([1.5,2.5])=2 AS float_ok;

--echo sum_still_rejects_signed_overflow
--error 1690
SELECT array_sum(s) FROM array_avg_integer_bounds WHERE id=1;
--echo sum_still_rejects_unsigned_overflow
--error 1690
SELECT array_sum(u) FROM array_avg_integer_bounds WHERE id=1;
DROP TABLE array_avg_integer_bounds;
