# Standard JSON syntax is identical on every platform.
select json_valid('{"a":[1,true,null,"雪"]}');
select json_valid('{a:1}');
select json_valid('{''a'':1}');
select json_valid('[1,]');
select json_valid('{"a":1,}');
select json_valid('TRUE');
select json_valid('False');
select json_valid('NULL');
select json_valid('+1');
select json_valid('.5');
select json_valid('01');
select json_valid('0x10');
select json_valid('NaN');
select json_valid('Infinity');
select json_valid('1.');
select json_valid('/* comment */null');
select json_type(cast('9223372036854775807' as json));
select json_type(cast('9223372036854775808' as json));
select json_type(cast('18446744073709551616' as json));
select json_type(cast('-0' as json));
select json_type(cast('-0.0' as json));
select json_type(cast('{"a":[1]}' as json));
select json_depth(cast('null' as json));
select json_depth(cast('[]' as json));
select json_depth(cast('{"a":[1,{"b":2}]}' as json));
select json_depth('{"a":[1,{"b":2}]}');
select json_depth(null);
select json_extract(cast('{"a":[1,2],"a":{"x":3}}' as json), '$.a.x');
select json_length(cast('{"a":[0,1,2,3],"b":{"a":5}}' as json));
select json_length('{"a":[0,1,2,3],"b":{"a":5}}', '$.a');
select json_length(cast('{"a":[0,1,2,3],"b":{"a":5}}' as json), '$.a[1 to 2]');
select json_length(cast('{"a":[0,1,2,3],"b":{"a":5}}' as json), '$**.a');
select json_length(cast('{"a":1}' as json), '$.missing');
select json_length(cast('1' as json), '$[0]');
select json_length(cast('1' as json), '$[*]');
select json_length('{"雪":{"x":true}}', '$.雪');
select json_contains_path(cast('{"a":[0,1,2,3],"b":{"a":5}}' as json), 'one', '$**.a');
select json_contains_path('{"a":[0,1,2,3],"b":{"a":5}}', 'all', '$.a', '$.b.a');
select json_contains_path(cast('{"a":1}' as json), 'all', '$.a', '$.missing');
select json_contains_path('{"雪":{"x":true},"a.b":9}', 'one', '$.雪.x', '$."a.b"');
select json_contains_path(cast('{"a":1}' as json), 'one', '$.missing', '$.a');
select json_value('{"a":1}', '$.a' returning signed);
select json_value('{"a":"雪"}', '$.a' returning char);
select json_value('{"a":true}', '$.a' returning signed);
select json_value('{"a":null}', '$.a' returning signed);
select json_value('{"a":2}', '$.missing' returning signed default 99 on empty);
select json_value('{"a":[1,2]}', '$.a[1]' returning signed);
select json_value('{"a":[1,2]}', '$.a[*]' returning signed default 88 on error);
select json_value('{"a":3}', '$.a' returning signed);
select json_query('{"a":[1,2]}', '$.a' returning json);
select json_query('{"a":1}', '$.a' returning json with wrapper);
select json_query('{"a":[1,2]}', '$.a[*]' returning json);
select json_query('{"a":[1,2]}', '$.a[*]' returning json with wrapper);
select json_query('{"a":[1,2]}', '$.a[*]' returning json with conditional wrapper);
select json_query('{"a":1}', '$.a[0]' returning json);
select json_query('{"a":1}', '$.a' returning json disallow scalars with conditional wrapper);
select json_query('{"a":{"x":1},"b":{"x":2}}', '$**.x' returning json with wrapper);
select json_query('{"a":"雪"}', '$.a' returning json with wrapper);
select json_query('{"a":1,"a":2}', '$.a' returning json);
select json_query(cast('{"a":[1,2]}' as json), '$.a' returning json);
select json_query('{"a":[1,2]}', '$.missing' returning json empty array on empty);
select json_query('{"a":[1,2]}', '$.missing' returning json empty object on empty);
set @json_invalid_document = 'not-json';
--error ER_INVALID_JSON_TEXT_IN_PARAM
select json_query(cast(@json_invalid_document as json), '$' returning json null on error);
--error ER_INVALID_JSON_TEXT_IN_PARAM
select json_value(cast(@json_invalid_document as json), '$' null on error);
set @json_invalid_document = null;
--error 4016
select json_query('{}', '' returning json);
select json_depth(json_query(concat(repeat('[',101),'0',repeat(']',101)), '$' returning json));
select json_depth(json_value(concat(repeat('[',101),'0',repeat(']',101)), '$' returning json));
select ord,a from json_table('[{"a":1},{"a":2}]', '$[*]' columns(ord for ordinality,a int path '$.a')) jt;
select * from json_table('[{"a":10,"b":[1,2]},{"a":20,"b":[]}]', '$[*]' columns(ord for ordinality,a int path '$.a',nested path '$.b[*]' columns(b int path '$'))) jt;
select * from json_table('[{"a":[{"b":[1]}]},{"a":[{"b":[2]}]}]','$[*]' columns(nested path '$.a[*]' columns(nested path '$.b[*]' columns(v int path '$')))) jt;
select * from json_table('{"a":[1,2],"b":[3,4]}', '$' columns(nested path '$.a[*]' columns(a int path '$'),nested path '$.b[*]' columns(b int path '$'))) jt;
select * from json_table('[{"a":[1,2]},{"a":null},{}]', '$[*]' columns(a json path '$.a[*]')) jt;
select * from json_table('[{"a":1},{}]', '$[*]' columns(a int path '$.missing' default '9' on empty)) jt;
prepare json_table_scan from 'select a from json_table(?, ''$[*]'' columns(a int path ''$.a'')) jt';
set @json_table_document = '[{"a":1},{"a":2}]';
execute json_table_scan using @json_table_document;
set @json_table_document = '[{"a":3}]';
execute json_table_scan using @json_table_document;
deallocate prepare json_table_scan;
set @json_table_document = null;
--error ER_INVALID_JSON_PATH
select json_length(cast('{"a":1}' as json), '$**');
--error ER_INVALID_JSON_PATH
select json_contains_path(cast('{"a":1}' as json), 'one', '$.0a');
select json_schema_valid('{"type":"object"}', '{"a":1}');
--error 1
select json_schema_valid('{"dependencies":{"a":{"required":["b"]}}}', 'null');
--error 1
select json_schema_validation_report('{"dependencies":{"a":{"required":["b"]}}}', 'null');
select json_schema_valid('{"properties":{"a":{"not":{"minimum":0}}},"patternProperties":{"a":{"not":{"type":"integer"}}}}', '{"ba":1}');
--error 1048
select json_schema_valid(schema_text,document_text) from (select '{"properties":{"a":{"not":{"minimum":0}}},"patternProperties":{"a":{"not":{"type":"integer"}}}}' schema_text,'{"ba":1}' document_text union all select '{}','{}') inputs;
--error ER_INVALID_JSON_TEXT_IN_PARAM
select json_schema_valid('{"type":"object"}', '{a:1}');
--error ER_INVALID_JSON_TEXT_IN_PARAM
select cast('{"a":1,}' as json);

--error ER_INVALID_JSON_PATH
select json_replace('{"a":[1,2]}', '$.a[*]', 9);
set @json_invalid_mutation_value = 'invalid json';
--error ER_INVALID_JSON_TEXT_IN_PARAM
select json_insert('1', '$.a', cast(@json_invalid_mutation_value as json));
select json_insert('1', '$.missing.a', cast(@json_invalid_mutation_value as json));
set @json_invalid_mutation_value = null;
select json_set('{"a":[1,2]}', '$.a[0]', 9, '$.a[1]', 8);
select json_schema_valid(json_object('enum',json_array(time '12:00:00.000001')),json_extract(json_array(time '12:00:00.000002'),'$[0]'));
select json_schema_valid('{"uniqueItems":true}',json_array(time '12:00:00.000001',time '12:00:00.000002'));
--echo # Negative SQL TIME values retain their sign and microseconds in JSON
select json_array(time '-12:00:00.000001', time '-12:00:00.000002') as negative_time_array;
select json_type(json_extract(json_array(time '-12:00:00.000001'), '$[0]')) as element_type;
select cast(json_extract(json_array(time '-12:00:00.000002'), '$[0]') as time(6)) as round_trip;
select json_schema_valid(json_object('enum', json_array(time '-12:00:00.000001')),
  json_extract(json_array(time '-12:00:00.000002'), '$[0]')) as enum_valid;
select json_schema_valid('{"uniqueItems":true}',
  json_array(time '-12:00:00.000001', time '-12:00:00.000002')) as unique_items_valid;
prepare json_table_nested_scan from 'select * from json_table(?, ''$[*]'' columns(nested path ''$.a[*]'' columns(nested path ''$.b[*]'' columns(v int path ''$'')))) jt';
set @json_nested_document = '[{"a":[{"b":[1,2]}]},{"a":[{"b":[3]}]}]';
execute json_table_nested_scan using @json_nested_document;
set @json_nested_document = '[{"a":[{"b":[4]}]},{"a":[{"b":[5,6]}]}]';
execute json_table_nested_scan using @json_nested_document;
deallocate prepare json_table_nested_scan;
set @json_nested_document = null;
select json_contains('[[2],1]', '1') as nested_scalar, json_contains('[{"a":2},1]', '[1]') as candidate_array, json_contains('[[3],1,2]', '[1,2]') as multiple_candidates, json_contains('{"b":{}}', '{"b":{"x":2}}') as empty_first, json_contains('{"a":1,"b":{}}', '{"a":1,"b":{"x":2}}') as empty_after_match;
select json_extract(json_array(repeat('x',300),-1),'$[1]') as constructed_negative, json_extract(cast(concat('["',repeat('x',300),'",-1]') as json),'$[1]') as parsed_negative;
select json_search('{"a":"leaf","nested":{"a":"leaf"}}','all','leaf',null,'$**.a') as recursive_locations;
# JSON_TYPE length must be valid for CASE and cover its longest type name.
SELECT CASE WHEN 0 THEN JSON_TYPE(CAST('9223372036854775808' AS JSON)) ELSE JSON_TYPE(CAST('9223372036854775808' AS JSON)) END AS type_name;

# JSON-valued member names must use text, including quotes on JSON strings.
set names utf8mb4;
select json_object(cast('{"c1":1}' as json),1) = json_object(cast(cast('{"c1":1}' as json) as char),1) as object_key, json_object(cast('[1,2]' as json),1) = json_object(cast(cast('[1,2]' as json) as char),1) as array_key, json_object(cast('1' as json),1) = json_object(cast(cast('1' as json) as char),1) as number_key, json_object(cast('"key"' as json),1) = json_object(cast(cast('"key"' as json) as char),1) as string_key, json_object(cast('null' as json),1) = json_object(cast(cast('null' as json) as char),1) as json_null_key, json_object(cast('true' as json),1) = json_object(cast(cast('true' as json) as char),1) as boolean_key, json_object(cast('"中文😀"' as json),1) = json_object(cast(cast('"中文😀"' as json) as char),1) as unicode_key;
create table json_object_key_regression(id int primary key, doc json);
insert into json_object_key_regression values (1,'{"c1":1}'),(2,'[1,2]'),(3,'1'),(4,'"key"'),(5,'null'),(6,'true'),(7,'"中文😀"'),(8,concat('{"c1":"',repeat('x',12000),'"}'));
select id, json_object(cast(doc as json),1) = json_object(cast(doc as char),1) as cast_column_key from json_object_key_regression order by id;
select id, json_object(doc,1) = json_object(cast(doc as char),1) as plain_column_key from json_object_key_regression order by id;
select json_object(cast('1' as json),1,cast('2' as json),2) = cast('{"1":1,"2":2}' as json) as distinct_keys, json_object(cast('1' as json),1,cast('1' as json),2) = cast('{"1":2}' as json) as duplicate_key, json_object('key',1) = cast('{"key":1}' as json) as plain_string_key, json_object(cast('1' as json),null) = cast('{"1":null}' as json) as null_value;
prepare json_object_key_regression_stmt from 'select json_object(cast(? as json),1) = json_object(cast(cast(? as json) as char),1) as prepared_key';
set @json_object_key_document = '{"c1":1}';
execute json_object_key_regression_stmt using @json_object_key_document,@json_object_key_document;
set @json_object_key_document = '[1,2]';
execute json_object_key_regression_stmt using @json_object_key_document,@json_object_key_document;
set @json_object_key_document = '"中文😀"';
execute json_object_key_regression_stmt using @json_object_key_document,@json_object_key_document;
set @json_object_key_document = concat('{"c1":"',repeat('x',12000),'"}');
execute json_object_key_regression_stmt using @json_object_key_document,@json_object_key_document;
deallocate prepare json_object_key_regression_stmt;
set @json_object_key_document = null;
--error 3158
select json_object(null,1);
--error 3144
select json_object(_binary'x',1);
--error 1582
select json_object('key');
drop table json_object_key_regression;
